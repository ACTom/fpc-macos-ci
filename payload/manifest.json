    "prior_commit": "2abfe69ab5af676c38a6bfd4012e4fcd36a206bd",
    "path": "packages/fcl-web/src/base/fphttpclient.pp",
    "prior_source_sha256": "f37f756f002818e0aa017c04ba6eccb9b6ac04305233875029fbf08531d050bd",
    "reverse_patch": "diff --git a/packages/fcl-web/src/base/fphttpclient.pp b/packages/fcl-web/src/base/fphttpclient.pp\nindex 971f10e84..59faa6f9d 100644\n--- a/packages/fcl-web/src/base/fphttpclient.pp\n+++ b/packages/fcl-web/src/base/fphttpclient.pp\n@@ -841,9 +841,6 @@ procedure TFPCustomHTTPClient.ConnectToServer(const AHost: String;\n Var\n   G : TSocketHandler;\n   S : TSocketStream;\n-  {$ifdef Unix}\n-  HandlerClass : TSSLSocketHandlerClass;\n-  {$endif}\n \n begin\n   If IsConnected Then\n@@ -859,33 +856,16 @@ procedure TFPCustomHTTPClient.ConnectToServer(const AHost: String;\n \n   G:=Nil;\n   {$ifdef Unix}\n-  if UnixSocketPath<>'' then\n-    begin\n-    { Keep the existing Unix socket route: no TLS handler or creation callbacks.\n-      A provider which requires its own transport must reject this route without\n-      constructing a handler or silently opening a different TCP connection. }\n-    if UseSSL then\n-      begin\n-      HandlerClass:=TSSLSocketHandler.GetDefaultHandlerClass;\n-      if Assigned(HandlerClass) and HandlerClass.RequiresClientPeer then\n-        raise EHTTPClient.Create('Transport-owning client peers do not support Unix sockets');\n-      end;\n-    end\n-  else\n+  if (UnixSocketPath='') or UseSSL then\n   {$endif}\n-    begin\n     G:=GetSocketHandler(UseSSL);\n-    try\n-      { Ask before opening TCP: currently macOS Network.framework owns TCP and\n-        TLS. Nil keeps OpenSSL, GnuTLS and Schannel on their socket path; a peer\n-        supplies the connection. Platform checks remain in the provider/selector. }\n-      if G is TSSLSocketHandler then\n-        FPeer:=TSSLSocketHandler(G).CreateClientPeer(AHost,APort);\n-    except\n-      G.Free;\n-      raise;\n-    end;\n-    end;\n+  try\n+    if G is TSSLSocketHandler then\n+      FPeer:=TSSLSocketHandler(G).CreateClientPeer(AHost,APort);\n+  except\n+    G.Free;\n+    raise;\n+  end;\n \n   if Assigned(FPeer) then\n     begin\n@@ -1671,8 +1651,6 @@ procedure TFPCustomHTTPClient.StartEventStream;\n   lSocket : TSocketStream;\n   lBuffer : AnsiString;\n begin\n-  { Event sources take ownership of a TSocketStream. A peer without a socket\n-    cannot be transferred through this API. }\n   if Assigned(FPeer) and not (FPeer is TSocketPeer) then\n     raise EHTTPClient.Create('This client peer does not support event streams');\n   lBuffer:=ExtractBuffer;\n"
  }
}
