 end;
 
-procedure FreeGnuTLS;
+procedure DoFreeGnuTLS;
 
 begin
   if Not GnuTLSLoaded then
@@ -3193,7 +3202,7 @@ procedure FreeGnuTLS;
 end;
 
 
-procedure LoadGnuTLS(alib : String = '');
+procedure DoLoadGnuTLS(alib: String);
 
   Function GPA(aName : string) : Pointer;
 
@@ -4027,4 +4036,41 @@ procedure LoadGnuTLS(alib : String = '');
   LoadedLibName:=aLib;
 end;
 
+procedure LoadGnuTLS(alib: String);
+begin
+  EnterCriticalSection(LibraryLock);
+  try
+    DoLoadGnuTLS(alib);
+  finally
+    LeaveCriticalSection(LibraryLock);
+  end;
+end;
+
+procedure FreeGnuTLS;
+begin
+  EnterCriticalSection(LibraryLock);
+  try
+    DoFreeGnuTLS;
+  finally
+    LeaveCriticalSection(LibraryLock);
+  end;
+end;
+
+function LoadGnuTLSIfUnloaded(const aLib: String): Boolean;
+begin
+  EnterCriticalSection(LibraryLock);
+  try
+    if (hlib<>NilHandle) or (aLib='') then
+      Exit(False);
+    DoLoadGnuTLS(aLib);
+    Result:=hlib<>NilHandle;
+  finally
+    LeaveCriticalSection(LibraryLock);
+  end;
+end;
+
+initialization
+  InitCriticalSection(LibraryLock);
+{ The normal explicit FreeGnuTLS API owns unload policy. Keep the lock valid
+  during other units' finalization; no new automatic library unload. }
 end.
diff --git a/packages/gnutls/src/gnutlssockets.pp b/packages/gnutls/src/gnutlssockets.pp
index 83a2a63bf..0490966c0 100644
--- a/packages/gnutls/src/gnutlssockets.pp
+++ b/packages/gnutls/src/gnutlssockets.pp
@@ -45,6 +45,9 @@ interface
     Function FetchErrorInfo: Boolean;
     function Check(aResult: cInt) : cInt;
     function CheckOK(aResult: cInt) : Boolean;
+    { Default preserves the existing explicit backend's verification setup.
+      A client adapter may condition this on VerifyPeerCert. }
+    procedure ConfigurePeerVerification(const HostName: AnsiString); virtual;
     function InitSession(AsServer: Boolean): Boolean; virtual;
     function DoneSession: Boolean; virtual;
     function InitSslKeys: boolean;virtual;
@@ -388,6 +391,11 @@ procedure TGNUTLSSocketHandler.SetGNUTLSLastErrorString(AValue: Ansistring);
 end;
 
 
