+#!/usr/bin/env python3
+"""Compile tests with a matching branch compiler/RTL and built FCL packages."""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--source', type=Path, required=True)
+    ap.add_argument('--compiler', type=Path, required=True)
+    ap.add_argument('--rtl', type=Path, required=True)
+    ap.add_argument('--output', type=Path, required=True)
+    ap.add_argument('--dotted', action='store_true')
+    ap.add_argument('--sdk')
+    ap.add_argument('--minimum')
+    args = ap.parse_args()
+    source, compiler, out = args.source.resolve(), args.compiler.resolve(), args.output.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    cpu = subprocess.check_output([str(compiler), '-iTP'], text=True).strip()
+    system = subprocess.check_output([str(compiler), '-iTO'], text=True).strip()
+    opts = ['-n', '-gl', '-dFPC_NETWORKFRAMEWORK_DIAGNOSTICS', '-Fu'+str(args.rtl.resolve())]
+    if args.dotted:
+        opts += ['-dFPC_DOTTEDUNITS', '-dTEST_DOTTEDUNITS']
+    if args.sdk:
+        opts += ['-XR'+args.sdk]
+    if args.minimum:
+        opts += ['-WM'+args.minimum]
+    for package in ['fcl-tls', 'gnutls', 'openssl', 'fcl-net', 'fcl-web']:
+        folder = source / 'packages' / package
+        src = folder / 'src'
+        if package == 'fcl-web':
+            src /= 'base'
+        opts += ['-Fi'+str(src), '-Fu'+str(folder/'namespaced' if args.dotted else src)]
+    opts += ['-Fi'+str(source/'packages/fcl-net/src'/('win' if system.startswith('win') else 'unix'))]
+    unit_pattern = '*/units/dotted/units/' if args.dotted else '*/units/'
+    opts += ['-Fu'+str(p) for p in sorted((source/'packages').glob(unit_pattern+cpu+'-'+system))]
+    opts += ['-FU'+str(out), '-FE'+str(out)]
+    tests = ['testsmartselection', 'testsmarthttp']
+    if system.startswith('win'):
+        tests += ['testsmartnative']
+    elif system == 'darwin' and not args.dotted:
+        tests += ['testsmartnetworkhttp']
+    rows = []
+    for name in tests:
+        with (out/(name+'-compile.log')).open('wb') as log:
+            p = subprocess.run([str(compiler), *opts, str(source/'packages/fcl-tls/tests'/(name+'.pp'))],
+                               cwd=out, stdout=log, stderr=log)
+        rows.append({'program': name, 'returncode': p.returncode})
+        print(name, p.returncode, flush=True)
+        if p.returncode:
+            print((out/(name+'-compile.log')).read_text(errors='replace')[-4000:])
+            break
+    (out/'compile-results.json').write_text(json.dumps(rows, indent=2)+'\n', encoding='utf-8')
+    return p.returncode
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/packages/fcl-tls/tests/testsmartexternal.py b/packages/fcl-tls/tests/testsmartexternal.py
new file mode 100644
index 00000000..547f413d
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartexternal.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Real bundled OpenSSL/GnuTLS HTTPS; no mock libraries or trust-store edits.
+
+Place actual runtime libraries beside --program before running. An existing
+OpenSSL CLI generates disposable certificates; Python ssl serves loopback TLS.
+Trusted positive controls isolate hostname/expiry failures. A rejection counts
+only with a certificate alert observed by the server, never a generic timeout.
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+from pathlib import Path
+import socket
+import ssl
+import subprocess
+import threading
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--program', type=Path, required=True)
+    ap.add_argument('--openssl', type=Path, required=True)
+    ap.add_argument('--backend', choices=['openssl', 'gnutls'], required=True)
+    ap.add_argument('--output', type=Path, required=True)
+    args = ap.parse_args()
+    args.program, args.openssl = args.program.resolve(), args.openssl.resolve()
+    root = args.output.resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    rows = []
+
+    def command(*parts):
+        p = subprocess.run([str(args.openssl), *map(str, parts)],
+                           capture_output=True, text=True, timeout=30)
+        if p.returncode:
+            raise RuntimeError(p.stdout + p.stderr)
+        return p.stdout.strip()
+
+    config = root / 'ca.conf'
+    config.write_text('[req]\ndistinguished_name=dn\nx509_extensions=ca\nprompt=no\n'
+                      '[dn]\nCN=FPC disposable smart TLS root\n[ca]\n'
+                      'basicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,cRLSign\n')
+    command('req', '-new', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3',
+            '-config', config, '-keyout', root / 'root.key', '-out', root / 'root.pem')
+    command('req', '-new', '-newkey', 'rsa:2048', '-nodes', '-subj', '/CN=localhost',
+            '-keyout', root / 'server.key', '-out', root / 'server.csr')
+    for index, (name, san) in enumerate([('valid', 'DNS:localhost,IP:127.0.0.1'),
+                                       ('wrong-dns', 'DNS:another.invalid')], 1):
+        ext = root / (name + '.ext')
+        ext.write_text('basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\n'
+                       'extendedKeyUsage=serverAuth\nsubjectAltName=' + san + '\n')
+        command('x509', '-req', '-in', root / 'server.csr', '-CA', root / 'root.pem',
+                '-CAkey', root / 'root.key', '-set_serial', index, '-days', '2',
+                '-extfile', ext, '-out', root / (name + '.pem'))
+    (root / 'index').write_text('')
+    (root / 'serial').write_text('1000\n')
+    config.write_text(f'[ca]\ndefault_ca=test\n[test]\ndir="{root.as_posix()}"\n'
+                      'database=$dir/index\nserial=$dir/serial\nnew_certs_dir=$dir\n'
+                      'certificate=$dir/root.pem\nprivate_key=$dir/root.key\ndefault_md=sha256\n'
+                      'policy=policy\n[policy]\ncommonName=supplied\n')
+    now = datetime.now(timezone.utc)
+    command('ca', '-batch', '-notext', '-config', config, '-in', root / 'server.csr',
+            '-extfile', root / 'valid.ext', '-startdate', (now-timedelta(days=2)).strftime('%Y%m%d%H%M%SZ'),
+            '-enddate', (now-timedelta(days=1)).strftime('%Y%m%d%H%M%SZ'), '-out', root / 'expired.pem')
+    # A second CA is never configured in the client.
+    command('req', '-new', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '2',
+            '-subj', '/CN=Untrusted smart TLS root', '-keyout', root / 'untrusted.key',
+            '-out', root / 'untrusted-root.pem')
+    command('x509', '-req', '-in', root / 'server.csr', '-CA', root / 'untrusted-root.pem',
+            '-CAkey', root / 'untrusted.key', '-set_serial', '10', '-days', '1',
+            '-extfile', root / 'valid.ext', '-out', root / 'untrusted.pem')
+
+    def case(name, certificate='valid', verify='true', mode='pass', tls='tls12'):
+        listener = socket.socket()
+        listener.bind(('127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(8)
+        observed = {'connections': 0, 'requests': 0}
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        version = ssl.TLSVersion.TLSv1_2 if tls == 'tls12' else ssl.TLSVersion.TLSv1_3
+        context.minimum_version = context.maximum_version = version
+        context.load_cert_chain(root / (certificate + '.pem'), root / 'server.key')
+        count = 2 if mode == 'reuse' else 1
+
+        def serve():
+            try:
+                connection, _ = listener.accept()
+                observed['connections'] += 1
+                connection.settimeout(6)
+                with context.wrap_socket(connection, server_side=True) as secure:
+                    observed['protocol'] = secure.version()
+                    pending = b''
+                    for _ in range(count):
+                        while b'\r\n\r\n' not in pending:
+                            data = secure.recv(4096)
+                            if not data:
+                                return
+                            pending += data
+                        _, pending = pending.split(b'\r\n\r\n', 1)
+                        observed['requests'] += 1
+                        body = b'native tls fixture\n'
+                        response = b'HTTP/1.1 200 OK\r\nContent-Length: '+str(len(body)).encode()+b'\r\nConnection: keep-alive\r\n\r\n'+body
+                        for offset in range(0, len(response), 7):
+                            secure.sendall(response[offset:offset+7])
+                    # Existing external handlers send close_notify on closing.
+                    secure.unwrap().close()
+                    observed['client_close_notify'] = True
+            except Exception as error:
+                observed['error'] = type(error).__name__ + ': ' + str(error)
+                if isinstance(error, ssl.SSLError):
+                    observed['ssl_reason'] = error.reason
+            finally:
+                listener.close()
+
+        thread = threading.Thread(target=serve, daemon=True)
+        thread.start()
+        url = f'https://localhost:{listener.getsockname()[1]}/'
+        p = subprocess.run([str(args.program), url, mode, verify, args.backend, str(root / 'root.pem')],
+                           capture_output=True, text=True, timeout=20)
+        thread.join(9)
+        passed = p.returncode == 0 and 'PASS real smart HTTPS' in p.stdout and not thread.is_alive()
+        if mode == 'reject':
+            passed &= observed.get('ssl_reason') in {
+                'SSLV3_ALERT_BAD_CERTIFICATE', 'SSLV3_ALERT_CERTIFICATE_EXPIRED',
+                'TLSV1_ALERT_UNKNOWN_CA', 'SSLV3_ALERT_CERTIFICATE_UNKNOWN'}
+            passed &= observed['requests'] == 0
+        elif mode == 'veto':
+            passed &= observed['requests'] == 0 and observed.get('protocol') == version.name.replace('TLSv1_', 'TLSv1.')
+        else:
+            passed &= observed['requests'] == count and observed['connections'] == 1
+            passed &= observed.get('client_close_notify', False) and 'error' not in observed
+        row = dict(case=name, real_tls=True, certificate=certificate, verify=verify,
+                   returncode=p.returncode, passed=bool(passed), server=observed,
+                   stdout=p.stdout, stderr=p.stderr)
+        rows.append(row)
+        (root / 'results.json').write_text(json.dumps(rows, indent=2)+'\n', encoding='utf-8')
+        print(('PASS' if passed else 'FAIL'), name, flush=True)
+        if not passed:
+            print(p.stdout, p.stderr, observed, flush=True)
+
+    case('trusted-chain-hostname-true')
+    case('trusted-chain-tls13', tls='tls13')
+    case('trusted-wrong-hostname-rejected', certificate='wrong-dns', mode='reject')
+    case('trusted-expired-rejected', certificate='expired', mode='reject')
+    case('untrusted-root-rejected', certificate='untrusted', mode='reject')
+    for verify in ['default', 'false']:
+        for certificate in ['valid', 'wrong-dns', 'expired', 'untrusted']:
+            case(certificate+'-verify-'+verify, certificate=certificate, verify=verify)
+    case('handler-after-create-false', certificate='untrusted', mode='afterfalse')
+    case('callback-veto-trusted', mode='veto')
+    case('one-connection-two-requests', mode='reuse')
+    passed = sum(row['passed'] for row in rows)
+    (root / 'environment.json').write_text(json.dumps({
+        'fixture_python_ssl': ssl.OPENSSL_VERSION, 'fixture_cli': command('version'),
+        'backend': args.backend, 'program': str(args.program), 'passed': passed,
+        'total': len(rows)}, indent=2)+'\n', encoding='utf-8')
+    print(f'{passed}/{len(rows)} real external HTTPS cases passed')
+    return passed != len(rows)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/packages/fcl-tls/tests/testsmarthttp.pp b/packages/fcl-tls/tests/testsmarthttp.pp
new file mode 100644
index 00000000..a2fc380c
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmarthttp.pp
@@ -0,0 +1,91 @@
+program testsmarthttp;
+{$mode objfpc}{$H+}
+{$IFDEF FPC_DOTTEDUNITS}
+uses {$ifdef unix}UnixApi.CThreads,{$endif} System.SysUtils, System.Classes,
+  FpWeb.Http.Client, System.Net.SSLSockets, System.Net.Ssockets,
+  System.Net.SmartSSLSockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+uses {$ifdef unix}cthreads,{$endif} SysUtils, Classes, fphttpclient, sslsockets,
+  ssockets, smartsslsockets, tlsbackendpolicy;
+{$ENDIF}
+type
+  TClient = class(TFPHTTPClient)
+  public
+    constructor Create;
+  end;
+  TObserver = class
+    CreatedCount, VerifyCount: Integer;
+    VerifyOption: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+var SelectedHandlerName: String; Backend: TSmartTLSBackend;
+constructor TClient.Create;
+begin
+  inherited Create(nil);
+  KeepConnectionReconnectLimit:=0;
+end;
+procedure Check(Value: Boolean; const What: String);
+begin if not Value then raise Exception.Create('FAIL '+What) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Check(Handler.ClassName=SelectedHandlerName,'selected handler class');
+  Check(TSSLSocketHandler(Handler).VerifyPeerCert=VerifyOption,'HTTP verification option');
+  if ParamStr(5)<>'none' then
+    begin
+    if Backend=stbOpenSSL then TSSLSocketHandler(Handler).CertificateData.CertCA.FileName:=ParamStr(5)
+    else if Backend=stbGnuTLS then TSSLSocketHandler(Handler).CertificateData.TrustedCertificate.FileName:=ParamStr(5)
+    else raise Exception.Create('Custom fixture CA applies only to external backends');
+    end;
+  if ParamStr(2)='afterfalse' then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(VerifyCount);
+  Check(Handler.ClassName=SelectedHandlerName,'callback handler');
+  Check(Allow,'legacy callback input');
+  Allow:=ParamStr(2)<>'veto';
+end;
+var Client: TClient; Observer: TObserver; H: TSSLSocketHandler;
+    Success: Boolean; Body,Failure: String; Count,I: Integer;
+begin
+  try
+    Check(ParamCount=5,'URL pass|reject|veto|reuse|afterfalse default|true|false backend CA|none');
+    Backend:=InitializeSmartTLS;
+    Check(SmartTLSBackendName(Backend)=ParamStr(4),'backend expectation');
+    Writeln('SELECTED version=',SmartTLSSelection.LibraryVersion,
+      ' primary=',SmartTLSSelection.PrimaryLibrary,' crypto=',SmartTLSSelection.CryptoLibrary);
+    H:=CreateSmartTLSHandler;
+    try SelectedHandlerName:=H.ClassName finally H.Free end;
+    Client:=TClient.Create; Observer:=TObserver.Create;
+    try
+      Check(not Client.VerifySSLCertificate,'legacy HTTP default False');
+      if ParamStr(3)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(3));
+      Observer.VerifyOption:=Client.VerifySSLCertificate;
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=5000; Client.IOTimeout:=5000;
+      Count:=1;
+      if ParamStr(2)='reuse' then begin Count:=2; Client.KeepConnection:=True end;
+      Success:=False; Failure:='';
+      try
+        for I:=1 to Count do
+          begin
+          Body:=Client.Get(ParamStr(1));
+          Check(Body='native tls fixture'+#10,'exact fixture body');
+          end;
+        Success:=True;
+      except on E: Exception do Failure:=E.ClassName+': '+E.Message end;
+      if (ParamStr(2)='reject') or (ParamStr(2)='veto') then Check(not Success,'request must fail')
+      else Check(Success,'request must succeed: '+Failure);
+      if ParamStr(2)='reuse' then Check(Observer.CreatedCount=1,'same TLS connection');
+      if ParamStr(2)='veto' then Check(Observer.VerifyCount=1,'application callback veto');
+      Check(SmartTLSSelection.Backend=Backend,'no backend fallback after request');
+      Check(TSSLSocketHandler.GetDefaultHandlerClass.ClassName=SelectedHandlerName,'default backend remains fixed');
+      Writeln('RESULT backend=',SmartTLSBackendName(Backend),' success=',Success,
+        ' created=',Observer.CreatedCount,' callbacks=',Observer.VerifyCount,' error=',Failure);
+    finally Client.Free; Observer.Free end;
+    Writeln('PASS real smart HTTPS');
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-tls/tests/testsmartmatrix.py b/packages/fcl-tls/tests/testsmartmatrix.py
new file mode 100644
index 00000000..2ee9f392
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartmatrix.py
@@ -0,0 +1,229 @@
+#!/usr/bin/env python3
+"""Fault-injection libraries test selection only; they never perform TLS.
+
+Run in fresh processes. Production clients use existing backend libraries;
+these stub fixtures deliberately expose enough entry points to isolate faults.
+"""
+import argparse
+import json
+import os
+import pathlib
+import platform
+import re
+import shutil
+import struct
+import subprocess
+import sys
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--source', required=True)
+    ap.add_argument('--output', required=True)
+    ap.add_argument('--program', required=True)
+    ap.add_argument('--compiler', required=True)
+    ap.add_argument('--rtl', required=True)
+    ap.add_argument('--sdk')
+    args = ap.parse_args()
+    source, out = pathlib.Path(args.source).resolve(), pathlib.Path(args.output).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    probe = (source / 'packages/fcl-tls/src/tlslibraryprobe.pp').read_text(encoding='utf-8')
+    groups = re.findall(r'RequireProcs\([^;]+?\[([^]]+)\]\);', probe, re.S)
+    assert len(groups) == 3
+    crypto_names, ssl_names, gnu_names = [re.findall(r"'([^']+)'", group) for group in groups]
+    ssl_names += ['SSL_get1_peer_certificate']
+    # All legacy binding symbols avoid optional-load warnings in the Gnu fixture.
+    gnu_names = sorted(set(gnu_names + re.findall(r"GPA\('([^']+)'\)",
+        (source / 'packages/gnutls/src/gnutls.pp').read_text(encoding='utf-8'))))
+    win, mac = sys.platform == 'win32', sys.platform == 'darwin'
+    cpu = 'aarch64' if platform.machine().lower() in ['arm64', 'aarch64'] else 'x86_64'
+    if win:
+        ssl_name, crypto_name, gnu_name = 'libssl-3-x64.dll', 'libcrypto-3-x64.dll', 'libgnutls-30.dll'
+    elif mac:
+        ssl_name, crypto_name, gnu_name = 'libssl.3.dylib', 'libcrypto.3.dylib', 'libgnutls.30.dylib'
+    else:
+        ssl_name, crypto_name, gnu_name = 'libssl.so.3', 'libcrypto.so.3', 'libgnutls.so.30'
+    built = out / 'mock-libraries'
+    built.mkdir(exist_ok=True)
+
+    def build(kind, names, filename, variant='normal', omit=None):
+        folder = built / variant
+        folder.mkdir(exist_ok=True)
+        names = [n for n in names if n != omit]
+        if win:
+            lines = ['library fixture;', '{$mode objfpc}{$H+}', 'uses ctypes;']
+            if kind == 'ssl':
+                lines += [f"function CryptoVersion: culong; cdecl; external '{crypto_name}' name 'OpenSSL_version_num';"]
+            exports = []
+            for i, name in enumerate(names):
+                fn = 'F' + str(i)
+                if name == 'OpenSSL_version_num':
+                    value = '$10101000' if variant == 'mixed' else '$30000000'
+                    lines += [f'function {fn}: culong; cdecl; begin Result:={value} end;']
+                elif name == 'gnutls_check_version':
+                    result = 'nil' if variant == 'oldgnu' else "'3.8.0'"
+                    lines += [f'function {fn}(Minimum: PAnsiChar): PAnsiChar; cdecl; begin Result:={result} end;']
+                elif name == 'TLS_method':
+                    lines += [f'function {fn}: Pointer; cdecl; begin Result:=Pointer(PtrUInt(CryptoVersion())) end;']
+                else:
+                    lines += [f'function {fn}: PtrInt; cdecl; begin Result:=0 end;']
+                exports.append(f"{fn} name '{name}'")
+            lines += ['exports ' + ',\n'.join(exports) + ';', 'begin end.']
+            code = folder / (kind + '.pp')
+            code.write_text('\n'.join(lines) + '\n', encoding='utf-8')
+            cmd = [args.compiler, '-n', '-Fu' + args.rtl, '-FU' + str(folder),
+                   '-FE' + str(folder), '-o' + filename, str(code)]
+        else:
+            lines = ['#include <stddef.h>', '#include <stdint.h>']
+            if kind == 'ssl':
+                lines += ['extern unsigned long OpenSSL_version_num(void);']
+            for name in names:
+                if name == 'OpenSSL_version_num':
+                    value = '0x10101000UL' if variant == 'mixed' else '0x30000000UL'
+                    lines += [f'unsigned long {name}(void) {{ return {value}; }}']
+                elif name == 'gnutls_check_version':
+                    value = 'NULL' if variant == 'oldgnu' else '"3.8.0"'
+                    lines += [f'const char *{name}(const char *minimum) {{ return {value}; }}']
+                elif name == 'TLS_method':
+                    lines += [f'void *{name}(void) {{ return (void *)(uintptr_t)OpenSSL_version_num(); }}']
+                else:
+                    lines += [f'long {name}(void) {{ return 0; }}']
+            code = folder / (kind + '.c')
+            code.write_text('\n'.join(lines) + '\n', encoding='utf-8')
+            cmd = ['cc', '-dynamiclib' if mac else '-shared', '-fPIC', str(code), '-o', str(folder / filename)]
+            if mac:
+                cmd += ['-Wl,-install_name,@rpath/' + filename, '-Wl,-rpath,@loader_path']
+            if kind == 'ssl':
+                cmd += [str(built / 'normal' / crypto_name)]
+        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=60)
+        (folder / (kind + '-build.log')).write_text(p.stdout, encoding='utf-8')
+        if p.returncode:
+            raise RuntimeError('Mock fixture build failed: ' + p.stdout)
+        return folder / filename
+
+    crypto = build('crypto', crypto_names, crypto_name)
+    ssl = build('ssl', ssl_names, ssl_name)
+    gnu = build('gnu', gnu_names, gnu_name)
+    missing_ssl = build('ssl', ssl_names, ssl_name, 'missing', 'SSL_set1_host')
+    mixed_crypto = build('crypto', crypto_names, crypto_name, 'mixed')
+    old_gnu = build('gnu', gnu_names, gnu_name, 'oldgnu')
+    cases = []
+    native = 'schannel' if win else 'networkframework' if mac else 'error'
+
+    def case(name, files=(), expected=native, preference='auto', mode='', diagnostic='', preload=(), cwd=None, app_relative=None):
+        folder = out / name
+        folder.mkdir(exist_ok=True)
+        app = folder / (app_relative or ('application.exe' if win else 'application'))
+        app.parent.mkdir(parents=True, exist_ok=True)
+        app.write_bytes(b'fixture application location only\n')
+        for src, target in files:
+            destination = folder / target
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(src, destination)
+        cmd = [str(pathlib.Path(args.program).resolve()), str(app), expected, preference, mode, diagnostic, *map(str, preload)]
+        p = subprocess.run(cmd, cwd=cwd or folder, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
+        row = {'case': name, 'fixture_only': True, 'expected': expected, 'preference': preference,
+               'returncode': p.returncode, 'stdout': p.stdout, 'stderr': p.stderr}
+        cases.append(row)
+        print(('PASS' if p.returncode == 0 else 'FAIL'), name)
+        return folder
+
+    both = [(ssl, ssl_name), (crypto, crypto_name)]
+    with_gnu = both + [(gnu, gnu_name)]
+    case('no-bundled-libraries')
+    case('openssl-before-gnu', with_gnu, 'openssl')
+    case('gnu-before-native', [(gnu, gnu_name)], 'gnutls')
+    case('openssl-lib-directory', [(ssl, 'lib/' + ssl_name), (crypto, 'lib/' + crypto_name)], 'openssl')
+    case('explicit-native-ignores-bundled', with_gnu, native, native)
+    case('explicit-gnu-override', with_gnu, 'gnutls', 'gnutls')
+    case('explicit-openssl-override', with_gnu, 'openssl', 'openssl')
+    case('explicit-openssl-absent', [], 'error', 'openssl', diagnostic='absent')
+    case('explicit-gnu-absent', [], 'error', 'gnutls', diagnostic='absent')
+    case('partial-ssl', [(ssl, ssl_name), (gnu, gnu_name)], 'error', diagnostic='Incomplete')
+    case('partial-crypto', [(crypto, crypto_name), (gnu, gnu_name)], 'error', diagnostic='Incomplete')
+    case('split-pair-directories', [(ssl, ssl_name), (crypto, 'lib/' + crypto_name)], 'error', diagnostic='Incomplete')
+    damaged = built / 'damaged'
+    damaged.write_bytes(b'not a native library')
+    case('damaged-pair', [(damaged, ssl_name), (crypto, crypto_name), (gnu, gnu_name)], 'error', diagnostic='Truncated')
+    case('missing-hostname-symbol', [(missing_ssl, ssl_name), (crypto, crypto_name), (gnu, gnu_name)], 'error', diagnostic='SSL_set1_host')
+    case('mixed-version-pair', [(ssl, ssl_name), (mixed_crypto, crypto_name)], 'error', diagnostic='mismatched')
+    case('old-gnu-version', [(old_gnu, gnu_name)], 'error', diagnostic='3.6.0')
+    case('gnu-false-true-local-adapter', [(gnu, gnu_name)], 'gnutls', mode='gnuverification')
+    case('concurrent-native', mode='threads')
+    case('concurrent-openssl', both, 'openssl', mode='threads')
+    case('concurrent-gnu', [(gnu, gnu_name)], 'gnutls', mode='threads')
+    case('preinitialized-openssl', both, 'error', mode='preopenssl', diagnostic='earlier', preload=[ssl, crypto])
+    case('preinitialized-gnu', [(gnu, gnu_name)], 'error', mode='pregnu', diagnostic='earlier', preload=[gnu])
+    case('destroyed-openssl-no-reload', both, 'openssl', mode='destroyed')
+    case('freed-gnu-no-reload', [(gnu, gnu_name)], 'gnutls', mode='destroyed')
+    wrong = built / ('wrong-' + ssl_name)
+    data = bytearray(ssl.read_bytes())
+    if win:
+        offset = struct.unpack_from('<I', data, 60)[0]
+        struct.pack_into('<H', data, offset + 4, 0x14c)
+    elif mac:
+        struct.pack_into('<I', data, 4, 0x0100000c if cpu == 'x86_64' else 0x01000007)
+    else:
+        struct.pack_into('<H', data, 18, 3)
+    wrong.write_bytes(data)
+    case('wrong-architecture', [(wrong, ssl_name), (crypto, crypto_name)], 'error', diagnostic='architecture')
+    foreign = case('foreign-current-directory', both, 'openssl')
+    case('current-directory-not-bundled', cwd=foreign)
+    invalid_type = out / 'library-directory'
+    (invalid_type / ssl_name).mkdir(parents=True, exist_ok=True)
+    case('library-directory', [(crypto, crypto_name)], 'error', diagnostic='regular file')
+    if win:
+        junction = out / 'outside-junction'
+        junction.mkdir(exist_ok=True)
+        p = subprocess.run(['cmd.exe', '/c', 'mklink', '/J', str(junction/'lib'), str(built/'normal')],
+                           capture_output=True, text=True, timeout=10)
+        if p.returncode:
+            raise RuntimeError('Junction fixture failed: '+p.stdout+p.stderr)
+        case('outside-junction', expected='error', diagnostic='outside')
+        wrong_import = built / ('wrong-import-'+ssl_name)
+        original = ssl.read_bytes()
+        assert original.count(crypto_name.encode()) == 1
+        wrong_import.write_bytes(original.replace(crypto_name.encode(), crypto_name.replace('-3-', '-9-').encode()))
+        case('mixed-import-pair', [(wrong_import, ssl_name), (crypto, crypto_name)], 'error', diagnostic='import pair mismatch')
+    if mac:
+        app_relative = 'Fixture.app/Contents/MacOS/application'
+        case('mac-app-frameworks', [(ssl, 'Fixture.app/Contents/Frameworks/'+ssl_name),
+             (crypto, 'Fixture.app/Contents/Frameworks/'+crypto_name)], 'openssl', app_relative=app_relative)
+        case('mac-app-lib-gnu', [(gnu, 'Fixture.app/Contents/lib/'+gnu_name)],
+             'gnutls', app_relative=app_relative)
+        thin = ssl.read_bytes()
+        cputype, subtype = struct.unpack_from('<II', thin, 4)
+        def fat_image(name, fat64=False, architecture=None, invalid_bounds=False):
+            magic = 0xcafebabf if fat64 else 0xcafebabe
+            # Keep slices aligned for both Intel 4 KiB and Apple Silicon 16 KiB pages.
+            offset = 16384
+            size = len(thin) + (16384 if invalid_bounds else 0)
+            entry = struct.pack('>IIQQII', architecture or cputype, subtype, offset, size, 14, 0) if fat64 else \
+                    struct.pack('>IIIII', architecture or cputype, subtype, offset, size, 14)
+            header = struct.pack('>II', magic, 1) + entry
+            path = built / name
+            path.write_bytes(header + b'\0' * (offset-len(header)) + thin)
+            return path
+        for fat64 in [False, True]:
+            label = 'fat64' if fat64 else 'fat32'
+            fat = fat_image(label, fat64=fat64)
+            case('mach-'+label, [(fat, ssl_name), (crypto, crypto_name)], 'openssl')
+        no_cpu = fat_image('fat-no-cpu', architecture=0x0100000c if cpu=='x86_64' else 0x01000007)
+        case('mach-fat-missing-architecture', [(no_cpu, ssl_name), (crypto, crypto_name)],
+             'error', diagnostic='matching Mach-O slice')
+        bounds = fat_image('fat-invalid-bounds', invalid_bounds=True)
+        case('mach-fat-invalid-bounds', [(bounds, ssl_name), (crypto, crypto_name)], 'error', diagnostic='bounds')
+    if not win:
+        folder = out / 'outside-symlink'
+        folder.mkdir(exist_ok=True)
+        (folder / ssl_name).symlink_to(ssl)
+        (folder / crypto_name).symlink_to(crypto)
+        case('outside-symlink', expected='error', diagnostic='outside')
+    (out / 'results.json').write_text(json.dumps(cases, indent=2) + '\n', encoding='utf-8')
+    failures = [row['case'] for row in cases if row['returncode']]
+    print('RESULT', len(cases), 'selector cases;', len(failures), 'failed:', ','.join(failures))
+    return bool(failures)
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/packages/fcl-tls/tests/testsmartnative.pp b/packages/fcl-tls/tests/testsmartnative.pp
new file mode 100644
index 00000000..79435c8c
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartnative.pp
@@ -0,0 +1,237 @@
+program testsmartnative;
+{$mode objfpc}{$H+}
+uses
+{$IFDEF TEST_DOTTEDUNITS}
+  System.SysUtils, System.Classes, WinApi.Windows, System.Net.Ssockets,
+  System.Net.Sslsockets, System.Net.Sslbase, System.Net.SchannelSSLSockets,
+  WinApi.SchannelSSPI, FpWeb.Http.Client, System.Net.SmartSSLSockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+  SysUtils, Classes, Windows, ssockets, sslsockets, sslbase, schannelsslsockets,
+  schannelsspi, fphttpclient, smartsslsockets, tlsbackendpolicy;
+{$ENDIF}
+
+type
+  TObserver = class
+    Calls: Integer;
+    procedure RawVerify(Sender: TObject; var Allow: Boolean);
+    procedure HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+
+procedure Check(Condition: Boolean; const MessageText: String);
+begin
+  if not Condition then raise Exception.Create(MessageText);
+end;
+
+function TickCount: QWord;
+begin
+  Result:={$IFDEF TEST_DOTTEDUNITS}System.{$ENDIF}SysUtils.GetTickCount64;
+end;
+
+procedure TObserver.RawVerify(Sender: TObject; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Check(Allow,'Unexpected callback input');
+  Allow:=ParamStr(7)<>'veto';
+end;
+
+procedure TObserver.HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  RawVerify(Handler,Allow);
+end;
+
+procedure CheckModules;
+var Snapshot: THandle; Entry: MODULEENTRY32; Name: String;
+begin
+  Snapshot:=CreateToolhelp32Snapshot(TH32CS_SNAPMODULE,GetCurrentProcessId);
+  Check(Snapshot<>INVALID_HANDLE_VALUE,'Cannot enumerate client modules');
+  try
+    FillChar(Entry,SizeOf(Entry),0);
+    Entry.dwSize:=SizeOf(Entry);
+    Check(Module32First(Snapshot,Entry),'Cannot read client module list');
+    repeat
+      Name:=LowerCase(StrPas(Entry.szModule));
+      Check((Pos('libssl',Name)=0) and (Pos('libcrypto',Name)=0) and
+        (Pos('gnutls',Name)=0) and (Name<>'ssleay32.dll') and
+        (Name<>'libeay32.dll'),'Third-party TLS module loaded: '+Name);
+    until not Module32Next(Snapshot,Entry);
+  finally CloseHandle(Snapshot) end;
+end;
+
+procedure Construct;
+var Handler: TSchannelSocketHandler; Rejected: Boolean;
+begin
+  Writeln('LAYOUT handle=',SizeOf(TSecHandle),' buffer=',SizeOf(TSecBuffer),
+    ' desc=',SizeOf(TSecBufferDesc),' cred=',SizeOf(TSchannelCred),
+    ' modern=',SizeOf(TSchCredentials));
+  Check(SizeOf(TSecHandle)=2*SizeOf(Pointer),'SSPI handle layout differs');
+  Check(SizeOf(TSecStreamSizes)=20,'SSPI stream-size layout differs');
+{$IFDEF CPU64}
+  Check((SizeOf(TSecBuffer)=16) and (SizeOf(TSecBufferDesc)=16) and
+    (SizeOf(TSchannelCred)=80) and (SizeOf(TSchCredentials)=72),'Win64 SSPI layout differs');
+{$ELSE}
+  Check((SizeOf(TSecBuffer)=12) and (SizeOf(TSecBufferDesc)=12) and
+    (SizeOf(TSchannelCred)=56) and (SizeOf(TSchCredentials)=44),'Win32 SSPI layout differs');
+{$ENDIF}
+  Handler:=TSchannelSocketHandler.Create;
+  try
+    Check(Handler.CertGenerator<>nil,'Certificate-generator contract broken');
+    Handler.RemoteHostName:='example.com';
+    Check(Handler.CertGenerator.HostName='example.com','Legacy hostname setter broken');
+    Rejected:=False;
+    try Handler.CreateSelfSignedCertificate
+    except on E: ESSLSocketError do Rejected:=True end;
+    Check(Rejected,'Certificate generation accepted');
+    Check(not Handler.VerifyPeerCert,'Handler verification default changed');
+    Check(not Handler.Accept,'Client-only handler accepted a connection');
+    Check((not Handler.SSLActive) and (Handler.LastSSLErrorCode<>0),'Accept did not fail closed');
+    Check(TSSLSocketHandler.GetDefaultHandlerClass=TSchannelSocketHandler,'Registration failed');
+  finally Handler.Free end;
+end;
+
+procedure CheckPattern(const Buffer; Count, Offset: Integer);
+var I: Integer;
+begin
+  for I:=0 to Count-1 do
+    Check((PByte(@Buffer)+I)^=Byte((Offset+I) mod 251),'Body differs at '+IntToStr(Offset+I));
+end;
+
+procedure CheckFailure(const ErrorText: String);
+begin
+  Check(ParamStr(4)='reject','Unexpected error: '+ErrorText);
+  Check((ParamStr(6)<>'') and (Pos(UpperCase(ParamStr(6)),UpperCase(ErrorText))>0),
+    'Expected specific TLS error '+ParamStr(6)+', got '+ErrorText);
+end;
+
+procedure HTTPTest;
+var Client: TFPHTTPClient; Observer: TObserver; Body: String; Failed: Boolean;
+begin
+  Client:=TFPHTTPClient.Create(nil);
+  Observer:=TObserver.Create;
+  try
+    Check(not Client.VerifySSLCertificate,'HTTP verification default changed');
+    if ParamStr(3)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(3));
+    if ParamStr(7)<>'none' then Client.OnVerifySSLCertificate:=@Observer.HTTPVerify;
+    Client.ConnectTimeout:=5000;
+    Client.IOTimeout:=3000;
+    Client.AllowRedirect:=False;
+    Failed:=False;
+    try Body:=Client.Get(ParamStr(2))
+    except on E: Exception do
+      begin Failed:=True; Writeln('ERROR ',E.Message); CheckFailure(E.Message) end end;
+    Check(Failed=(ParamStr(4)='reject'),'Invalid certificate or TLS failure accepted');
+    if not Failed then
+      begin
+      Check(Client.ResponseStatusCode=200,'Expected HTTP 200');
+      if ParamStr(5)='fixture' then Check(Body='local tls fixture'+#10,'HTTP body differs')
+      else if ParamStr(5)='pattern' then
+        begin
+        Check(Length(Body)=1048576,'Large HTTP body length differs');
+        CheckPattern(Body[1],Length(Body),0);
+        end
+      else Check(Length(Body)>0,'Empty public HTTPS response');
+      Writeln('BODY ',Length(Body));
+      end;
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected HTTP callback count');
+  finally Observer.Free; Client.Free end;
+end;
+
+procedure RawTest;
+var Handler: TSchannelSocketHandler; Stream: TInetSocket; Observer: TObserver;
+    Buffer: array[0..4095] of Byte; Upload: TBytes;
+    N, Total, Expected, I: Integer; Started: QWord; Failed: Boolean; Mode: String;
+begin
+  Handler:=TSchannelSocketHandler.Create;
+  Observer:=TObserver.Create;
+  if ParamStr(3)<>'default' then Handler.VerifyPeerCert:=StrToBool(ParamStr(3));
+  Handler.ServerName:=ParamStr(9);
+  if Handler.ServerName='nul' then Handler.ServerName:='localhost'+#0+'invalid';
+  if ParamStr(10)='tls12' then Handler.SSLType:=stTLSv1_2;
+  if ParamStr(7)<>'none' then Handler.OnVerifyCertificate:=@Observer.RawVerify;
+  if ParamStr(12)='' then Stream:=TInetSocket.Create('127.0.0.1',StrToInt(ParamStr(2)),Handler)
+  else Stream:=TInetSocket.Create(ParamStr(12),StrToInt(ParamStr(2)),Handler);
+  try
+    Stream.ConnectTimeout:=3000;
+    Stream.IOTimeout:=3000;
+    Mode:=ParamStr(5);
+    if Mode='handshake-timeout' then Stream.ConnectTimeout:=150;
+    if Mode='unsupported' then Handler.CertificateData.CertCA.FileName:='unsupported-test-ca.pem';
+    Failed:=False;
+    Started:=TickCount;
+    try
+      Stream.Connect;
+      Check(Handler.SSLActive,'Handshake did not activate TLS');
+      if Mode='connect-only' then
+        begin
+        Check(ParamStr(4)='ok','Expected certificate rejection missing');
+        Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+        Check(Handler.Shutdown(False),'Connected TLS close failed');
+        Check(not Handler.SSLActive,'Close left TLS active');
+        Check(Handler.Shutdown(False),'Repeated close failed');
+        Exit;
+        end;
+      if Mode='read-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(Stream.Read(Buffer,SizeOf(Buffer))=-1,'Read timeout did not fail');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if Mode='shutdown-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(not Handler.Shutdown(True),'Unanswered bidirectional close succeeded');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if (Mode='send') or (Mode='send-timeout') then
+        begin
+        N:=1048576;
+        if Mode='send-timeout' then
+          begin N:=16777216; Stream.IOTimeout:=150; Started:=TickCount end;
+        SetLength(Upload,N);
+        for I:=0 to N-1 do Upload[I]:=Byte(I mod 251);
+        I:=Stream.Write(Upload[0],N);
+        if I<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        Check(I=N,'Partial send reported as success');
+        end;
+      Expected:=StrToInt(ParamStr(11));
+      Total:=0;
+      repeat
+        Check(Stream.CanRead(3000),'Receive readiness timed out');
+        N:=SizeOf(Buffer);
+        if Total<16 then N:=1;
+        N:=Stream.Read(Buffer,N);
+        if N<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        CheckPattern(Buffer,N,Total);
+        Inc(Total,N);
+        Check(Total<=Expected,'Extra TLS control bytes delivered as plaintext');
+      until N=0;
+      Check(Total=Expected,'Raw body length differs');
+      Check(Stream.Read(Buffer,1)=0,'EOF was not stable');
+      Check(Handler.Shutdown(True),'TLS close failed: '+Handler.LastSSLErrorString);
+      Check(not Handler.SSLActive,'Shutdown left TLS active');
+      Check(Handler.Shutdown(False),'Repeated shutdown failed');
+      Writeln('BODY ',Total);
+    except on E: Exception do
+      begin
+      Failed:=True;
+      Writeln('ERROR ',E.Message);
+      CheckFailure(E.Message);
+      Check(not Handler.SSLActive,'Failed TLS remained active');
+      end end;
+    if (Pos('timeout',Mode)>0) then Check(TickCount-Started<2000,'Deadline exceeded');
+    Check(Failed=(ParamStr(4)='reject'),'Expected TLS rejection missing');
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+  finally Stream.Free; Observer.Free end;
+end;
+
+begin
+  Check(InitializeSmartTLS=stbSchannel,'smart selected Schannel');
+  Writeln('SMART backend=',SmartTLSBackendName(SmartTLSSelection.Backend));
+  if ParamStr(1)='construct' then Construct
+  else if ParamStr(1)='http' then HTTPTest
+  else if ParamStr(1)='raw' then RawTest
+  else raise Exception.Create('Usage: construct | http/raw target verify expected mode code callback calls [name protocol bytes]');
+  CheckModules;
+  Writeln('PASS ',ParamStr(1),' no third-party TLS modules');
+end.
diff --git a/packages/fcl-tls/tests/testsmartnetworkhttp.pp b/packages/fcl-tls/tests/testsmartnetworkhttp.pp
new file mode 100644
index 00000000..4308e8f1
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartnetworkhttp.pp
@@ -0,0 +1,113 @@
+{ Real macOS HTTP acceptance harness. Run with the sibling Python fixture.
+  Requires cthreads first, native provider and diagnostic counters. }
+program testsmartnetworkhttp;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+  SysUtils, Classes, fphttpclient, ssockets, sslsockets, networkframeworksslsockets,
+  networkframeworknative, smartsslsockets, tlsbackendpolicy;
+type
+  TNativeHTTPClient = class(TFPHTTPClient)
+  public
+    property KeepConnectionReconnectLimit;
+  end;
+  TObserver = class
+    CreatedCount, Calls: Integer;
+    CallbackAllow, DisableAfterCreate: Boolean;
+    ExpectedVerify: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+procedure Require(Value: Boolean; const MessageText: String);
+begin if not Value then raise Exception.Create('FAIL '+MessageText) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Require(Handler is TNetworkFrameworkSocketHandler,'native handler selected');
+  Require(TSSLSocketHandler(Handler).VerifyPeerCert=ExpectedVerify,'HTTP verification forwarded');
+  Require(TSSLSocketHandler(Handler).CertGenerator<>nil,'no external certificate generator');
+  if DisableAfterCreate then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Require(Handler is TNetworkFrameworkSocketHandler,'callback has native handler');
+  Require(Allow,'legacy callback starts with Allow=True');
+  Allow:=CallbackAllow;
+end;
+function CertificateFailure(Domain, Code: LongInt): Boolean;
+begin
+  { Apple Security/base/SecBase.h: network TLS domain uses these SSL codes.
+    A TCP reset, EOF, timeout or generic handshake error is never a pass. }
+  Result:=(Domain=3) and ((Code=-9807) or (Code=-9808) or (Code=-9812) or (Code=-9813) or
+    (Code=-9814) or (Code=-9815) or (Code=-9843));
+end;
+var Client: TNativeHTTPClient; Observer: TObserver; URL, Expected, BodyMode, Body,
+    Failure: String; Requests, Index, Domain, Code: LongInt; Succeeded: Boolean;
+    Started: QWord; Output: TStringStream; ExpectedStatus: Integer;
+begin
+  try
+    Require(ParamCount=8,'usage: URL default|true|false callback after_false expected callbacks body_mode requests');
+    URL:=ParamStr(1); Expected:=ParamStr(5); BodyMode:=ParamStr(7);
+    Requests:=StrToInt(ParamStr(8)); Require(Requests>0,'positive request count');
+    Require((Expected='pass') or (Expected='certificate') or (Expected='veto'),'known expectation');
+    Require(InitializeSmartTLS=stbNetworkFramework,'smart selected Network.framework');
+    Observer:=TObserver.Create; Client:=TNativeHTTPClient.Create(nil);
+    try
+      Require(not Client.VerifySSLCertificate,'existing default remains False');
+      if ParamStr(2)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(2));
+      Observer.ExpectedVerify:=Client.VerifySSLCertificate;
+      Observer.CallbackAllow:=StrToBool(ParamStr(3));
+      Observer.DisableAfterCreate:=StrToBool(ParamStr(4));
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=10000; Client.IOTimeout:=5000;
+      Client.KeepConnection:=Requests>1; Client.KeepConnectionReconnectLimit:=0;
+      Succeeded:=False; Domain:=0; Code:=0; Failure:='';
+      try
+        for Index:=1 to Requests do
+          begin
+          Output:=TStringStream.Create('');
+          try
+            if BodyMode='head' then Client.HTTPMethod('HEAD',URL,Output,[])
+            else Client.HTTPMethod('GET',URL,Output,[]);
+            Body:=Output.DataString;
+          finally Output.Free end;
+          ExpectedStatus:=200;
+          if BodyMode='204' then ExpectedStatus:=204 else if BodyMode='304' then ExpectedStatus:=304
+          else if BodyMode='101' then ExpectedStatus:=101;
+          Require(Client.ResponseStatusCode=ExpectedStatus,'exact HTTP status');
+          if BodyMode='local' then Require(Body='native tls fixture'+#10,'exact local HTTP contents')
+          else if BodyMode='public' then Require(Length(Body)>0,'public response body')
+          else Require(Body='','bodyless HTTP response');
+          end;
+        Succeeded:=True;
+      except
+        on E: ENetworkFrameworkTLS do
+          begin Domain:=E.Domain; Code:=E.NativeCode; Failure:=E.Message end;
+        on E: Exception do Failure:=E.ClassName+': '+E.Message;
+      end;
+      Writeln('RESULT success=',Succeeded,' created=',Observer.CreatedCount,
+        ' callbacks=',Observer.Calls,' domain=',Domain,' code=',Code,' error=',Failure);
+      if Expected='pass' then Require(Succeeded,'request must succeed')
+      else if Expected='certificate' then
+        Require(not Succeeded and CertificateFailure(Domain,Code),'specific certificate rejection required')
+      else if Expected='veto' then
+        Require(not Succeeded and (Pos('application certificate veto',LowerCase(Failure))>0),'callback veto required');
+      Require(Observer.Calls=StrToInt(ParamStr(6)),'exact callback count');
+      if (Expected='pass') and (Requests>1) then Require(Observer.CreatedCount=1,'same native TLS connection reused');
+      Require(SmartTLSSelection.Backend=stbNetworkFramework,'smart backend remains fixed');
+      Require(TSSLSocketHandler.GetDefaultHandlerClass=TNetworkFrameworkSocketHandler,
+        'backend remains fixed');
+    finally
+      Client.Free; Observer.Free;
+    end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Started:=GetTickCount64;
+    while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+    Require(NetworkFrameworkLiveContexts=0,'native callbacks release all contexts');
+    Writeln('PASS contexts drained; destroyed=',NetworkFrameworkDestroyedContexts);
+{$endif}
+    Writeln('PASS native fphttpclient ',Expected);
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
