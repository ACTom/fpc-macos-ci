+  with Installer do
+    begin
+{$endif ALLPACKAGES}
+    P:=AddPackage('fcl-tls');
+    P.ShortName:='fcltls';
+    P.Version:='3.3.1';
+    P.Description:='Explicit application-local TLS backend selection.';
+{$ifdef ALLPACKAGES}
+    P.Directory:=ADirectory;
+{$endif}
+    P.License:='LGPL with modification';
+    P.OSes:=[win32,win64,darwin,linux];
+    P.Dependencies.Add('fcl-net');
+    P.Dependencies.Add('openssl');
+    P.Dependencies.Add('gnutls');
+    P.SourcePath.Add('src');
+    T:=P.Targets.AddUnit('tlsbackendpolicy.pp');
+    T:=P.Targets.AddUnit('tlslibraryprobe.pp');
+    T.Dependencies.AddUnit('tlsbackendpolicy');
+    T:=P.Targets.AddUnit('smartsslsockets.pp');
+    T.Dependencies.AddUnit('tlsbackendpolicy');
+    T.Dependencies.AddUnit('tlslibraryprobe');
+    P.NamespaceMap:='namespaces.lst';
+{$ifndef ALLPACKAGES}
+    Run;
+    end;
