+{ Part of FCL; see COPYING.FPC. Real socket compatibility and extraction. }
+program testsocketpeer;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+{$ifdef FPC_DOTTEDUNITS}
+  System.SysUtils, System.Classes, System.Net.Ssockets, System.Net.ClientPeers,
+  FpWeb.Http.Client;
+{$else}
+  SysUtils, Classes, ssockets, clientpeers, fphttpclient;
+{$endif}
+
+type
+  TClient = class(TFPHTTPClient)
+    procedure Open(const Host: String; Port: Integer);
+    procedure Disconnect;
+    property Socket;
+  end;
+
+procedure Check(Value: Boolean; const What: String);
+begin
+  if not Value then raise Exception.Create('FAIL '+What);
+end;
+
+procedure TClient.Open(const Host: String; Port: Integer);
+begin
+  ConnectToServer(Host,Port,False);
+end;
+
+procedure TClient.Disconnect;
+begin
+  DisconnectFromServer;
+end;
+
+var
+  C: TClient;
+  S: TSocketStream;
+  P: TSocketPeer;
+  Host, Request: String;
+  Port: Integer;
+  B: Byte;
+begin
+  try
+    Check(ParamCount=2,'usage host port');
+    Host:=ParamStr(1); Port:=StrToInt(ParamStr(2));
+    C:=TClient.Create(Nil);
+    try
+      C.IOTimeout:=1000;
+      C.ConnectTimeout:=1000;
+      C.Open(Host,Port);
+      Check(C.Socket is TInetSocket,'classic path exposes real TInetSocket');
+      Check((C.Socket.IOTimeout=1000) and (C.Socket.ConnectTimeout=1000),
+        'original timeout settings forwarded');
+      S:=C.Socket;
+      S.IOTimeout:=777;
+      Check(C.ExtractSocket=S,'ExtractSocket returns original object');
+      Check(C.Socket=Nil,'extraction clears HTTP ownership');
+      P:=TSocketPeer.Create(S);
+      try
+        Check(P.IOTimeout=777,'peer delegates current socket timeout');
+        P.IOTimeout:=888;
+        Check(S.IOTimeout=888,'peer setter updates actual socket');
+        Request:='GET / HTTP/1.0'+#13#10+#13#10;
+        Check(P.Write(Request[1],Length(Request))=Length(Request),'write after extraction');
+        Check(P.CanRead(1000),'socket readiness after extraction');
+        Check((P.Read(B,1)=1) and (B=Ord('H')),'read after HTTP owner detached');
+      finally P.Free end;
+      C.Disconnect;
+    finally C.Free end;
+    Writeln('PASS real socket identity/timeout dispatch/readiness/extraction/ownership');
+  except on E: Exception do
+    begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
