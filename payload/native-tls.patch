+++ b/packages/fcl-tls/tests/testverifyoptions.pp
@@ -0,0 +1,63 @@
+program testverifyoptions;
+{$mode objfpc}{$H+}
+uses SysUtils, Classes, fphttpclient, ssockets, sslsockets, openssl, opensslsockets,
+  smartsslsockets, schannelsslsockets;
+type
+  TObserver = class
+    Calls: Integer;
+    procedure Verify(Sender: TObject; AHandler: TSSLSocketHandler; var Allow: Boolean);
+    procedure Created(Sender: TObject; AHandler: TSocketHandler);
+  end;
+procedure TObserver.Verify(Sender: TObject; AHandler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Writeln('CALLBACK input=',Allow,' peer_verify=',AHandler.VerifyPeerCert);
+  Allow:=StrToBool(ParamStr(3));
+end;
+procedure TObserver.Created(Sender: TObject; AHandler: TSocketHandler);
+begin
+  Writeln('AFTER_CREATE class=',AHandler.ClassName,' peer_verify=',TSSLSocketHandler(AHandler).VerifyPeerCert);
+  if ParamStr(4)='false' then TSSLSocketHandler(AHandler).VerifyPeerCert:=False;
+end;
+var C: TFPHTTPClient; O: TObserver; B, ErrorText: String; OK: Boolean; Iter, Arg: Integer;
+begin
+  if ParamStr(1)='legacy' then
+    begin
+    if not InitSSLInterface(GetEnvironmentVariable('TLS_SSL_LIBRARY'),GetEnvironmentVariable('TLS_CRYPTO_LIBRARY')) then
+      raise Exception.Create('OpenSSL initialization failed');
+    TSSLSocketHandler.SetDefaultHandlerClass(TOpenSSLSocketHandler);
+    end
+  else if ParamStr(1)='smart' then
+    begin
+    SetSmartTLSLibraryPaths(GetEnvironmentVariable('TLS_SSL_LIBRARY'),GetEnvironmentVariable('TLS_CRYPTO_LIBRARY'),'');
+    SetSmartTLSBackend(tbOpenSSL);
+    end
+  else if ParamStr(1)='native' then SetSmartTLSBackend(tbSchannel)
+  else raise Exception.Create('Bad mode');
+  C:=TFPHTTPClient.Create(nil); O:=TObserver.Create;
+  try
+    Writeln('CLIENT_DEFAULT=',C.VerifySSLCertificate);
+    if C.VerifySSLCertificate then raise Exception.Create('HTTP default changed');
+    if ParamStr(2)<>'default' then C.VerifySSLCertificate:=StrToBool(ParamStr(2));
+    C.OnVerifySSLCertificate:=@O.Verify;
+    C.AfterSocketHandlerCreate:=@O.Created;
+    if ParamStr(1)='legacy' then C.CertCAFileName:=GetEnvironmentVariable('SSL_CERT_FILE');
+    C.ConnectTimeout:=5000; C.IOTimeout:=5000;
+    for Iter:=0 to Ord(ParamCount>=12) do
+      begin
+      Arg:=Iter*4;
+      if Iter=1 then C.VerifySSLCertificate:=StrToBool(ParamStr(9));
+      O.Calls:=0;
+    OK:=False; ErrorText:='';
+    try
+      B:=C.Get(ParamStr(5));
+      OK:=(C.ResponseStatusCode=200) and (B='local tls fixture'+#10);
+    except on E: Exception do begin ErrorText:=E.Message; Writeln('ERROR ',ErrorText) end end;
+    Writeln('RESULT ok=',OK,' callbacks=',O.Calls);
+    if OK<>StrToBool(ParamStr(6+Arg)) then raise Exception.Create('Unexpected request result');
+    if O.Calls<>StrToInt(ParamStr(7+Arg)) then raise Exception.Create('Unexpected callback count');
+    if (ParamStr(8+Arg)<>'none') and (Pos(ParamStr(8+Arg),ErrorText)=0) then
+      raise Exception.Create('Expected a certificate rejection, not another failure');
+      end;
+  finally O.Free; C.Free end;
+end.
diff --git a/packages/fcl-tls/tests/tlsrelay.py b/packages/fcl-tls/tests/tlsrelay.py
new file mode 100644
index 0000000000..ee26bda4b2
--- /dev/null
+++ b/packages/fcl-tls/tests/tlsrelay.py
@@ -0,0 +1,95 @@
+"""Relay an authenticated public TLS connection through fragmented loopback TCP.
+
+Never decrypts traffic or changes certificate trust. testtransport authenticates
+the original hostname through ServerName. No third party Python modules needed.
+"""
+import argparse
+import socket
+import subprocess
+import threading
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("exe")
+    parser.add_argument("--host", default="speed.cloudflare.com")
+    parser.add_argument("--mode", choices=["large", "timeout", "stall", "upload"], default="large")
+    parser.add_argument("--bytes", type=int, default=1048576)
+    parser.add_argument("--tls12", action="store_true")
+    args = parser.parse_args()
+    listener = socket.socket()
+    listener.bind(("127.0.0.1", 0))
+    listener.listen(1)
+    listener.settimeout(15)
+    port = listener.getsockname()[1]
+    errors = []
+    counts = [0, 0, 0]
+
+    def server():
+        try:
+            client, _ = listener.accept()
+            with client:
+                if args.mode == "stall":
+                    client.recv(16384)
+                    time.sleep(0.5)
+                    return
+                remote = socket.create_connection((args.host, 443), timeout=10)
+                remote.settimeout(10)
+                client.settimeout(10)
+
+                def pump(src, dst, fragment, index):
+                    try:
+                        while True:
+                            data = src.recv(16384)
+                            if not data:
+                                break
+                            counts[index] += len(data)
+                            if fragment:
+                                offset = 0
+                                # Fragment initial TLS record headers as well as
+                                # subsequent ciphertext and coalesced records.
+                                while offset < len(data):
+                                    size = [1, 7, 31, 1024][counts[2] % 4]
+                                    counts[2] += 1
+                                    dst.sendall(data[offset:offset + size])
+                                    offset += size
+                            else:
+                                dst.sendall(data)
+                    except (BrokenPipeError, ConnectionResetError):
+                        pass  # Expected during a client's timeout or shutdown.
+                    except Exception as exc:
+                        errors.append(str(exc))
+                    finally:
+                        try:
+                            dst.shutdown(socket.SHUT_WR)
+                        except OSError:
+                            pass
+
+                with remote:
+                    worker = threading.Thread(target=pump, args=(client, remote, False, 0))
+                    worker.start()
+                    pump(remote, client, True, 1)
+                    worker.join(12)
+        except Exception as exc:
+            errors.append(str(exc))
+        finally:
+            listener.close()
+
+    worker = threading.Thread(target=server, daemon=True)
+    worker.start()
+    mode = str(args.bytes) if args.mode == "large" else args.mode
+    result = subprocess.run([args.exe, str(port), args.host, mode, "tls12" if args.tls12 else ""], timeout=30)
+    worker.join(15)
+    print(f"relay client_bytes={counts[0]} server_bytes={counts[1]} fragments={counts[2]}")
+    if errors:
+        print("relay errors:", "; ".join(errors))
+    if worker.is_alive():
+        raise SystemExit("relay did not finish")
+    if args.mode == "upload" and not result.returncode and counts[0] < 1048576:
+        raise AssertionError("Relay did not observe the full encrypted upload")
+    raise SystemExit(result.returncode or bool(errors))
+
+
+if __name__ == "__main__":
+    main()
