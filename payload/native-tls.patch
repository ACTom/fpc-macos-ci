+{$ifndef ALLPACKAGES}
+{$mode objfpc}{$H+}
+program fpmake;
+uses {$ifdef unix}cthreads,{$endif} fpmkunit;
+var P: TPackage; T: TTarget;
+begin
+  with Installer do
+    begin
+{$endif}
+    P:=AddPackage('fcl-tls');
+    P.ShortName:='fcltls';
+{$ifdef ALLPACKAGES}
+    P.Directory:=ADirectory;
+{$endif}
+    P.Version:='3.3.1';
+    P.Description:='Client TLS backend selection for FCL sockets.';
+    P.License:='LGPL with modification';
+    P.OSes:=AllUnixOSes+[win32,win64]-[qnx];
+    if Defaults.CPU=jvm then P.OSes:=P.OSes-[java,android];
+    P.Dependencies.Add('fcl-net');
+    P.Dependencies.Add('openssl');
+    P.Dependencies.Add('gnutls');
+    P.SourcePath.Add('src');
+    T:=P.Targets.AddUnit('tlsbackendpolicy.pp');
+    T:=P.Targets.AddUnit('smartsslsockets.pp');
+    T.Dependencies.AddUnit('tlsbackendpolicy');
+    P.NamespaceMap:='namespaces.lst';
+{$ifndef ALLPACKAGES}
+    Run;
+    end;
+end.
+{$endif}
