diff --git a/packages/fcl-net/src/clientpeers.pp b/packages/fcl-net/src/clientpeers.pp
new file mode 100644
index 00000000..c0bb7423
--- /dev/null
+++ b/packages/fcl-net/src/clientpeers.pp
@@ -0,0 +1,165 @@
+{
+    This file is part of the Free Component Library (FCL).
+    See COPYING.FPC for copyright and license details.
+
+    Byte streams for client connections which may own their TCP transport.
+}
+{$IFNDEF FPC_DOTTEDUNITS}
+unit clientpeers;
+{$ENDIF}
+
+{$mode objfpc}{$H+}
+
+interface
+
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Classes, System.Net.Ssockets;
+{$ELSE}
+uses Classes, ssockets;
+{$ENDIF}
+
+type
+  { Connect/Read/Write are serialized by the caller. Close may cancel an active
+    operation. Before freeing a peer, stop callers from starting further calls. }
+  TClientPeer = class(TStream)
+  private
+    FConnectTimeout, FIOTimeout: Integer;
+  protected
+    function GetConnectTimeout: Integer; virtual;
+    function GetIOTimeout: Integer; virtual;
+    procedure SetConnectTimeout(AValue: Integer); virtual;
+    procedure SetIOTimeout(AValue: Integer); virtual;
+  public
+    procedure Connect; virtual; abstract;
+    procedure Close; virtual; abstract;
+    function CanRead(Timeout: Integer): Boolean; virtual; abstract;
+    function BytesAvailable: Integer; virtual; abstract;
+    function Seek(const Offset: Int64; Origin: TSeekOrigin): Int64; override;
+    property ConnectTimeout: Integer read GetConnectTimeout write SetConnectTimeout;
+    property IOTimeout: Integer read GetIOTimeout write SetIOTimeout;
+  end;
+
+  { Owns an existing, successfully constructed socket. The socket, its handler,
+    timeout settings and descriptor retain their normal ssockets semantics. }
+  TSocketPeer = class(TClientPeer)
+  private
+    FSocket: TSocketStream;
+  protected
+    function GetConnectTimeout: Integer; override;
+    function GetIOTimeout: Integer; override;
+    procedure SetConnectTimeout(AValue: Integer); override;
+    procedure SetIOTimeout(AValue: Integer); override;
+  public
+    constructor Create(ASocket: TSocketStream);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+    function ExtractSocket: TSocketStream;
+    property Socket: TSocketStream read FSocket;
+  end;
+
+implementation
+
+function TClientPeer.GetConnectTimeout: Integer;
+begin
+  Result:=FConnectTimeout;
+end;
+
+function TClientPeer.GetIOTimeout: Integer;
+begin
+  Result:=FIOTimeout;
+end;
+
+procedure TClientPeer.SetConnectTimeout(AValue: Integer);
+begin
+  FConnectTimeout:=AValue;
+end;
+
+procedure TClientPeer.SetIOTimeout(AValue: Integer);
+begin
+  FIOTimeout:=AValue;
+end;
+
+function TClientPeer.Seek(const Offset: Int64; Origin: TSeekOrigin): Int64;
+begin
+  raise EStreamError.Create('Client peers do not support seeking');
+end;
+
+constructor TSocketPeer.Create(ASocket: TSocketStream);
+begin
+  inherited Create;
+  if ASocket=Nil then
+    raise EStreamError.Create('A socket peer requires a socket');
+  FSocket:=ASocket;
+end;
+
+destructor TSocketPeer.Destroy;
+begin
+  FSocket.Free;
+  inherited Destroy;
+end;
+
+procedure TSocketPeer.Connect;
+begin
+  if FSocket is TInetSocket then
+    TInetSocket(FSocket).Connect;
+  { TUnixSocket is already connected by its constructor. }
+end;
+
+procedure TSocketPeer.Close;
+begin
+  if Assigned(FSocket) then
+    FSocket.Close;
+end;
+
+function TSocketPeer.Read(var Buffer; Count: LongInt): LongInt;
+begin
+  Result:=FSocket.Read(Buffer,Count);
+end;
+
+function TSocketPeer.Write(const Buffer; Count: LongInt): LongInt;
+begin
+  Result:=FSocket.Write(Buffer,Count);
+end;
+
+function TSocketPeer.CanRead(Timeout: Integer): Boolean;
+begin
+  Result:=FSocket.CanRead(Timeout);
+end;
+
+function TSocketPeer.BytesAvailable: Integer;
+begin
+  Result:=FSocket.Handler.BytesAvailable;
+end;
+
+function TSocketPeer.GetConnectTimeout: Integer;
+begin
+  Result:=FSocket.ConnectTimeout;
+end;
+
+function TSocketPeer.GetIOTimeout: Integer;
+begin
+  Result:=FSocket.IOTimeout;
+end;
+
+procedure TSocketPeer.SetConnectTimeout(AValue: Integer);
+begin
+  FSocket.ConnectTimeout:=AValue;
+end;
+
+procedure TSocketPeer.SetIOTimeout(AValue: Integer);
+begin
+  FSocket.IOTimeout:=AValue;
+end;
+
+function TSocketPeer.ExtractSocket: TSocketStream;
+begin
+  Result:=FSocket;
+  FSocket:=Nil;
+end;
+
+end.
diff --git a/packages/fcl-net/src/networkframeworkapi.pp b/packages/fcl-net/src/networkframeworkapi.pp
new file mode 100644
index 00000000..0dc64284
--- /dev/null
+++ b/packages/fcl-net/src/networkframeworkapi.pp
@@ -0,0 +1,224 @@
+{ Part of FCL; see COPYING.FPC.
+  Minimal C API declarations for a pure Pascal Network.framework transport.
+  Blocks are FPC cblocks, not ordinary cdecl procedure pointers. Declarations
+  follow Apple's documented APIs and Security/libdispatch primary headers.
+  Basic connection APIs require macOS 10.14 or later. Availability is checked
+  through system symbols at runtime; compiler deployment defaults are retained.
+  Production requires macOS x86_64/arm64 and the normal Darwin Blocks RTL.
+  Audited minimums remain the compiler defaults (10.8 x86_64, 11.0 arm64);
+  that link audit does not establish runtime support on older systems.
+  No Network/Security framework is linked strongly or unloaded after use. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworkapi;
+{$ENDIF}
+{$mode objfpc}{$H+}{$packrecords c}
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and not defined(ios) and not defined(iphonesim)}
+  {$define FPC_NATIVE_NETWORK_FRAMEWORK}
+  {$modeswitch cblocks}
+{$endif}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.CTypes;
+{$ELSE}
+uses ctypes;
+{$ENDIF}
+type
+  { Apple C99 bool is not ctypes.cbool (= LongBool in this branch). }
+  TNWBoolean = Boolean;
+  TNWHandle = type Pointer;
+  TNWConnection = type Pointer;
+  TNWParameters = type Pointer;
+  TNWEndpoint = type Pointer;
+  TNWProtocolOptions = type Pointer;
+  TNWContentContext = type Pointer;
+  TNWError = type Pointer;
+  TSecProtocolOptions = type Pointer;
+  TSecProtocolMetadata = type Pointer;
+  TSecTrust = type Pointer;
+  TDispatchQueue = type Pointer;
+  TDispatchData = type Pointer;
+  TDispatchSemaphore = type Pointer;
+  TNWState = cint;
+  TNWErrorDomain = cint;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  TSecVerifyComplete = reference to procedure(Verified: TNWBoolean); cdecl; cblock;
+  TSecVerifyBlock = reference to procedure(Metadata: TSecProtocolMetadata;
+    Trust: TSecTrust; Complete: TSecVerifyComplete); cdecl; cblock;
+  TNWConfigureBlock = reference to procedure(Options: TNWProtocolOptions); cdecl; cblock;
+  TNWStateBlock = reference to procedure(State: TNWState; Error: TNWError); cdecl; cblock;
+  TNWReceiveBlock = reference to procedure(Data: TDispatchData;
+    Context: TNWContentContext; IsComplete: TNWBoolean; Error: TNWError); cdecl; cblock;
+  TNWSendBlock = reference to procedure(Error: TNWError); cdecl; cblock;
+  TDispatchBlock = reference to procedure; cdecl; cblock;
+{$else}
+  { Non-Darwin compiles only the ABI/shared-state model, never a native binding. }
+  TSecVerifyComplete = Pointer;
+  TSecVerifyBlock = Pointer;
+  TNWConfigureBlock = Pointer;
+  TNWStateBlock = Pointer;
+  TNWReceiveBlock = Pointer;
+  TNWSendBlock = Pointer;
+  TDispatchBlock = Pointer;
+{$endif}
+  TMachTimebaseInfo = record Numer, Denom: cuint32 end;
+  PMachTimebaseInfo = ^TMachTimebaseInfo;
+  TNetworkFrameworkFunctions = record
+    ParametersCreateSecureTCP: function(TLS, TCP: TNWConfigureBlock): TNWParameters; cdecl;
+    TLSCopySecurityOptions: function(Options: TNWProtocolOptions): TSecProtocolOptions; cdecl;
+    EndpointCreateHost: function(Host, Port: PAnsiChar): TNWEndpoint; cdecl;
+    ConnectionCreate: function(Endpoint: TNWEndpoint; Parameters: TNWParameters): TNWConnection; cdecl;
+    ConnectionSetQueue: procedure(Connection: TNWConnection; Queue: TDispatchQueue); cdecl;
+    ConnectionSetStateHandler: procedure(Connection: TNWConnection; Handler: TNWStateBlock); cdecl;
+    ConnectionStart: procedure(Connection: TNWConnection); cdecl;
+    ConnectionCancel: procedure(Connection: TNWConnection); cdecl;
+    ConnectionReceive: procedure(Connection: TNWConnection; Minimum, Maximum: cuint32;
+      Complete: TNWReceiveBlock); cdecl;
+    ConnectionSend: procedure(Connection: TNWConnection; Data: TDispatchData;
+      Context: TNWContentContext; IsComplete: TNWBoolean; Complete: TNWSendBlock); cdecl;
+    ContentCreate: function(Identifier: PAnsiChar): TNWContentContext; cdecl;
+    ContentSetFinal: procedure(Context: TNWContentContext; IsFinal: TNWBoolean); cdecl;
+    ContentGetFinal: function(Context: TNWContentContext): TNWBoolean; cdecl;
+    ErrorDomain: function(Error: TNWError): TNWErrorDomain; cdecl;
+    ErrorCode: function(Error: TNWError): cint; cdecl;
+    NWRelease: procedure(Handle: Pointer); cdecl;
+    SecuritySetServerName: procedure(Options: TSecProtocolOptions; Name: PAnsiChar); cdecl;
+    SecuritySetPeerRequired: procedure(Options: TSecProtocolOptions; Required: TNWBoolean); cdecl;
+    SecuritySetVerifyBlock: procedure(Options: TSecProtocolOptions; Verify: TSecVerifyBlock;
+      Queue: TDispatchQueue); cdecl;
+    SecurityRelease: procedure(Handle: Pointer); cdecl;
+    QueueCreate: function(LabelText: PAnsiChar; Attributes: Pointer): TDispatchQueue; cdecl;
+    DataCreate: function(Buffer: Pointer; Size: csize_t; Queue: TDispatchQueue;
+      Deallocator: TDispatchBlock): TDispatchData; cdecl;
+    DataCreateMap: function(Data: TDispatchData; Buffer: PPointer; Size: pcsize_t): TDispatchData; cdecl;
+    DispatchRelease: procedure(Handle: Pointer); cdecl;
+    SemaphoreCreate: function(Value: clong): TDispatchSemaphore; cdecl;
+    SemaphoreSignal: function(Semaphore: TDispatchSemaphore): clong; cdecl;
+    SemaphoreWait: function(Semaphore: TDispatchSemaphore; Timeout: cuint64): clong; cdecl;
+    DispatchTime: function(When: cuint64; Delta: cint64): cuint64; cdecl;
+    MachAbsoluteTime: function: cuint64; cdecl;
+    MachTimebaseInfo: function(Info: PMachTimebaseInfo): cint; cdecl;
+  end;
+  PNetworkFrameworkFunctions = ^TNetworkFrameworkFunctions;
+const
+  NWStateInvalid = 0;
+  NWStateWaiting = 1;
+  NWStatePreparing = 2;
+  NWStateReady = 3;
+  NWStateFailed = 4;
+  NWStateCancelled = 5;
+  NWDomainPOSIX = 1;
+{ Returns immutable process-lifetime symbols, or nil when unavailable. }
+function NetworkFrameworkSymbols: PNetworkFrameworkFunctions;
+function NetworkFrameworkSymbolsAvailable: Boolean;
+function NetworkFrameworkSymbolError: String;
+implementation
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.DynLibs;
+{$ELSE}
+uses DynLibs;
+{$ENDIF}
+var
+  Symbols: TNetworkFrameworkFunctions;
+  LoadLock: TRTLCriticalSection;
+  LoadAttempted, Loaded: Boolean;
+  AvailabilityError: String;
+  NetworkHandle, SecurityHandle, SystemHandle: TLibHandle;
+
+function Resolve(Handle: TLibHandle; const Name: AnsiString; var ProcAddress): Boolean;
+var Address: Pointer;
+begin
+  Address:=GetProcedureAddress(Handle,Name);
+  PPointer(@ProcAddress)^:=Address;
+  Result:=Address<>nil;
+  if not Result then AvailabilityError:='Missing mandatory system symbol: '+Name;
+end;
+
+procedure LoadSymbols;
+begin
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  if (SizeOf(TNWBoolean)<>1) or (SizeOf(cint)<>4) or
+    (SizeOf(cuint32)<>4) or (SizeOf(csize_t)<>SizeOf(Pointer)) then
+      begin
+      AvailabilityError:='Unsupported native ABI widths';
+      Exit;
+      end;
+  NetworkHandle:=LoadLibrary('/System/Library/Frameworks/Network.framework/Network');
+  SecurityHandle:=LoadLibrary('/System/Library/Frameworks/Security.framework/Security');
+  SystemHandle:=LoadLibrary('/usr/lib/libSystem.B.dylib');
+  if (NetworkHandle=NilHandle) or (SecurityHandle=NilHandle) or (SystemHandle=NilHandle) then
+    begin
+      AvailabilityError:='Required system Network/Security/libSystem unavailable';
+      Exit;
+    end;
+  if not Resolve(NetworkHandle,'nw_parameters_create_secure_tcp',Symbols.ParametersCreateSecureTCP) then Exit;
+  if not Resolve(NetworkHandle,'nw_tls_copy_sec_protocol_options',Symbols.TLSCopySecurityOptions) then Exit;
+  if not Resolve(NetworkHandle,'nw_endpoint_create_host',Symbols.EndpointCreateHost) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_create',Symbols.ConnectionCreate) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_set_queue',Symbols.ConnectionSetQueue) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_set_state_changed_handler',Symbols.ConnectionSetStateHandler) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_start',Symbols.ConnectionStart) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_cancel',Symbols.ConnectionCancel) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_receive',Symbols.ConnectionReceive) then Exit;
+  if not Resolve(NetworkHandle,'nw_connection_send',Symbols.ConnectionSend) then Exit;
+  if not Resolve(NetworkHandle,'nw_content_context_create',Symbols.ContentCreate) then Exit;
+  if not Resolve(NetworkHandle,'nw_content_context_set_is_final',Symbols.ContentSetFinal) then Exit;
+  if not Resolve(NetworkHandle,'nw_content_context_get_is_final',Symbols.ContentGetFinal) then Exit;
+  if not Resolve(NetworkHandle,'nw_error_get_error_domain',Symbols.ErrorDomain) then Exit;
+  if not Resolve(NetworkHandle,'nw_error_get_error_code',Symbols.ErrorCode) then Exit;
+  if not Resolve(NetworkHandle,'nw_release',Symbols.NWRelease) then Exit;
+  if not Resolve(SecurityHandle,'sec_protocol_options_set_tls_server_name',Symbols.SecuritySetServerName) then Exit;
+  if not Resolve(SecurityHandle,'sec_protocol_options_set_peer_authentication_required',Symbols.SecuritySetPeerRequired) then Exit;
+  if not Resolve(SecurityHandle,'sec_protocol_options_set_verify_block',Symbols.SecuritySetVerifyBlock) then Exit;
+  if not Resolve(SecurityHandle,'sec_release',Symbols.SecurityRelease) then Exit;
+  if not Resolve(SystemHandle,'dispatch_queue_create',Symbols.QueueCreate) then Exit;
+  if not Resolve(SystemHandle,'dispatch_data_create',Symbols.DataCreate) then Exit;
+  if not Resolve(SystemHandle,'dispatch_data_create_map',Symbols.DataCreateMap) then Exit;
+  if not Resolve(SystemHandle,'dispatch_release',Symbols.DispatchRelease) then Exit;
+  if not Resolve(SystemHandle,'mach_absolute_time',Symbols.MachAbsoluteTime) then Exit;
+  if not Resolve(SystemHandle,'mach_timebase_info',Symbols.MachTimebaseInfo) then Exit;
+  if not Resolve(SystemHandle,'dispatch_semaphore_create',Symbols.SemaphoreCreate) then Exit;
+  if not Resolve(SystemHandle,'dispatch_semaphore_signal',Symbols.SemaphoreSignal) then Exit;
+  if not Resolve(SystemHandle,'dispatch_semaphore_wait',Symbols.SemaphoreWait) then Exit;
+  if not Resolve(SystemHandle,'dispatch_time',Symbols.DispatchTime) then Exit;
+  Loaded:=True;
+{$else}
+  AvailabilityError:='Requires macOS x86_64 or arm64';
+{$endif}
+end;
+
+function NetworkFrameworkSymbols: PNetworkFrameworkFunctions;
+begin
+  EnterCriticalSection(LoadLock);
+  try
+    if not LoadAttempted then
+      begin
+      LoadAttempted:=True;
+      LoadSymbols;
+      end;
+    if Loaded then Result:=@Symbols else Result:=nil;
+  finally
+    LeaveCriticalSection(LoadLock);
+  end;
+end;
+
+function NetworkFrameworkSymbolsAvailable: Boolean;
+begin
+  Result:=NetworkFrameworkSymbols<>nil;
+end;
+
+function NetworkFrameworkSymbolError: String;
+begin
+  NetworkFrameworkSymbols;
+  EnterCriticalSection(LoadLock);
+  try
+    Result:=AvailabilityError;
+  finally
+    LeaveCriticalSection(LoadLock);
+  end;
+end;
+
+initialization
+  InitCriticalSection(LoadLock);
+{ Do not unload handles or destroy the load lock in finalization: a late native
+  completion may still release its context during other units' finalization. }
+end.
diff --git a/packages/fcl-net/src/networkframeworknative.pp b/packages/fcl-net/src/networkframeworknative.pp
new file mode 100644
index 00000000..c7412a20
--- /dev/null
+++ b/packages/fcl-net/src/networkframeworknative.pp
@@ -0,0 +1,847 @@
+{ Part of FCL; see COPYING.FPC.
+  Pure Pascal Network.framework client TCP+TLS provider. No C object dependency.
+  Callback methods belong to an explicitly retained context, never the stream.
+  One serial queue and one pending receive/send; owned plaintext is <=16 KiB.
+  Read/write return partial counts. Timeout 0 is unlimited for I/O; readiness
+  timeout 0 polls and High(Cardinal) is unlimited. Readiness expiry is benign.
+  Close wakes a concurrent caller and releases its one owner reference; each
+  caller must separately retain a captured context until its call returns.
+  Unix programs must load cthreads first. Serialization is provided by the caller.
+  EOF follows Network.framework semantics; the API does not distinguish a bare
+  TCP FIN from a received TLS close_notify on the tested macOS versions.
+  Shared Windows tests are state/ABI models only, not Apple runtime evidence. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworknative;
+{$ENDIF}
+{$mode objfpc}{$H+}
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and not defined(ios) and not defined(iphonesim)}
+  {$define FPC_NATIVE_NETWORK_FRAMEWORK}
+  {$modeswitch cblocks}
+{$endif}
+interface
+function NetworkFrameworkAvailable: Boolean;
+{ Internal synchronous adapter. Each operation requires a retained context.
+  NativeClose cancels and drops its owner reference exactly once. }
+function NativeCreate(Host, Port: PAnsiChar; VerifyPeer: LongInt;
+  out Domain, Code: LongInt): Pointer; cdecl;
+function NativeConnect(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+function NativeRead(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+function NativeWrite(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+function NativeCanRead(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+function NativeBytesAvailable(Value: Pointer): LongInt; cdecl;
+procedure NativeRetain(Value: Pointer); cdecl;
+procedure NativeRelease(Value: Pointer); cdecl;
+procedure NativeClose(Value: Pointer); cdecl;
+function NetworkFrameworkAvailabilityError: String;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+{ Test-only process counters: observe eventual release after native callbacks. }
+function NetworkFrameworkLiveContexts: LongInt;
+function NetworkFrameworkDestroyedContexts: LongInt;
+function NetworkFrameworkReceiveDiagnostics: String;
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+{ Explicit test build only: uses the production context/state helpers while
+  replacing native completion delivery. This is not a macOS test. }
+procedure RunNetworkFrameworkCoreModelTests;
+{$endif}
+implementation
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.CTypes, System.Net.NetworkFrameworkAPI
+  {$ifdef FPC_NETWORKFRAMEWORK_MODEL}, System.Classes{$endif};
+{$ELSE}
+uses SysUtils, ctypes, networkframeworkapi
+  {$ifdef FPC_NETWORKFRAMEWORK_MODEL}, Classes{$endif};
+{$ENDIF}
+const
+  PlaintextCapacity = 16384;
+  { Darwin POSIX values. These describe the native provider even in model tests. }
+  NW_EIO = 5;
+  NW_ENOMEM = 12;
+  NW_EBUSY = 16;
+  NW_EINVAL = 22;
+  NW_EALREADY = 37;
+  NW_ENOTCONN = 57;
+  NW_ETIMEDOUT = 60;
+  NW_ENOSYS = 78;
+  NW_EOVERFLOW = 84;
+  NW_ECANCELED = 89;
+type
+  TNativeDeadline = record
+    Start: QWord;
+    Timeout: Cardinal;
+    Infinite: Boolean;
+  end;
+  TNativeContext = class
+  private
+    FLock: TRTLCriticalSection;
+    FLockInitialized: Boolean;
+    {$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}FCounted: Boolean;{$endif}
+    FModelEvent: PRTLEvent;
+    FReferences: LongInt;
+    FFunctions: PNetworkFrameworkFunctions;
+    FSemaphore: TDispatchSemaphore;
+    FQueue: TDispatchQueue;
+    FConnection: TNWConnection;
+    FTimebase: TMachTimebaseInfo;
+    FHost: UTF8String;
+    FVerify: Boolean;
+    FConstructionFailed: Boolean;
+    FStarted, FReady, FStopped, FOwnerClosed: Boolean;
+    FStateReference, FReceivePending: Boolean;
+    FSendPending, FSendDone: Boolean;
+    FEOF, FError: Boolean;
+    FDomain, FCode: LongInt;
+    FOffset, FLength: SizeUInt;
+    FPlaintext: array[0..PlaintextCapacity-1] of Byte;
+    procedure Lock;
+    procedure Unlock;
+    procedure WakeLocked;
+    procedure FailureLocked(Domain, Code: LongInt);
+    procedure LocalFailureLocked(Code: LongInt);
+    procedure NativeFailureLocked(Error: TNWError);
+    procedure CallbackFailure;
+    function ErrorResultLocked(out Domain, Code: LongInt): LongInt;
+    function UsableLocked: Boolean;
+    function CurrentTick: QWord;
+    function NewDeadline(Timeout: Cardinal; Infinite: Boolean): TNativeDeadline;
+    function WaitLocked(const Deadline: TNativeDeadline): Boolean;
+    procedure ReceiveResultLocked(Buffer: Pointer; Size: SizeUInt;
+      FinalContent, HasError: Boolean; Domain, Code: LongInt);
+    procedure StartLocked;
+    procedure ReceiveLocked;
+    procedure ConfigureTLS(Options: TNWProtocolOptions); cdecl;
+    procedure StateChanged(State: TNWState; Error: TNWError); cdecl;
+    procedure ReceiveCompleted(Data: TDispatchData; Content: TNWContentContext;
+      IsComplete: TNWBoolean; Error: TNWError); cdecl;
+    procedure SendCompleted(Error: TNWError); cdecl;
+  public
+    constructor Create(Functions: PNetworkFrameworkFunctions);
+    destructor Destroy; override;
+    procedure Retain;
+    procedure Release;
+  end;
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+var ModelDestroyed: LongInt;
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+var LiveContexts, DestroyedContexts: LongInt;
+    ReceiveCount, LastComplete, LastContentFinal, LastContentPresent,
+    LastDataPresent, LastErrorPresent, LastErrorDomain, LastErrorCode,
+    LastState, StateEvents: LongInt;
+function NetworkFrameworkLiveContexts: LongInt;
+begin
+  Result:=InterlockedCompareExchange(LiveContexts,0,0);
+end;
+function NetworkFrameworkDestroyedContexts: LongInt;
+begin
+  Result:=InterlockedCompareExchange(DestroyedContexts,0,0);
+end;
+function NetworkFrameworkReceiveDiagnostics: String;
+begin
+  Result:=Format('receive_count=%d complete=%d content_present=%d final=%d data_present=%d error_present=%d domain=%d code=%d state=%d state_events=%d',
+    [InterlockedCompareExchange(ReceiveCount,0,0),InterlockedCompareExchange(LastComplete,0,0),
+     InterlockedCompareExchange(LastContentPresent,0,0),InterlockedCompareExchange(LastContentFinal,0,0),
+     InterlockedCompareExchange(LastDataPresent,0,0),InterlockedCompareExchange(LastErrorPresent,0,0),
+     InterlockedCompareExchange(LastErrorDomain,0,0),InterlockedCompareExchange(LastErrorCode,0,0),
+     InterlockedCompareExchange(LastState,0,0),InterlockedCompareExchange(StateEvents,0,0)]);
+end;
+{$endif}
+
+function NetworkFrameworkAvailabilityError: String;
+begin
+  Result:=NetworkFrameworkSymbolError;
+end;
+
+function ValidPort(Port: PAnsiChar): Boolean;
+var Value, Digits: Cardinal;
+begin
+  Result:=False;
+  if (Port=nil) or (Port^=#0) then Exit;
+  Value:=0; Digits:=0;
+  while Port^<>#0 do
+    begin
+    Inc(Digits);
+    if (Digits>5) or (Port^<'0') or (Port^>'9') then Exit;
+    Value:=Value*10+Ord(Port^)-Ord('0');
+    Inc(Port);
+    end;
+  Result:=(Value>0) and (Value<=65535);
+end;
+
+constructor TNativeContext.Create(Functions: PNetworkFrameworkFunctions);
+begin
+  inherited Create;
+  InitCriticalSection(FLock);
+  FLockInitialized:=True;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  InterlockedIncrement(LiveContexts); FCounted:=True;
+{$endif}
+  FReferences:=1;
+  FFunctions:=Functions;
+  FTimebase.Numer:=1000000; FTimebase.Denom:=1;
+  if FFunctions<>nil then
+    begin
+    if (FFunctions^.MachTimebaseInfo(@FTimebase)<>0) or
+       (FTimebase.Numer=0) or (FTimebase.Denom=0) then
+      raise Exception.Create('Unavailable monotonic timebase');
+    FSemaphore:=FFunctions^.SemaphoreCreate(0);
+    if FSemaphore=nil then raise EOutOfMemory.Create('Native wait semaphore');
+    FQueue:=FFunctions^.QueueCreate('org.freepascal.tls.network',nil);
+    if FQueue=nil then raise EOutOfMemory.Create('Native callback queue');
+    end
+  else
+    begin
+    { Only the explicit core model constructs a context with no native symbols. }
+    FModelEvent:=RTLEventCreate;
+    if FModelEvent=nil then raise EOutOfMemory.Create('Core model condition');
+    end;
+end;
+
+destructor TNativeContext.Destroy;
+begin
+  if FFunctions<>nil then
+    begin
+    if FConnection<>nil then FFunctions^.NWRelease(Pointer(FConnection));
+    if FQueue<>nil then FFunctions^.DispatchRelease(Pointer(FQueue));
+    if FSemaphore<>nil then FFunctions^.DispatchRelease(Pointer(FSemaphore));
+    end;
+  if FModelEvent<>nil then RTLEventDestroy(FModelEvent);
+  if FLockInitialized then DoneCriticalSection(FLock);
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+  InterlockedIncrement(ModelDestroyed);
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  if FCounted then
+    begin
+      InterlockedIncrement(DestroyedContexts);
+      InterlockedDecrement(LiveContexts);
+    end;
+{$endif}
+  inherited Destroy;
+end;
+
+procedure TNativeContext.Lock;
+begin
+  EnterCriticalSection(FLock);
+end;
+procedure TNativeContext.Unlock;
+begin
+  LeaveCriticalSection(FLock);
+end;
+
+procedure TNativeContext.Retain;
+begin
+  Lock;
+  try
+    Inc(FReferences);
+  finally
+    Unlock;
+  end;
+end;
+
+procedure TNativeContext.Release;
+var Dispose: Boolean;
+begin
+  Lock;
+  try
+    Dec(FReferences);
+    Dispose:=FReferences=0;
+  finally Unlock end;
+  if Dispose then Free;
+end;
+
+procedure TNativeContext.WakeLocked;
+begin
+  if FSemaphore<>nil then FFunctions^.SemaphoreSignal(FSemaphore)
+  else if FModelEvent<>nil then RTLEventSetEvent(FModelEvent);
+end;
+
+procedure TNativeContext.FailureLocked(Domain, Code: LongInt);
+var Cancel: Boolean;
+begin
+  if not FError then
+    begin
+      FError:=True;
+      FDomain:=Domain;
+      FCode:=Code;
+    end;
+  Cancel:=not FStopped;
+  FStopped:=True; FReady:=False;
+  { Publish terminal state and wake BEFORE asking for eventual native callbacks. }
+  WakeLocked;
+  if Cancel and (FConnection<>nil) and (FFunctions<>nil) then
+    FFunctions^.ConnectionCancel(FConnection);
+end;
+
+procedure TNativeContext.LocalFailureLocked(Code: LongInt);
+begin
+  FOffset:=0; FLength:=0;
+  FailureLocked(NWDomainPOSIX,Code);
+end;
+
+procedure TNativeContext.NativeFailureLocked(Error: TNWError);
+begin
+  if (Error<>nil) and (FFunctions<>nil) then
+    FailureLocked(FFunctions^.ErrorDomain(Error),FFunctions^.ErrorCode(Error))
+  else FailureLocked(NWDomainPOSIX,NW_EIO);
+end;
+
+procedure TNativeContext.CallbackFailure;
+begin
+  { No Pascal exception may escape through a C/Blocks callback boundary. }
+  try
+    Lock;
+    try
+      LocalFailureLocked(NW_EIO);
+    finally
+      Unlock;
+    end;
+  except
+    { Even a secondary RTL failure must not cross the foreign callback boundary. }
+  end;
+end;
+
+function TNativeContext.ErrorResultLocked(out Domain, Code: LongInt): LongInt;
+begin
+  Domain:=FDomain;
+  Code:=FCode;
+  Result:=-1;
+end;
+
+function TNativeContext.UsableLocked: Boolean;
+begin
+  Result:=not FError;
+  if Result and not FReady then
+    begin
+      LocalFailureLocked(NW_ENOTCONN);
+      Result:=False;
+    end;
+end;
+
+function TNativeContext.CurrentTick: QWord;
+begin
+  if FFunctions<>nil then Result:=FFunctions^.MachAbsoluteTime()
+  else Result:=GetTickCount64;
+end;
+
+function TNativeContext.NewDeadline(Timeout: Cardinal; Infinite: Boolean): TNativeDeadline;
+begin
+  Result.Start:=CurrentTick;
+  Result.Timeout:=Timeout;
+  Result.Infinite:=Infinite;
+end;
+
+function TNativeContext.WaitLocked(const Deadline: TNativeDeadline): Boolean;
+var Elapsed: Extended; Remaining: QWord; NativeTime: cuint64; WaitMS: LongInt;
+begin
+  Result:=True;
+  if Deadline.Infinite then Remaining:=High(QWord)
+  else
+    begin
+    Elapsed:=Extended(CurrentTick-Deadline.Start)*FTimebase.Numer/FTimebase.Denom;
+    if Elapsed>=Extended(Deadline.Timeout)*1000000 then Exit(False);
+    Remaining:=Trunc(Extended(Deadline.Timeout)*1000000-Elapsed);
+    end;
+  if FSemaphore<>nil then
+    begin
+    { Clear stale condition notifications while holding the predicate lock.
+      A callback cannot signal between this drain and the release of the lock. }
+    while FFunctions^.SemaphoreWait(FSemaphore,0)=0 do ;
+    if Deadline.Infinite then NativeTime:=High(cuint64)
+    else NativeTime:=FFunctions^.DispatchTime(0,cint64(Remaining));
+    Unlock;
+    try Result:=FFunctions^.SemaphoreWait(FSemaphore,NativeTime)=0
+    finally Lock end;
+    end
+  else
+    begin
+    RTLEventResetEvent(FModelEvent);
+    Unlock;
+    try
+      if Deadline.Infinite then RTLEventWaitFor(FModelEvent)
+      else
+        begin
+        Remaining:=(Remaining+999999) div 1000000;
+        if Remaining>QWord(High(LongInt)) then WaitMS:=High(LongInt)
+        else WaitMS:=LongInt(Remaining);
+        RTLEventWaitFor(FModelEvent,WaitMS);
+        end;
+    finally Lock end;
+    { RTL event does not return a timeout status. Recheck monotonic elapsed time.
+      This branch is used only by Windows state tests, not the native provider. }
+    if not Deadline.Infinite then
+      Result:=Extended(CurrentTick-Deadline.Start)*FTimebase.Numer/FTimebase.Denom<
+        Extended(Deadline.Timeout)*1000000;
+    end;
+end;
+
+procedure TNativeContext.ReceiveResultLocked(Buffer: Pointer; Size: SizeUInt;
+  FinalContent, HasError: Boolean; Domain, Code: LongInt);
+begin
+  FReceivePending:=False;
+  if not FStopped then
+    begin
+    if (Size>PlaintextCapacity) or ((Size>0) and (Buffer=nil)) then
+      LocalFailureLocked(NW_EOVERFLOW)
+    else
+      begin
+      if Size>0 then
+        begin
+        Move(Buffer^,FPlaintext[0],Size);
+        FOffset:=0; FLength:=Size;
+        end;
+      { Preserve data delivered with a receive error; reads drain it before
+        reporting the first native error. Never accept error+complete as EOF. }
+      if HasError then FailureLocked(Domain,Code)
+      else if FinalContent then FEOF:=True;
+      end;
+    end;
+  WakeLocked;
+end;
+
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+procedure ConfigureTCP(Options: TNWProtocolOptions); cdecl;
+begin
+  { The default TCP configuration requires no mutations. };
+end;
+
+procedure AcceptPeer(Metadata: TSecProtocolMetadata; Trust: TSecTrust;
+  Complete: TSecVerifyComplete); cdecl;
+begin
+  { This per-connection block changes neither system trust nor TLS policy. }
+  { Apple supplies a non-null completion block. Assigned attempts a TMethod
+    conversion for cblocks in this compiler and cannot be used here. }
+  try Complete(True) except end;
+end;
+{$endif}
+
+procedure TNativeContext.ConfigureTLS(Options: TNWProtocolOptions); cdecl;
+var Security: TSecProtocolOptions;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    VerifyBlock: TSecVerifyBlock;
+{$endif}
+begin
+  try
+    Security:=FFunctions^.TLSCopySecurityOptions(Options);
+    if Security=nil then
+      begin
+      FConstructionFailed:=True;
+      Exit;
+      end;
+    try
+      FFunctions^.SecuritySetServerName(Security,PAnsiChar(FHost));
+      FFunctions^.SecuritySetPeerRequired(Security,True);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+      if not FVerify then
+        begin
+        VerifyBlock:=@AcceptPeer;
+        FFunctions^.SecuritySetVerifyBlock(Security,VerifyBlock,FQueue);
+        end;
+{$endif}
+    finally FFunctions^.SecurityRelease(Pointer(Security)) end;
+  except FConstructionFailed:=True end;
+end;
+
+procedure TNativeContext.StateChanged(State: TNWState; Error: TNWError); cdecl;
+var DropState: Boolean;
+begin
+  DropState:=False;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  InterlockedExchange(LastState,State); InterlockedIncrement(StateEvents);
+{$endif}
+  try
+    Lock;
+    try
+      case State of
+        NWStateReady: if not FStopped then FReady:=True;
+        NWStateFailed: NativeFailureLocked(Error);
+        NWStateWaiting: if Error<>nil then NativeFailureLocked(Error);
+        NWStateCancelled:
+          begin
+          if not FStopped then LocalFailureLocked(NW_ECANCELED);
+          if FStateReference then
+            begin
+              FStateReference:=False;
+              DropState:=True;
+            end;
+          if FFunctions<>nil then FFunctions^.ConnectionSetStateHandler(FConnection,nil);
+          end;
+      end;
+      WakeLocked;
+    finally Unlock end;
+  except CallbackFailure end;
+  if DropState then
+    try Release except end;
+end;
+
+procedure TNativeContext.ReceiveCompleted(Data: TDispatchData;
+  Content: TNWContentContext; IsComplete: TNWBoolean; Error: TNWError); cdecl;
+var Mapped: TDispatchData; Buffer: Pointer; Size: csize_t;
+    FinalContent: Boolean; Domain, Code: LongInt;
+begin
+  Mapped:=nil; Buffer:=nil; Size:=0;
+  try
+    try
+      if Data<>nil then
+        begin
+        Mapped:=FFunctions^.DataCreateMap(Data,@Buffer,@Size);
+        if Mapped=nil then raise EOutOfMemory.Create('Native data map');
+        end;
+      FinalContent:=IsComplete and ((Content=nil) or FFunctions^.ContentGetFinal(Content));
+      Domain:=0; Code:=0;
+      if Error<>nil then
+        begin
+          Domain:=FFunctions^.ErrorDomain(Error);
+          Code:=FFunctions^.ErrorCode(Error);
+        end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+      InterlockedExchange(LastComplete,Ord(IsComplete));
+      InterlockedExchange(LastContentPresent,Ord(Content<>nil));
+      InterlockedExchange(LastContentFinal,Ord(FinalContent));
+      InterlockedExchange(LastDataPresent,Ord(Data<>nil));
+      InterlockedExchange(LastErrorPresent,Ord(Error<>nil));
+      InterlockedExchange(LastErrorDomain,Domain); InterlockedExchange(LastErrorCode,Code);
+      InterlockedIncrement(ReceiveCount);
+{$endif}
+      Lock;
+      try ReceiveResultLocked(Buffer,Size,FinalContent,Error<>nil,Domain,Code)
+      finally Unlock end;
+    except CallbackFailure end;
+  finally
+    { Each receive completion balances its explicit context reference. }
+    try if Mapped<>nil then FFunctions^.DispatchRelease(Pointer(Mapped)) except end;
+    try Release except end;
+  end;
+end;
+
+procedure TNativeContext.SendCompleted(Error: TNWError); cdecl;
+begin
+  try
+    try
+      Lock;
+      try
+        FSendPending:=False; FSendDone:=True;
+        if Error<>nil then NativeFailureLocked(Error);
+        WakeLocked;
+      finally Unlock end;
+    except CallbackFailure end;
+  finally
+    try Release except end;
+  end;
+end;
+
+procedure TNativeContext.StartLocked;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var StateBlock: TNWStateBlock;
+{$endif}
+begin
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  try StateBlock:=@Self.StateChanged
+  except LocalFailureLocked(NW_ENOMEM); Exit end;
+{$endif}
+  FStarted:=True; FStateReference:=True; Inc(FReferences);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  FFunctions^.ConnectionSetStateHandler(FConnection,StateBlock);
+  FFunctions^.ConnectionStart(FConnection);
+{$endif}
+end;
+
+procedure TNativeContext.ReceiveLocked;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var ReceiveBlock: TNWReceiveBlock;
+{$endif}
+begin
+  if FReceivePending or (FLength>0) or FEOF or FStopped then Exit;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  try ReceiveBlock:=@Self.ReceiveCompleted
+  except LocalFailureLocked(NW_ENOMEM); Exit end;
+{$endif}
+  FReceivePending:=True; Inc(FReferences);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  FFunctions^.ConnectionReceive(FConnection,1,PlaintextCapacity,ReceiveBlock);
+{$endif}
+end;
+
+function NativeCreate(Host, Port: PAnsiChar; VerifyPeer: LongInt;
+  out Domain, Code: LongInt): Pointer; cdecl;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var Context: TNativeContext; Functions: PNetworkFrameworkFunctions;
+    Parameters: TNWParameters; Endpoint: TNWEndpoint;
+    TLSBlock, TCPBlock: TNWConfigureBlock;
+{$endif}
+begin
+  Result:=nil; Domain:=0; Code:=0;
+  if (Host=nil) or (Host^=#0) or not ValidPort(Port) then
+    begin
+      Domain:=NWDomainPOSIX;
+      Code:=NW_EINVAL;
+      Exit;
+    end;
+  if not NetworkFrameworkAvailable then
+    begin
+      Domain:=NWDomainPOSIX;
+      Code:=NW_ENOSYS;
+      Exit;
+    end;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  Functions:=NetworkFrameworkSymbols;
+  Context:=nil; Parameters:=nil; Endpoint:=nil;
+  try
+    try
+      Context:=TNativeContext.Create(Functions);
+      SetString(Context.FHost,Host,StrLen(Host)); Context.FVerify:=VerifyPeer<>0;
+      TLSBlock:=@Context.ConfigureTLS; TCPBlock:=@ConfigureTCP;
+      Parameters:=Functions^.ParametersCreateSecureTCP(TLSBlock,TCPBlock);
+      if (Parameters=nil) or Context.FConstructionFailed then
+        begin
+          Domain:=NWDomainPOSIX;
+          Code:=NW_EIO;
+          Exit;
+        end;
+      Endpoint:=Functions^.EndpointCreateHost(Host,Port);
+      if Endpoint=nil then
+        begin
+        Domain:=NWDomainPOSIX;
+        Code:=NW_ENOMEM;
+        Exit;
+        end;
+      Context.FConnection:=Functions^.ConnectionCreate(Endpoint,Parameters);
+      if Context.FConnection=nil then
+        begin
+        Domain:=NWDomainPOSIX;
+        Code:=NW_ENOMEM;
+        Exit;
+        end;
+      Functions^.ConnectionSetQueue(Context.FConnection,Context.FQueue);
+      { No connection is started and no state hold exists until Connect. }
+      Result:=Pointer(Context); Context:=nil;
+    except
+      on E: EOutOfMemory do begin Domain:=NWDomainPOSIX; Code:=NW_ENOMEM end;
+      else begin Domain:=NWDomainPOSIX; Code:=NW_EIO end;
+    end;
+  finally
+    if Endpoint<>nil then Functions^.NWRelease(Pointer(Endpoint));
+    if Parameters<>nil then Functions^.NWRelease(Pointer(Parameters));
+    if Context<>nil then Context.Release;
+  end;
+{$endif}
+end;
+
+function NativeConnect(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then
+    begin
+    Domain:=NWDomainPOSIX;
+    Code:=NW_EINVAL;
+    Exit(-1);
+    end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Context.FStarted then
+      begin
+        Context.LocalFailureLocked(NW_EALREADY);
+        Exit(Context.ErrorResultLocked(Domain,Code));
+      end;
+    Context.StartLocked;
+    while not Context.FReady and not Context.FError do
+      if not Context.WaitLocked(Deadline) and not Context.FReady and not Context.FError then
+        Context.LocalFailureLocked(NW_ETIMEDOUT);
+    if Context.FError then Result:=Context.ErrorResultLocked(Domain,Code) else Result:=1;
+  finally Context.Unlock end;
+end;
+
+function NativeRead(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline; Size: SizeUInt;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then
+    begin
+    Domain:=NWDomainPOSIX;
+    Code:=NW_EINVAL;
+    Exit(-1);
+    end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if (Count<0) or ((Count>0) and (Buffer=nil)) then
+      begin
+        Context.LocalFailureLocked(NW_EINVAL);
+        Exit(Context.ErrorResultLocked(Domain,Code));
+      end;
+    if Count=0 then
+      begin
+        if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code)) else Exit(0);
+      end;
+    repeat
+      if Context.FLength>0 then
+        begin
+        Size:=SizeUInt(Count); if Size>Context.FLength then Size:=Context.FLength;
+        Move(Context.FPlaintext[Context.FOffset],Buffer^,Size);
+        Inc(Context.FOffset,Size); Dec(Context.FLength,Size);
+        if Context.FLength=0 then Context.FOffset:=0;
+        Exit(LongInt(Size));
+        end;
+      if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+      if Context.FEOF then Exit(0);
+      if not Context.UsableLocked then Continue;
+      Context.ReceiveLocked;
+      if Context.FError then Continue;
+      if not Context.WaitLocked(Deadline) and (Context.FLength=0) and
+        not Context.FEOF and not Context.FError then Context.LocalFailureLocked(NW_ETIMEDOUT);
+    until False;
+  finally Context.Unlock end;
+end;
+
+function NativeCanRead(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then
+    begin
+    Domain:=NWDomainPOSIX;
+    Code:=NW_EINVAL;
+    Exit(-1);
+    end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=High(Cardinal));
+  Context.Lock;
+  try
+    repeat
+      if Context.FLength>0 then Exit(1);
+      if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+      if Context.FEOF then Exit(1);
+      if not Context.UsableLocked then Continue;
+      Context.ReceiveLocked;
+      if Context.FError then Continue;
+      if Timeout=0 then Exit(0);
+      if not Context.WaitLocked(Deadline) and (Context.FLength=0) and
+        not Context.FEOF and not Context.FError then Exit(0);
+    until False;
+  finally Context.Unlock end;
+end;
+
+function NativeWrite(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline; Size: SizeUInt;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    Data: TDispatchData; Content: TNWContentContext; SendBlock: TNWSendBlock;
+{$endif}
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then
+    begin
+    Domain:=NWDomainPOSIX;
+    Code:=NW_EINVAL;
+    Exit(-1);
+    end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if (Count<0) or ((Count>0) and (Buffer=nil)) then Context.LocalFailureLocked(NW_EINVAL);
+    if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Count=0 then Exit(0);
+    if not Context.UsableLocked then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Context.FSendPending then
+      begin
+        Context.LocalFailureLocked(NW_EBUSY);
+        Exit(Context.ErrorResultLocked(Domain,Code));
+      end;
+    Size:=SizeUInt(Count); if Size>PlaintextCapacity then Size:=PlaintextCapacity;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    try SendBlock:=@Context.SendCompleted
+    except
+      Context.LocalFailureLocked(NW_ENOMEM);
+      Exit(Context.ErrorResultLocked(Domain,Code));
+    end;
+    { nil is DISPATCH_DATA_DESTRUCTOR_DEFAULT: dispatch copies these bytes before
+      returning. No caller buffer or Pascal allocator reaches an async callback. }
+    Data:=Context.FFunctions^.DataCreate(Buffer,Size,Context.FQueue,nil);
+    if Data=nil then
+      begin
+        Context.LocalFailureLocked(NW_ENOMEM);
+        Exit(Context.ErrorResultLocked(Domain,Code));
+      end;
+    Content:=nil;
+    try
+      Content:=Context.FFunctions^.ContentCreate('org.freepascal.tls.write');
+      if Content=nil then
+        begin
+          Context.LocalFailureLocked(NW_ENOMEM);
+          Exit(Context.ErrorResultLocked(Domain,Code));
+        end;
+      Context.FFunctions^.ContentSetFinal(Content,False);
+      Context.FSendDone:=False; Context.FSendPending:=True; Inc(Context.FReferences);
+      Context.FFunctions^.ConnectionSend(Context.FConnection,Data,Content,True,SendBlock);
+    finally
+      if Content<>nil then Context.FFunctions^.NWRelease(Pointer(Content));
+      Context.FFunctions^.DispatchRelease(Pointer(Data));
+    end;
+{$else}
+    { Model exercises shared deadline/completion state, without sending data. }
+    Context.FSendDone:=False; Context.FSendPending:=True; Inc(Context.FReferences);
+{$endif}
+    while not Context.FSendDone and not Context.FError do
+      if not Context.WaitLocked(Deadline) and not Context.FSendDone and not Context.FError then
+        Context.LocalFailureLocked(NW_ETIMEDOUT);
+    if Context.FError then Result:=Context.ErrorResultLocked(Domain,Code) else Result:=LongInt(Size);
+  finally Context.Unlock end;
+end;
+
+function NativeBytesAvailable(Value: Pointer): LongInt; cdecl;
+var Context: TNativeContext;
+begin
+  if Value=nil then Exit(0);
+  Context:=TNativeContext(Value); Context.Lock;
+  try
+    Result:=Context.FLength;
+  finally
+    Context.Unlock;
+  end;
+end;
+
+procedure NativeRetain(Value: Pointer); cdecl;
+begin
+  if Value<>nil then TNativeContext(Value).Retain;
+end;
+procedure NativeRelease(Value: Pointer); cdecl;
+begin
+  if Value<>nil then TNativeContext(Value).Release;
+end;
+
+procedure NativeClose(Value: Pointer); cdecl;
+var Context: TNativeContext; DropOwner: Boolean;
+begin
+  if Value=nil then Exit;
+  Context:=TNativeContext(Value); DropOwner:=False;
+  Context.Lock;
+  try
+    if not Context.FOwnerClosed then
+      begin
+      Context.FOwnerClosed:=True;
+      Context.LocalFailureLocked(NW_ECANCELED);
+      DropOwner:=True;
+      end;
+  finally Context.Unlock end;
+  if DropOwner then Context.Release;
+end;
+
+function NetworkFrameworkAvailable: Boolean;
+begin
+  Result:=NetworkFrameworkSymbolsAvailable;
+end;
+
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+{$i networkframeworkmodel.inc}
+{$endif}
+
+end.
diff --git a/packages/fcl-net/src/networkframeworksslsockets.pp b/packages/fcl-net/src/networkframeworksslsockets.pp
new file mode 100644
index 00000000..85d3796e
--- /dev/null
+++ b/packages/fcl-net/src/networkframeworksslsockets.pp
@@ -0,0 +1,541 @@
+{
+    This file is part of the Free Component Library (FCL).
+    See COPYING.FPC for copyright and license details.
+
+    A client-only TLS peer owning its TCP connection through Network.framework.
+    The inherited socket interface cannot adopt an existing TCP descriptor.
+}
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworksslsockets;
+{$ENDIF}
+
+{$mode objfpc}{$H+}
+
+interface
+
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Net.Sslbase, System.Net.Sslsockets,
+  System.Net.ClientPeers;
+{$ELSE}
+uses SysUtils, sslbase, sslsockets, clientpeers;
+{$ENDIF}
+
+type
+  ENetworkFrameworkTLS = class(ESSLSocketError)
+  private
+    FDomain, FCode: LongInt;
+  public
+    constructor CreateNative(const Operation: String; ADomain, ACode: LongInt);
+    property Domain: LongInt read FDomain;
+    property NativeCode: LongInt read FCode;
+  end;
+
+  TNetworkFrameworkSocketHandler = class(TSSLSocketHandler)
+  private
+    FError: String;
+    FErrorCode: Integer;
+    procedure CheckCapabilities;
+    procedure RecordError(E: Exception);
+  protected
+    function GetLastSSLErrorString: String; override;
+    function GetLastSSLErrorCode: Integer; override;
+  public
+    function CreateCertGenerator: TX509Certificate; override;
+    function CreateClientPeer(const Host: String; Port: Word): TClientPeer; override;
+    function Connect: Boolean; override;
+    function Accept: Boolean; override;
+  end;
+
+  { Owns its handler after construction succeeds. Callers serialize ordinary
+    operations; Close can cancel a blocked operation. Stop further callers before
+    Free. Asynchronous Apple callbacks retain a private context, never this peer,
+    the handler, the HTTP client or an application buffer. }
+  TNetworkFrameworkPeer = class(TClientPeer)
+  private
+    FHandler: TNetworkFrameworkSocketHandler;
+    FContext: Pointer;
+    FStateLock, FIOLock: TRTLCriticalSection;
+    FLocksInitialized: Boolean;
+    FHost: UTF8String;
+    FPort: AnsiString;
+    FReady, FConnecting, FPeerEOF: Boolean;
+    FGeneration: QWord;
+    function AcquireContext: Pointer;
+    procedure DropContext(Context: Pointer; PeerEOF: Boolean = False);
+    procedure Fail(Context: Pointer; const Operation: String; Domain, Code: LongInt);
+    procedure CheckCurrent(Context: Pointer);
+  protected
+    procedure SetConnectTimeout(AValue: Integer); override;
+    procedure SetIOTimeout(AValue: Integer); override;
+  public
+    constructor Create(Handler: TNetworkFrameworkSocketHandler;
+      const Host: String; Port: Word);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+  end;
+
+function NetworkFrameworkTLSAvailable: Boolean;
+
+implementation
+
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Classes, System.Net.NetworkFrameworkNative;
+{$ELSE}
+uses Classes, networkframeworknative;
+{$ENDIF}
+
+type
+  TUnsupportedCertificate = class(TX509Certificate)
+    function CreateCertificateAndKey: TCertAndKey; override;
+  end;
+
+function NetworkFrameworkTLSAvailable: Boolean;
+begin
+  Result:=NetworkFrameworkAvailable;
+end;
+
+constructor ENetworkFrameworkTLS.CreateNative(const Operation: String;
+  ADomain, ACode: LongInt);
+begin
+  FDomain:=ADomain;
+  FCode:=ACode;
+  inherited CreateFmt('Network.framework %s failed (domain %d, code %d)',
+    [Operation,ADomain,ACode]);
+end;
+
+function TUnsupportedCertificate.CreateCertificateAndKey: TCertAndKey;
+begin
+  raise ESSLSocketError.Create('Network.framework certificate generation is unsupported');
+end;
+
+function TNetworkFrameworkSocketHandler.CreateCertGenerator: TX509Certificate;
+begin
+  { The non-nil object also preserves the legacy RemoteHostName setter. }
+  Result:=TUnsupportedCertificate.Create;
+end;
+
+function TNetworkFrameworkSocketHandler.GetLastSSLErrorString: String;
+begin
+  Result:=FError;
+end;
+
+function TNetworkFrameworkSocketHandler.GetLastSSLErrorCode: Integer;
+begin
+  Result:=FErrorCode;
+end;
+
+procedure TNetworkFrameworkSocketHandler.RecordError(E: Exception);
+begin
+  SetSSLActive(False);
+  FError:=E.Message;
+  if E is ENetworkFrameworkTLS then
+    FErrorCode:=ENetworkFrameworkTLS(E).NativeCode
+  else
+    FErrorCode:=0;
+end;
+
+procedure TNetworkFrameworkSocketHandler.CheckCapabilities;
+begin
+  if not CertificateData.Certificate.Empty or
+     not CertificateData.PrivateKey.Empty or
+     not CertificateData.CertCA.Empty or
+     not CertificateData.TrustedCertificate.Empty or
+     not CertificateData.PFX.Empty or
+     (CertificateData.TrustedCertsDir<>'') or
+     (CertificateData.ALPNProtocols<>'') or
+     (CertificateData.CipherList<>'DEFAULT') or
+     (CertificateData.KeyPassword<>'') or
+     not SendHostAsSNI or (SSLType<>stAny) then
+    raise ESSLSocketError.Create('Network.framework custom credentials, trust, '+
+      'ciphers, ALPN or protocol selection are unsupported');
+end;
+
+function TNetworkFrameworkSocketHandler.CreateClientPeer(const Host: String;
+  Port: Word): TClientPeer;
+begin
+  CheckCapabilities;
+  if not NetworkFrameworkTLSAvailable then
+    raise ESSLSocketError.Create('Network.framework unavailable: '+
+      NetworkFrameworkAvailabilityError);
+  Result:=TNetworkFrameworkPeer.Create(Self,Host,Port);
+end;
+
+function TNetworkFrameworkSocketHandler.Connect: Boolean;
+begin
+  raise ESSLSocketError.Create('Network.framework requires a peer before TCP creation');
+  Result:=False;
+end;
+
+function TNetworkFrameworkSocketHandler.Accept: Boolean;
+begin
+  raise ESSLSocketError.Create('Network.framework TLS is client-only');
+  Result:=False;
+end;
+
+constructor TNetworkFrameworkPeer.Create(Handler: TNetworkFrameworkSocketHandler;
+  const Host: String; Port: Word);
+begin
+  inherited Create;
+  InitCriticalSection(FStateLock);
+  InitCriticalSection(FIOLock);
+  FLocksInitialized:=True;
+  if (Handler=Nil) or (Host='') or (Pos(#0,Host)<>0) or (Port=0) then
+    raise ESSLSocketError.Create('A handler, nonempty hostname and nonzero port are required');
+  FHost:=UTF8Encode(UnicodeString(Host));
+  FPort:=IntToStr(Port);
+  { Assign ownership last: the caller retains Handler on constructor exception. }
+  FHandler:=Handler;
+end;
+
+destructor TNetworkFrameworkPeer.Destroy;
+begin
+  if FLocksInitialized then
+    begin
+    Close;
+    { Drain the cancelled operation before freeing the handler or either lock. }
+    EnterCriticalSection(FIOLock);
+    try
+      FreeAndNil(FHandler);
+    finally
+      LeaveCriticalSection(FIOLock);
+    end;
+    DoneCriticalSection(FIOLock);
+    DoneCriticalSection(FStateLock);
+    end;
+  inherited Destroy;
+end;
+
+procedure TNetworkFrameworkPeer.SetConnectTimeout(AValue: Integer);
+begin
+  if AValue<0 then
+    raise ESSLSocketError.Create('Negative native connect timeout');
+  inherited SetConnectTimeout(AValue);
+end;
+
+procedure TNetworkFrameworkPeer.SetIOTimeout(AValue: Integer);
+begin
+  if AValue<0 then
+    raise ESSLSocketError.Create('Negative native I/O timeout');
+  inherited SetIOTimeout(AValue);
+end;
+
+function TNetworkFrameworkPeer.AcquireContext: Pointer;
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    if not FReady or (FContext=Nil) then
+      raise ESSLSocketError.Create('TLS connection is not open');
+    Result:=FContext;
+    NativeRetain(Result);
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+end;
+
+procedure TNetworkFrameworkPeer.DropContext(Context: Pointer; PeerEOF: Boolean);
+var
+  DropOwner: Boolean;
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    DropOwner:=(Context<>Nil) and (FContext=Context);
+    if DropOwner then
+      begin
+      FContext:=Nil;
+      FReady:=False;
+      FPeerEOF:=PeerEOF;
+      Inc(FGeneration);
+      FHandler.SetSSLActive(False);
+      end;
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+  if DropOwner then
+    NativeClose(Context);
+end;
+
+procedure TNetworkFrameworkPeer.Fail(Context: Pointer; const Operation: String;
+  Domain, Code: LongInt);
+begin
+  DropContext(Context);
+  raise ENetworkFrameworkTLS.CreateNative(Operation,Domain,Code);
+end;
+
+procedure TNetworkFrameworkPeer.CheckCurrent(Context: Pointer);
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    if FContext<>Context then
+      raise ESSLSocketError.Create('TLS connection was closed during the operation');
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+end;
+
+procedure TNetworkFrameworkPeer.Connect;
+var
+  Context: Pointer;
+  Generation: QWord;
+  Domain, Code: LongInt;
+  Allow, Started: Boolean;
+begin
+  Started:=False;
+  EnterCriticalSection(FIOLock);
+  try
+    try
+      EnterCriticalSection(FStateLock);
+      try
+        if FConnecting then
+          raise ESSLSocketError.Create('Reentrant TLS connect is unsupported');
+        if FReady then
+          Exit;
+        FConnecting:=True;
+        Started:=True;
+        Generation:=FGeneration;
+      finally
+        LeaveCriticalSection(FStateLock);
+      end;
+      FHandler.CheckCapabilities;
+      FHandler.FError:='';
+      FHandler.FErrorCode:=0;
+      Context:=NativeCreate(PAnsiChar(FHost),PAnsiChar(FPort),
+        Ord(FHandler.VerifyPeerCert),Domain,Code);
+      if Context=Nil then
+        raise ENetworkFrameworkTLS.CreateNative('create',Domain,Code);
+      EnterCriticalSection(FStateLock);
+      try
+        Allow:=Generation=FGeneration;
+        if Allow then
+          begin
+          FContext:=Context;
+          FPeerEOF:=False;
+          NativeRetain(Context);
+          end;
+      finally
+        LeaveCriticalSection(FStateLock);
+      end;
+      if not Allow then
+        begin
+        NativeClose(Context);
+        raise ESSLSocketError.Create('TLS connection was closed during creation');
+        end;
+      try
+        try
+          if NativeConnect(Context,ConnectTimeout,Domain,Code)<>1 then
+            Fail(Context,'connect',Domain,Code);
+          CheckCurrent(Context);
+          { System trust/hostname failure never reaches this application veto. }
+          if not FHandler.DoVerifyCert then
+            Fail(Context,'application certificate veto',0,0);
+          EnterCriticalSection(FStateLock);
+          try
+            if FContext<>Context then
+              raise ESSLSocketError.Create('TLS connection was closed by verification callback');
+            FReady:=True;
+            FHandler.SetSSLActive(True);
+          finally
+            LeaveCriticalSection(FStateLock);
+          end;
+        except
+          DropContext(Context);
+          raise;
+        end;
+      finally
+        NativeRelease(Context);
+      end;
+    except
+      on E: Exception do
+        begin
+        FHandler.RecordError(E);
+        raise;
+        end;
+    end;
+  finally
+    if Started then
+      begin
+      EnterCriticalSection(FStateLock);
+      try
+        FConnecting:=False;
+      finally
+        LeaveCriticalSection(FStateLock);
+      end;
+      end;
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+procedure TNetworkFrameworkPeer.Close;
+var
+  Context: Pointer;
+begin
+  if not FLocksInitialized then
+    Exit;
+  { Do not take FIOLock: cancellation must wake Connect/Read/Write/CanRead. }
+  EnterCriticalSection(FStateLock);
+  try
+    Context:=FContext;
+    FContext:=Nil;
+    FReady:=False;
+    FPeerEOF:=False;
+    Inc(FGeneration);
+    if Assigned(FHandler) then
+      FHandler.SetSSLActive(False);
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+  if Context<>Nil then
+    NativeClose(Context);
+end;
+
+function TNetworkFrameworkPeer.Read(var Buffer; Count: LongInt): LongInt;
+var
+  Context: Pointer;
+  Domain, Code: LongInt;
+begin
+  if Count<0 then
+    raise EStreamError.Create('Negative TLS read count');
+  if Count=0 then
+    Exit(0);
+  EnterCriticalSection(FIOLock);
+  try
+    try
+      EnterCriticalSection(FStateLock);
+      try
+        if FPeerEOF then
+          Exit(0);
+      finally
+        LeaveCriticalSection(FStateLock);
+      end;
+      Context:=AcquireContext;
+      try
+        Result:=NativeRead(Context,@Buffer,Count,IOTimeout,Domain,Code);
+        if Result<0 then
+          Fail(Context,'read',Domain,Code);
+        CheckCurrent(Context);
+        if Result=0 then
+          DropContext(Context,True);
+      finally
+        NativeRelease(Context);
+      end;
+    except
+      on E: Exception do
+        begin
+        FHandler.RecordError(E);
+        raise;
+        end;
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkPeer.Write(const Buffer; Count: LongInt): LongInt;
+var
+  Context: Pointer;
+  Domain, Code: LongInt;
+begin
+  if Count<0 then
+    raise EStreamError.Create('Negative TLS write count');
+  if Count=0 then
+    Exit(0);
+  EnterCriticalSection(FIOLock);
+  try
+    try
+      Context:=AcquireContext;
+      try
+        Result:=NativeWrite(Context,@Buffer,Count,IOTimeout,Domain,Code);
+        if Result<0 then
+          Fail(Context,'write',Domain,Code);
+        CheckCurrent(Context);
+      finally
+        NativeRelease(Context);
+      end;
+    except
+      on E: Exception do
+        begin
+        FHandler.RecordError(E);
+        raise;
+        end;
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkPeer.CanRead(Timeout: Integer): Boolean;
+var
+  Context: Pointer;
+  Domain, Code, Status: LongInt;
+  NativeTimeout: Cardinal;
+begin
+  if Timeout<0 then
+    NativeTimeout:=High(Cardinal)
+  else
+    NativeTimeout:=Timeout;
+  EnterCriticalSection(FIOLock);
+  try
+    try
+      EnterCriticalSection(FStateLock);
+      try
+        if FPeerEOF then
+          Exit(True);
+      finally
+        LeaveCriticalSection(FStateLock);
+      end;
+      Context:=AcquireContext;
+      try
+        Status:=NativeCanRead(Context,NativeTimeout,Domain,Code);
+        if Status<0 then
+          Fail(Context,'readiness',Domain,Code);
+        CheckCurrent(Context);
+        Result:=Status=1;
+      finally
+        NativeRelease(Context);
+      end;
+    except
+      on E: Exception do
+        begin
+        FHandler.RecordError(E);
+        raise;
+        end;
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkPeer.BytesAvailable: Integer;
+var
+  Context: Pointer;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+    EnterCriticalSection(FStateLock);
+    try
+      if not FReady then
+        Exit(0);
+    finally
+      LeaveCriticalSection(FStateLock);
+    end;
+    Context:=AcquireContext;
+    try
+      Result:=NativeBytesAvailable(Context);
+      CheckCurrent(Context);
+    finally
+      NativeRelease(Context);
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+initialization
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and not defined(ios) and not defined(iphonesim)}
+  TSSLSocketHandler.SetDefaultHandlerClass(TNetworkFrameworkSocketHandler);
+{$endif}
+end.
