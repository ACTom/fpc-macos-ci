diff --git a/packages/fcl-tls/src/smartsslsockets.pp b/packages/fcl-tls/src/smartsslsockets.pp
new file mode 100644
index 000000000..c7f220494
--- /dev/null
+++ b/packages/fcl-tls/src/smartsslsockets.pp
@@ -0,0 +1,233 @@
+{ Part of FCL; see COPYING.FPC. Explicit, process-lifetime TLS backend selection. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit smartsslsockets;
+{$ENDIF}
+{$mode objfpc}{$H+}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Net.SSLSockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+uses SysUtils, sslsockets, tlsbackendpolicy;
+{$ENDIF}
+type
+  TSmartTLSSelection = record
+    Backend: TSmartTLSBackend;
+    ExecutablePath, PrimaryLibrary, CryptoLibrary, LibraryVersion, Diagnostic: String;
+  end;
+{ Call before creating HTTP/socket handlers or initializing third-party loaders.
+  Auto: bundled OpenSSL, bundled GnuTLS, available platform backend. Selection
+  and failures are cached. A different option/path after the first call fails. }
+function InitializeSmartTLS(Preference: TSmartTLSBackend=stbAuto;
+  const ExecutablePath: String=''): TSmartTLSBackend;
+function SmartTLSSelection: TSmartTLSSelection;
+function CreateSmartTLSHandler: TSSLSocketHandler;
+implementation
+{$if defined(darwin) and (defined(cpux86_64) or defined(cpuaarch64)) and not defined(ios) and not defined(iphonesim)}
+  {$define FPC_SMART_NATIVE_MACOS}
+{$endif}
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Net.TLSLibraryProbe, Api.Openssl, System.Net.Opensslsockets,
+  Api.GnuTls, System.Net.Gnutlssockets
+  {$ifdef windows}, System.Net.SchannelSSLSockets{$endif}
+  {$ifdef FPC_SMART_NATIVE_MACOS}, System.Net.NetworkFrameworkSSLSockets{$endif};
+{$ELSE}
+uses tlslibraryprobe, openssl, opensslsockets, gnutls, gnutlssockets
+  {$ifdef windows}, schannelsslsockets{$endif}
+  {$ifdef FPC_SMART_NATIVE_MACOS}, networkframeworksslsockets{$endif};
+{$ENDIF}
+type
+  TSmartOpenSSLHandler = class(TOpenSSLSocketHandler)
+  protected
+    function InitContext(NeedCertificate: Boolean): Boolean; override;
+  public
+    constructor Create; override;
+  end;
+  TSmartGnuTLSHandler = class(TGNUTLSSocketHandler)
+  protected
+    procedure ConfigurePeerVerification(const HostName: AnsiString); override;
+  public
+    constructor Create; override;
+    function Connect: Boolean; override;
+  end;
+  TSelectionState = (ssNew, ssReady, ssFailed);
+var
+  SelectionLock: TRTLCriticalSection;
+  State: TSelectionState;
+  Requested: TSmartTLSBackend;
+  Selected: TSmartTLSSelection;
+  HandlerClass: TSSLSocketHandlerClass;
+
+constructor TSmartOpenSSLHandler.Create;
+begin
+  if not IsSSLLoaded then raise ESmartTLS.Create('Selected OpenSSL interface was destroyed');
+  inherited Create;
+end;
+
+function TSmartOpenSSLHandler.InitContext(NeedCertificate: Boolean): Boolean;
+begin
+  if not IsSSLLoaded then raise ESmartTLS.Create('Selected OpenSSL interface was destroyed');
+  Result:=inherited InitContext(NeedCertificate);
+end;
+
+constructor TSmartGnuTLSHandler.Create;
+begin
+  if not GnuTLSLoaded then raise ESmartTLS.Create('Selected GnuTLS interface was freed');
+  inherited Create;
+end;
+
+function TSmartGnuTLSHandler.Connect: Boolean;
+begin
+  if not GnuTLSLoaded then raise ESmartTLS.Create('Selected GnuTLS interface was freed');
+  Result:=inherited Connect;
+end;
+
+procedure TSmartGnuTLSHandler.ConfigurePeerVerification(const HostName: AnsiString);
+begin
+  { The explicit GnuTLS backend keeps its existing setup. Only this adapter
+    refrains from automatic handshake verification when False was requested. }
+  if VerifyPeerCert then inherited ConfigurePeerVerification(HostName);
+end;
+
+procedure SelectExternal(const LibraryInfo: TSmartTLSLibrary);
+var Probe: TLoadedTLSProbe; Info: TSmartTLSLibrary;
+begin
+  if ((LibraryInfo.Backend=stbOpenSSL) and IsSSLLoaded) or
+    ((LibraryInfo.Backend=stbGnuTLS) and GnuTLSLoaded) then
+    raise ESmartTLS.Create('Selected TLS loader was initialized earlier; initialize smart TLS first');
+  Probe:=TLoadedTLSProbe.Create(LibraryInfo);
+  try
+    Info:=Probe.Info;
+    if Info.Backend=stbOpenSSL then
+      begin
+      if not InitSSLInterfaceIfUnloaded(Info.PrimaryPath,Info.CryptoPath) then
+        raise ESmartTLS.Create('OpenSSL initialization failed or another caller initialized it first');
+      HandlerClass:=TSmartOpenSSLHandler;
+      end
+    else
+      begin
+      if not LoadGnuTLSIfUnloaded(Info.PrimaryPath) then
+        raise ESmartTLS.Create('GnuTLS initialization failed or another caller initialized it first');
+      HandlerClass:=TSmartGnuTLSHandler;
+      end;
+    Selected.Backend:=Info.Backend;
+    Selected.PrimaryLibrary:=Info.PrimaryPath;
+    Selected.CryptoLibrary:=Info.CryptoPath;
+    Selected.LibraryVersion:=Info.Version;
+  finally
+    Probe.Free;
+  end;
+end;
+
+procedure SelectNative(Backend: TSmartTLSBackend);
+begin
+  case Backend of
+    stbSchannel:
+      begin
+{$ifdef windows}
+      HandlerClass:=TSchannelSocketHandler;
+{$else}
+      raise ESmartTLS.Create('Schannel requires Windows');
+{$endif}
+      end;
+    stbNetworkFramework:
+      begin
+{$ifdef FPC_SMART_NATIVE_MACOS}
+      if not NetworkFrameworkTLSAvailable then
+        raise ESmartTLS.Create('Network.framework system APIs are unavailable');
+      HandlerClass:=TNetworkFrameworkSocketHandler;
+{$else}
+      raise ESmartTLS.Create('Network.framework requires macOS x86_64 or arm64');
+{$endif}
+      end;
+    else raise ESmartTLS.Create('No platform TLS backend is available');
+  end;
+  Selected.Backend:=Backend;
+  Selected.LibraryVersion:='system';
+end;
+
+function InitializeSmartTLS(Preference: TSmartTLSBackend;
+  const ExecutablePath: String): TSmartTLSBackend;
+var Path: String; Info: TSmartTLSLibrary;
+begin
+  EnterCriticalSection(SelectionLock);
+  try
+    if ExecutablePath='' then Path:=SmartTLSExecutablePath
+    else Path:=CanonicalTLSPath(ExecutablePath);
+    if State<>ssNew then
+      begin
+      if (Preference<>Requested) or not SameTLSPath(Path,Selected.ExecutablePath) then
+        raise ESmartTLS.Create('Smart TLS selection is immutable; option/application path differs');
+      if State=ssFailed then raise ESmartTLS.Create(Selected.Diagnostic);
+      Exit(Selected.Backend);
+      end;
+    Requested:=Preference;
+    Selected.ExecutablePath:=Path;
+    try
+      case Preference of
+        stbOpenSSL,stbGnuTLS:
+          begin
+          if not FindBundledTLSLibrary(Path,Preference,Info) then
+            raise ESmartTLS.Create('Requested bundled '+SmartTLSBackendName(Preference)+' is absent');
+          SelectExternal(Info);
+          end;
+        stbSchannel,stbNetworkFramework: SelectNative(Preference);
+        stbAuto:
+          if FindBundledTLSLibrary(Path,stbOpenSSL,Info) then SelectExternal(Info)
+          else if FindBundledTLSLibrary(Path,stbGnuTLS,Info) then SelectExternal(Info)
+          else
+            begin
+{$ifdef windows}
+            SelectNative(stbSchannel);
+{$elseif defined(FPC_SMART_NATIVE_MACOS)}
+            SelectNative(stbNetworkFramework);
+{$else}
+            raise ESmartTLS.Create('No bundled TLS library or native backend is available');
+{$endif}
+            end;
+        else raise ESmartTLS.Create('Invalid smart TLS preference');
+      end;
+      TSSLSocketHandler.SetDefaultHandlerClass(HandlerClass);
+      Selected.Diagnostic:='Selected '+SmartTLSBackendName(Selected.Backend);
+      State:=ssReady;
+      Result:=Selected.Backend;
+    except
+      on E: Exception do
+        begin
+        HandlerClass:=nil;
+        Selected.Backend:=stbUnselected;
+        Selected.Diagnostic:=E.Message;
+        State:=ssFailed;
+        raise;
+        end;
+    end;
+  finally
+    LeaveCriticalSection(SelectionLock);
+  end;
+end;
+
+function SmartTLSSelection: TSmartTLSSelection;
+begin
+  EnterCriticalSection(SelectionLock);
+  try Result:=Selected finally LeaveCriticalSection(SelectionLock) end;
+end;
+
+function CreateSmartTLSHandler: TSSLSocketHandler;
+var C: TSSLSocketHandlerClass;
+begin
+  EnterCriticalSection(SelectionLock);
+  try
+    if State<>ssReady then raise ESmartTLS.Create('Call InitializeSmartTLS before creating handlers');
+    C:=HandlerClass;
+  finally
+    LeaveCriticalSection(SelectionLock);
+  end;
+  Result:=C.Create;
+end;
+
+initialization
+  InitCriticalSection(SelectionLock);
+  { Backend units register their legacy defaults while initializing. Requiring
+    this unit's explicit initialization prevents their uses order deciding TLS. }
+  TSSLSocketHandler.SetDefaultHandlerClass(nil);
+{ No reset/unload/finalization ownership: selected loaders retain normal policy. }
+end.
diff --git a/packages/fcl-tls/src/tlsbackendpolicy.pp b/packages/fcl-tls/src/tlsbackendpolicy.pp
new file mode 100644
index 000000000..7d23e2ebc
--- /dev/null
+++ b/packages/fcl-tls/src/tlsbackendpolicy.pp
@@ -0,0 +1,275 @@
+{ Part of FCL; see COPYING.FPC. Deterministic application-local TLS candidates. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit tlsbackendpolicy;
+{$ENDIF}
+{$mode objfpc}{$H+}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Classes;
+{$ELSE}
+uses SysUtils, Classes;
+{$ENDIF}
+type
+  ESmartTLS = class(Exception);
+  TSmartTLSBackend = (stbUnselected, stbAuto, stbOpenSSL, stbGnuTLS,
+    stbSchannel, stbNetworkFramework);
+  TSmartTLSLibrary = record
+    Backend: TSmartTLSBackend;
+    PrimaryPath, CryptoPath: String;
+    ExpectedMajor: Integer;
+    Version: String;
+  end;
+function SmartTLSBackendName(Backend: TSmartTLSBackend): String;
+function SmartTLSExecutablePath: String;
+function CanonicalTLSPath(const Path: String): String;
+function SameTLSPath(const A, B: String): Boolean;
+function FindBundledTLSLibrary(const ExecutablePath: String;
+  Backend: TSmartTLSBackend; out LibraryInfo: TSmartTLSLibrary): Boolean;
+implementation
+{$IFDEF FPC_DOTTEDUNITS}
+uses {$ifdef windows}WinApi.Windows{$else}UnixApi.Base{$endif};
+{$ELSE}
+uses {$ifdef windows}Windows{$else}BaseUnix{$endif};
+{$ENDIF}
+{$ifdef unix}
+function TLSRealPath(Path, Buffer: PAnsiChar): PAnsiChar; cdecl;
+  external name 'realpath';
+{$endif}
+{$ifdef darwin}
+function TLSNSExecutablePath(Buffer: PAnsiChar; var Size: LongWord): LongInt;
+  cdecl; external name '_NSGetExecutablePath';
+{$endif}
+
+function SmartTLSBackendName(Backend: TSmartTLSBackend): String;
+const Names: array[TSmartTLSBackend] of String = ('unselected','auto','openssl',
+  'gnutls','schannel','networkframework');
+begin
+  Result:=Names[Backend];
+end;
+
+function AbsolutePath(const Path: String): Boolean;
+begin
+{$ifdef windows}
+  Result:=((Length(Path)>=3) and (Path[2]=':') and (Path[3] in ['\','/'])) or
+    ((Length(Path)>=2) and (Path[1]='\') and (Path[2]='\'));
+{$else}
+  Result:=(Path<>'') and (Path[1]='/');
+{$endif}
+end;
+
+function CanonicalTLSPath(const Path: String): String;
+{$ifdef unix}var Buffer: array[0..4095] of AnsiChar;{$endif}
+{$ifdef windows}
+type TFinalPath = function(FileHandle: THandle; Buffer: PWideChar;
+    BufferSize, Flags: LongWord): LongWord; stdcall;
+var FinalPath: TFinalPath; Handle: THandle; WidePath,Buffer: UnicodeString;
+    Count: LongWord; Ancestor,Parent: String;
+{$endif}
+begin
+  if not AbsolutePath(Path) then
+    raise ESmartTLS.Create('TLS application/library paths must be absolute: '+Path);
+{$ifdef unix}
+  if TLSRealPath(PAnsiChar(Path),@Buffer[0])=nil then
+    raise ESmartTLS.Create('Cannot resolve TLS application/library path: '+Path);
+  Result:=StrPas(@Buffer[0]);
+{$else}
+  Result:=ExpandFileName(Path);
+  WidePath:=UnicodeString(Result);
+  Handle:=CreateFileW(PWideChar(WidePath),FILE_READ_ATTRIBUTES,
+    FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,nil,OPEN_EXISTING,
+    FILE_FLAG_BACKUP_SEMANTICS,0);
+  if Handle=INVALID_HANDLE_VALUE then
+    raise ESmartTLS.Create('Cannot resolve TLS application/library path: '+Path);
+  try
+    Pointer(FinalPath):=GetProcAddress(GetModuleHandle('kernel32.dll'),'GetFinalPathNameByHandleW');
+    if Assigned(FinalPath) then
+      begin
+      Count:=FinalPath(Handle,nil,0,0);
+      if Count=0 then raise ESmartTLS.Create('Cannot resolve final TLS path: '+Path);
+      SetLength(Buffer,Count);
+      Count:=FinalPath(Handle,PWideChar(Buffer),Length(Buffer),0);
+      if (Count=0) or (Count>=LongWord(Length(Buffer))) then
+        raise ESmartTLS.Create('Cannot resolve final TLS path: '+Path);
+      SetLength(Buffer,Count);
+      if Copy(Buffer,1,8)='\\?\UNC\' then Buffer:='\\'+Copy(Buffer,9,Length(Buffer))
+      else if Copy(Buffer,1,4)='\\?\' then Delete(Buffer,1,4);
+      Result:=String(Buffer);
+      end
+    else
+      begin
+      { Older Windows: ordinary paths remain usable. Fail explicitly when a
+        reparse point cannot be resolved with the available system APIs. }
+      Ancestor:=Result;
+      repeat
+        if (FileGetAttr(Ancestor) and FILE_ATTRIBUTE_REPARSE_POINT)<>0 then
+          raise ESmartTLS.Create('Cannot resolve TLS reparse path on this Windows version: '+Path);
+        Parent:=ExtractFileDir(Ancestor);
+        if SameText(Parent,Ancestor) or (Parent='') then Break;
+        Ancestor:=Parent;
+      until False;
+      end;
+  finally
+    CloseHandle(Handle);
+  end;
+{$endif}
+end;
+
+function SameTLSPath(const A, B: String): Boolean;
+begin
+{$ifdef windows}
+  Result:=SameText(A,B);
+{$else}
+  Result:=A=B;
+{$endif}
+end;
+
+function SmartTLSExecutablePath: String;
+{$ifdef darwin}
+var Buffer: array[0..4095] of AnsiChar; Size: LongWord;
+{$endif}
+begin
+{$ifdef windows}
+  Result:=GetModuleName(0);
+{$elseif defined(darwin)}
+  Size:=SizeOf(Buffer);
+  if TLSNSExecutablePath(@Buffer[0],Size)<>0 then
+    raise ESmartTLS.Create('Cannot obtain absolute application executable path');
+  Result:=StrPas(@Buffer[0]);
+{$elseif defined(linux)}
+  Result:=fpReadLink('/proc/self/exe');
+{$else}
+  raise ESmartTLS.Create('Supply an absolute executable path on this platform');
+{$endif}
+  Result:=CanonicalTLSPath(Result);
+end;
+
+function PathPresent(const Path: String): Boolean;
+{$ifdef unix}var Info: Stat;{$endif}
+begin
+{$ifdef unix}
+  Result:=fpLStat(Path,Info)=0;
+{$else}
+  Result:=FileGetAttr(Path)<>-1;
+{$endif}
+end;
+
+function BundledFile(const Path, AppRoot: String): String;
+var Prefix: String;
+begin
+  if not FileExists(Path) or DirectoryExists(Path) then
+    raise ESmartTLS.Create('Bundled TLS library is not a readable regular file: '+Path);
+  Result:=CanonicalTLSPath(Path);
+  Prefix:=IncludeTrailingPathDelimiter(CanonicalTLSPath(AppRoot));
+{$ifdef windows}
+  if not SameText(Copy(Result,1,Length(Prefix)),Prefix) then
+{$else}
+  if Copy(Result,1,Length(Prefix))<>Prefix then
+{$endif}
+    raise ESmartTLS.Create('Bundled TLS library resolves outside the application: '+Path);
+end;
+
+procedure ApplicationRoots(const ExecutablePath: String; Roots: TStrings;
+  out AppRoot: String);
+var ExeDir: String;
+begin
+  if not FileExists(ExecutablePath) then
+    raise ESmartTLS.Create('Application executable path does not exist: '+ExecutablePath);
+  ExeDir:=ExtractFileDir(CanonicalTLSPath(ExecutablePath));
+  AppRoot:=ExeDir;
+  Roots.Add(ExeDir);
+{$ifdef darwin}
+  if (ExtractFileName(ExeDir)='MacOS') and
+     (ExtractFileName(ExtractFileDir(ExeDir))='Contents') and
+     (ExtractFileExt(ExtractFileDir(ExtractFileDir(ExeDir)))='.app') then
+    begin
+    AppRoot:=ExtractFileDir(ExeDir);
+    Roots.Add(AppRoot+'/Frameworks');
+    Roots.Add(AppRoot+'/lib');
+    end;
+{$endif}
+  Roots.Add(ExeDir+DirectorySeparator+'lib');
+end;
+
+function FindBundledTLSLibrary(const ExecutablePath: String;
+  Backend: TSmartTLSBackend; out LibraryInfo: TSmartTLSLibrary): Boolean;
+var Roots: TStringList; AppRoot, Root: String; I: Integer;
+
+  function Pair(const SSLName, CryptoName: String; Major: Integer): Boolean;
+  var S,C: String; HasS,HasC: Boolean;
+  begin
+    S:=IncludeTrailingPathDelimiter(Root)+SSLName;
+    C:=IncludeTrailingPathDelimiter(Root)+CryptoName;
+    HasS:=PathPresent(S); HasC:=PathPresent(C);
+    Result:=HasS or HasC;
+    if not Result then Exit;
+    if not (HasS and HasC) then
+      raise ESmartTLS.Create('Incomplete bundled OpenSSL pair: '+S+' ; '+C);
+    LibraryInfo.PrimaryPath:=BundledFile(S,AppRoot);
+    LibraryInfo.CryptoPath:=BundledFile(C,AppRoot);
+    LibraryInfo.ExpectedMajor:=Major;
+  end;
+
+  function Single(const Name: String): Boolean;
+  var P: String;
+  begin
+    P:=IncludeTrailingPathDelimiter(Root)+Name;
+    Result:=PathPresent(P);
+    if Result then LibraryInfo.PrimaryPath:=BundledFile(P,AppRoot);
+  end;
+
+begin
+  LibraryInfo:=Default(TSmartTLSLibrary);
+  LibraryInfo.Backend:=Backend;
+  if not (Backend in [stbOpenSSL,stbGnuTLS]) then
+    raise ESmartTLS.Create('Bundled library search requires OpenSSL or GnuTLS');
+  Roots:=TStringList.Create;
+  try
+    ApplicationRoots(ExecutablePath,Roots,AppRoot);
+    for I:=0 to Roots.Count-1 do
+      begin
+      Root:=Roots[I];
+      if Backend=stbOpenSSL then
+        begin
+{$ifdef windows}
+{$ifdef cpux86_64}
+        if Pair('libssl-3-x64.dll','libcrypto-3-x64.dll',3) then Exit(True);
+{$elseif defined(cpuaarch64)}
+        if Pair('libssl-3-arm64.dll','libcrypto-3-arm64.dll',3) then Exit(True);
+{$endif}
+        if Pair('libssl-3.dll','libcrypto-3.dll',3) then Exit(True);
+{$ifdef cpux86_64}
+        if Pair('libssl-1_1-x64.dll','libcrypto-1_1-x64.dll',1) then Exit(True);
+{$endif}
+        if Pair('libssl-1_1.dll','libcrypto-1_1.dll',1) then Exit(True);
+        if Pair('libssl.dll','libcrypto.dll',0) then Exit(True);
+        if Pair('ssleay32.dll','libeay32.dll',1) then Exit(True);
+{$elseif defined(darwin)}
+        if Pair('libssl.3.dylib','libcrypto.3.dylib',3) then Exit(True);
+        if Pair('libssl.1.1.dylib','libcrypto.1.1.dylib',1) then Exit(True);
+        if Pair('libssl.dylib','libcrypto.dylib',0) then Exit(True);
+{$else}
+        if Pair('libssl.so.3','libcrypto.so.3',3) then Exit(True);
+        if Pair('libssl.so.1.1','libcrypto.so.1.1',1) then Exit(True);
+        if Pair('libssl.so','libcrypto.so',0) then Exit(True);
+{$endif}
+        end
+      else
+        begin
+{$ifdef windows}
+        if Single('libgnutls-30.dll') then Exit(True);
+        if Single('libgnutls.dll') then Exit(True);
+{$elseif defined(darwin)}
+        if Single('libgnutls.30.dylib') then Exit(True);
+        if Single('libgnutls.dylib') then Exit(True);
+{$else}
+        if Single('libgnutls.so.30') then Exit(True);
+        if Single('libgnutls.so') then Exit(True);
+{$endif}
+        end;
+      end;
+    Result:=False;
+  finally
+    Roots.Free;
+  end;
+end;
+end.
diff --git a/packages/fcl-tls/src/tlslibraryprobe.pp b/packages/fcl-tls/src/tlslibraryprobe.pp
new file mode 100644
index 000000000..bd2758daa
--- /dev/null
+++ b/packages/fcl-tls/src/tlslibraryprobe.pp
@@ -0,0 +1,340 @@
+{ Part of FCL; see COPYING.FPC. Validate bundled native images and TLS entry points. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit tlslibraryprobe;
+{$ENDIF}
+{$mode objfpc}{$H+}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Classes, System.CTypes, System.DynLibs,
+  System.Net.TLSBackendPolicy;
+{$ELSE}
+uses SysUtils, Classes, ctypes, DynLibs, tlsbackendpolicy;
+{$ENDIF}
+type
+  TLoadedTLSProbe = class
+  private
+    FPrimary, FCrypto: TLibHandle;
+    FInfo: TSmartTLSLibrary;
+  public
+    constructor Create(const LibraryInfo: TSmartTLSLibrary);
+    destructor Destroy; override;
+    property Info: TSmartTLSLibrary read FInfo;
+  end;
+procedure RequireTLSLibraryImage(const Path: String; CryptoImports: TStrings=nil);
+implementation
+{$ifdef windows}
+{$IFDEF FPC_DOTTEDUNITS}uses WinApi.Windows;{$ELSE}uses Windows;{$ENDIF}
+{$else}
+{$IFDEF FPC_DOTTEDUNITS}uses UnixApi.Dl;{$ELSE}uses dl;{$ENDIF}
+{$endif}
+type
+  TBytesBuffer = array of Byte;
+  TImageReader = class
+    Stream: TFileStream;
+    Path: String;
+    constructor Create(const APath: String);
+    destructor Destroy; override;
+    function ReadAt(Offset: QWord; Count: Integer): TBytesBuffer;
+    procedure Check(CryptoImports: TStrings);
+  end;
+
+function U16(const B: TBytesBuffer; I: Integer): Word;
+begin
+  if (I<0) or (I+2>Length(B)) then raise ESmartTLS.Create('Truncated library header');
+  Result:=B[I] or (Word(B[I+1]) shl 8);
+end;
+
+function U32(const B: TBytesBuffer; I: Integer; Big: Boolean=False): LongWord;
+begin
+  if (I<0) or (I+4>Length(B)) then raise ESmartTLS.Create('Truncated library header');
+  if Big then Result:=(LongWord(B[I]) shl 24) or (LongWord(B[I+1]) shl 16) or
+    (LongWord(B[I+2]) shl 8) or B[I+3]
+  else Result:=B[I] or (LongWord(B[I+1]) shl 8) or (LongWord(B[I+2]) shl 16) or
+    (LongWord(B[I+3]) shl 24);
+end;
+
+function U64(const B: TBytesBuffer; I: Integer; Big: Boolean): QWord;
+begin
+  if Big then Result:=(QWord(U32(B,I,True)) shl 32) or U32(B,I+4,True)
+  else Result:=U32(B,I) or (QWord(U32(B,I+4)) shl 32);
+end;
+
+constructor TImageReader.Create(const APath: String);
+begin
+  inherited Create;
+  Path:=APath;
+  Stream:=TFileStream.Create(Path,fmOpenRead or fmShareDenyWrite);
+end;
+
+destructor TImageReader.Destroy;
+begin
+  Stream.Free;
+  inherited Destroy;
+end;
+
+function TImageReader.ReadAt(Offset: QWord; Count: Integer): TBytesBuffer;
+begin
+  if (Count<0) or (Offset>QWord(Stream.Size)) or
+    (QWord(Count)>QWord(Stream.Size)-Offset) then
+    raise ESmartTLS.Create('Truncated or invalid TLS library: '+Path);
+  SetLength(Result,Count);
+  Stream.Position:=Offset;
+  if Count>0 then Stream.ReadBuffer(Result[0],Count);
+end;
+
+procedure TImageReader.Check(CryptoImports: TStrings);
+var B,H,S,D,N: TBytesBuffer; CPU,Magic,Count,EntrySize: LongWord;
+    I,J,Sections,OptionalSize: Integer; Posn,SliceOffset,SliceSize: QWord;
+    SectionOffset,ImportRVA,NameRVA,VA,Raw,Span: LongWord;
+    Big,Fat64,Found: Boolean; Name: String;
+
+  function RVAOffset(RVA: LongWord): QWord;
+  var K: Integer;
+  begin
+    for K:=0 to Sections-1 do
+      begin
+      VA:=U32(S,K*40+12); Raw:=U32(S,K*40+20);
+      Span:=U32(S,K*40+16);
+      if (RVA>=VA) and (QWord(RVA)-VA<Span) then
+        Exit(QWord(Raw)+RVA-VA);
+      end;
+    raise ESmartTLS.Create('Invalid PE import address: '+Path);
+  end;
+
+  procedure CheckMach(Offset,Size: QWord);
+  var Header: TBytesBuffer; M,C: LongWord; Be,Is64: Boolean;
+  begin
+    if Size<32 then raise ESmartTLS.Create('Truncated Mach-O slice: '+Path);
+    Header:=ReadAt(Offset,32); M:=U32(Header,0);
+    Be:=(M=$CEFAEDFE) or (M=$CFFAEDFE);
+    Is64:=(M=$FEEDFACF) or (M=$CFFAEDFE);
+    if (M<>$FEEDFACE) and (M<>$FEEDFACF) and (M<>$CEFAEDFE) and (M<>$CFFAEDFE) then
+      raise ESmartTLS.Create('Invalid Mach-O library: '+Path);
+    C:=U32(Header,4,Be);
+    if (C<>CPU) or (Is64<>(SizeOf(Pointer)=8)) or (U32(Header,12,Be)<>6) then
+      raise ESmartTLS.Create('TLS library architecture/type mismatch: '+Path);
+  end;
+
+begin
+  B:=ReadAt(0,64);
+{$ifdef windows}
+{$ifdef cpux86_64}CPU:=$8664;{$elseif defined(cpuaarch64)}CPU:=$AA64;{$else}CPU:=$14C;{$endif}
+  if U16(B,0)<>$5A4D then raise ESmartTLS.Create('Expected a Windows TLS DLL: '+Path);
+  Posn:=U32(B,60); H:=ReadAt(Posn,24);
+  if (U32(H,0)<>$4550) or (U16(H,4)<>CPU) or ((U16(H,22) and $2000)=0) then
+    raise ESmartTLS.Create('TLS DLL architecture/type mismatch: '+Path);
+  Sections:=U16(H,6); OptionalSize:=U16(H,20);
+  if (Sections<1) or (Sections>96) or (OptionalSize<104) then
+    raise ESmartTLS.Create('Invalid PE library headers: '+Path);
+  H:=ReadAt(Posn+24,OptionalSize);
+  if SizeOf(Pointer)=8 then
+    begin
+    if U16(H,0)<>$20B then raise ESmartTLS.Create('Expected a 64-bit TLS DLL: '+Path);
+    SectionOffset:=120;
+    end
+  else
+    begin
+    if U16(H,0)<>$10B then raise ESmartTLS.Create('Expected a 32-bit TLS DLL: '+Path);
+    SectionOffset:=104;
+    end;
+  if CryptoImports=nil then Exit;
+  ImportRVA:=U32(H,SectionOffset);
+  if ImportRVA=0 then Exit;
+  S:=ReadAt(Posn+24+OptionalSize,Sections*40);
+  Posn:=RVAOffset(ImportRVA);
+  for I:=0 to 255 do
+    begin
+    D:=ReadAt(Posn+QWord(I)*20,20); NameRVA:=U32(D,12);
+    if NameRVA=0 then Exit;
+    Name:=''; SliceOffset:=RVAOffset(NameRVA);
+    for J:=0 to 255 do
+      begin
+      N:=ReadAt(SliceOffset+QWord(J),1);
+      if N[0]=0 then Break;
+      Name:=Name+Chr(N[0]);
+      end;
+    if J=255 then raise ESmartTLS.Create('Invalid PE import name: '+Path);
+    if (Pos('crypto',LowerCase(Name))>0) or SameText(Name,'libeay32.dll') then
+      CryptoImports.Add(Name);
+    end;
+  raise ESmartTLS.Create('Invalid PE import table: '+Path);
+{$elseif defined(darwin)}
+{$ifdef cpux86_64}CPU:=$01000007;{$elseif defined(cpuaarch64)}CPU:=$0100000C;{$else}CPU:=7;{$endif}
+  Magic:=U32(B,0);
+  if (Magic=$BEBAFECA) or (Magic=$BFBAFECA) or (Magic=$CAFEBABE) or (Magic=$CAFEBABF) then
+    begin
+    Big:=(Magic=$BEBAFECA) or (Magic=$BFBAFECA);
+    Fat64:=(Magic=$BFBAFECA) or (Magic=$CAFEBABF);
+    Count:=U32(B,4,Big);
+    if (Count=0) or (Count>64) then raise ESmartTLS.Create('Invalid fat Mach-O library: '+Path);
+    if Fat64 then EntrySize:=32 else EntrySize:=20;
+    Found:=False;
+    for I:=0 to Count-1 do
+      begin
+      H:=ReadAt(8+QWord(I)*EntrySize,EntrySize);
+      if U32(H,0,Big)=CPU then
+        begin
+        if Fat64 then
+          begin SliceOffset:=U64(H,8,Big); SliceSize:=U64(H,16,Big) end
+        else
+          begin SliceOffset:=U32(H,8,Big); SliceSize:=U32(H,12,Big) end;
+        if (SliceOffset>QWord(Stream.Size)) or (SliceSize>QWord(Stream.Size)-SliceOffset) then
+          raise ESmartTLS.Create('Invalid fat Mach-O slice bounds: '+Path);
+        CheckMach(SliceOffset,SliceSize); Found:=True; Break;
+        end;
+      end;
+    if not Found then raise ESmartTLS.Create('TLS library has no matching Mach-O slice: '+Path);
+    end
+  else CheckMach(0,Stream.Size);
+{$else}
+{$ifdef cpux86_64}CPU:=62;{$elseif defined(cpuaarch64)}CPU:=183;{$else}CPU:=3;{$endif}
+  if (U32(B,0)<>$464C457F) or (B[5]<>1) or
+    (B[4]<>1+Ord(SizeOf(Pointer)=8)) or (U16(B,16)<>3) or (U16(B,18)<>CPU) then
+    raise ESmartTLS.Create('TLS library ELF architecture/type mismatch: '+Path);
+{$endif}
+end;
+
+procedure RequireTLSLibraryImage(const Path: String; CryptoImports: TStrings);
+var Image: TImageReader;
+begin
+  Image:=TImageReader.Create(Path);
+  try Image.Check(CryptoImports) finally Image.Free end;
+end;
+
+function RequiredProc(Handle: TLibHandle; const Name, Path: String): Pointer;
+begin
+  Result:=GetProcedureAddress(Handle,Name);
+  if Result=nil then raise ESmartTLS.Create('Missing required TLS symbol '+Name+' in '+Path);
+end;
+
+procedure RequireProcs(Handle: TLibHandle; const Path: String; const Names: array of String);
+var I: Integer;
+begin
+  for I:=Low(Names) to High(Names) do RequiredProc(Handle,Names[I],Path);
+end;
+
+function AddressPath(Address: Pointer): String;
+{$ifdef unix}var Info: dl_info;{$endif}
+begin
+{$ifdef unix}
+  FillChar(Info,SizeOf(Info),0);
+  if (dladdr(Address,@Info)=0) or (Info.dli_fname=nil) then
+    raise ESmartTLS.Create('Cannot identify TLS symbol module');
+  Result:=CanonicalTLSPath(StrPas(Info.dli_fname));
+{$else}
+  Result:='';
+{$endif}
+end;
+
+function ProbeLoadLibrary(const Path: String): TLibHandle;
+begin
+{$IFDEF FPC_DOTTEDUNITS}
+  Result:=System.DynLibs.LoadLibrary(Path);
+{$ELSE}
+  Result:=DynLibs.LoadLibrary(Path);
+{$ENDIF}
+end;
+
+procedure ProbeUnloadLibrary(Handle: TLibHandle);
+begin
+{$IFDEF FPC_DOTTEDUNITS}
+  System.DynLibs.UnloadLibrary(Handle);
+{$ELSE}
+  DynLibs.UnloadLibrary(Handle);
+{$ENDIF}
+end;
+
+constructor TLoadedTLSProbe.Create(const LibraryInfo: TSmartTLSLibrary);
+type TVersion = function: culong; cdecl;
+     TGnuVersion = function(Minimum: PAnsiChar): PAnsiChar; cdecl;
+var Imports: TStringList; Version: QWord; VersionProc: TVersion;
+    GnuVersion: TGnuVersion; Text: PAnsiChar; I: Integer; Match: Boolean;
+begin
+  inherited Create;
+  FInfo:=LibraryInfo;
+  Imports:=TStringList.Create;
+  try
+    RequireTLSLibraryImage(FInfo.PrimaryPath,Imports);
+    if FInfo.Backend=stbOpenSSL then
+      begin
+      RequireTLSLibraryImage(FInfo.CryptoPath);
+{$ifdef windows}
+      Match:=False;
+      for I:=0 to Imports.Count-1 do
+        if SameText(Imports[I],ExtractFileName(FInfo.CryptoPath)) then Match:=True;
+      if not Match or (Imports.Count<>1) then
+        raise ESmartTLS.Create('Bundled OpenSSL SSL/crypto import pair mismatch: '+FInfo.PrimaryPath);
+{$endif}
+      FCrypto:=ProbeLoadLibrary(FInfo.CryptoPath);
+      if FCrypto=NilHandle then raise ESmartTLS.Create('Cannot load bundled crypto library: '+FInfo.CryptoPath);
+      RequireProcs(FCrypto,FInfo.CryptoPath,['OpenSSL_version_num','OPENSSL_init_crypto',
+        'ERR_get_error','ERR_error_string_n','X509_free','BIO_new','BIO_free',
+        'BIO_new_file','BIO_ctrl','PEM_read_bio_X509','PEM_read_bio_PrivateKey']);
+      Pointer(VersionProc):=RequiredProc(FCrypto,'OpenSSL_version_num',FInfo.CryptoPath);
+      Version:=VersionProc();
+      if (Version<$10101000) or not ((Version shr 28) in [1,3]) or
+        ((FInfo.ExpectedMajor<>0) and ((Version shr 28)<>QWord(FInfo.ExpectedMajor))) then
+        raise ESmartTLS.Create('Unsupported or mismatched bundled OpenSSL version: '+IntToHex(Version,8));
+      FInfo.Version:='OpenSSL 0x'+IntToHex(Version,8);
+      FPrimary:=ProbeLoadLibrary(FInfo.PrimaryPath);
+      if FPrimary=NilHandle then raise ESmartTLS.Create('Cannot load bundled SSL library: '+FInfo.PrimaryPath);
+      RequireProcs(FPrimary,FInfo.PrimaryPath,['OPENSSL_init_ssl','TLS_method',
+        'SSL_CTX_new','SSL_CTX_free','SSL_new','SSL_free','SSL_set_fd','SSL_ctrl',
+        'SSL_connect','SSL_accept','SSL_shutdown','SSL_read','SSL_write','SSL_pending',
+        'SSL_get_error','SSL_get_verify_result','SSL_set1_host','SSL_CTX_set_verify',
+        'SSL_CTX_ctrl','SSL_CTX_set_cipher_list','SSL_CTX_set_default_passwd_cb',
+        'SSL_CTX_set_default_passwd_cb_userdata',
+        'SSL_CTX_set_default_verify_paths','SSL_CTX_load_verify_locations',
+        'SSL_CTX_use_certificate','SSL_CTX_use_PrivateKey','SSL_CTX_check_private_key']);
+      if (GetProcedureAddress(FPrimary,'SSL_get_peer_certificate')=nil) and
+        (GetProcedureAddress(FPrimary,'SSL_get1_peer_certificate')=nil) then
+        raise ESmartTLS.Create('Bundled SSL library lacks peer certificate access');
+{$ifdef windows}
+      if not SameTLSPath(CanonicalTLSPath(GetModuleName(FPrimary)),FInfo.PrimaryPath) or
+        not SameTLSPath(CanonicalTLSPath(GetModuleName(FCrypto)),FInfo.CryptoPath) or
+        not SameTLSPath(CanonicalTLSPath(GetModuleName(GetModuleHandle(PChar(ExtractFileName(FInfo.CryptoPath))))),FInfo.CryptoPath) then
+        raise ESmartTLS.Create('Bundled OpenSSL resolved to a different loaded module');
+{$else}
+      if not SameTLSPath(AddressPath(RequiredProc(FPrimary,'OPENSSL_init_ssl',FInfo.PrimaryPath)),FInfo.PrimaryPath) or
+        not SameTLSPath(AddressPath(RequiredProc(FPrimary,'OpenSSL_version_num',FInfo.PrimaryPath)),FInfo.CryptoPath) then
+        raise ESmartTLS.Create('Bundled OpenSSL SSL/crypto dependency resolves outside the selected pair');
+{$endif}
+      end
+    else
+      begin
+      FPrimary:=ProbeLoadLibrary(FInfo.PrimaryPath);
+      if FPrimary=NilHandle then raise ESmartTLS.Create('Cannot load bundled GnuTLS library: '+FInfo.PrimaryPath);
+      RequireProcs(FPrimary,FInfo.PrimaryPath,['gnutls_check_version','gnutls_init',
+        'gnutls_deinit','gnutls_bye','gnutls_handshake','gnutls_handshake_set_timeout',
+        'gnutls_error_is_fatal','gnutls_strerror','gnutls_priority_set_direct',
+        'gnutls_certificate_allocate_credentials','gnutls_certificate_free_credentials',
+        'gnutls_credentials_set','gnutls_certificate_set_x509_system_trust',
+        'gnutls_certificate_set_x509_trust_file','gnutls_certificate_set_x509_trust_mem',
+        'gnutls_certificate_set_x509_trust_dir','gnutls_certificate_set_x509_key_mem',
+        'gnutls_certificate_set_x509_key_file','gnutls_transport_set_int2',
+        'gnutls_server_name_set','gnutls_session_set_verify_cert',
+        'gnutls_record_send','gnutls_record_recv','gnutls_record_check_pending']);
+      Pointer(GnuVersion):=RequiredProc(FPrimary,'gnutls_check_version',FInfo.PrimaryPath);
+      Text:=GnuVersion('3.6.0');
+      if Text=nil then raise ESmartTLS.Create('Bundled GnuTLS 3.6.0 or newer is required');
+      FInfo.Version:='GnuTLS '+StrPas(Text);
+{$ifdef windows}
+      if not SameTLSPath(CanonicalTLSPath(GetModuleName(FPrimary)),FInfo.PrimaryPath) then
+{$else}
+      if not SameTLSPath(AddressPath(Pointer(GnuVersion)),FInfo.PrimaryPath) then
+{$endif}
+        raise ESmartTLS.Create('Bundled GnuTLS resolved to a different loaded module');
+      end;
+  finally
+    Imports.Free;
+  end;
+end;
+
+destructor TLoadedTLSProbe.Destroy;
+begin
+  { Release only these probe references. Never unload a loader/caller's reference. }
+  if FPrimary<>NilHandle then ProbeUnloadLibrary(FPrimary);
+  if FCrypto<>NilHandle then ProbeUnloadLibrary(FCrypto);
+  inherited Destroy;
+end;
+end.
diff --git a/packages/fcl-tls/tests/testsmarthttp.pp b/packages/fcl-tls/tests/testsmarthttp.pp
new file mode 100644
index 000000000..a2fc380cd
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmarthttp.pp
@@ -0,0 +1,91 @@
+program testsmarthttp;
+{$mode objfpc}{$H+}
+{$IFDEF FPC_DOTTEDUNITS}
+uses {$ifdef unix}UnixApi.CThreads,{$endif} System.SysUtils, System.Classes,
+  FpWeb.Http.Client, System.Net.SSLSockets, System.Net.Ssockets,
+  System.Net.SmartSSLSockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+uses {$ifdef unix}cthreads,{$endif} SysUtils, Classes, fphttpclient, sslsockets,
+  ssockets, smartsslsockets, tlsbackendpolicy;
+{$ENDIF}
+type
+  TClient = class(TFPHTTPClient)
+  public
+    constructor Create;
+  end;
+  TObserver = class
+    CreatedCount, VerifyCount: Integer;
+    VerifyOption: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+var SelectedHandlerName: String; Backend: TSmartTLSBackend;
+constructor TClient.Create;
+begin
+  inherited Create(nil);
+  KeepConnectionReconnectLimit:=0;
+end;
+procedure Check(Value: Boolean; const What: String);
+begin if not Value then raise Exception.Create('FAIL '+What) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Check(Handler.ClassName=SelectedHandlerName,'selected handler class');
+  Check(TSSLSocketHandler(Handler).VerifyPeerCert=VerifyOption,'HTTP verification option');
+  if ParamStr(5)<>'none' then
+    begin
+    if Backend=stbOpenSSL then TSSLSocketHandler(Handler).CertificateData.CertCA.FileName:=ParamStr(5)
+    else if Backend=stbGnuTLS then TSSLSocketHandler(Handler).CertificateData.TrustedCertificate.FileName:=ParamStr(5)
+    else raise Exception.Create('Custom fixture CA applies only to external backends');
+    end;
+  if ParamStr(2)='afterfalse' then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(VerifyCount);
+  Check(Handler.ClassName=SelectedHandlerName,'callback handler');
+  Check(Allow,'legacy callback input');
+  Allow:=ParamStr(2)<>'veto';
+end;
+var Client: TClient; Observer: TObserver; H: TSSLSocketHandler;
+    Success: Boolean; Body,Failure: String; Count,I: Integer;
+begin
+  try
+    Check(ParamCount=5,'URL pass|reject|veto|reuse|afterfalse default|true|false backend CA|none');
+    Backend:=InitializeSmartTLS;
+    Check(SmartTLSBackendName(Backend)=ParamStr(4),'backend expectation');
+    Writeln('SELECTED version=',SmartTLSSelection.LibraryVersion,
+      ' primary=',SmartTLSSelection.PrimaryLibrary,' crypto=',SmartTLSSelection.CryptoLibrary);
+    H:=CreateSmartTLSHandler;
+    try SelectedHandlerName:=H.ClassName finally H.Free end;
+    Client:=TClient.Create; Observer:=TObserver.Create;
+    try
+      Check(not Client.VerifySSLCertificate,'legacy HTTP default False');
+      if ParamStr(3)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(3));
+      Observer.VerifyOption:=Client.VerifySSLCertificate;
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=5000; Client.IOTimeout:=5000;
+      Count:=1;
+      if ParamStr(2)='reuse' then begin Count:=2; Client.KeepConnection:=True end;
+      Success:=False; Failure:='';
+      try
+        for I:=1 to Count do
+          begin
+          Body:=Client.Get(ParamStr(1));
+          Check(Body='native tls fixture'+#10,'exact fixture body');
+          end;
+        Success:=True;
+      except on E: Exception do Failure:=E.ClassName+': '+E.Message end;
+      if (ParamStr(2)='reject') or (ParamStr(2)='veto') then Check(not Success,'request must fail')
+      else Check(Success,'request must succeed: '+Failure);
+      if ParamStr(2)='reuse' then Check(Observer.CreatedCount=1,'same TLS connection');
+      if ParamStr(2)='veto' then Check(Observer.VerifyCount=1,'application callback veto');
+      Check(SmartTLSSelection.Backend=Backend,'no backend fallback after request');
+      Check(TSSLSocketHandler.GetDefaultHandlerClass.ClassName=SelectedHandlerName,'default backend remains fixed');
+      Writeln('RESULT backend=',SmartTLSBackendName(Backend),' success=',Success,
+        ' created=',Observer.CreatedCount,' callbacks=',Observer.VerifyCount,' error=',Failure);
+    finally Client.Free; Observer.Free end;
+    Writeln('PASS real smart HTTPS');
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-tls/tests/testsmartnative.pp b/packages/fcl-tls/tests/testsmartnative.pp
new file mode 100644
index 000000000..79435c8c6
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartnative.pp
@@ -0,0 +1,237 @@
+program testsmartnative;
+{$mode objfpc}{$H+}
+uses
+{$IFDEF TEST_DOTTEDUNITS}
+  System.SysUtils, System.Classes, WinApi.Windows, System.Net.Ssockets,
+  System.Net.Sslsockets, System.Net.Sslbase, System.Net.SchannelSSLSockets,
+  WinApi.SchannelSSPI, FpWeb.Http.Client, System.Net.SmartSSLSockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+  SysUtils, Classes, Windows, ssockets, sslsockets, sslbase, schannelsslsockets,
+  schannelsspi, fphttpclient, smartsslsockets, tlsbackendpolicy;
+{$ENDIF}
+
+type
+  TObserver = class
+    Calls: Integer;
+    procedure RawVerify(Sender: TObject; var Allow: Boolean);
+    procedure HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+
+procedure Check(Condition: Boolean; const MessageText: String);
+begin
+  if not Condition then raise Exception.Create(MessageText);
+end;
+
+function TickCount: QWord;
+begin
+  Result:={$IFDEF TEST_DOTTEDUNITS}System.{$ENDIF}SysUtils.GetTickCount64;
+end;
+
+procedure TObserver.RawVerify(Sender: TObject; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Check(Allow,'Unexpected callback input');
+  Allow:=ParamStr(7)<>'veto';
+end;
+
+procedure TObserver.HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  RawVerify(Handler,Allow);
+end;
+
+procedure CheckModules;
+var Snapshot: THandle; Entry: MODULEENTRY32; Name: String;
+begin
+  Snapshot:=CreateToolhelp32Snapshot(TH32CS_SNAPMODULE,GetCurrentProcessId);
+  Check(Snapshot<>INVALID_HANDLE_VALUE,'Cannot enumerate client modules');
+  try
+    FillChar(Entry,SizeOf(Entry),0);
+    Entry.dwSize:=SizeOf(Entry);
+    Check(Module32First(Snapshot,Entry),'Cannot read client module list');
+    repeat
+      Name:=LowerCase(StrPas(Entry.szModule));
+      Check((Pos('libssl',Name)=0) and (Pos('libcrypto',Name)=0) and
+        (Pos('gnutls',Name)=0) and (Name<>'ssleay32.dll') and
+        (Name<>'libeay32.dll'),'Third-party TLS module loaded: '+Name);
+    until not Module32Next(Snapshot,Entry);
+  finally CloseHandle(Snapshot) end;
+end;
+
+procedure Construct;
+var Handler: TSchannelSocketHandler; Rejected: Boolean;
+begin
+  Writeln('LAYOUT handle=',SizeOf(TSecHandle),' buffer=',SizeOf(TSecBuffer),
+    ' desc=',SizeOf(TSecBufferDesc),' cred=',SizeOf(TSchannelCred),
+    ' modern=',SizeOf(TSchCredentials));
+  Check(SizeOf(TSecHandle)=2*SizeOf(Pointer),'SSPI handle layout differs');
+  Check(SizeOf(TSecStreamSizes)=20,'SSPI stream-size layout differs');
+{$IFDEF CPU64}
+  Check((SizeOf(TSecBuffer)=16) and (SizeOf(TSecBufferDesc)=16) and
+    (SizeOf(TSchannelCred)=80) and (SizeOf(TSchCredentials)=72),'Win64 SSPI layout differs');
+{$ELSE}
+  Check((SizeOf(TSecBuffer)=12) and (SizeOf(TSecBufferDesc)=12) and
+    (SizeOf(TSchannelCred)=56) and (SizeOf(TSchCredentials)=44),'Win32 SSPI layout differs');
+{$ENDIF}
+  Handler:=TSchannelSocketHandler.Create;
+  try
+    Check(Handler.CertGenerator<>nil,'Certificate-generator contract broken');
+    Handler.RemoteHostName:='example.com';
+    Check(Handler.CertGenerator.HostName='example.com','Legacy hostname setter broken');
+    Rejected:=False;
+    try Handler.CreateSelfSignedCertificate
+    except on E: ESSLSocketError do Rejected:=True end;
+    Check(Rejected,'Certificate generation accepted');
+    Check(not Handler.VerifyPeerCert,'Handler verification default changed');
+    Check(not Handler.Accept,'Client-only handler accepted a connection');
+    Check((not Handler.SSLActive) and (Handler.LastSSLErrorCode<>0),'Accept did not fail closed');
+    Check(TSSLSocketHandler.GetDefaultHandlerClass=TSchannelSocketHandler,'Registration failed');
+  finally Handler.Free end;
+end;
+
+procedure CheckPattern(const Buffer; Count, Offset: Integer);
+var I: Integer;
+begin
+  for I:=0 to Count-1 do
+    Check((PByte(@Buffer)+I)^=Byte((Offset+I) mod 251),'Body differs at '+IntToStr(Offset+I));
+end;
+
+procedure CheckFailure(const ErrorText: String);
+begin
+  Check(ParamStr(4)='reject','Unexpected error: '+ErrorText);
+  Check((ParamStr(6)<>'') and (Pos(UpperCase(ParamStr(6)),UpperCase(ErrorText))>0),
+    'Expected specific TLS error '+ParamStr(6)+', got '+ErrorText);
+end;
+
+procedure HTTPTest;
+var Client: TFPHTTPClient; Observer: TObserver; Body: String; Failed: Boolean;
+begin
+  Client:=TFPHTTPClient.Create(nil);
+  Observer:=TObserver.Create;
+  try
+    Check(not Client.VerifySSLCertificate,'HTTP verification default changed');
+    if ParamStr(3)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(3));
+    if ParamStr(7)<>'none' then Client.OnVerifySSLCertificate:=@Observer.HTTPVerify;
+    Client.ConnectTimeout:=5000;
+    Client.IOTimeout:=3000;
+    Client.AllowRedirect:=False;
+    Failed:=False;
+    try Body:=Client.Get(ParamStr(2))
+    except on E: Exception do
+      begin Failed:=True; Writeln('ERROR ',E.Message); CheckFailure(E.Message) end end;
+    Check(Failed=(ParamStr(4)='reject'),'Invalid certificate or TLS failure accepted');
+    if not Failed then
+      begin
+      Check(Client.ResponseStatusCode=200,'Expected HTTP 200');
+      if ParamStr(5)='fixture' then Check(Body='local tls fixture'+#10,'HTTP body differs')
+      else if ParamStr(5)='pattern' then
+        begin
+        Check(Length(Body)=1048576,'Large HTTP body length differs');
+        CheckPattern(Body[1],Length(Body),0);
+        end
+      else Check(Length(Body)>0,'Empty public HTTPS response');
+      Writeln('BODY ',Length(Body));
+      end;
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected HTTP callback count');
+  finally Observer.Free; Client.Free end;
+end;
+
+procedure RawTest;
+var Handler: TSchannelSocketHandler; Stream: TInetSocket; Observer: TObserver;
+    Buffer: array[0..4095] of Byte; Upload: TBytes;
+    N, Total, Expected, I: Integer; Started: QWord; Failed: Boolean; Mode: String;
+begin
+  Handler:=TSchannelSocketHandler.Create;
+  Observer:=TObserver.Create;
+  if ParamStr(3)<>'default' then Handler.VerifyPeerCert:=StrToBool(ParamStr(3));
+  Handler.ServerName:=ParamStr(9);
+  if Handler.ServerName='nul' then Handler.ServerName:='localhost'+#0+'invalid';
+  if ParamStr(10)='tls12' then Handler.SSLType:=stTLSv1_2;
+  if ParamStr(7)<>'none' then Handler.OnVerifyCertificate:=@Observer.RawVerify;
+  if ParamStr(12)='' then Stream:=TInetSocket.Create('127.0.0.1',StrToInt(ParamStr(2)),Handler)
+  else Stream:=TInetSocket.Create(ParamStr(12),StrToInt(ParamStr(2)),Handler);
+  try
+    Stream.ConnectTimeout:=3000;
+    Stream.IOTimeout:=3000;
+    Mode:=ParamStr(5);
+    if Mode='handshake-timeout' then Stream.ConnectTimeout:=150;
+    if Mode='unsupported' then Handler.CertificateData.CertCA.FileName:='unsupported-test-ca.pem';
+    Failed:=False;
+    Started:=TickCount;
+    try
+      Stream.Connect;
+      Check(Handler.SSLActive,'Handshake did not activate TLS');
+      if Mode='connect-only' then
+        begin
+        Check(ParamStr(4)='ok','Expected certificate rejection missing');
+        Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+        Check(Handler.Shutdown(False),'Connected TLS close failed');
+        Check(not Handler.SSLActive,'Close left TLS active');
+        Check(Handler.Shutdown(False),'Repeated close failed');
+        Exit;
+        end;
+      if Mode='read-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(Stream.Read(Buffer,SizeOf(Buffer))=-1,'Read timeout did not fail');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if Mode='shutdown-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(not Handler.Shutdown(True),'Unanswered bidirectional close succeeded');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if (Mode='send') or (Mode='send-timeout') then
+        begin
+        N:=1048576;
+        if Mode='send-timeout' then
+          begin N:=16777216; Stream.IOTimeout:=150; Started:=TickCount end;
+        SetLength(Upload,N);
+        for I:=0 to N-1 do Upload[I]:=Byte(I mod 251);
+        I:=Stream.Write(Upload[0],N);
+        if I<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        Check(I=N,'Partial send reported as success');
+        end;
+      Expected:=StrToInt(ParamStr(11));
+      Total:=0;
+      repeat
+        Check(Stream.CanRead(3000),'Receive readiness timed out');
+        N:=SizeOf(Buffer);
+        if Total<16 then N:=1;
+        N:=Stream.Read(Buffer,N);
+        if N<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        CheckPattern(Buffer,N,Total);
+        Inc(Total,N);
+        Check(Total<=Expected,'Extra TLS control bytes delivered as plaintext');
+      until N=0;
+      Check(Total=Expected,'Raw body length differs');
+      Check(Stream.Read(Buffer,1)=0,'EOF was not stable');
+      Check(Handler.Shutdown(True),'TLS close failed: '+Handler.LastSSLErrorString);
+      Check(not Handler.SSLActive,'Shutdown left TLS active');
+      Check(Handler.Shutdown(False),'Repeated shutdown failed');
+      Writeln('BODY ',Total);
+    except on E: Exception do
+      begin
+      Failed:=True;
+      Writeln('ERROR ',E.Message);
+      CheckFailure(E.Message);
+      Check(not Handler.SSLActive,'Failed TLS remained active');
+      end end;
+    if (Pos('timeout',Mode)>0) then Check(TickCount-Started<2000,'Deadline exceeded');
+    Check(Failed=(ParamStr(4)='reject'),'Expected TLS rejection missing');
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+  finally Stream.Free; Observer.Free end;
+end;
+
+begin
+  Check(InitializeSmartTLS=stbSchannel,'smart selected Schannel');
+  Writeln('SMART backend=',SmartTLSBackendName(SmartTLSSelection.Backend));
+  if ParamStr(1)='construct' then Construct
+  else if ParamStr(1)='http' then HTTPTest
+  else if ParamStr(1)='raw' then RawTest
+  else raise Exception.Create('Usage: construct | http/raw target verify expected mode code callback calls [name protocol bytes]');
+  CheckModules;
+  Writeln('PASS ',ParamStr(1),' no third-party TLS modules');
+end.
diff --git a/packages/fcl-tls/tests/testsmartnetworkhttp.pp b/packages/fcl-tls/tests/testsmartnetworkhttp.pp
new file mode 100644
index 000000000..258ab3d05
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartnetworkhttp.pp
@@ -0,0 +1,113 @@
+{ Real macOS HTTP acceptance harness.
+  Requires cthreads first, native provider and diagnostic counters. }
+program testsmartnetworkhttp;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+  SysUtils, Classes, fphttpclient, ssockets, sslsockets, networkframeworksslsockets,
+  networkframeworknative, smartsslsockets, tlsbackendpolicy;
+type
+  TNativeHTTPClient = class(TFPHTTPClient)
+  public
+    property KeepConnectionReconnectLimit;
+  end;
+  TObserver = class
+    CreatedCount, Calls: Integer;
+    CallbackAllow, DisableAfterCreate: Boolean;
+    ExpectedVerify: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+procedure Require(Value: Boolean; const MessageText: String);
+begin if not Value then raise Exception.Create('FAIL '+MessageText) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Require(Handler is TNetworkFrameworkSocketHandler,'native handler selected');
+  Require(TSSLSocketHandler(Handler).VerifyPeerCert=ExpectedVerify,'HTTP verification forwarded');
+  Require(TSSLSocketHandler(Handler).CertGenerator<>nil,'no external certificate generator');
+  if DisableAfterCreate then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Require(Handler is TNetworkFrameworkSocketHandler,'callback has native handler');
+  Require(Allow,'legacy callback starts with Allow=True');
+  Allow:=CallbackAllow;
+end;
+function CertificateFailure(Domain, Code: LongInt): Boolean;
+begin
+  { Apple Security/base/SecBase.h: network TLS domain uses these SSL codes.
+    A TCP reset, EOF, timeout or generic handshake error is never a pass. }
+  Result:=(Domain=3) and ((Code=-9807) or (Code=-9808) or (Code=-9812) or (Code=-9813) or
+    (Code=-9814) or (Code=-9815) or (Code=-9843));
+end;
+var Client: TNativeHTTPClient; Observer: TObserver; URL, Expected, BodyMode, Body,
+    Failure: String; Requests, Index, Domain, Code: LongInt; Succeeded: Boolean;
+    Started: QWord; Output: TStringStream; ExpectedStatus: Integer;
+begin
+  try
+    Require(ParamCount=8,'usage: URL default|true|false callback after_false expected callbacks body_mode requests');
+    URL:=ParamStr(1); Expected:=ParamStr(5); BodyMode:=ParamStr(7);
+    Requests:=StrToInt(ParamStr(8)); Require(Requests>0,'positive request count');
+    Require((Expected='pass') or (Expected='certificate') or (Expected='veto'),'known expectation');
+    Require(InitializeSmartTLS=stbNetworkFramework,'smart selected Network.framework');
+    Observer:=TObserver.Create; Client:=TNativeHTTPClient.Create(nil);
+    try
+      Require(not Client.VerifySSLCertificate,'existing default remains False');
+      if ParamStr(2)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(2));
+      Observer.ExpectedVerify:=Client.VerifySSLCertificate;
+      Observer.CallbackAllow:=StrToBool(ParamStr(3));
+      Observer.DisableAfterCreate:=StrToBool(ParamStr(4));
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=10000; Client.IOTimeout:=5000;
+      Client.KeepConnection:=Requests>1; Client.KeepConnectionReconnectLimit:=0;
+      Succeeded:=False; Domain:=0; Code:=0; Failure:='';
+      try
+        for Index:=1 to Requests do
+          begin
+          Output:=TStringStream.Create('');
+          try
+            if BodyMode='head' then Client.HTTPMethod('HEAD',URL,Output,[])
+            else Client.HTTPMethod('GET',URL,Output,[]);
+            Body:=Output.DataString;
+          finally Output.Free end;
+          ExpectedStatus:=200;
+          if BodyMode='204' then ExpectedStatus:=204 else if BodyMode='304' then ExpectedStatus:=304
+          else if BodyMode='101' then ExpectedStatus:=101;
+          Require(Client.ResponseStatusCode=ExpectedStatus,'exact HTTP status');
+          if BodyMode='local' then Require(Body='native tls fixture'+#10,'exact local HTTP contents')
+          else if BodyMode='public' then Require(Length(Body)>0,'public response body')
+          else Require(Body='','bodyless HTTP response');
+          end;
+        Succeeded:=True;
+      except
+        on E: ENetworkFrameworkTLS do
+          begin Domain:=E.Domain; Code:=E.NativeCode; Failure:=E.Message end;
+        on E: Exception do Failure:=E.ClassName+': '+E.Message;
+      end;
+      Writeln('RESULT success=',Succeeded,' created=',Observer.CreatedCount,
+        ' callbacks=',Observer.Calls,' domain=',Domain,' code=',Code,' error=',Failure);
+      if Expected='pass' then Require(Succeeded,'request must succeed')
+      else if Expected='certificate' then
+        Require(not Succeeded and CertificateFailure(Domain,Code),'specific certificate rejection required')
+      else if Expected='veto' then
+        Require(not Succeeded and (Pos('application certificate veto',LowerCase(Failure))>0),'callback veto required');
+      Require(Observer.Calls=StrToInt(ParamStr(6)),'exact callback count');
+      if (Expected='pass') and (Requests>1) then Require(Observer.CreatedCount=1,'same native TLS connection reused');
+      Require(SmartTLSSelection.Backend=stbNetworkFramework,'smart backend remains fixed');
+      Require(TSSLSocketHandler.GetDefaultHandlerClass=TNetworkFrameworkSocketHandler,
+        'backend remains fixed');
+    finally
+      Client.Free; Observer.Free;
+    end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Started:=GetTickCount64;
+    while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+    Require(NetworkFrameworkLiveContexts=0,'native callbacks release all contexts');
+    Writeln('PASS contexts drained; destroyed=',NetworkFrameworkDestroyedContexts);
+{$endif}
+    Writeln('PASS native fphttpclient ',Expected);
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-tls/tests/testsmartselection.pp b/packages/fcl-tls/tests/testsmartselection.pp
new file mode 100644
index 000000000..c7b48d3c5
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartselection.pp
@@ -0,0 +1,138 @@
+program testsmartselection;
+{$mode objfpc}{$H+}
+{$IFDEF FPC_DOTTEDUNITS}
+uses {$ifdef unix}UnixApi.CThreads,{$endif} System.SysUtils, System.Classes,
+  System.Net.SSLSockets, System.Net.SmartSSLSockets, System.Net.TLSBackendPolicy,
+  Api.Openssl, Api.GnuTls, System.Net.Gnutlssockets;
+{$ELSE}
+uses {$ifdef unix}cthreads,{$endif} SysUtils, Classes, sslsockets, smartsslsockets,
+  tlsbackendpolicy, openssl, gnutls, gnutlssockets;
+{$ENDIF}
+type
+  TGnuAccess = class(TGNUTLSSocketHandler)
+  public
+    procedure ExerciseVerification;
+  end;
+  TSelectorThread = class(TThread)
+  public
+    Error: String;
+    Backend: TSmartTLSBackend;
+    procedure Execute; override;
+  end;
+var ExePath: String; Preference: TSmartTLSBackend; VerifyCalls: Integer;
+
+procedure SpyVerify(Session: tgnutls_session_t; Name: PAnsiChar; Flags: LongWord); cdecl;
+begin
+  Inc(VerifyCalls);
+end;
+
+procedure TGnuAccess.ExerciseVerification;
+begin
+  ConfigurePeerVerification('selector.test');
+end;
+
+procedure Check(Value: Boolean; const What: String);
+begin
+  if not Value then raise Exception.Create('FAIL '+What);
+end;
+
+procedure TSelectorThread.Execute;
+begin
+  try Backend:=InitializeSmartTLS(Preference,ExePath)
+  except on E: Exception do Error:=E.Message end;
+end;
+
+function ParseBackend(const Name: String): TSmartTLSBackend;
+var B: TSmartTLSBackend;
+begin
+  for B:=stbAuto to stbNetworkFramework do
+    if Name=SmartTLSBackendName(B) then Exit(B);
+  raise Exception.Create('Unknown backend argument: '+Name);
+end;
+
+var Expected,Mode,FirstError: String; Backend: TSmartTLSBackend;
+    Info: TSmartTLSSelection; H: TSSLSocketHandler; Threads: array[0..15] of TSelectorThread;
+    I: Integer; PreviousGnuInit: Pointer;
+begin
+  try
+    Check(ParamCount>=2,'arguments');
+    ExePath:=ParamStr(1); Expected:=ParamStr(2);
+    Preference:=stbAuto; if ParamCount>=3 then Preference:=ParseBackend(ParamStr(3));
+    Mode:=ParamStr(4);
+    if Mode='preopenssl' then
+      Check(InitSSLInterface(ParamStr(6),ParamStr(7)),'preinitialize OpenSSL');
+    if Mode='pregnu' then
+      begin LoadGnuTLS(ParamStr(6)); PreviousGnuInit:=Pointer(gnutls_init) end;
+    if Expected='error' then
+      begin
+      FirstError:='';
+      try InitializeSmartTLS(Preference,ExePath)
+      except on E: Exception do FirstError:=E.Message end;
+      Check(FirstError<>'','initialization must fail');
+      Check(Pos(ParamStr(5),FirstError)>0,'diagnostic '+FirstError);
+      Check(SmartTLSSelection.Backend=stbUnselected,'no selected backend on failure');
+      try
+        InitializeSmartTLS(Preference,ExePath);
+        raise Exception.Create('FAIL failure was not cached');
+      except on E: ESmartTLS do Check(E.Message=FirstError,'cached failure unchanged') end;
+      if Mode='preopenssl' then Check(IsSSLLoaded,'existing OpenSSL interface preserved');
+      if Mode='pregnu' then Check(GnuTLSLoaded and (Pointer(gnutls_init)=PreviousGnuInit),'existing GnuTLS interface preserved');
+      Writeln('PASS rejected: ',FirstError);
+      Halt(0);
+      end;
+    if Mode='threads' then
+      begin
+      for I:=0 to High(Threads) do Threads[I]:=TSelectorThread.Create(False);
+      for I:=0 to High(Threads) do
+        begin
+        Threads[I].WaitFor;
+        Check(Threads[I].Error='','concurrent selection '+Threads[I].Error);
+        Check(SmartTLSBackendName(Threads[I].Backend)=Expected,'concurrent backend');
+        Threads[I].Free;
+        end;
+      end;
+    Backend:=InitializeSmartTLS(Preference,ExePath);
+    Check(SmartTLSBackendName(Backend)=Expected,'expected '+Expected);
+    Check(InitializeSmartTLS(Preference,ExePath)=Backend,'repeat selection');
+    Info:=SmartTLSSelection;
+    Check(Info.Backend=Backend,'observable backend');
+    H:=CreateSmartTLSHandler;
+    try
+      Check(H.ClassType=TSSLSocketHandler.GetDefaultHandlerClass,'registered class matches');
+      H.VerifyPeerCert:=False; Check(not H.VerifyPeerCert,'False preserved');
+      H.VerifyPeerCert:=True; Check(H.VerifyPeerCert,'True preserved');
+      if Mode='gnuverification' then
+        begin
+        Check(H is TGNUTLSSocketHandler,'GnuTLS verification adapter');
+        gnutls_session_set_verify_cert:=@SpyVerify;
+        H.VerifyPeerCert:=False;
+        TGnuAccess(H).ExerciseVerification;
+        Check(VerifyCalls=0,'False does not install automatic GnuTLS verification');
+        H.VerifyPeerCert:=True;
+        TGnuAccess(H).ExerciseVerification;
+        Check(VerifyCalls=1,'True installs automatic GnuTLS verification');
+        end;
+    finally H.Free end;
+    try
+      InitializeSmartTLS(stbUnselected,ExePath);
+      raise Exception.Create('FAIL changed preference accepted');
+    except on E: ESmartTLS do Check(Pos('immutable',E.Message)>0,'immutable selection') end;
+    Check(SmartTLSSelection.Backend=Backend,'no backend switch');
+    if Mode='destroyed' then
+      begin
+      if Backend=stbOpenSSL then DestroySSLInterface
+      else if Backend=stbGnuTLS then FreeGnuTLS
+      else raise Exception.Create('Invalid destroyed-interface case');
+      try
+        H:=CreateSmartTLSHandler;
+        H.Free;
+        raise Exception.Create('FAIL destroyed loader silently reinitialized');
+      except on E: ESmartTLS do Check(Pos('interface',E.Message)>0,'destroyed interface diagnostic') end;
+      Check(SmartTLSSelection.Backend=Backend,'no fallback after explicit loader destruction');
+      end;
+    Writeln('PASS backend=',SmartTLSBackendName(Backend),' version=',Info.LibraryVersion,
+      ' primary=',Info.PrimaryLibrary,' crypto=',Info.CryptoLibrary);
+  except
+    on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end;
+  end;
+end.
