diff --git a/packages/fcl-net/tests/networkframeworkmodel.inc b/packages/fcl-net/tests/networkframeworkmodel.inc
new file mode 100644
index 000000000..a7ff9a2f2
--- /dev/null
+++ b/packages/fcl-net/tests/networkframeworkmodel.inc
@@ -0,0 +1,197 @@
+procedure CoreCheck(Condition: Boolean; const Name: String);
+begin if not Condition then raise Exception.Create('FAIL core model: '+Name) end;
+
+function ModelContext: TNativeContext;
+begin Result:=TNativeContext.Create(nil); Result.FReady:=True end;
+
+procedure DeliverModel(Context: TNativeContext; Data: Pointer; Size: SizeUInt;
+  FinalContent, HasError: Boolean; Domain, Code: LongInt);
+begin
+  Context.Lock;
+  try
+    CoreCheck(Context.FReceivePending,'one pending receive before delivery');
+    Context.ReceiveResultLocked(Data,Size,FinalContent,HasError,Domain,Code);
+  finally Context.Unlock end;
+  Context.Release;
+end;
+
+function RaisingErrorDomain(Error: TNWError): TNWErrorDomain; cdecl;
+begin raise Exception.Create('intentional boundary conversion failure') end;
+
+type
+  TModelReader = class(TThread)
+    Context: TNativeContext;
+    Readiness: Boolean;
+    Status, Domain, Code: LongInt;
+    procedure Execute; override;
+  end;
+
+procedure TModelReader.Execute;
+var ByteValue: Byte;
+begin
+  try
+    if Readiness then Status:=NativeCanRead(Pointer(Context),High(Cardinal),Domain,Code)
+    else Status:=NativeRead(Pointer(Context),@ByteValue,1,0,Domain,Code);
+  finally Context.Release end;
+end;
+
+procedure RunNetworkFrameworkCoreModelTests;
+var Context: TNativeContext; Domain, Code, Status, BeforeDestroy: LongInt;
+    Buffer: array[0..7] of Byte; LiteralData: AnsiString;
+    FakeFunctions: TNetworkFrameworkFunctions; Reader: TModelReader;
+    Start: QWord; Pending: Boolean;
+    LargeBuffer: array[0..PlaintextCapacity] of Byte;
+    Index, CallerKind: LongInt;
+begin
+  CoreCheck(ValidPort('443') and ValidPort('65535'),'valid decimal ports');
+  CoreCheck(not ValidPort(nil) and not ValidPort('0') and not ValidPort('65536') and
+    not ValidPort('12x') and not ValidPort('-1'),'invalid ports');
+  CoreCheck((SizeOf(TNWBoolean)=1) and (SizeOf(cint)=4) and
+    (SizeOf(csize_t)=SizeOf(Pointer)),
+    'native scalar widths');
+{$ifndef FPC_NATIVE_NETWORK_FRAMEWORK}
+  CoreCheck(not NetworkFrameworkAvailable,
+    'non-Darwin unavailable, no pretend native provider');
+{$endif}
+  BeforeDestroy:=ModelDestroyed;
+  Context:=TNativeContext.Create(nil);
+  NativeRetain(Pointer(Context)); NativeClose(Pointer(Context));
+  Status:=NativeConnect(Pointer(Context),1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=1) and (Code=89),'close before start is terminal');
+  NativeClose(Pointer(Context)); { repeated close only while the explicit hold exists }
+  NativeRelease(Pointer(Context));
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'one owner release and one operation hold');
+
+  LiteralData:='abc'; Context:=ModelContext;
+  Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(NativeBytesAvailable(Pointer(Context))=3,'buffered plaintext count');
+  FillChar(Buffer,SizeOf(Buffer),0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,2,1,Domain,Code)=2,'partial read');
+  CoreCheck((Buffer[0]=Ord('a')) and (Buffer[1]=Ord('b')) and
+    (NativeBytesAvailable(Pointer(Context))=1),'partial contents and remaining count');
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=1,'remaining read');
+  CoreCheck(Buffer[0]=Ord('c'),'remaining contents');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,True,True,3,-9807);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=3,'native error after partial data');
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=3) and (Code=-9807) and not Context.FEOF,
+    'native TLS error preserved over final content');
+  NativeRetain(Pointer(Context)); NativeClose(Pointer(Context));
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=3) and (Code=-9807),'close cannot replace first native error');
+  NativeRelease(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,True,False,0,0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=3,'data before EOF');
+  CoreCheck((NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0) and
+    (NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0),'clean EOF is repeatable');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext;
+  CoreCheck(NativeCanRead(Pointer(Context),0,Domain,Code)=0,'readiness poll');
+  CoreCheck(NativeCanRead(Pointer(Context),2,Domain,Code)=0,'benign readiness deadline');
+  CoreCheck(Context.FReceivePending and not Context.FStopped and (Context.FReferences=2),
+    'readiness keeps exactly one pending receive');
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,3,1,Domain,Code)=3,'receive survives readiness timeout');
+  NativeClose(Pointer(Context));
+
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext; Buffer[0]:=99;
+  Status:=NativeRead(Pointer(Context),@Buffer,1,2,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=1) and (Code=60) and (Buffer[0]=99),
+    'read deadline terminal and caller buffer untouched');
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60),'deadline persists');
+  NativeClose(Pointer(Context));
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck((Buffer[0]=99) and (ModelDestroyed=BeforeDestroy+1),
+    'late receive after timeout/owner close releases safely');
+
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext;
+  Status:=NativeWrite(Pointer(Context),PAnsiChar(LiteralData),3,2,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60) and Context.FSendPending,'terminal send deadline');
+  NativeClose(Pointer(Context));
+  Context.SendCompleted(nil);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'late send completion releases safely');
+
+  Context:=ModelContext;
+  FillChar(FakeFunctions,SizeOf(FakeFunctions),0);
+  FakeFunctions.ErrorDomain:=@RaisingErrorDomain;
+  Context.FFunctions:=@FakeFunctions;
+  Context.StateChanged(NWStateFailed,TNWError(Pointer(1)));
+  CoreCheck(Context.FError and (Context.FDomain=1) and (Context.FCode=5),
+    'callback exception converted locally, no foreign unwind');
+  Context.FFunctions:=nil;
+  NativeClose(Pointer(Context));
+
+  for CallerKind:=0 to 1 do
+    begin
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext;
+  NativeRetain(Pointer(Context));
+  Reader:=TModelReader.Create(True);
+  Reader.Readiness:=CallerKind=1;
+  Reader.Context:=Context;
+  Reader.Start;
+  Start:=GetTickCount64;
+  repeat
+    Context.Lock; try Pending:=Context.FReceivePending finally Context.Unlock end;
+    if not Pending then Sleep(1);
+  until Pending or (GetTickCount64-Start>1000);
+  CoreCheck(Pending,'blocking reader reached pending receive');
+  NativeClose(Pointer(Context));
+  Reader.WaitFor;
+  CoreCheck((Reader.Status=-1) and (Reader.Domain=1) and (Reader.Code=89),
+    'concurrent close interrupts unlimited read under operation hold');
+  Reader.Free;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'closed caller and late callback each release once');
+    end;
+
+  BeforeDestroy:=ModelDestroyed; Context:=TNativeContext.Create(nil);
+  Status:=NativeConnect(Pointer(Context),2,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60) and Context.FStateReference and
+    (Context.FReferences=2),'connect deadline retains one state handler');
+  NativeClose(Pointer(Context));
+  Context.StateChanged(NWStateCancelled,nil);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'late cancelled state releases after connect timeout');
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,nil,0,False,False,0,0);
+  CoreCheck(not Context.FEOF and (NativeCanRead(Pointer(Context),0,Domain,Code)=0),
+    'empty nonfinal receive is not EOF and queues next receive');
+  DeliverModel(Context,nil,0,True,False,0,0);
+  CoreCheck((NativeCanRead(Pointer(Context),0,Domain,Code)=1) and
+    (NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0),'empty final receive is EOF');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),PlaintextCapacity+1,False,False,0,0);
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=84) and (NativeBytesAvailable(Pointer(Context))=0),
+    'oversized native payload rejected before copy');
+  NativeClose(Pointer(Context));
+
+  for Index:=0 to PlaintextCapacity-1 do LargeBuffer[Index]:=Index mod 251;
+  LargeBuffer[PlaintextCapacity]:=99;
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,@LargeBuffer,PlaintextCapacity,False,False,0,0);
+  FillChar(LargeBuffer,PlaintextCapacity,0);
+  CoreCheck(NativeBytesAvailable(Pointer(Context))=PlaintextCapacity,'16 KiB capacity');
+  CoreCheck(NativeRead(Pointer(Context),@LargeBuffer,PlaintextCapacity+1,1,Domain,Code)=
+    PlaintextCapacity,'bounded partial read at capacity');
+  for Index:=0 to PlaintextCapacity-1 do
+    CoreCheck(LargeBuffer[Index]=Index mod 251,'exact capacity payload');
+  CoreCheck(LargeBuffer[PlaintextCapacity]=99,'read never writes past returned count');
+  CoreCheck((NativeRead(Pointer(Context),nil,0,1,Domain,Code)=0) and
+    (NativeWrite(Pointer(Context),nil,0,1,Domain,Code)=0),'zero length operations');
+  CoreCheck(not Context.FReceivePending and not Context.FSendPending,
+    'zero length operations do not create callbacks');
+  Status:=NativeRead(Pointer(Context),nil,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=22),'nil positive read is terminal EINVAL');
+  NativeClose(Pointer(Context));
+end;
diff --git a/packages/fcl-net/tests/testnetworkhttp.pp b/packages/fcl-net/tests/testnetworkhttp.pp
new file mode 100644
index 000000000..bf29cffe6
--- /dev/null
+++ b/packages/fcl-net/tests/testnetworkhttp.pp
@@ -0,0 +1,112 @@
+{ Real macOS HTTP acceptance harness.
+  Requires cthreads first, native provider and diagnostic counters. }
+program testnetworkhttp;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+  SysUtils, Classes, fphttpclient, ssockets, sslsockets, networkframeworksslsockets,
+  networkframeworknative;
+type
+  TNativeHTTPClient = class(TFPHTTPClient)
+  public
+    property KeepConnectionReconnectLimit;
+  end;
+  TObserver = class
+    CreatedCount, Calls: Integer;
+    CallbackAllow, DisableAfterCreate: Boolean;
+    ExpectedVerify: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+procedure Require(Value: Boolean; const MessageText: String);
+begin if not Value then raise Exception.Create('FAIL '+MessageText) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Require(Handler is TNetworkFrameworkSocketHandler,'native handler selected');
+  Require(TSSLSocketHandler(Handler).VerifyPeerCert=ExpectedVerify,'HTTP verification forwarded');
+  Require(TSSLSocketHandler(Handler).CertGenerator<>nil,'no external certificate generator');
+  if DisableAfterCreate then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Require(Handler is TNetworkFrameworkSocketHandler,'callback has native handler');
+  Require(Allow,'legacy callback starts with Allow=True');
+  Allow:=CallbackAllow;
+end;
+function CertificateFailure(Domain, Code: LongInt): Boolean;
+begin
+  { Apple Security/base/SecBase.h: network TLS domain uses these SSL codes.
+    A TCP reset, EOF, timeout or generic handshake error is never a pass. }
+  Result:=(Domain=3) and ((Code=-9807) or (Code=-9808) or (Code=-9812) or (Code=-9813) or
+    (Code=-9814) or (Code=-9815) or (Code=-9843));
+end;
+var Client: TNativeHTTPClient; Observer: TObserver; URL, Expected, BodyMode, Body,
+    Failure: String; Requests, Index, Domain, Code: LongInt; Succeeded: Boolean;
+    Started: QWord; Output: TStringStream; ExpectedStatus: Integer;
+begin
+  try
+    Require(ParamCount=8,'usage: URL default|true|false callback after_false expected callbacks body_mode requests');
+    URL:=ParamStr(1); Expected:=ParamStr(5); BodyMode:=ParamStr(7);
+    Requests:=StrToInt(ParamStr(8)); Require(Requests>0,'positive request count');
+    Require((Expected='pass') or (Expected='certificate') or (Expected='veto'),'known expectation');
+    TSSLSocketHandler.SetDefaultHandlerClass(TNetworkFrameworkSocketHandler);
+    Observer:=TObserver.Create; Client:=TNativeHTTPClient.Create(nil);
+    try
+      Require(not Client.VerifySSLCertificate,'existing default remains False');
+      if ParamStr(2)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(2));
+      Observer.ExpectedVerify:=Client.VerifySSLCertificate;
+      Observer.CallbackAllow:=StrToBool(ParamStr(3));
+      Observer.DisableAfterCreate:=StrToBool(ParamStr(4));
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=10000; Client.IOTimeout:=5000;
+      Client.KeepConnection:=Requests>1; Client.KeepConnectionReconnectLimit:=0;
+      Succeeded:=False; Domain:=0; Code:=0; Failure:='';
+      try
+        for Index:=1 to Requests do
+          begin
+          Output:=TStringStream.Create('');
+          try
+            if BodyMode='head' then Client.HTTPMethod('HEAD',URL,Output,[])
+            else Client.HTTPMethod('GET',URL,Output,[]);
+            Body:=Output.DataString;
+          finally Output.Free end;
+          ExpectedStatus:=200;
+          if BodyMode='204' then ExpectedStatus:=204 else if BodyMode='304' then ExpectedStatus:=304
+          else if BodyMode='101' then ExpectedStatus:=101;
+          Require(Client.ResponseStatusCode=ExpectedStatus,'exact HTTP status');
+          if BodyMode='local' then Require(Body='native tls fixture'+#10,'exact local HTTP contents')
+          else if BodyMode='public' then Require(Length(Body)>0,'public response body')
+          else Require(Body='','bodyless HTTP response');
+          end;
+        Succeeded:=True;
+      except
+        on E: ENetworkFrameworkTLS do
+          begin Domain:=E.Domain; Code:=E.NativeCode; Failure:=E.Message end;
+        on E: Exception do Failure:=E.ClassName+': '+E.Message;
+      end;
+      Writeln('RESULT success=',Succeeded,' created=',Observer.CreatedCount,
+        ' callbacks=',Observer.Calls,' domain=',Domain,' code=',Code,' error=',Failure);
+      if Expected='pass' then Require(Succeeded,'request must succeed')
+      else if Expected='certificate' then
+        Require(not Succeeded and CertificateFailure(Domain,Code),'specific certificate rejection required')
+      else if Expected='veto' then
+        Require(not Succeeded and (Pos('application certificate veto',LowerCase(Failure))>0),'callback veto required');
+      Require(Observer.Calls=StrToInt(ParamStr(6)),'exact callback count');
+      if (Expected='pass') and (Requests>1) then Require(Observer.CreatedCount=1,'same native TLS connection reused');
+      Require(TSSLSocketHandler.GetDefaultHandlerClass=TNetworkFrameworkSocketHandler,
+        'backend remains fixed');
+    finally
+      Client.Free; Observer.Free;
+    end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Started:=GetTickCount64;
+    while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+    Require(NetworkFrameworkLiveContexts=0,'native callbacks release all contexts');
+    Writeln('PASS contexts drained; destroyed=',NetworkFrameworkDestroyedContexts);
+{$endif}
+    Writeln('PASS native fphttpclient ',Expected);
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-net/tests/testnetworknative.pp b/packages/fcl-net/tests/testnetworknative.pp
new file mode 100644
index 000000000..f3a358765
--- /dev/null
+++ b/packages/fcl-net/tests/testnetworknative.pp
@@ -0,0 +1,338 @@
+{ Part of FCL; see COPYING.FPC.
+  Integration harness for the pure Pascal native provider; no C object required.
+  No arguments: construction/argument/retained owner tests, no connection starts.
+  host port verify ready: TLS handshake must succeed (verify is exactly 0 or 1).
+  host port verify error domain code: exact native connection failure expected.
+  host port verify echo: fragmented 1 MiB, partial writes, readiness timeout reuse.
+  host port verify timeout: TLS fixture sends no application data.
+  host port verify close: same idle fixture; Close interrupts unlimited Read.
+  host port verify canclose: Close interrupts unlimited CanRead.
+  host port verify eof: fixture sends 'abc' then ends TLS cleanly.
+  host port verify reset: fixture aborts TCP; must report an error, never EOF.
+  Certificates, server connection counts, fixtures and trust belong to the macOS
+  runner. This program never changes system trust or provisions a server.
+  Build with -Fu../src -Fi. -FU<output> -FE<output> testnetworknative.pp.
+  Define FPC_NETWORKFRAMEWORK_MODEL on Windows to run shared production state
+  tests only: this does not compile cblocks or prove native/TLS operation. }
+program testnetworknative;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}
+  cthreads,
+{$endif}
+  SysUtils, Classes, networkframeworknative;
+
+{$ifndef FPC_NETWORKFRAMEWORK_MODEL}
+const
+  DeadlineMS = 5000;
+  POSIXDomain = 1;
+  DarwinEINVAL = 22;
+  DarwinETIMEDOUT = 60;
+  DarwinECANCELED = 89;
+  PlaintextCapacity = 16384;
+
+procedure Check(Condition: Boolean; const What: String; Domain, Code: LongInt);
+begin
+  if not Condition then
+    raise Exception.CreateFmt('FAIL %s (domain=%d code=%d)',[What,Domain,Code]);
+end;
+
+procedure Construction;
+var Context: Pointer; Domain, Code, Status, Verify: LongInt;
+begin
+  Domain:=0; Code:=0;
+  Context:=NativeCreate(nil,'443',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'null hostname rejected',Domain,Code);
+  Context:=NativeCreate('localhost','0',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'invalid port rejected',Domain,Code);
+  for Verify:=0 to 1 do
+    begin
+    Context:=NativeCreate('localhost','443',Verify,Domain,Code);
+    Check(Context<>nil,'construction',Domain,Code);
+    Check(NativeBytesAvailable(Context)=0,'no premature plaintext',0,0);
+    NativeRetain(Context);
+    NativeClose(Context);
+    try
+      Status:=NativeConnect(Context,1,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinECANCELED),
+        'closed unstarted context valid under operation hold',Domain,Code);
+    finally NativeRelease(Context) end;
+    end;
+  Writeln('PASS construction/arguments/retained close; no connection started');
+end;
+
+procedure Echo(Context: Pointer);
+var Sent: array[0..32768] of Byte; Received: array[0..252] of Byte;
+    Offset, Size, Consumed, Returned, Offered, Count, Index, Block: LongInt;
+    Domain, Code: LongInt; Marker: AnsiString;
+begin
+  Offset:=0; Block:=0;
+  while Offset<1024*1024 do
+    begin
+    if Odd(Block) then Size:=Length(Sent) else Size:=137;
+    if Size>1024*1024-Offset then Size:=1024*1024-Offset;
+    for Index:=0 to Size-1 do Sent[Index]:=(Offset+Index) mod 251;
+    Consumed:=0;
+    while Consumed<Size do
+      begin
+      Count:=NativeWrite(Context,@Sent[Consumed],Size-Consumed,DeadlineMS,Domain,Code);
+      Check((Count>0) and (Count<=PlaintextCapacity) and (Count<=Size-Consumed),
+        'bounded partial write',Domain,Code);
+      Returned:=0;
+      while Returned<Count do
+        begin
+        Offered:=Count-Returned;
+        if Offered>Length(Received) then Offered:=Length(Received);
+        Offered:=NativeRead(Context,@Received,Offered,DeadlineMS,Domain,Code);
+        Check((Offered>0) and (Offered<=Count-Returned),'fragmented read',Domain,Code);
+        for Index:=0 to Offered-1 do
+          Check(Received[Index]=Sent[Consumed+Returned+Index],
+            'exact echo contents',Domain,Code);
+        Inc(Returned,Offered);
+        end;
+      Inc(Consumed,Count);
+      end;
+    Inc(Offset,Size); Inc(Block);
+    end;
+  Count:=NativeCanRead(Context,1,Domain,Code);
+  Check((Count=0) and (Domain=0) and (Code=0),'benign idle readiness timeout',Domain,Code);
+  Marker:='xyz';
+  Count:=NativeWrite(Context,PAnsiChar(Marker),3,DeadlineMS,Domain,Code);
+  Check(Count=3,'usable write after readiness timeout',Domain,Code);
+  Offset:=0;
+  while Offset<3 do
+    begin
+    Count:=NativeRead(Context,@Received,3-Offset,DeadlineMS,Domain,Code);
+    Check((Count>0) and (Count<=3-Offset),'receive after readiness timeout',Domain,Code);
+    for Index:=0 to Count-1 do
+      Check(Received[Index]=Ord(Marker[Offset+Index+1]),'reuse contents',Domain,Code);
+    Inc(Offset,Count);
+    end;
+  Writeln('PASS 1 MiB fragmented echo/partial writes/readiness timeout reuse');
+end;
+
+procedure WriteTimeout(Context: Pointer);
+var Buffer: array[0..16383] of Byte; Count, Domain, Code: LongInt;
+    Sent, Started: QWord;
+begin
+  FillChar(Buffer,SizeOf(Buffer),$a5); Sent:=0; Started:=GetTickCount64;
+  repeat
+    Count:=NativeWrite(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+    if Count>0 then Inc(Sent,Count);
+  until (Count<0) or (Sent>=64*1024*1024) or (GetTickCount64-Started>=5000);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'terminal send deadline under fixture backpressure',Domain,Code);
+  FillChar(Buffer,SizeOf(Buffer),$5a); Sleep(100);
+  Count:=NativeWrite(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'send deadline remains terminal',Domain,Code);
+  Writeln('PASS terminal send deadline; bytes queued before timeout=',Sent);
+end;
+
+type
+  TBlockingCaller = class(TThread)
+  public
+    Context: Pointer;
+    Readiness: Boolean;
+    Entered, Completed, Status, Domain, Code: LongInt;
+    constructor Create(Value: Pointer; IsReadiness: Boolean);
+    procedure Execute; override;
+  end;
+
+constructor TBlockingCaller.Create(Value: Pointer; IsReadiness: Boolean);
+begin
+  inherited Create(True);
+  Context:=Value; Readiness:=IsReadiness;
+end;
+
+procedure TBlockingCaller.Execute;
+var ByteValue: Byte;
+begin
+  try
+    InterlockedExchange(Entered,1);
+    if Readiness then Status:=NativeCanRead(Context,High(Cardinal),Domain,Code)
+    else Status:=NativeRead(Context,@ByteValue,1,0,Domain,Code);
+  finally
+    NativeRelease(Context);
+    InterlockedExchange(Completed,1);
+  end;
+end;
+
+procedure ConcurrentClose(var Context: Pointer; Readiness: Boolean);
+var Caller: TBlockingCaller; Start: QWord;
+begin
+  NativeRetain(Context);
+  try Caller:=TBlockingCaller.Create(Context,Readiness)
+  except NativeRelease(Context); raise end;
+  Caller.Start;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Entered,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Entered<>0,'caller thread entered',0,0);
+  Sleep(20);
+  NativeClose(Context); Context:=nil;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Completed,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Completed<>0,'Close wakes caller promptly',0,0);
+  Caller.WaitFor;
+  try
+    Check((Caller.Status=-1) and (Caller.Domain=POSIXDomain) and
+      (Caller.Code=DarwinECANCELED),'concurrent Close cancellation',Caller.Domain,Caller.Code);
+  finally Caller.Free end;
+  Writeln('PASS concurrent Close interrupts unlimited caller under operation hold');
+end;
+
+procedure AwaitNativeRelease;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+var Started: QWord;
+{$endif}
+begin
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  Started:=GetTickCount64;
+  while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+  Check(NetworkFrameworkLiveContexts=0,'all native contexts eventually released',0,0);
+  Writeln('PASS native context release; destroyed=',NetworkFrameworkDestroyedContexts);
+{$else}
+  Writeln('NOT RUN context-release observation: build with FPC_NETWORKFRAMEWORK_DIAGNOSTICS');
+{$endif}
+end;
+
+procedure RunNative;
+var Context: Pointer; Host, Port, Mode: AnsiString;
+    Verify, Domain, Code, Status, ExpectedDomain, ExpectedCode, Count, Index: LongInt;
+    ByteValue: Byte; Bytes: array[0..2] of Byte;
+begin
+  if not NetworkFrameworkAvailable then
+    begin
+    Writeln('SKIP native Network.framework provider unavailable: ',NetworkFrameworkAvailabilityError);
+    Halt(77);
+    end;
+  if ParamCount=0 then begin Construction; Exit end;
+  if (ParamCount<>4) and (ParamCount<>6) then
+    raise Exception.Create('usage: host port 0|1 ready|echo|timeout|writetimeout|connecttimeout|close|canclose|eof|reset; or host port 0|1 error domain code');
+  Host:=ParamStr(1); Port:=ParamStr(2); Mode:=ParamStr(4);
+  Check(TryStrToInt(ParamStr(3),Verify) and ((Verify=0) or (Verify=1)),
+    'verification is exactly 0 or 1',0,0);
+  if Mode='error' then
+    begin
+    Check((ParamCount=6) and TryStrToInt(ParamStr(5),ExpectedDomain) and
+      TryStrToInt(ParamStr(6),ExpectedCode) and (ExpectedDomain<>0) and
+      (ExpectedCode<>0),'explicit expected native error required',0,0);
+    end
+  else Check((ParamCount=4) and ((Mode='ready') or (Mode='echo') or
+    (Mode='timeout') or (Mode='close') or (Mode='canclose') or (Mode='eof') or
+    (Mode='reset') or (Mode='writetimeout') or (Mode='connecttimeout') or (Mode='finobserve') or (Mode='eofobserve')),'known test mode',0,0);
+  Context:=NativeCreate(PAnsiChar(Host),PAnsiChar(Port),Verify,Domain,Code);
+  Check(Context<>nil,'create',Domain,Code);
+  try
+    if Mode='connecttimeout' then Status:=NativeConnect(Context,100,Domain,Code)
+    else Status:=NativeConnect(Context,DeadlineMS,Domain,Code);
+    if Mode='connecttimeout' then
+      begin
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal handshake deadline',Domain,Code);
+      Writeln('PASS terminal handshake deadline'); Exit;
+      end;
+    if Mode='error' then
+      begin
+      Check((Status=-1) and (Domain=ExpectedDomain) and (Code=ExpectedCode),
+        'exact expected native connection error',Domain,Code);
+      Writeln('PASS exact expected terminal error; classification belongs to fixture expectation');
+      Exit;
+      end;
+    Check(Status=1,'TLS connection ready',Domain,Code);
+    if Mode='reset' then
+      begin
+      Writeln('FIXTURE_READY_RESET');
+      Flush(Output);
+      end;
+    if Mode='ready' then Writeln('PASS TLS connection ready')
+    else if Mode='echo' then Echo(Context)
+    else if Mode='writetimeout' then WriteTimeout(Context)
+    else if (Mode='close') or (Mode='canclose') then ConcurrentClose(Context,Mode='canclose')
+    else if Mode='timeout' then
+      begin
+      ByteValue:=99;
+      Status:=NativeRead(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal read deadline',Domain,Code);
+      Sleep(250);
+      Check(ByteValue=99,'late completion cannot touch caller buffer',0,0);
+      Status:=NativeRead(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'read deadline remains terminal',Domain,Code);
+      Writeln('PASS terminal read deadline and retained caller buffer contents');
+      end
+    else if (Mode='eof') or (Mode='eofobserve') then
+      begin
+      Count:=0;
+      while Count<3 do
+        begin
+        Status:=NativeRead(Context,@Bytes[Count],3-Count,DeadlineMS,Domain,Code);
+        Check((Status>0) and (Status<=3-Count),'data before EOF',Domain,Code);
+        Inc(Count,Status);
+        end;
+      for Index:=0 to 2 do Check(Bytes[Index]=Ord('a')+Index,'EOF fixture contents',0,0);
+      Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      Check(Status=0,'clean EOF',Domain,Code);
+      Status:=NativeRead(Context,@ByteValue,1,1,Domain,Code);
+      Check(Status=0,'repeated clean EOF',Domain,Code);
+      Writeln('PASS data before clean/repeated EOF');
+      if Mode='eofobserve' then
+        begin
+        Sleep(500);
+        Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+        Writeln('OBSERVED later EOF status=',Status,' domain=',Domain,' code=',Code);
+        end;
+      end
+    else if (Mode='reset') or (Mode='finobserve') then
+      begin
+      Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      if Mode='finobserve' then
+        begin
+        Writeln('OBSERVED first FIN status=',Status,' domain=',Domain,' code=',Code);
+        Sleep(500);
+        Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+        Writeln('OBSERVED later FIN status=',Status,' domain=',Domain,' code=',Code);
+        Writeln('DIAGNOSTIC only: no strict truncation acceptance claim');
+        end
+      else
+        begin
+        Check((Status=-1) and (Domain<>0) and (Code<>0) and
+          not ((Domain=POSIXDomain) and (Code=DarwinETIMEDOUT)),
+          'transport abort is an error',Domain,Code);
+        Writeln('PASS transport abort rejected as clean EOF');
+        end;
+      end;
+  finally
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Writeln('OBSERVED before local Close ',NetworkFrameworkReceiveDiagnostics);
+{$endif}
+    if Context<>nil then NativeClose(Context);
+    AwaitNativeRelease;
+  end;
+end;
+{$endif}
+
+begin
+  try
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+    RunNetworkFrameworkCoreModelTests;
+    Writeln('PASS shared Pascal context/state/ABI model; NOT macOS or TLS runtime validation');
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    if (NetworkFrameworkLiveContexts<>0) or (NetworkFrameworkDestroyedContexts=0) then
+      raise Exception.Create('Shared model diagnostic counters did not drain');
+    Writeln('PASS shared-model context counters drained');
+{$endif}
+{$else}
+    RunNative;
+    AwaitNativeRelease;
+{$endif}
+  except
+    on E: Exception do
+      begin Writeln(StdErr,E.Message); Halt(1) end;
+  end;
+end.
diff --git a/packages/fcl-net/tests/testnetworkpeer.pp b/packages/fcl-net/tests/testnetworkpeer.pp
new file mode 100644
index 000000000..d4e4a0556
--- /dev/null
+++ b/packages/fcl-net/tests/testnetworkpeer.pp
@@ -0,0 +1,250 @@
+{ Part of FCL; see COPYING.FPC. Tests the public peer, not a raw socket facade. }
+program testnetworkpeer;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+{$ifdef FPC_DOTTEDUNITS}
+  System.SysUtils, System.Classes, System.Net.Sslbase, System.Net.Sslsockets,
+  System.Net.ClientPeers, System.Net.NetworkFrameworkSSLSockets,
+  System.Net.NetworkFrameworkNative;
+{$else}
+  SysUtils, Classes, sslbase, sslsockets, clientpeers, networkframeworksslsockets,
+  networkframeworknative;
+{$endif}
+
+type
+  THandler = class(TNetworkFrameworkSocketHandler)
+    destructor Destroy; override;
+  end;
+  TCaller = class(TThread)
+    Peer: TClientPeer;
+    Readiness: Boolean;
+    Entered, Completed, ErrorCode: LongInt;
+    ErrorText: String;
+    procedure Execute; override;
+  end;
+  TObserver = class
+    Peer: TClientPeer;
+    Mode: String;
+    Calls: Integer;
+    procedure Verify(Sender: TObject; var Allow: Boolean);
+  end;
+
+var
+  DestroyedHandlers: Integer;
+
+procedure Check(Value: Boolean; const What: String);
+begin
+  if not Value then
+    raise Exception.Create('FAIL '+What);
+end;
+
+destructor THandler.Destroy;
+begin
+  Inc(DestroyedHandlers);
+  inherited Destroy;
+end;
+
+procedure TCaller.Execute;
+var
+  B: Byte;
+begin
+  InterlockedExchange(Entered,1);
+  try
+    try
+      if Readiness then Peer.CanRead(-1) else Peer.Read(B,1);
+    except
+      on E: ENetworkFrameworkTLS do
+        begin
+        ErrorCode:=E.NativeCode;
+        ErrorText:=E.Message;
+        end;
+      on E: Exception do ErrorText:=E.Message;
+    end;
+  finally
+    InterlockedExchange(Completed,1);
+  end;
+end;
+
+procedure TObserver.Verify(Sender: TObject; var Allow: Boolean);
+var
+  Failed: Boolean;
+begin
+  Inc(Calls);
+  Check(Sender is TNetworkFrameworkSocketHandler,'handler is verification sender');
+  Check(Allow,'initial callback allow');
+  if Mode='callbackclose' then
+    Peer.Close
+  else if Mode='callbackreenter' then
+    begin
+    Failed:=False;
+    try Peer.Connect except on E: ESSLSocketError do
+      Failed:=Pos('Reentrant',E.Message)>0 end;
+    Check(Failed,'reentrant connect rejected');
+    end;
+end;
+
+procedure Construction;
+var
+  H: THandler;
+  P: TClientPeer;
+  Failed: Boolean;
+  Before: Integer;
+  B: Byte;
+begin
+  Before:=DestroyedHandlers;
+  Check(THandler.RequiresClientPeer,'native provider requires its own transport peer');
+  H:=THandler.Create;
+  try
+    Check(H.CertGenerator<>Nil,'native handler needs no external generator');
+    H.RemoteHostName:='legacy.invalid';
+    Check(H.CertificateData.HostName='legacy.invalid','legacy hostname setter');
+    Failed:=False;
+    try H.CreateSelfSignedCertificate except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'certificate generation unsupported');
+    Failed:=False;
+    try H.Accept except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'Accept never permits plaintext');
+    Failed:=False;
+    try H.Connect except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'raw socket adoption rejected');
+    Failed:=False;
+    try TNetworkFrameworkPeer.Create(H,'',443) except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed and (DestroyedHandlers=Before),'failed constructor leaves handler owned by caller');
+    P:=TNetworkFrameworkPeer.Create(H,'localhost',443);
+    H:=Nil;
+    try
+      Failed:=False;
+      try P.IOTimeout:=-1 except on E: ESSLSocketError do Failed:=True end;
+      Check(Failed,'negative native I/O timeout rejected');
+      Failed:=False;
+      try P.ConnectTimeout:=-1 except on E: ESSLSocketError do Failed:=True end;
+      Check(Failed,'negative native connect timeout rejected');
+      Check((P.Read(B,0)=0) and (P.Write(B,0)=0),'empty operations start no context');
+      P.Close;
+      P.Close;
+    finally P.Free end;
+    Check(DestroyedHandlers=Before+1,'successful peer owns handler exactly once');
+  finally H.Free end;
+  Writeln('PASS native peer construction/ownership/capability refusals; no TLS connection started');
+end;
+
+procedure RunPeer;
+var
+  H: THandler;
+  P: TClientPeer;
+  Observer: TObserver;
+  Caller: TCaller;
+  Mode: String;
+  Failed: Boolean;
+  Started: QWord;
+  B: Byte;
+  Data: array[0..16383] of Byte;
+  Count, I, Offset: Integer;
+begin
+  Check(ParamCount=4,'usage host port 0|1 ready|echo|timeout|close|canclose|destroy|callbackclose|callbackreenter');
+  Mode:=ParamStr(4);
+  Check((ParamStr(3)='0') or (ParamStr(3)='1'),'explicit verification setting');
+  Check((Mode='ready') or (Mode='echo') or (Mode='timeout') or
+    (Mode='close') or (Mode='canclose') or (Mode='destroy') or
+    (Mode='callbackclose') or (Mode='callbackreenter'),'known peer mode');
+  H:=THandler.Create;
+  H.VerifyPeerCert:=ParamStr(3)='1';
+  try
+    P:=H.CreateClientPeer(ParamStr(1),StrToInt(ParamStr(2)));
+  except
+    H.Free;
+    raise;
+  end;
+  Observer:=TObserver.Create;
+  try
+    Observer.Peer:=P;
+    Observer.Mode:=Mode;
+    H.OnVerifyCertificate:=@Observer.Verify;
+    P.ConnectTimeout:=5000;
+    P.IOTimeout:=5000;
+    Failed:=False;
+    try P.Connect except on E: ESSLSocketError do
+      if Mode='callbackclose' then Failed:=Pos('closed by verification',E.Message)>0
+      else raise end;
+    if Mode='callbackclose' then
+      Check(Failed and not H.SSLActive,'Close in verification prevents publication')
+    else
+      begin
+      Check(H.SSLActive and (Observer.Calls=1),'native peer ready with one callback');
+      if Mode='echo' then
+        begin
+        for I:=0 to High(Data) do Data[I]:=I mod 251;
+        Offset:=0;
+        while Offset<Length(Data) do
+          begin
+          Count:=P.Write(Data[Offset],Length(Data)-Offset);
+          Check((Count>0) and (Count<=Length(Data)-Offset),'partial peer write');
+          Inc(Offset,Count);
+          end;
+        Offset:=0;
+        while Offset<Length(Data) do
+          begin
+          Count:=P.Read(Data[Offset],Length(Data)-Offset);
+          Check((Count>0) and (Count<=Length(Data)-Offset),'partial peer read');
+          Inc(Offset,Count);
+          end;
+        for I:=0 to High(Data) do Check(Data[I]=I mod 251,'exact peer echo bytes');
+        Check(not P.CanRead(1),'readiness timeout is benign');
+        end
+      else if Mode='timeout' then
+        begin
+        P.IOTimeout:=10;
+        B:=99;
+        Failed:=False;
+        try P.Read(B,1) except on E: ENetworkFrameworkTLS do
+          Failed:=(E.Domain=1) and (E.NativeCode=60) end;
+        Check(Failed and (B=99) and not H.SSLActive,'peer read deadline terminal, caller buffer intact');
+        end
+      else if (Mode='close') or (Mode='canclose') or (Mode='destroy') then
+        begin
+        P.IOTimeout:=0;
+        Caller:=TCaller.Create(True);
+        Caller.Peer:=P;
+        Caller.Readiness:=Mode='canclose';
+        try
+          Caller.Start;
+          Started:=GetTickCount64;
+          while (InterlockedCompareExchange(Caller.Entered,0,0)=0) and
+            (GetTickCount64-Started<1000) do Sleep(1);
+          Check(Caller.Entered<>0,'caller entered');
+          Sleep(50);
+          if Mode='destroy' then FreeAndNil(P) else P.Close;
+          Started:=GetTickCount64;
+          while (InterlockedCompareExchange(Caller.Completed,0,0)=0) and
+            (GetTickCount64-Started<1000) do Sleep(1);
+          Check(Caller.Completed<>0,'Close/destructor cancels promptly');
+          Caller.WaitFor;
+          Check(Caller.ErrorCode=89,'active caller sees native cancellation');
+        finally Caller.Free end;
+        end;
+      end;
+  finally
+    P.Free;
+    Observer.Free;
+  end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  Started:=GetTickCount64;
+  while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+  Check(NetworkFrameworkLiveContexts=0,'all peer contexts drained');
+{$endif}
+  Check(DestroyedHandlers=1,'handler freed once');
+  Writeln('PASS public native peer ',Mode);
+end;
+
+begin
+  try
+    if ParamCount=0 then Construction else RunPeer;
+  except
+    on E: Exception do
+      begin
+      Writeln(StdErr,E.Message);
+      Halt(1);
+      end;
+  end;
+end.
diff --git a/packages/fcl-net/tests/testschannel.pp b/packages/fcl-net/tests/testschannel.pp
new file mode 100644
index 000000000..89a13e449
--- /dev/null
+++ b/packages/fcl-net/tests/testschannel.pp
@@ -0,0 +1,235 @@
+program testschannel;
+{$mode objfpc}{$H+}
+uses
+{$IFDEF TEST_DOTTEDUNITS}
+  System.SysUtils, System.Classes, WinApi.Windows, System.Net.Ssockets,
+  System.Net.Sslsockets, System.Net.Sslbase, System.Net.SchannelSSLSockets,
+  WinApi.SchannelSSPI, FpWeb.Http.Client;
+{$ELSE}
+  SysUtils, Classes, Windows, ssockets, sslsockets, sslbase, schannelsslsockets,
+  schannelsspi, fphttpclient;
+{$ENDIF}
+
+type
+  TObserver = class
+    Calls: Integer;
+    procedure RawVerify(Sender: TObject; var Allow: Boolean);
+    procedure HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+
+procedure Check(Condition: Boolean; const MessageText: String);
+begin
+  if not Condition then raise Exception.Create(MessageText);
+end;
+
+function TickCount: QWord;
+begin
+  Result:={$IFDEF TEST_DOTTEDUNITS}System.{$ENDIF}SysUtils.GetTickCount64;
+end;
+
+procedure TObserver.RawVerify(Sender: TObject; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Check(Allow,'Unexpected callback input');
+  Allow:=ParamStr(7)<>'veto';
+end;
+
+procedure TObserver.HTTPVerify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  RawVerify(Handler,Allow);
+end;
+
+procedure CheckModules;
+var Snapshot: THandle; Entry: MODULEENTRY32; Name: String;
+begin
+  Snapshot:=CreateToolhelp32Snapshot(TH32CS_SNAPMODULE,GetCurrentProcessId);
+  Check(Snapshot<>INVALID_HANDLE_VALUE,'Cannot enumerate client modules');
+  try
+    FillChar(Entry,SizeOf(Entry),0);
+    Entry.dwSize:=SizeOf(Entry);
+    Check(Module32First(Snapshot,Entry),'Cannot read client module list');
+    repeat
+      Name:=LowerCase(StrPas(Entry.szModule));
+      Check((Pos('libssl',Name)=0) and (Pos('libcrypto',Name)=0) and
+        (Pos('gnutls',Name)=0) and (Name<>'ssleay32.dll') and
+        (Name<>'libeay32.dll'),'Third-party TLS module loaded: '+Name);
+    until not Module32Next(Snapshot,Entry);
+  finally CloseHandle(Snapshot) end;
+end;
+
+procedure Construct;
+var Handler: TSchannelSocketHandler; Rejected: Boolean;
+begin
+  Writeln('LAYOUT handle=',SizeOf(TSecHandle),' buffer=',SizeOf(TSecBuffer),
+    ' desc=',SizeOf(TSecBufferDesc),' cred=',SizeOf(TSchannelCred),
+    ' modern=',SizeOf(TSchCredentials));
+  Check(SizeOf(TSecHandle)=2*SizeOf(Pointer),'SSPI handle layout differs');
+  Check(SizeOf(TSecStreamSizes)=20,'SSPI stream-size layout differs');
+{$IFDEF CPU64}
+  Check((SizeOf(TSecBuffer)=16) and (SizeOf(TSecBufferDesc)=16) and
+    (SizeOf(TSchannelCred)=80) and (SizeOf(TSchCredentials)=72),'Win64 SSPI layout differs');
+{$ELSE}
+  Check((SizeOf(TSecBuffer)=12) and (SizeOf(TSecBufferDesc)=12) and
+    (SizeOf(TSchannelCred)=56) and (SizeOf(TSchCredentials)=44),'Win32 SSPI layout differs');
+{$ENDIF}
+  Handler:=TSchannelSocketHandler.Create;
+  try
+    Check(Handler.CertGenerator<>nil,'Certificate-generator contract broken');
+    Handler.RemoteHostName:='example.com';
+    Check(Handler.CertGenerator.HostName='example.com','Legacy hostname setter broken');
+    Rejected:=False;
+    try Handler.CreateSelfSignedCertificate
+    except on E: ESSLSocketError do Rejected:=True end;
+    Check(Rejected,'Certificate generation accepted');
+    Check(not Handler.VerifyPeerCert,'Handler verification default changed');
+    Check(not Handler.Accept,'Client-only handler accepted a connection');
+    Check((not Handler.SSLActive) and (Handler.LastSSLErrorCode<>0),'Accept did not fail closed');
+    Check(TSSLSocketHandler.GetDefaultHandlerClass=TSchannelSocketHandler,'Registration failed');
+  finally Handler.Free end;
+end;
+
+procedure CheckPattern(const Buffer; Count, Offset: Integer);
+var I: Integer;
+begin
+  for I:=0 to Count-1 do
+    Check((PByte(@Buffer)+I)^=Byte((Offset+I) mod 251),'Body differs at '+IntToStr(Offset+I));
+end;
+
+procedure CheckFailure(const ErrorText: String);
+begin
+  Check(ParamStr(4)='reject','Unexpected error: '+ErrorText);
+  Check((ParamStr(6)<>'') and (Pos(UpperCase(ParamStr(6)),UpperCase(ErrorText))>0),
+    'Expected specific TLS error '+ParamStr(6)+', got '+ErrorText);
+end;
+
+procedure HTTPTest;
+var Client: TFPHTTPClient; Observer: TObserver; Body: String; Failed: Boolean;
+begin
+  Client:=TFPHTTPClient.Create(nil);
+  Observer:=TObserver.Create;
+  try
+    Check(not Client.VerifySSLCertificate,'HTTP verification default changed');
+    if ParamStr(3)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(3));
+    if ParamStr(7)<>'none' then Client.OnVerifySSLCertificate:=@Observer.HTTPVerify;
+    Client.ConnectTimeout:=5000;
+    Client.IOTimeout:=3000;
+    Client.AllowRedirect:=False;
+    Failed:=False;
+    try Body:=Client.Get(ParamStr(2))
+    except on E: Exception do
+      begin Failed:=True; Writeln('ERROR ',E.Message); CheckFailure(E.Message) end end;
+    Check(Failed=(ParamStr(4)='reject'),'Invalid certificate or TLS failure accepted');
+    if not Failed then
+      begin
+      Check(Client.ResponseStatusCode=200,'Expected HTTP 200');
+      if ParamStr(5)='fixture' then Check(Body='local tls fixture'+#10,'HTTP body differs')
+      else if ParamStr(5)='pattern' then
+        begin
+        Check(Length(Body)=1048576,'Large HTTP body length differs');
+        CheckPattern(Body[1],Length(Body),0);
+        end
+      else Check(Length(Body)>0,'Empty public HTTPS response');
+      Writeln('BODY ',Length(Body));
+      end;
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected HTTP callback count');
+  finally Observer.Free; Client.Free end;
+end;
+
+procedure RawTest;
+var Handler: TSchannelSocketHandler; Stream: TInetSocket; Observer: TObserver;
+    Buffer: array[0..4095] of Byte; Upload: TBytes;
+    N, Total, Expected, I: Integer; Started: QWord; Failed: Boolean; Mode: String;
+begin
+  Handler:=TSchannelSocketHandler.Create;
+  Observer:=TObserver.Create;
+  if ParamStr(3)<>'default' then Handler.VerifyPeerCert:=StrToBool(ParamStr(3));
+  Handler.ServerName:=ParamStr(9);
+  if Handler.ServerName='nul' then Handler.ServerName:='localhost'+#0+'invalid';
+  if ParamStr(10)='tls12' then Handler.SSLType:=stTLSv1_2;
+  if ParamStr(7)<>'none' then Handler.OnVerifyCertificate:=@Observer.RawVerify;
+  if ParamStr(12)='' then Stream:=TInetSocket.Create('127.0.0.1',StrToInt(ParamStr(2)),Handler)
+  else Stream:=TInetSocket.Create(ParamStr(12),StrToInt(ParamStr(2)),Handler);
+  try
+    Stream.ConnectTimeout:=3000;
+    Stream.IOTimeout:=3000;
+    Mode:=ParamStr(5);
+    if Mode='handshake-timeout' then Stream.ConnectTimeout:=150;
+    if Mode='unsupported' then Handler.CertificateData.CertCA.FileName:='unsupported-test-ca.pem';
+    Failed:=False;
+    Started:=TickCount;
+    try
+      Stream.Connect;
+      Check(Handler.SSLActive,'Handshake did not activate TLS');
+      if Mode='connect-only' then
+        begin
+        Check(ParamStr(4)='ok','Expected certificate rejection missing');
+        Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+        Check(Handler.Shutdown(False),'Connected TLS close failed');
+        Check(not Handler.SSLActive,'Close left TLS active');
+        Check(Handler.Shutdown(False),'Repeated close failed');
+        Exit;
+        end;
+      if Mode='read-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(Stream.Read(Buffer,SizeOf(Buffer))=-1,'Read timeout did not fail');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if Mode='shutdown-timeout' then
+        begin
+        Stream.IOTimeout:=150;
+        Started:=TickCount;
+        Check(not Handler.Shutdown(True),'Unanswered bidirectional close succeeded');
+        raise Exception.Create(Handler.LastSSLErrorString);
+        end;
+      if (Mode='send') or (Mode='send-timeout') then
+        begin
+        N:=1048576;
+        if Mode='send-timeout' then
+          begin N:=16777216; Stream.IOTimeout:=150; Started:=TickCount end;
+        SetLength(Upload,N);
+        for I:=0 to N-1 do Upload[I]:=Byte(I mod 251);
+        I:=Stream.Write(Upload[0],N);
+        if I<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        Check(I=N,'Partial send reported as success');
+        end;
+      Expected:=StrToInt(ParamStr(11));
+      Total:=0;
+      repeat
+        Check(Stream.CanRead(3000),'Receive readiness timed out');
+        N:=SizeOf(Buffer);
+        if Total<16 then N:=1;
+        N:=Stream.Read(Buffer,N);
+        if N<0 then raise Exception.Create(Handler.LastSSLErrorString);
+        CheckPattern(Buffer,N,Total);
+        Inc(Total,N);
+        Check(Total<=Expected,'Extra TLS control bytes delivered as plaintext');
+      until N=0;
+      Check(Total=Expected,'Raw body length differs');
+      Check(Stream.Read(Buffer,1)=0,'EOF was not stable');
+      Check(Handler.Shutdown(True),'TLS close failed: '+Handler.LastSSLErrorString);
+      Check(not Handler.SSLActive,'Shutdown left TLS active');
+      Check(Handler.Shutdown(False),'Repeated shutdown failed');
+      Writeln('BODY ',Total);
+    except on E: Exception do
+      begin
+      Failed:=True;
+      Writeln('ERROR ',E.Message);
+      CheckFailure(E.Message);
+      Check(not Handler.SSLActive,'Failed TLS remained active');
+      end end;
+    if (Pos('timeout',Mode)>0) then Check(TickCount-Started<2000,'Deadline exceeded');
+    Check(Failed=(ParamStr(4)='reject'),'Expected TLS rejection missing');
+    Check(Observer.Calls=StrToInt(ParamStr(8)),'Unexpected raw callback count');
+  finally Stream.Free; Observer.Free end;
+end;
+
+begin
+  if ParamStr(1)='construct' then Construct
+  else if ParamStr(1)='http' then HTTPTest
+  else if ParamStr(1)='raw' then RawTest
+  else raise Exception.Create('Usage: construct | http/raw target verify expected mode code callback calls [name protocol bytes]');
+  CheckModules;
+  Writeln('PASS ',ParamStr(1),' no third-party TLS modules');
+end.
