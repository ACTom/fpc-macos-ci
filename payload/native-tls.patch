+  finally LeaveCriticalSection(GnuTLSCS) end;
+end;
+
+procedure LoadGnuTLS(alib: String = '');
+begin
+  EnterCriticalSection(GnuTLSCS);
+  try LoadGnuTLSLocked(alib,NilHandle) finally LeaveCriticalSection(GnuTLSCS) end;
+end;
+
+procedure AcquireGnuTLS(const LibName: String; CheckedHandle: TLibHandle);
+begin
+  if CheckedHandle=NilHandle then raise Exception.Create('GnuTLS checked handle is empty');
+  EnterCriticalSection(GnuTLSCS);
+  try
+    LoadGnuTLSLocked(LibName,CheckedHandle);
+    Inc(GnuTLSClaims);
+  finally LeaveCriticalSection(GnuTLSCS) end;
+end;
+
+procedure ReleaseGnuTLSClaim;
+begin
+  EnterCriticalSection(GnuTLSCS);
+  try if GnuTLSClaims>0 then Dec(GnuTLSClaims) finally LeaveCriticalSection(GnuTLSCS) end;
+end;
+
+initialization
+  InitCriticalSection(GnuTLSCS);
+finalization
+  DoneCriticalSection(GnuTLSCS);
 end.
