diff --git a/packages/fcl-web/tests/tcclientpeer.pp b/packages/fcl-web/tests/tcclientpeer.pp
new file mode 100644
index 000000000..cd8113a0b
--- /dev/null
+++ b/packages/fcl-web/tests/tcclientpeer.pp
@@ -0,0 +1,379 @@
+{ Part of FCL; see COPYING.FPC. HTTP peer ownership and dispatch tests. }
+unit tcclientpeer;
+{$mode objfpc}{$H+}
+
+interface
+
+uses
+{$ifdef FPC_DOTTEDUNITS}
+  System.SysUtils, System.Classes, FpcUnit.Test, FpcUnit.Registry, System.Net.Ssockets, System.Net.Sslbase,
+  System.Net.Sslsockets, System.Net.ClientPeers, FpWeb.Http.Client;
+{$else}
+  SysUtils, Classes, fpcunit, testregistry, ssockets, sslbase, sslsockets, clientpeers, fphttpclient;
+{$endif}
+
+type
+  TTestClientPeers = class(TTestCase)
+  private
+    FPreviousHandler: TSSLSocketHandlerClass;
+    FGetHandlerCalls, FCreatedHandlerCalls: Integer;
+    procedure GetHandler(Sender: TObject; const UseSSL: Boolean;
+      out Handler: TSocketHandler);
+    procedure HandlerCreated(Sender: TObject; Handler: TSocketHandler);
+    {$ifdef Unix}
+    procedure CheckUnixRoute(WithCallbacks: Boolean);
+    {$endif}
+  protected
+    procedure SetUp; override;
+    procedure TearDown; override;
+  published
+    procedure TestOwnershipAndDispatch;
+    {$ifdef Unix}
+    procedure TestUnixHTTPSWithoutTLSHandler;
+    procedure TestUnixHTTPSWithoutHandlerCallbacks;
+    {$endif}
+  end;
+
+implementation
+
+type
+  TTestHandler = class;
+  TCertificate = class(TX509Certificate)
+    function CreateCertificateAndKey: TCertAndKey; override;
+  end;
+  TTestPeer = class(TClientPeer)
+    Handler: TTestHandler;
+    Offset: Integer;
+    constructor Create(AHandler: TTestHandler);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+  end;
+  TTestHandler = class(TSSLSocketHandler)
+  protected
+    function GetLastSSLErrorString: String; override;
+    function GetLastSSLErrorCode: Integer; override;
+  public
+    constructor Create; override;
+    destructor Destroy; override;
+    class function RequiresClientPeer: Boolean; override;
+    function CreateCertGenerator: TX509Certificate; override;
+    function CreateClientPeer(const Host: String; Port: Word): TClientPeer; override;
+  end;
+  TLegacyHandler = class(TTestHandler)
+  public
+    class function RequiresClientPeer: Boolean; override;
+    function CreateClientPeer(const Host: String; Port: Word): TClientPeer; override;
+  end;
+  TClient = class(TFPHTTPClient)
+  public
+    procedure Open(const Host: String; Port: Integer; SSL: Boolean);
+    procedure Disconnect;
+    function Connected: Boolean;
+    procedure EventStream;
+  end;
+
+const
+  Reply = 'HTTP/1.1 200 OK'+#13#10+'Content-Length: 3'+#13#10+#13#10+'abc';
+var
+  Peers, Handlers, CreatedHandlers, ConnectedCount, FactoryCalls, Checks: Integer;
+  FactoryRaises, ConnectRaises: Boolean;
+  LastVerify: Boolean;
+
+procedure Check(Value: Boolean; const What: String);
+begin
+  Inc(Checks);
+  if not Value then
+    TAssert.Fail(What);
+end;
+
+function TCertificate.CreateCertificateAndKey: TCertAndKey;
+begin
+  raise ESSLSocketError.Create('Test certificate generation unsupported');
+end;
+
+function TTestHandler.CreateCertGenerator: TX509Certificate;
+begin
+  Result:=TCertificate.Create;
+end;
+
+function TTestHandler.GetLastSSLErrorString: String;
+begin
+  Result:='';
+end;
+
+function TTestHandler.GetLastSSLErrorCode: Integer;
+begin
+  Result:=0;
+end;
+
+constructor TTestHandler.Create;
+begin
+  inherited Create;
+  Inc(CreatedHandlers);
+end;
+
+class function TTestHandler.RequiresClientPeer: Boolean;
+begin
+  Result:=True;
+end;
+
+class function TLegacyHandler.RequiresClientPeer: Boolean;
+begin
+  Result:=False;
+end;
+
+function TLegacyHandler.CreateClientPeer(const Host: String; Port: Word): TClientPeer;
+begin
+  Inc(FactoryCalls);
+  Result:=Nil;
+end;
+
+destructor TTestHandler.Destroy;
+begin
+  Inc(Handlers);
+  inherited Destroy;
+end;
+
+function TTestHandler.CreateClientPeer(const Host: String; Port: Word): TClientPeer;
+begin
+  Inc(FactoryCalls);
+  Check((Host<>'') and (Port>0),'factory has endpoint before TCP');
+  if FactoryRaises then
+    raise ESSLSocketError.Create('Test factory failure');
+  Result:=TTestPeer.Create(Self);
+end;
+
+constructor TTestPeer.Create(AHandler: TTestHandler);
+begin
+  inherited Create;
+  Handler:=AHandler;
+end;
+
+destructor TTestPeer.Destroy;
+begin
+  Inc(Peers);
+  Handler.Free;
+  inherited Destroy;
+end;
+
+procedure TTestPeer.Connect;
+begin
+  Inc(ConnectedCount);
+  LastVerify:=Handler.VerifyPeerCert;
+  if ConnectRaises then
+    raise ESSLSocketError.Create('Test handshake failure');
+end;
+
+procedure TTestPeer.Close;
+begin
+end;
+
+function TTestPeer.Read(var Buffer; Count: LongInt): LongInt;
+begin
+  Result:=Length(Reply)-Offset;
+  if Result>Count then Result:=Count;
+  if Result>0 then Move(Reply[Offset+1],Buffer,Result);
+  Inc(Offset,Result);
+end;
+
+function TTestPeer.Write(const Buffer; Count: LongInt): LongInt;
+begin
+  Offset:=0;
+  Result:=Count;
+end;
+
+function TTestPeer.CanRead(Timeout: Integer): Boolean;
+begin
+  Result:=True;
+end;
+
+function TTestPeer.BytesAvailable: Integer;
+begin
+  Result:=Length(Reply)-Offset;
+end;
+
+procedure TClient.Open(const Host: String; Port: Integer; SSL: Boolean);
+begin
+  ConnectToServer(Host,Port,SSL);
+end;
+
+procedure TClient.Disconnect;
+begin
+  DisconnectFromServer;
+end;
+
+function TClient.Connected: Boolean;
+begin
+  Result:=IsConnected;
+end;
+
+procedure TClient.EventStream;
+begin
+  StartEventStream;
+end;
+
+procedure TTestClientPeers.SetUp;
+begin
+  inherited SetUp;
+  FPreviousHandler:=TSSLSocketHandler.GetDefaultHandlerClass;
+  Peers:=0; Handlers:=0; CreatedHandlers:=0;
+  ConnectedCount:=0; FactoryCalls:=0; Checks:=0;
+  FGetHandlerCalls:=0; FCreatedHandlerCalls:=0;
+  FactoryRaises:=False; ConnectRaises:=False; LastVerify:=False;
+  TSSLSocketHandler.SetDefaultHandlerClass(TTestHandler);
+end;
+
+procedure TTestClientPeers.GetHandler(Sender: TObject; const UseSSL: Boolean;
+  out Handler: TSocketHandler);
+begin
+  Inc(FGetHandlerCalls);
+  Handler:=Nil;
+end;
+
+procedure TTestClientPeers.HandlerCreated(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(FCreatedHandlerCalls);
+end;
+
+{$ifdef Unix}
+procedure TTestClientPeers.CheckUnixRoute(WithCallbacks: Boolean);
+var
+  C: TClient;
+  Server: TUnixServer;
+  SocketName: String;
+begin
+  SocketName:=GetTempFileName('','fpc-http-peer-');
+  Server:=Nil;
+  C:=Nil;
+  try
+    Server:=TUnixServer.Create(SocketName);
+    Server.Listen;
+    C:=TClient.Create(Nil);
+    C.UnixSocketPath:=SocketName;
+    if WithCallbacks then
+      begin
+      TSSLSocketHandler.SetDefaultHandlerClass(TLegacyHandler);
+      C.OnGetSocketHandler:=@GetHandler;
+      C.AfterSocketHandlerCreate:=@HandlerCreated;
+      end
+    else
+      TSSLSocketHandler.SetDefaultHandlerClass(Nil);
+    { HTTPS must retain the historical explicit Unix socket route, including
+      its independence from TLS handler registration and creation callbacks. }
+    C.Open('unused.invalid',0,True);
+    AssertTrue('HTTPS Unix route exposes the original Unix socket',C.Socket is TUnixSocket);
+    AssertTrue('Unix socket connection established',C.Connected);
+    AssertEquals('Unix route must skip OnGetSocketHandler',0,FGetHandlerCalls);
+    AssertEquals('Unix route must skip AfterSocketHandlerCreate',0,FCreatedHandlerCalls);
+    AssertEquals('Unix route must not construct a TLS handler',0,CreatedHandlers);
+    AssertEquals('Unix route must not call a TLS peer factory',0,FactoryCalls);
+  finally
+    C.Free;
+    Server.Free;
+    DeleteFile(SocketName);
+  end;
+end;
+
+procedure TTestClientPeers.TestUnixHTTPSWithoutTLSHandler;
+begin
+  CheckUnixRoute(False);
+end;
+
+procedure TTestClientPeers.TestUnixHTTPSWithoutHandlerCallbacks;
+begin
+  CheckUnixRoute(True);
+end;
+{$endif}
+
+procedure TTestClientPeers.TearDown;
+begin
+  TSSLSocketHandler.SetDefaultHandlerClass(FPreviousHandler);
+  FactoryRaises:=False; ConnectRaises:=False;
+  inherited TearDown;
+end;
+
+procedure TTestClientPeers.TestOwnershipAndDispatch;
+var
+  C: TClient;
+  P, H, N: Integer;
+  {$ifdef Unix}
+  F, Created: Integer;
+  {$endif}
+  Failed: Boolean;
+begin
+    Check(not TSSLSocketHandler.RequiresClientPeer,'default provider retains socket route');
+    Check(not TLegacyHandler.RequiresClientPeer,'legacy provider retains socket route');
+    Check(TTestHandler.RequiresClientPeer,'transport-owning provider declares peer requirement');
+    C:=TClient.Create(Nil);
+    try
+      C.ConnectTimeout:=31;
+      C.IOTimeout:=43;
+      C.Open('no-tcp.invalid',443,True);
+      Check(C.Connected and (C.Socket=Nil),'peer established without raw socket');
+      Check(not LastVerify,'existing default False forwarded');
+      Failed:=False;
+      try C.ExtractSocket except on E: EHTTPClient do Failed:=True end;
+      Check(Failed and C.Connected,'unsupported ExtractSocket retains peer');
+      Failed:=False;
+      try C.EventStream except on E: EHTTPClient do Failed:=True end;
+      Check(Failed and C.Connected,'SSE refusal retains peer');
+      C.Disconnect;
+      Check(not C.Connected,'disconnect frees peer');
+      C.VerifySSLCertificate:=True;
+      C.KeepConnection:=True;
+      Check(C.Get('https://no-tcp.invalid:443/')='abc','HTTP read/write dispatch');
+      N:=ConnectedCount;
+      Check(C.Get('https://no-tcp.invalid:443/')='abc','reuse response');
+      Check(ConnectedCount=N,'same endpoint reuses native peer');
+      Check(C.Get('https://other.invalid:443/')='abc','changed host response');
+      Check(ConnectedCount=N+1,'changed host replaces native peer');
+      Check(LastVerify,'True forwarded');
+      C.Disconnect;
+
+      P:=Peers; H:=Handlers;
+      FactoryRaises:=True;
+      Failed:=False;
+      try C.Open('invalid',443,True) except on E: ESSLSocketError do Failed:=True end;
+      FactoryRaises:=False;
+      Check(Failed and not C.Connected,'factory error remains terminal');
+      Check((Peers=P) and (Handlers=H+1),'caller frees handler after factory exception');
+
+      P:=Peers; H:=Handlers;
+      ConnectRaises:=True;
+      Failed:=False;
+      try C.Open('invalid',443,True) except on E: ESSLSocketError do Failed:=True end;
+      ConnectRaises:=False;
+      Check(Failed and not C.Connected,'handshake error remains terminal');
+      Check((Peers=P+1) and (Handlers=H+1),'failed Connect frees owned handler once');
+
+      C.Proxy.Host:='proxy.invalid'; C.Proxy.Port:=8080;
+      N:=ConnectedCount; P:=Peers; H:=Handlers;
+      Failed:=False;
+      try C.Get('https://target.invalid/') except on E: EHTTPClient do Failed:=True end;
+      Check(Failed and (ConnectedCount=N),'proxy rejected before native Connect');
+      Check((Peers=P+1) and (Handlers=H+1),'proxy rejection frees owned handler once');
+      C.Proxy.Host:='';
+      C.UnixSocketPath:='/no-socket';
+      {$ifdef Unix}
+      F:=FactoryCalls; Created:=CreatedHandlers;
+      {$endif}
+      Failed:=False;
+      try C.Open('target.invalid',443,True) except on E: EHTTPClient do Failed:=True end;
+      Check(Failed and (ConnectedCount=N),'Unix route rejected before native Connect');
+      {$ifdef Unix}
+      Check((FactoryCalls=F) and (CreatedHandlers=Created),
+        'Unix route rejected without constructing a transport-owning handler');
+      {$endif}
+      C.UnixSocketPath:='';
+    finally C.Free end;
+    Check(Peers=Handlers-1,'all peers/handlers released, including factory failure');
+end;
+
+initialization
+  RegisterTest(TTestClientPeers);
+end.
