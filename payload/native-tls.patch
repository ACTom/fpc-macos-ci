+interface
+type
+  TFPNWCreate = function(Host, Port: PAnsiChar; VerifyPeer: LongInt;
+    out Domain, Code: LongInt): Pointer; cdecl;
+  TFPNWConnect = function(Context: Pointer; Timeout: Cardinal;
+    out Domain, Code: LongInt): LongInt; cdecl;
+  TFPNWRead = function(Context, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+    out Domain, Code: LongInt): LongInt; cdecl;
+  TFPNWWrite = function(Context, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+    out Domain, Code: LongInt): LongInt; cdecl;
+  TFPNWCanRead = function(Context: Pointer; Timeout: Cardinal;
+    out Domain, Code: LongInt): LongInt; cdecl;
+  TFPNWBytesAvailable = function(Context: Pointer): LongInt; cdecl;
+  TFPNWContextProc = procedure(Context: Pointer); cdecl;
+  TFPNWAPI = record
+    CreateConnection: TFPNWCreate;
+    Connect: TFPNWConnect;
+    Read: TFPNWRead;
+    Write: TFPNWWrite;
+    CanRead: TFPNWCanRead;
+    BytesAvailable: TFPNWBytesAvailable;
+    Close, Retain, Release: TFPNWContextProc;
+  end;
+implementation
+end.
