+program testverifyoptions;
+{$mode objfpc}{$H+}
+uses SysUtils, Classes, fphttpclient, ssockets, sslsockets, openssl, opensslsockets,
+  smartsslsockets, schannelsslsockets;
+type
+  TObserver = class
+    Calls: Integer;
+    procedure Verify(Sender: TObject; AHandler: TSSLSocketHandler; var Allow: Boolean);
+    procedure Created(Sender: TObject; AHandler: TSocketHandler);
+  end;
+procedure TObserver.Verify(Sender: TObject; AHandler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Writeln('CALLBACK input=',Allow,' peer_verify=',AHandler.VerifyPeerCert);
+  Allow:=StrToBool(ParamStr(3));
+end;
+procedure TObserver.Created(Sender: TObject; AHandler: TSocketHandler);
+begin
+  Writeln('AFTER_CREATE class=',AHandler.ClassName,' peer_verify=',TSSLSocketHandler(AHandler).VerifyPeerCert);
+  if ParamStr(4)='false' then TSSLSocketHandler(AHandler).VerifyPeerCert:=False;
+end;
+var C: TFPHTTPClient; O: TObserver; B, ErrorText: String; OK: Boolean; Iter, Arg: Integer;
+begin
+  if ParamStr(1)='legacy' then
+    begin
+    if not InitSSLInterface(GetEnvironmentVariable('TLS_SSL_LIBRARY'),GetEnvironmentVariable('TLS_CRYPTO_LIBRARY')) then
+      raise Exception.Create('OpenSSL initialization failed');
+    TSSLSocketHandler.SetDefaultHandlerClass(TOpenSSLSocketHandler);
+    end
+  else if ParamStr(1)='smart' then
+    begin
+    SetSmartTLSLibraryPaths(GetEnvironmentVariable('TLS_SSL_LIBRARY'),GetEnvironmentVariable('TLS_CRYPTO_LIBRARY'),'');
+    SetSmartTLSBackend(tbOpenSSL);
+    end
+  else if ParamStr(1)='native' then SetSmartTLSBackend(tbSchannel)
+  else raise Exception.Create('Bad mode');
+  C:=TFPHTTPClient.Create(nil); O:=TObserver.Create;
+  try
+    Writeln('CLIENT_DEFAULT=',C.VerifySSLCertificate);
+    if C.VerifySSLCertificate then raise Exception.Create('HTTP default changed');
+    if ParamStr(2)<>'default' then C.VerifySSLCertificate:=StrToBool(ParamStr(2));
+    C.OnVerifySSLCertificate:=@O.Verify;
+    C.AfterSocketHandlerCreate:=@O.Created;
+    if ParamStr(1)='legacy' then C.CertCAFileName:=GetEnvironmentVariable('SSL_CERT_FILE');
+    C.ConnectTimeout:=5000; C.IOTimeout:=5000;
+    for Iter:=0 to Ord(ParamCount>=12) do
+      begin
+      Arg:=Iter*4;
+      if Iter=1 then C.VerifySSLCertificate:=StrToBool(ParamStr(9));
+      O.Calls:=0;
+    OK:=False; ErrorText:='';
+    try
+      B:=C.Get(ParamStr(5));
+      OK:=(C.ResponseStatusCode=200) and (B='local tls fixture'+#10);
+    except on E: Exception do begin ErrorText:=E.Message; Writeln('ERROR ',ErrorText) end end;
+    Writeln('RESULT ok=',OK,' callbacks=',O.Calls);
+    if OK<>StrToBool(ParamStr(6+Arg)) then raise Exception.Create('Unexpected request result');
+    if O.Calls<>StrToInt(ParamStr(7+Arg)) then raise Exception.Create('Unexpected callback count');
+    if (ParamStr(8+Arg)<>'none') and (Pos(ParamStr(8+Arg),ErrorText)=0) then
+      raise Exception.Create('Expected a certificate rejection, not another failure');
+      end;
+  finally O.Free; C.Free end;
+end.
diff --git a/packages/fcl-tls/tests/tlsrelay.py b/packages/fcl-tls/tests/tlsrelay.py
