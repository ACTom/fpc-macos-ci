+++ b/packages/fcl-net/tests/networkframework/run.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+set -euo pipefail
+source_dir="${1:?FPC source root}"
+output_dir="${2:?Fresh output directory}"
+compiler="${3:?Matching branch compiler}"
+sdk="${4:?Apple macOS SDK path}"
+test "$(uname -s)" = Darwin
+test ! -e "$output_dir"
+mkdir -p "$output_dir"
+if [[ "$(uname -m)" = arm64 ]]; then cpu=aarch64; minimum=11.0; else cpu=x86_64; minimum=10.8; fi
+tools="$(dirname "$(xcrun --sdk macosx --find ld)")"
+options=(-n -gl -dFPC_NETWORKFRAMEWORK_DIAGNOSTICS "-XR$sdk" "-WM$minimum" "-FD$tools"
+  "-Fu$source_dir/rtl/units/$cpu-darwin" "-Fu$source_dir/packages/fcl-net/src"
+  "-Fi$source_dir/packages/fcl-net/src/unix" "-Fi$source_dir/packages/fcl-net/tests/networkframework"
+  "-Fu$source_dir/packages/fcl-web/src/base"
+  "-FU$output_dir" "-FE$output_dir")
+for package in rtl-objpas rtl-extra fcl-base fcl-web; do
+  options+=("-Fu$source_dir/packages/$package/units/$cpu-darwin")
+done
+cd "$output_dir"
+for program in testnetworknative testnetworkhttp testnetworkpeer; do
+  "$compiler" "${options[@]}" "$source_dir/packages/fcl-net/tests/networkframework/$program.pp"
+done
+"$output_dir/testnetworknative"
+"$output_dir/testnetworkpeer"
+"$compiler" "${options[@]}" "$source_dir/packages/fcl-web/tests/testclientpeer.pp"
+"$output_dir/testclientpeer"
+otool -L "$output_dir/testnetworkhttp" | tee "$output_dir/native-imports.txt"
+if grep -Ei 'Network.framework|Security.framework|libssl|libcrypto|libgnutls' "$output_dir/native-imports.txt"; then
+  echo 'FAIL unexpected strong framework/third-party TLS dependency' >&2
+  exit 1
+fi
+python3 "$source_dir/packages/fcl-net/tests/networkframework/testnetworktls.py"   "$output_dir/testnetworknative" "$output_dir/testnetworkhttp" "$output_dir/tls-fixtures"   --peer "$output_dir/testnetworkpeer"
diff --git a/packages/fcl-net/tests/networkframework/testnetworkhttp.pp b/packages/fcl-net/tests/networkframework/testnetworkhttp.pp
new file mode 100644
index 00000000..c3fa0a3e
--- /dev/null
+++ b/packages/fcl-net/tests/networkframework/testnetworkhttp.pp
@@ -0,0 +1,112 @@
+{ Real macOS HTTP acceptance harness. Run with the sibling Python fixture.
+  Requires cthreads first, native provider and diagnostic counters. }
+program testnetworkhttp;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+  SysUtils, Classes, fphttpclient, ssockets, sslsockets, networkframeworksslsockets,
+  networkframeworknative;
+type
+  TNativeHTTPClient = class(TFPHTTPClient)
+  public
+    property KeepConnectionReconnectLimit;
+  end;
+  TObserver = class
+    CreatedCount, Calls: Integer;
+    CallbackAllow, DisableAfterCreate: Boolean;
+    ExpectedVerify: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+procedure Require(Value: Boolean; const MessageText: String);
+begin if not Value then raise Exception.Create('FAIL '+MessageText) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Require(Handler is TNetworkFrameworkSocketHandler,'native handler selected');
+  Require(TSSLSocketHandler(Handler).VerifyPeerCert=ExpectedVerify,'HTTP verification forwarded');
+  Require(TSSLSocketHandler(Handler).CertGenerator<>nil,'no external certificate generator');
+  if DisableAfterCreate then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Require(Handler is TNetworkFrameworkSocketHandler,'callback has native handler');
+  Require(Allow,'legacy callback starts with Allow=True');
+  Allow:=CallbackAllow;
+end;
+function CertificateFailure(Domain, Code: LongInt): Boolean;
+begin
+  { Apple Security/base/SecBase.h: network TLS domain uses these SSL codes.
+    A TCP reset, EOF, timeout or generic handshake error is never a pass. }
+  Result:=(Domain=3) and ((Code=-9807) or (Code=-9808) or (Code=-9812) or (Code=-9813) or
+    (Code=-9814) or (Code=-9815) or (Code=-9843));
+end;
+var Client: TNativeHTTPClient; Observer: TObserver; URL, Expected, BodyMode, Body,
+    Failure: String; Requests, Index, Domain, Code: LongInt; Succeeded: Boolean;
+    Started: QWord; Output: TStringStream; ExpectedStatus: Integer;
+begin
+  try
+    Require(ParamCount=8,'usage: URL default|true|false callback after_false expected callbacks body_mode requests');
+    URL:=ParamStr(1); Expected:=ParamStr(5); BodyMode:=ParamStr(7);
+    Requests:=StrToInt(ParamStr(8)); Require(Requests>0,'positive request count');
+    Require((Expected='pass') or (Expected='certificate') or (Expected='veto'),'known expectation');
+    TSSLSocketHandler.SetDefaultHandlerClass(TNetworkFrameworkSocketHandler);
+    Observer:=TObserver.Create; Client:=TNativeHTTPClient.Create(nil);
+    try
+      Require(not Client.VerifySSLCertificate,'existing default remains False');
+      if ParamStr(2)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(2));
+      Observer.ExpectedVerify:=Client.VerifySSLCertificate;
+      Observer.CallbackAllow:=StrToBool(ParamStr(3));
+      Observer.DisableAfterCreate:=StrToBool(ParamStr(4));
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=10000; Client.IOTimeout:=5000;
+      Client.KeepConnection:=Requests>1; Client.KeepConnectionReconnectLimit:=0;
+      Succeeded:=False; Domain:=0; Code:=0; Failure:='';
+      try
+        for Index:=1 to Requests do
+          begin
+          Output:=TStringStream.Create('');
+          try
+            if BodyMode='head' then Client.HTTPMethod('HEAD',URL,Output,[])
+            else Client.HTTPMethod('GET',URL,Output,[]);
+            Body:=Output.DataString;
+          finally Output.Free end;
+          ExpectedStatus:=200;
+          if BodyMode='204' then ExpectedStatus:=204 else if BodyMode='304' then ExpectedStatus:=304
+          else if BodyMode='101' then ExpectedStatus:=101;
+          Require(Client.ResponseStatusCode=ExpectedStatus,'exact HTTP status');
+          if BodyMode='local' then Require(Body='native tls fixture'+#10,'exact local HTTP contents')
+          else if BodyMode='public' then Require(Length(Body)>0,'public response body')
+          else Require(Body='','bodyless HTTP response');
+          end;
+        Succeeded:=True;
+      except
+        on E: ENetworkFrameworkTLS do
+          begin Domain:=E.Domain; Code:=E.NativeCode; Failure:=E.Message end;
+        on E: Exception do Failure:=E.ClassName+': '+E.Message;
+      end;
+      Writeln('RESULT success=',Succeeded,' created=',Observer.CreatedCount,
+        ' callbacks=',Observer.Calls,' domain=',Domain,' code=',Code,' error=',Failure);
+      if Expected='pass' then Require(Succeeded,'request must succeed')
+      else if Expected='certificate' then
+        Require(not Succeeded and CertificateFailure(Domain,Code),'specific certificate rejection required')
+      else if Expected='veto' then
+        Require(not Succeeded and (Pos('application certificate veto',LowerCase(Failure))>0),'callback veto required');
+      Require(Observer.Calls=StrToInt(ParamStr(6)),'exact callback count');
+      if (Expected='pass') and (Requests>1) then Require(Observer.CreatedCount=1,'same native TLS connection reused');
+      Require(TSSLSocketHandler.GetDefaultHandlerClass=TNetworkFrameworkSocketHandler,
+        'backend remains fixed');
+    finally
+      Client.Free; Observer.Free;
+    end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Started:=GetTickCount64;
+    while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+    Require(NetworkFrameworkLiveContexts=0,'native callbacks release all contexts');
+    Writeln('PASS contexts drained; destroyed=',NetworkFrameworkDestroyedContexts);
+{$endif}
+    Writeln('PASS native fphttpclient ',Expected);
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-net/tests/networkframework/testnetworknative.pp b/packages/fcl-net/tests/networkframework/testnetworknative.pp
new file mode 100644
index 00000000..9d5f3457
--- /dev/null
+++ b/packages/fcl-net/tests/networkframework/testnetworknative.pp
@@ -0,0 +1,338 @@
+{ Part of FCL; see COPYING.FPC.
+  Integration harness for the pure Pascal native provider; no C object required.
+  No arguments: construction/argument/retained owner tests, no connection starts.
+  host port verify ready: TLS handshake must succeed (verify is exactly 0 or 1).
+  host port verify error domain code: exact native connection failure expected.
+  host port verify echo: fragmented 1 MiB, partial writes, readiness timeout reuse.
+  host port verify timeout: TLS fixture sends no application data.
+  host port verify close: same idle fixture; Close interrupts unlimited Read.
+  host port verify canclose: Close interrupts unlimited CanRead.
+  host port verify eof: fixture sends 'abc' then ends TLS cleanly.
+  host port verify reset: fixture aborts TCP; must report an error, never EOF.
+  Certificates, server connection counts, fixtures and trust belong to the macOS
+  runner. This program never changes system trust or provisions a server.
+  Build with -Fu../../src -Fi. -FU<output> -FE<output> testnetworknative.pp.
+  Define FPC_NETWORKFRAMEWORK_MODEL on Windows to run shared production state
+  tests only: this does not compile cblocks or prove native/TLS operation. }
+program testnetworknative;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}
+  cthreads,
+{$endif}
+  SysUtils, Classes, networkframeworknative;
+
+{$ifndef FPC_NETWORKFRAMEWORK_MODEL}
+const
+  DeadlineMS = 5000;
+  POSIXDomain = 1;
+  DarwinEINVAL = 22;
+  DarwinETIMEDOUT = 60;
+  DarwinECANCELED = 89;
+  PlaintextCapacity = 16384;
+
+procedure Check(Condition: Boolean; const What: String; Domain, Code: LongInt);
+begin
+  if not Condition then
+    raise Exception.CreateFmt('FAIL %s (domain=%d code=%d)',[What,Domain,Code]);
+end;
+
+procedure Construction;
+var Context: Pointer; Domain, Code, Status, Verify: LongInt;
+begin
+  Domain:=0; Code:=0;
+  Context:=NativeCreate(nil,'443',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'null hostname rejected',Domain,Code);
+  Context:=NativeCreate('localhost','0',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'invalid port rejected',Domain,Code);
+  for Verify:=0 to 1 do
+    begin
+    Context:=NativeCreate('localhost','443',Verify,Domain,Code);
+    Check(Context<>nil,'construction',Domain,Code);
+    Check(NativeBytesAvailable(Context)=0,'no premature plaintext',0,0);
+    NativeRetain(Context);
+    NativeClose(Context);
+    try
+      Status:=NativeConnect(Context,1,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinECANCELED),
+        'closed unstarted context valid under operation hold',Domain,Code);
+    finally NativeRelease(Context) end;
+    end;
+  Writeln('PASS construction/arguments/retained close; no connection started');
+end;
+
+procedure Echo(Context: Pointer);
+var Sent: array[0..32768] of Byte; Received: array[0..252] of Byte;
+    Offset, Size, Consumed, Returned, Offered, Count, Index, Block: LongInt;
+    Domain, Code: LongInt; Marker: AnsiString;
+begin
+  Offset:=0; Block:=0;
+  while Offset<1024*1024 do
+    begin
+    if Odd(Block) then Size:=Length(Sent) else Size:=137;
+    if Size>1024*1024-Offset then Size:=1024*1024-Offset;
+    for Index:=0 to Size-1 do Sent[Index]:=(Offset+Index) mod 251;
+    Consumed:=0;
+    while Consumed<Size do
+      begin
+      Count:=NativeWrite(Context,@Sent[Consumed],Size-Consumed,DeadlineMS,Domain,Code);
+      Check((Count>0) and (Count<=PlaintextCapacity) and (Count<=Size-Consumed),
+        'bounded partial write',Domain,Code);
+      Returned:=0;
+      while Returned<Count do
+        begin
+        Offered:=Count-Returned;
+        if Offered>Length(Received) then Offered:=Length(Received);
+        Offered:=NativeRead(Context,@Received,Offered,DeadlineMS,Domain,Code);
+        Check((Offered>0) and (Offered<=Count-Returned),'fragmented read',Domain,Code);
+        for Index:=0 to Offered-1 do
+          Check(Received[Index]=Sent[Consumed+Returned+Index],
+            'exact echo contents',Domain,Code);
+        Inc(Returned,Offered);
+        end;
+      Inc(Consumed,Count);
+      end;
+    Inc(Offset,Size); Inc(Block);
+    end;
+  Count:=NativeCanRead(Context,1,Domain,Code);
+  Check((Count=0) and (Domain=0) and (Code=0),'benign idle readiness timeout',Domain,Code);
+  Marker:='xyz';
+  Count:=NativeWrite(Context,PAnsiChar(Marker),3,DeadlineMS,Domain,Code);
+  Check(Count=3,'usable write after readiness timeout',Domain,Code);
+  Offset:=0;
+  while Offset<3 do
+    begin
+    Count:=NativeRead(Context,@Received,3-Offset,DeadlineMS,Domain,Code);
+    Check((Count>0) and (Count<=3-Offset),'receive after readiness timeout',Domain,Code);
+    for Index:=0 to Count-1 do
+      Check(Received[Index]=Ord(Marker[Offset+Index+1]),'reuse contents',Domain,Code);
+    Inc(Offset,Count);
+    end;
+  Writeln('PASS 1 MiB fragmented echo/partial writes/readiness timeout reuse');
+end;
+
+procedure WriteTimeout(Context: Pointer);
+var Buffer: array[0..16383] of Byte; Count, Domain, Code: LongInt;
+    Sent, Started: QWord;
+begin
+  FillChar(Buffer,SizeOf(Buffer),$a5); Sent:=0; Started:=GetTickCount64;
+  repeat
+    Count:=NativeWrite(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+    if Count>0 then Inc(Sent,Count);
+  until (Count<0) or (Sent>=64*1024*1024) or (GetTickCount64-Started>=5000);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'terminal send deadline under fixture backpressure',Domain,Code);
+  FillChar(Buffer,SizeOf(Buffer),$5a); Sleep(100);
+  Count:=NativeWrite(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'send deadline remains terminal',Domain,Code);
+  Writeln('PASS terminal send deadline; bytes queued before timeout=',Sent);
+end;
+
+type
+  TBlockingCaller = class(TThread)
+  public
+    Context: Pointer;
+    Readiness: Boolean;
+    Entered, Completed, Status, Domain, Code: LongInt;
+    constructor Create(Value: Pointer; IsReadiness: Boolean);
+    procedure Execute; override;
+  end;
+
+constructor TBlockingCaller.Create(Value: Pointer; IsReadiness: Boolean);
+begin
+  inherited Create(True);
+  Context:=Value; Readiness:=IsReadiness;
+end;
+
+procedure TBlockingCaller.Execute;
+var ByteValue: Byte;
+begin
+  try
+    InterlockedExchange(Entered,1);
+    if Readiness then Status:=NativeCanRead(Context,High(Cardinal),Domain,Code)
+    else Status:=NativeRead(Context,@ByteValue,1,0,Domain,Code);
+  finally
+    NativeRelease(Context);
+    InterlockedExchange(Completed,1);
+  end;
+end;
+
+procedure ConcurrentClose(var Context: Pointer; Readiness: Boolean);
+var Caller: TBlockingCaller; Start: QWord;
+begin
+  NativeRetain(Context);
+  try Caller:=TBlockingCaller.Create(Context,Readiness)
+  except NativeRelease(Context); raise end;
+  Caller.Start;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Entered,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Entered<>0,'caller thread entered',0,0);
+  Sleep(20);
+  NativeClose(Context); Context:=nil;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Completed,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Completed<>0,'Close wakes caller promptly',0,0);
+  Caller.WaitFor;
+  try
+    Check((Caller.Status=-1) and (Caller.Domain=POSIXDomain) and
+      (Caller.Code=DarwinECANCELED),'concurrent Close cancellation',Caller.Domain,Caller.Code);
+  finally Caller.Free end;
+  Writeln('PASS concurrent Close interrupts unlimited caller under operation hold');
+end;
+
+procedure AwaitNativeRelease;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+var Started: QWord;
+{$endif}
+begin
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  Started:=GetTickCount64;
+  while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+  Check(NetworkFrameworkLiveContexts=0,'all native contexts eventually released',0,0);
+  Writeln('PASS native context release; destroyed=',NetworkFrameworkDestroyedContexts);
+{$else}
+  Writeln('NOT RUN context-release observation: build with FPC_NETWORKFRAMEWORK_DIAGNOSTICS');
+{$endif}
+end;
+
+procedure RunNative;
+var Context: Pointer; Host, Port, Mode: AnsiString;
+    Verify, Domain, Code, Status, ExpectedDomain, ExpectedCode, Count, Index: LongInt;
+    ByteValue: Byte; Bytes: array[0..2] of Byte;
+begin
+  if not NetworkFrameworkAvailable then
+    begin
+    Writeln('SKIP native Network.framework provider unavailable: ',NetworkFrameworkAvailabilityError);
+    Halt(77);
+    end;
+  if ParamCount=0 then begin Construction; Exit end;
+  if (ParamCount<>4) and (ParamCount<>6) then
+    raise Exception.Create('usage: host port 0|1 ready|echo|timeout|writetimeout|connecttimeout|close|canclose|eof|reset; or host port 0|1 error domain code');
+  Host:=ParamStr(1); Port:=ParamStr(2); Mode:=ParamStr(4);
+  Check(TryStrToInt(ParamStr(3),Verify) and ((Verify=0) or (Verify=1)),
+    'verification is exactly 0 or 1',0,0);
+  if Mode='error' then
+    begin
+    Check((ParamCount=6) and TryStrToInt(ParamStr(5),ExpectedDomain) and
+      TryStrToInt(ParamStr(6),ExpectedCode) and (ExpectedDomain<>0) and
+      (ExpectedCode<>0),'explicit expected native error required',0,0);
+    end
+  else Check((ParamCount=4) and ((Mode='ready') or (Mode='echo') or
+    (Mode='timeout') or (Mode='close') or (Mode='canclose') or (Mode='eof') or
+    (Mode='reset') or (Mode='writetimeout') or (Mode='connecttimeout') or (Mode='finobserve') or (Mode='eofobserve')),'known test mode',0,0);
+  Context:=NativeCreate(PAnsiChar(Host),PAnsiChar(Port),Verify,Domain,Code);
+  Check(Context<>nil,'create',Domain,Code);
+  try
+    if Mode='connecttimeout' then Status:=NativeConnect(Context,100,Domain,Code)
+    else Status:=NativeConnect(Context,DeadlineMS,Domain,Code);
+    if Mode='connecttimeout' then
+      begin
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal handshake deadline',Domain,Code);
+      Writeln('PASS terminal handshake deadline'); Exit;
+      end;
+    if Mode='error' then
+      begin
+      Check((Status=-1) and (Domain=ExpectedDomain) and (Code=ExpectedCode),
+        'exact expected native connection error',Domain,Code);
+      Writeln('PASS exact expected terminal error; classification belongs to fixture expectation');
+      Exit;
+      end;
+    Check(Status=1,'TLS connection ready',Domain,Code);
+    if Mode='reset' then
+      begin
+      Writeln('FIXTURE_READY_RESET');
+      Flush(Output);
+      end;
+    if Mode='ready' then Writeln('PASS TLS connection ready')
+    else if Mode='echo' then Echo(Context)
+    else if Mode='writetimeout' then WriteTimeout(Context)
+    else if (Mode='close') or (Mode='canclose') then ConcurrentClose(Context,Mode='canclose')
+    else if Mode='timeout' then
+      begin
+      ByteValue:=99;
+      Status:=NativeRead(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal read deadline',Domain,Code);
+      Sleep(250);
+      Check(ByteValue=99,'late completion cannot touch caller buffer',0,0);
+      Status:=NativeRead(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'read deadline remains terminal',Domain,Code);
+      Writeln('PASS terminal read deadline and retained caller buffer contents');
+      end
+    else if (Mode='eof') or (Mode='eofobserve') then
+      begin
+      Count:=0;
+      while Count<3 do
+        begin
+        Status:=NativeRead(Context,@Bytes[Count],3-Count,DeadlineMS,Domain,Code);
+        Check((Status>0) and (Status<=3-Count),'data before EOF',Domain,Code);
+        Inc(Count,Status);
+        end;
+      for Index:=0 to 2 do Check(Bytes[Index]=Ord('a')+Index,'EOF fixture contents',0,0);
+      Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      Check(Status=0,'clean EOF',Domain,Code);
+      Status:=NativeRead(Context,@ByteValue,1,1,Domain,Code);
+      Check(Status=0,'repeated clean EOF',Domain,Code);
+      Writeln('PASS data before clean/repeated EOF');
+      if Mode='eofobserve' then
+        begin
+        Sleep(500);
+        Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+        Writeln('OBSERVED later EOF status=',Status,' domain=',Domain,' code=',Code);
+        end;
+      end
+    else if (Mode='reset') or (Mode='finobserve') then
+      begin
+      Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      if Mode='finobserve' then
+        begin
+        Writeln('OBSERVED first FIN status=',Status,' domain=',Domain,' code=',Code);
+        Sleep(500);
+        Status:=NativeRead(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+        Writeln('OBSERVED later FIN status=',Status,' domain=',Domain,' code=',Code);
+        Writeln('DIAGNOSTIC only: no strict truncation acceptance claim');
+        end
+      else
+        begin
+        Check((Status=-1) and (Domain<>0) and (Code<>0) and
+          not ((Domain=POSIXDomain) and (Code=DarwinETIMEDOUT)),
+          'transport abort is an error',Domain,Code);
+        Writeln('PASS transport abort rejected as clean EOF');
+        end;
+      end;
+  finally
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Writeln('OBSERVED before local Close ',NetworkFrameworkReceiveDiagnostics);
+{$endif}
+    if Context<>nil then NativeClose(Context);
+    AwaitNativeRelease;
+  end;
+end;
+{$endif}
+
+begin
+  try
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+    RunNetworkFrameworkCoreModelTests;
+    Writeln('PASS shared Pascal context/state/ABI model; NOT macOS or TLS runtime validation');
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    if (NetworkFrameworkLiveContexts<>0) or (NetworkFrameworkDestroyedContexts=0) then
+      raise Exception.Create('Shared model diagnostic counters did not drain');
+    Writeln('PASS shared-model context counters drained');
+{$endif}
+{$else}
+    RunNative;
+    AwaitNativeRelease;
+{$endif}
+  except
+    on E: Exception do
+      begin Writeln(StdErr,E.Message); Halt(1) end;
+  end;
+end.
diff --git a/packages/fcl-net/tests/networkframework/testnetworkpeer.pp b/packages/fcl-net/tests/networkframework/testnetworkpeer.pp
new file mode 100644
index 00000000..b603157a
--- /dev/null
+++ b/packages/fcl-net/tests/networkframework/testnetworkpeer.pp
@@ -0,0 +1,249 @@
+{ Part of FCL; see COPYING.FPC. Tests the public peer, not a raw socket facade. }
+program testnetworkpeer;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+{$ifdef FPC_DOTTEDUNITS}
+  System.SysUtils, System.Classes, System.Net.Sslbase, System.Net.Sslsockets,
+  System.Net.ClientPeers, System.Net.NetworkFrameworkSSLSockets,
+  System.Net.NetworkFrameworkNative;
+{$else}
+  SysUtils, Classes, sslbase, sslsockets, clientpeers, networkframeworksslsockets,
+  networkframeworknative;
+{$endif}
+
+type
+  THandler = class(TNetworkFrameworkSocketHandler)
+    destructor Destroy; override;
+  end;
+  TCaller = class(TThread)
+    Peer: TClientPeer;
+    Readiness: Boolean;
+    Entered, Completed, ErrorCode: LongInt;
+    ErrorText: String;
+    procedure Execute; override;
+  end;
+  TObserver = class
+    Peer: TClientPeer;
+    Mode: String;
+    Calls: Integer;
+    procedure Verify(Sender: TObject; var Allow: Boolean);
+  end;
+
+var
+  DestroyedHandlers: Integer;
+
+procedure Check(Value: Boolean; const What: String);
+begin
+  if not Value then
+    raise Exception.Create('FAIL '+What);
+end;
+
+destructor THandler.Destroy;
+begin
+  Inc(DestroyedHandlers);
+  inherited Destroy;
+end;
+
+procedure TCaller.Execute;
+var
+  B: Byte;
+begin
+  InterlockedExchange(Entered,1);
+  try
+    try
+      if Readiness then Peer.CanRead(-1) else Peer.Read(B,1);
+    except
+      on E: ENetworkFrameworkTLS do
+        begin
+        ErrorCode:=E.NativeCode;
+        ErrorText:=E.Message;
+        end;
+      on E: Exception do ErrorText:=E.Message;
+    end;
+  finally
+    InterlockedExchange(Completed,1);
+  end;
+end;
+
+procedure TObserver.Verify(Sender: TObject; var Allow: Boolean);
+var
+  Failed: Boolean;
+begin
+  Inc(Calls);
+  Check(Sender is TNetworkFrameworkSocketHandler,'handler is verification sender');
+  Check(Allow,'initial callback allow');
+  if Mode='callbackclose' then
+    Peer.Close
+  else if Mode='callbackreenter' then
+    begin
+    Failed:=False;
+    try Peer.Connect except on E: ESSLSocketError do
+      Failed:=Pos('Reentrant',E.Message)>0 end;
+    Check(Failed,'reentrant connect rejected');
+    end;
+end;
+
+procedure Construction;
+var
+  H: THandler;
+  P: TClientPeer;
+  Failed: Boolean;
+  Before: Integer;
+  B: Byte;
+begin
+  Before:=DestroyedHandlers;
+  H:=THandler.Create;
+  try
+    Check(H.CertGenerator<>Nil,'native handler needs no external generator');
+    H.RemoteHostName:='legacy.invalid';
+    Check(H.CertificateData.HostName='legacy.invalid','legacy hostname setter');
+    Failed:=False;
+    try H.CreateSelfSignedCertificate except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'certificate generation unsupported');
+    Failed:=False;
+    try H.Accept except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'Accept never permits plaintext');
+    Failed:=False;
+    try H.Connect except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed,'raw socket adoption rejected');
+    Failed:=False;
+    try TNetworkFrameworkPeer.Create(H,'',443) except on E: ESSLSocketError do Failed:=True end;
+    Check(Failed and (DestroyedHandlers=Before),'failed constructor leaves handler owned by caller');
+    P:=TNetworkFrameworkPeer.Create(H,'localhost',443);
+    H:=Nil;
+    try
+      Failed:=False;
+      try P.IOTimeout:=-1 except on E: ESSLSocketError do Failed:=True end;
+      Check(Failed,'negative native I/O timeout rejected');
+      Failed:=False;
+      try P.ConnectTimeout:=-1 except on E: ESSLSocketError do Failed:=True end;
+      Check(Failed,'negative native connect timeout rejected');
+      Check((P.Read(B,0)=0) and (P.Write(B,0)=0),'empty operations start no context');
+      P.Close;
+      P.Close;
+    finally P.Free end;
+    Check(DestroyedHandlers=Before+1,'successful peer owns handler exactly once');
+  finally H.Free end;
+  Writeln('PASS native peer construction/ownership/capability refusals; no TLS connection started');
+end;
+
+procedure RunPeer;
+var
+  H: THandler;
+  P: TClientPeer;
+  Observer: TObserver;
+  Caller: TCaller;
+  Mode: String;
+  Failed: Boolean;
+  Started: QWord;
+  B: Byte;
+  Data: array[0..16383] of Byte;
+  Count, I, Offset: Integer;
+begin
+  Check(ParamCount=4,'usage host port 0|1 ready|echo|timeout|close|canclose|destroy|callbackclose|callbackreenter');
+  Mode:=ParamStr(4);
+  Check((ParamStr(3)='0') or (ParamStr(3)='1'),'explicit verification setting');
+  Check((Mode='ready') or (Mode='echo') or (Mode='timeout') or
+    (Mode='close') or (Mode='canclose') or (Mode='destroy') or
+    (Mode='callbackclose') or (Mode='callbackreenter'),'known peer mode');
+  H:=THandler.Create;
+  H.VerifyPeerCert:=ParamStr(3)='1';
+  try
+    P:=H.CreateClientPeer(ParamStr(1),StrToInt(ParamStr(2)));
+  except
+    H.Free;
+    raise;
+  end;
+  Observer:=TObserver.Create;
+  try
+    Observer.Peer:=P;
+    Observer.Mode:=Mode;
+    H.OnVerifyCertificate:=@Observer.Verify;
+    P.ConnectTimeout:=5000;
+    P.IOTimeout:=5000;
+    Failed:=False;
+    try P.Connect except on E: ESSLSocketError do
+      if Mode='callbackclose' then Failed:=Pos('closed by verification',E.Message)>0
+      else raise end;
+    if Mode='callbackclose' then
+      Check(Failed and not H.SSLActive,'Close in verification prevents publication')
+    else
+      begin
+      Check(H.SSLActive and (Observer.Calls=1),'native peer ready with one callback');
+      if Mode='echo' then
+        begin
+        for I:=0 to High(Data) do Data[I]:=I mod 251;
+        Offset:=0;
+        while Offset<Length(Data) do
+          begin
+          Count:=P.Write(Data[Offset],Length(Data)-Offset);
+          Check((Count>0) and (Count<=Length(Data)-Offset),'partial peer write');
+          Inc(Offset,Count);
+          end;
+        Offset:=0;
+        while Offset<Length(Data) do
+          begin
+          Count:=P.Read(Data[Offset],Length(Data)-Offset);
+          Check((Count>0) and (Count<=Length(Data)-Offset),'partial peer read');
+          Inc(Offset,Count);
+          end;
+        for I:=0 to High(Data) do Check(Data[I]=I mod 251,'exact peer echo bytes');
+        Check(not P.CanRead(1),'readiness timeout is benign');
+        end
+      else if Mode='timeout' then
+        begin
+        P.IOTimeout:=10;
+        B:=99;
+        Failed:=False;
+        try P.Read(B,1) except on E: ENetworkFrameworkTLS do
+          Failed:=(E.Domain=1) and (E.NativeCode=60) end;
+        Check(Failed and (B=99) and not H.SSLActive,'peer read deadline terminal, caller buffer intact');
+        end
+      else if (Mode='close') or (Mode='canclose') or (Mode='destroy') then
+        begin
+        P.IOTimeout:=0;
+        Caller:=TCaller.Create(True);
+        Caller.Peer:=P;
+        Caller.Readiness:=Mode='canclose';
+        try
+          Caller.Start;
+          Started:=GetTickCount64;
+          while (InterlockedCompareExchange(Caller.Entered,0,0)=0) and
+            (GetTickCount64-Started<1000) do Sleep(1);
+          Check(Caller.Entered<>0,'caller entered');
+          Sleep(50);
+          if Mode='destroy' then FreeAndNil(P) else P.Close;
+          Started:=GetTickCount64;
+          while (InterlockedCompareExchange(Caller.Completed,0,0)=0) and
+            (GetTickCount64-Started<1000) do Sleep(1);
+          Check(Caller.Completed<>0,'Close/destructor cancels promptly');
+          Caller.WaitFor;
+          Check(Caller.ErrorCode=89,'active caller sees native cancellation');
+        finally Caller.Free end;
+        end;
+      end;
+  finally
+    P.Free;
+    Observer.Free;
+  end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  Started:=GetTickCount64;
+  while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+  Check(NetworkFrameworkLiveContexts=0,'all peer contexts drained');
+{$endif}
+  Check(DestroyedHandlers=1,'handler freed once');
+  Writeln('PASS public native peer ',Mode);
+end;
+
+begin
+  try
+    if ParamCount=0 then Construction else RunPeer;
+  except
+    on E: Exception do
+      begin
+      Writeln(StdErr,E.Message);
+      Halt(1);
+      end;
+  end;
+end.
diff --git a/packages/fcl-net/tests/networkframework/testnetworktls.py b/packages/fcl-net/tests/networkframework/testnetworktls.py
new file mode 100644
index 00000000..d916e40b
--- /dev/null
+++ b/packages/fcl-net/tests/networkframework/testnetworktls.py
@@ -0,0 +1,268 @@
+"""macOS native TLS acceptance, using existing Python ssl/OpenSSL only as servers.
+
+The Pascal clients load system Network/Security, never the fixture's TLS library.
+All certificates are disposable; this script does not change any trust store.
+Public negative controls isolate hostname/expiry; private fixtures test untrusted
+chains and Verify=False, and cannot isolate a hostname/expiry trust failure.
+Each case is run once and its full result retained, including early TCP failures.
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import ssl
+import struct
+import subprocess
+import threading
+from types import SimpleNamespace
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('native', type=Path)
+    parser.add_argument('http', type=Path)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--peer', type=Path, required=True)
+    args = parser.parse_args()
+    args.native, args.http = args.native.resolve(), args.http.resolve()
+    root = args.output.resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    openssl_path = shutil.which('openssl')
+    if not openssl_path:
+        raise SystemExit('Existing OpenSSL CLI is required only to generate disposable server fixtures')
+    results = []
+
+    def save():
+        (root / 'results.json').write_text(json.dumps(results, indent=2), encoding='utf-8')
+
+    def openssl(*parts):
+        completed = subprocess.run([openssl_path, *map(str, parts)], capture_output=True,
+                                   text=True, timeout=30)
+        if completed.returncode:
+            raise RuntimeError(f'Fixture command {parts[0]} failed: {completed.stderr}')
+        return completed.stdout
+
+    print('SERVER_ONLY Python', ssl.OPENSSL_VERSION, 'CLI', openssl('version').strip(), flush=True)
+    config = root / 'root.conf'
+    config.write_text('[req]\ndistinguished_name=dn\nx509_extensions=ca\nprompt=no\n'
+                      '[dn]\nCN=FPC disposable native TLS root\n[ca]\n'
+                      'basicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,cRLSign\n')
+    openssl('req', '-new', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3',
+            '-config', config, '-keyout', root / 'root.key', '-out', root / 'root.pem')
+    openssl('req', '-new', '-newkey', 'rsa:2048', '-nodes', '-subj', '/CN=localhost',
+            '-keyout', root / 'server.key', '-out', root / 'server.csr')
+    for index, (name, san) in enumerate((('valid', 'DNS:localhost,IP:127.0.0.1'),
+                                        ('wrong-dns', 'DNS:another.invalid')), 1):
+        ext = root / f'{name}.ext'
+        ext.write_text('basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\n'
+                       'extendedKeyUsage=serverAuth\nsubjectAltName=' + san + '\n')
+        openssl('x509', '-req', '-in', root / 'server.csr', '-CA', root / 'root.pem',
+                '-CAkey', root / 'root.key', '-set_serial', index, '-days', '2',
+                '-extfile', ext, '-out', root / f'{name}.pem')
+    (root / 'chain.pem').write_bytes((root / 'valid.pem').read_bytes() + (root / 'root.pem').read_bytes())
+    (root / 'index.txt').write_text('')
+    (root / 'serial').write_text('1000\n')
+    config.write_text(f'[ca]\ndefault_ca=test\n[test]\ndir="{root.as_posix()}"\n'
+                      'database=$dir/index.txt\nserial=$dir/serial\nnew_certs_dir=$dir\n'
+                      'certificate=$dir/root.pem\nprivate_key=$dir/root.key\ndefault_md=sha256\n'
+                      'policy=policy\nunique_subject=no\n[policy]\ncommonName=supplied\n')
+    now = datetime.now(timezone.utc)
+    openssl('ca', '-batch', '-notext', '-config', config, '-in', root / 'server.csr',
+            '-extfile', root / 'valid.ext', '-startdate', (now-timedelta(days=2)).strftime('%Y%m%d%H%M%SZ'),
+            '-enddate', (now-timedelta(days=1)).strftime('%Y%m%d%H%M%SZ'), '-out', root / 'expired.pem')
+
+    def execute(name, command, observed=None, ready=None):
+        row = {'case': name, 'diagnostic_only': 'observation' in name, **(observed or {})}
+        try:
+            if ready is None:
+                run = subprocess.run(list(map(str, command)), capture_output=True, text=True, timeout=25)
+            else:
+                process = subprocess.Popen(list(map(str, command)), stdout=subprocess.PIPE,
+                                           stderr=subprocess.PIPE, text=True)
+                output, errors = [], []
+                def collect(stream, target):
+                    for line in stream:
+                        target.append(line)
+                        if stream is process.stdout and line.strip() == 'FIXTURE_READY_RESET':
+                            ready.set()
+                readers = [threading.Thread(target=collect, args=(process.stdout, output)),
+                           threading.Thread(target=collect, args=(process.stderr, errors))]
+                for reader in readers:
+                    reader.start()
+                try:
+                    process.wait(timeout=25)
+                finally:
+                    if process.poll() is None:
+                        process.kill()
+                        process.wait()
+                    for reader in readers:
+                        reader.join(2)
+                run = SimpleNamespace(returncode=process.returncode,
+                                      stdout=''.join(output), stderr=''.join(errors))
+            row.update(returncode=run.returncode, stdout=run.stdout, stderr=run.stderr)
+        except subprocess.TimeoutExpired as exc:
+            row.update(returncode=-1, error=str(exc))
+        results.append(row)
+        save()
+        label = ('DIAGNOSTIC' if row['diagnostic_only'] else 'PASS') if row['returncode'] == 0 else 'FAIL'
+        print(label, name,
+              row.get('stdout', '').strip().replace('\n', ' | '), row.get('stderr', '').strip(), flush=True)
+        return row
+
+    def local(name, mode='http', certificate='valid', verify='false', callback='true',
+              after='false', expected='pass', calls=1, requests=1, tls='tls12', framing=None, body_mode=None, peer=False):
+        listener = socket.socket()
+        listener.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 16384)
+        listener.bind(('127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(15)
+        port = listener.getsockname()[1]
+        stop = threading.Event()
+        ready = threading.Event() if mode == 'reset' else None
+        observed = {'tls': tls, 'certificate': certificate, 'accepted': 0, 'requests': 0,
+                    'framing': framing, 'methods': [],
+                    'category': 'EOF_compatibility' if framing else 'tls_behavior'}
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        version = ssl.TLSVersion.TLSv1_2 if tls == 'tls12' else ssl.TLSVersion.TLSv1_3
+        context.minimum_version = context.maximum_version = version
+        context.load_cert_chain(root / f'{certificate}.pem', root / 'server.key')
+
+        def serve():
+            try:
+                connection, _ = listener.accept()
+                observed['accepted'] += 1
+                connection.settimeout(12)
+                if mode == 'connecttimeout':
+                    stop.wait(12)
+                    connection.close()
+                    return
+                with context.wrap_socket(connection, server_side=True) as secure:
+                    observed['handshake'] = secure.version()
+                    if mode == 'http':
+                        data = b''
+                        for _ in range(requests):
+                            while b'\r\n\r\n' not in data:
+                                chunk = secure.recv(4096)
+                                if not chunk:
+                                    return
+                                data += chunk
+                            header, data = data.split(b'\r\n\r\n', 1)
+                            observed['requests'] += 1
+                            observed['methods'].append(header.split(b' ', 1)[0].decode('ascii'))
+                            body = b'native tls fixture\n'
+                            if framing in ('close-clean', 'close-fin'):
+                                response = b'HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n'+body
+                            else:
+                                response = b'HTTP/1.1 200 OK\r\nContent-Length: '+str(len(body)).encode()+b'\r\nConnection: keep-alive\r\n\r\n'+body
+                            for offset in range(0, len(response), 7):
+                                secure.sendall(response[offset:offset+7])
+                            if framing == 'close-fin':
+                                fd = secure.detach()
+                                with socket.socket(fileno=fd) as raw:
+                                    raw.shutdown(socket.SHUT_WR)
+                                observed['bare_fin_after_http'] = True
+                                return
+                            if framing == 'close-clean':
+                                observed['close_notify_attempted'] = True
+                                secure.unwrap().close()
+                                return
+                    elif mode == 'echo':
+                        while not stop.is_set():
+                            data = secure.recv(4096)
+                            if not data:
+                                break
+                            for offset in range(0, len(data), 113):
+                                secure.sendall(data[offset:offset+113])
+                    elif mode in ('eof', 'reset', 'finobserve', 'eofobserve'):
+                        if mode in ('eof', 'eofobserve'):
+                            secure.sendall(b'abc')
+                            secure.unwrap().close()
+                        else:
+                            fd = secure.detach()
+                            with socket.socket(fileno=fd) as raw:
+                                if mode == 'reset':
+                                    if not ready.wait(5):
+                                        observed['fixture_error'] = 'Client ready marker missing before reset'
+                                        return
+                                    observed['client_ready_before_reset'] = True
+                                    raw.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
+                                else:
+                                    raw.shutdown(socket.SHUT_WR)
+                    elif mode == 'timeout':
+                        if not stop.wait(0.15):
+                            observed['late_send_attempt'] = True
+                            secure.sendall(b'late-data')
+                    else:
+                        stop.wait(12)
+            except (ssl.SSLError, OSError) as exc:
+                observed['server_error'] = str(exc)
+            finally:
+                listener.close()
+
+        worker = threading.Thread(target=serve, daemon=True)
+        worker.start()
+        if mode == 'http':
+            command = [args.http, f'https://localhost:{port}/', verify, callback, after,
+                       expected, calls, body_mode or 'local', requests]
+        else:
+            command = [args.peer if peer else args.native, 'localhost', port, '0', mode]
+        row = execute(name, command, ready=ready)
+        stop.set()
+        worker.join(2)
+        listener.close()
+        row.update(observed)
+        if worker.is_alive() or observed['accepted'] != 1:
+            row['fixture_error'] = 'server thread did not stop or connection missing'
+            row['returncode'] = -1
+        if expected == 'pass' and mode == 'http' and observed['requests'] != requests:
+            row['fixture_error'] = 'unexpected number of HTTP requests'
+            row['returncode'] = -1
+        if expected in ('certificate', 'veto') and observed['requests']:
+            row['fixture_error'] = 'application bytes sent after rejection'
+            row['returncode'] = -1
+        if mode == 'http' and observed['requests'] and observed['methods'] != ['HEAD' if body_mode == 'head' else 'GET'] * observed['requests']:
+            row['fixture_error'] = 'unexpected HTTP request method'
+            row['returncode'] = -1
+        save()
+
+    for tls in ('tls12', 'tls13'):
+        if tls == 'tls13' and not ssl.HAS_TLSv1_3:
+            results.append({'case': 'tls13-support', 'returncode': -1, 'error': 'fixture lacks TLS 1.3'})
+            continue
+        local(tls+'-http-default', verify='default', tls=tls)
+        for cert in ('valid', 'wrong-dns', 'expired', 'chain'):
+            local(tls+'-'+cert+'-false', certificate=cert, tls=tls)
+            local(tls+'-'+cert+'-true-reject', certificate=cert, verify='true', expected='certificate', calls=0, tls=tls)
+        local(tls+'-after-create-false', verify='true', after='true', tls=tls)
+        local(tls+'-callback-veto', callback='false', expected='veto', tls=tls)
+        local(tls+'-http-keepalive', requests=2, tls=tls)
+        local(tls+'-fin-observation', mode='finobserve', tls=tls)
+        local(tls+'-eof-observation', mode='eofobserve', tls=tls)
+        for framing in ('close-clean', 'close-fin'):
+            local(tls+'-'+framing+'-compatibility', framing=framing, tls=tls)
+        for mode in ('echo', 'timeout', 'writetimeout', 'connecttimeout', 'close', 'canclose', 'eof', 'reset'):
+            local(tls+'-'+mode, mode=mode, tls=tls)
+        for mode in ('echo', 'timeout', 'close', 'canclose', 'destroy', 'callbackclose', 'callbackreenter'):
+            local(tls+'-peer-'+mode, mode=mode, peer=True, tls=tls)
+    # Public controls use the runner's system trust unchanged. Both settings run
+    # even if one fails, so a connection failure cannot be mislabeled validation.
+    for host in ('example.com', 'wrong.host.badssl.com', 'expired.badssl.com', 'self-signed.badssl.com', 'untrusted-root.badssl.com'):
+        for verify in ('true', 'false'):
+            expected = 'pass' if host == 'example.com' or verify == 'false' else 'certificate'
+            execute('public-'+host+'-'+verify, [args.http, f'https://{host}/', verify, 'true', 'false', expected,
+                                               1 if expected == 'pass' else 0, 'public', 1])
+    save()
+    failures = [row['case'] for row in results if row.get('returncode') != 0]
+    acceptance = [row for row in results if not row.get('diagnostic_only')]
+    diagnostic = [row for row in results if row.get('diagnostic_only')]
+    print('RESULT', len(acceptance), 'supported-feature acceptance cases;', sum(row['returncode'] != 0 for row in acceptance),
+          'failed;', len(diagnostic), 'EOF compatibility observations;',
+          len(failures), 'unexpected failures:', ', '.join(failures), flush=True)
+    raise SystemExit(bool(failures))
+
+
+if __name__ == '__main__':
+    main()
