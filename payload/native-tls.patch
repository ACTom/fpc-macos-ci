+++ b/packages/fcl-tls/src/networkframeworknative.pp
@@ -0,0 +1,906 @@
+{ Part of FCL; see COPYING.FPC.
+  Pure Pascal Network.framework client TCP+TLS provider. No C object dependency.
+  Callback methods belong to an explicitly retained context, never the stream.
+  One serial queue and one pending receive/send; owned plaintext is <=16 KiB.
+  Read/write return partial counts. Timeout 0 is unlimited for I/O; readiness
+  timeout 0 polls and High(Cardinal) is unlimited. Readiness expiry is benign.
+  Close wakes a concurrent caller and releases its one owner reference; each
+  caller must separately retain a captured context until its call returns.
+  Unix programs must load cthreads first. Serialization is provided by the caller.
+  Pending: exact Apple SDK declarations, Darwin x86_64/arm64 build/link, native
+  callback ABI, foreign-thread RTL, trust, cancellation and sanitizer validation.
+  Shared Windows tests are state/ABI models only, not Apple runtime evidence. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworknative;
+{$ENDIF}
+{$mode objfpc}{$H+}
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and not defined(ios) and not defined(iphonesim)}
+  {$define FPC_NATIVE_NETWORK_FRAMEWORK}
+  {$modeswitch cblocks}
+{$endif}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Net.NetworkFrameworkCommon;
+{$ELSE}
+uses networkframeworkcommon;
+{$ENDIF}
+function NetworkFrameworkAvailable: Boolean;
+function NativeNetworkFrameworkAPI: TFPNWAPI;
+function NetworkFrameworkAvailabilityError: String;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+{ Test-only process counters: observe eventual release after native callbacks. }
+function NetworkFrameworkLiveContexts: LongInt;
+function NetworkFrameworkDestroyedContexts: LongInt;
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+{ Explicit test build only: uses the production context/state helpers while
+  replacing native completion delivery. This is not a macOS test. }
+procedure RunNetworkFrameworkCoreModelTests;
+{$endif}
+implementation
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.CTypes, System.Net.NetworkFrameworkAPI
+  {$ifdef FPC_NETWORKFRAMEWORK_MODEL}, System.Classes{$endif};
+{$ELSE}
+uses SysUtils, ctypes, networkframeworkapi
+  {$ifdef FPC_NETWORKFRAMEWORK_MODEL}, Classes{$endif};
+{$ENDIF}
+const
+  PlaintextCapacity = 16384;
+  { Darwin POSIX values. These describe the native provider even in model tests. }
+  NW_EIO = 5;
+  NW_ENOMEM = 12;
+  NW_EBUSY = 16;
+  NW_EINVAL = 22;
+  NW_EALREADY = 37;
+  NW_ENOTCONN = 57;
+  NW_ETIMEDOUT = 60;
+  NW_ENOSYS = 78;
+  NW_EOVERFLOW = 84;
+  NW_ECANCELED = 89;
+type
+  TNativeDeadline = record
+    Start: QWord;
+    Timeout: Cardinal;
+    Infinite: Boolean;
+  end;
+  TNativeContext = class
+  private
+    FLock: TRTLCriticalSection;
+    FLockInitialized: Boolean;
+    {$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}FCounted: Boolean;{$endif}
+    FModelEvent: PRTLEvent;
+    FReferences: LongInt;
+    FFunctions: PNetworkFrameworkFunctions;
+    FSemaphore: TDispatchSemaphore;
+    FQueue: TDispatchQueue;
+    FConnection: TNWConnection;
+    FTimebase: TMachTimebaseInfo;
+    FHost: UTF8String;
+    FVerify: Boolean;
+    FConstructionFailed: Boolean;
+    FStarted, FReady, FStopped, FOwnerClosed: Boolean;
+    FStateReference, FReceivePending: Boolean;
+    FSendPending, FSendDone: Boolean;
+    FEOF, FError: Boolean;
+    FDomain, FCode: LongInt;
+    FOffset, FLength: SizeUInt;
+    FPlaintext: array[0..PlaintextCapacity-1] of Byte;
+    procedure Lock;
+    procedure Unlock;
+    procedure WakeLocked;
+    procedure FailureLocked(Domain, Code: LongInt);
+    procedure LocalFailureLocked(Code: LongInt);
+    procedure NativeFailureLocked(Error: TNWError);
+    procedure CallbackFailure;
+    function ErrorResultLocked(out Domain, Code: LongInt): LongInt;
+    function UsableLocked: Boolean;
+    function CurrentTick: QWord;
+    function NewDeadline(Timeout: Cardinal; Infinite: Boolean): TNativeDeadline;
+    function WaitLocked(const Deadline: TNativeDeadline): Boolean;
+    procedure ReceiveResultLocked(Buffer: Pointer; Size: SizeUInt;
+      FinalContent, HasError: Boolean; Domain, Code: LongInt);
+    procedure StartLocked;
+    procedure ReceiveLocked;
+    procedure ConfigureTLS(Options: TNWProtocolOptions); cdecl;
+    procedure StateChanged(State: TNWState; Error: TNWError); cdecl;
+    procedure ReceiveCompleted(Data: TDispatchData; Content: TNWContentContext;
+      IsComplete: TNWBoolean; Error: TNWError); cdecl;
+    procedure SendCompleted(Error: TNWError); cdecl;
+  public
+    constructor Create(Functions: PNetworkFrameworkFunctions);
+    destructor Destroy; override;
+    procedure Retain;
+    procedure Release;
+  end;
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+var ModelDestroyed: LongInt;
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+var LiveContexts, DestroyedContexts: LongInt;
+function NetworkFrameworkLiveContexts: LongInt;
+begin Result:=InterlockedCompareExchange(LiveContexts,0,0) end;
+function NetworkFrameworkDestroyedContexts: LongInt;
+begin Result:=InterlockedCompareExchange(DestroyedContexts,0,0) end;
+{$endif}
+
+function NetworkFrameworkAvailabilityError: String;
+begin Result:=NetworkFrameworkSymbolError end;
+
+function ValidPort(Port: PAnsiChar): Boolean;
+var Value, Digits: Cardinal;
+begin
+  Result:=False;
+  if (Port=nil) or (Port^=#0) then Exit;
+  Value:=0; Digits:=0;
+  while Port^<>#0 do
+    begin
+    Inc(Digits);
+    if (Digits>5) or (Port^<'0') or (Port^>'9') then Exit;
+    Value:=Value*10+Ord(Port^)-Ord('0');
+    Inc(Port);
+    end;
+  Result:=(Value>0) and (Value<=65535);
+end;
+
+constructor TNativeContext.Create(Functions: PNetworkFrameworkFunctions);
+begin
+  inherited Create;
+  InitCriticalSection(FLock);
+  FLockInitialized:=True;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  InterlockedIncrement(LiveContexts); FCounted:=True;
+{$endif}
+  FReferences:=1;
+  FFunctions:=Functions;
+  FTimebase.Numer:=1000000; FTimebase.Denom:=1;
+  if FFunctions<>nil then
+    begin
+    if (FFunctions^.MachTimebaseInfo(@FTimebase)<>0) or
+       (FTimebase.Numer=0) or (FTimebase.Denom=0) then
+      raise Exception.Create('Unavailable monotonic timebase');
+    FSemaphore:=FFunctions^.SemaphoreCreate(0);
+    if FSemaphore=nil then raise EOutOfMemory.Create('Native wait semaphore');
+    FQueue:=FFunctions^.QueueCreate('org.freepascal.tls.network',nil);
+    if FQueue=nil then raise EOutOfMemory.Create('Native callback queue');
+    end
+  else
+    begin
+    { Only the explicit core model constructs a context with no native symbols. }
+    FModelEvent:=RTLEventCreate;
+    if FModelEvent=nil then raise EOutOfMemory.Create('Core model condition');
+    end;
+end;
+
+destructor TNativeContext.Destroy;
+begin
+  if FFunctions<>nil then
+    begin
+    if FConnection<>nil then FFunctions^.NWRelease(Pointer(FConnection));
+    if FQueue<>nil then FFunctions^.DispatchRelease(Pointer(FQueue));
+    if FSemaphore<>nil then FFunctions^.DispatchRelease(Pointer(FSemaphore));
+    end;
+  if FModelEvent<>nil then RTLEventDestroy(FModelEvent);
+  if FLockInitialized then DoneCriticalSection(FLock);
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+  InterlockedIncrement(ModelDestroyed);
+{$endif}
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  if FCounted then
+    begin InterlockedIncrement(DestroyedContexts); InterlockedDecrement(LiveContexts) end;
+{$endif}
+  inherited Destroy;
+end;
+
+procedure TNativeContext.Lock;
+begin EnterCriticalSection(FLock) end;
+procedure TNativeContext.Unlock;
+begin LeaveCriticalSection(FLock) end;
+
+procedure TNativeContext.Retain;
+begin
+  Lock;
+  try Inc(FReferences) finally Unlock end;
+end;
+
+procedure TNativeContext.Release;
+var Dispose: Boolean;
+begin
+  Lock;
+  try
+    Dec(FReferences);
+    Dispose:=FReferences=0;
+  finally Unlock end;
+  if Dispose then Free;
+end;
+
+procedure TNativeContext.WakeLocked;
+begin
+  if FSemaphore<>nil then FFunctions^.SemaphoreSignal(FSemaphore)
+  else if FModelEvent<>nil then RTLEventSetEvent(FModelEvent);
+end;
+
+procedure TNativeContext.FailureLocked(Domain, Code: LongInt);
+var Cancel: Boolean;
+begin
+  if not FError then
+    begin FError:=True; FDomain:=Domain; FCode:=Code end;
+  Cancel:=not FStopped;
+  FStopped:=True; FReady:=False;
+  { Publish terminal state and wake BEFORE asking for eventual native callbacks. }
+  WakeLocked;
+  if Cancel and (FConnection<>nil) and (FFunctions<>nil) then
+    FFunctions^.ConnectionCancel(FConnection);
+end;
+
+procedure TNativeContext.LocalFailureLocked(Code: LongInt);
+begin
+  FOffset:=0; FLength:=0;
+  FailureLocked(NWDomainPOSIX,Code);
+end;
+
+procedure TNativeContext.NativeFailureLocked(Error: TNWError);
+begin
+  if (Error<>nil) and (FFunctions<>nil) then
+    FailureLocked(FFunctions^.ErrorDomain(Error),FFunctions^.ErrorCode(Error))
+  else FailureLocked(NWDomainPOSIX,NW_EIO);
+end;
+
+procedure TNativeContext.CallbackFailure;
+begin
+  { No Pascal exception may escape through a C/Blocks callback boundary. }
+  try
+    Lock;
+    try LocalFailureLocked(NW_EIO) finally Unlock end;
+  except
+    { Even a secondary RTL failure must not cross the foreign callback boundary. }
+  end;
+end;
+
+function TNativeContext.ErrorResultLocked(out Domain, Code: LongInt): LongInt;
+begin Domain:=FDomain; Code:=FCode; Result:=-1 end;
+
+function TNativeContext.UsableLocked: Boolean;
+begin
+  Result:=not FError;
+  if Result and not FReady then
+    begin LocalFailureLocked(NW_ENOTCONN); Result:=False end;
+end;
+
+function TNativeContext.CurrentTick: QWord;
+begin
+  if FFunctions<>nil then Result:=FFunctions^.MachAbsoluteTime()
+  else Result:=GetTickCount64;
+end;
+
+function TNativeContext.NewDeadline(Timeout: Cardinal; Infinite: Boolean): TNativeDeadline;
+begin Result.Start:=CurrentTick; Result.Timeout:=Timeout; Result.Infinite:=Infinite end;
+
+function TNativeContext.WaitLocked(const Deadline: TNativeDeadline): Boolean;
+var Elapsed: Extended; Remaining: QWord; NativeTime: cuint64; WaitMS: LongInt;
+begin
+  Result:=True;
+  if Deadline.Infinite then Remaining:=High(QWord)
+  else
+    begin
+    Elapsed:=Extended(CurrentTick-Deadline.Start)*FTimebase.Numer/FTimebase.Denom;
+    if Elapsed>=Extended(Deadline.Timeout)*1000000 then Exit(False);
+    Remaining:=Trunc(Extended(Deadline.Timeout)*1000000-Elapsed);
+    end;
+  if FSemaphore<>nil then
+    begin
+    { Clear stale condition notifications while holding the predicate lock.
+      A callback cannot signal between this drain and the release of the lock. }
+    while FFunctions^.SemaphoreWait(FSemaphore,0)=0 do ;
+    if Deadline.Infinite then NativeTime:=High(cuint64)
+    else NativeTime:=FFunctions^.DispatchTime(0,cint64(Remaining));
+    Unlock;
+    try Result:=FFunctions^.SemaphoreWait(FSemaphore,NativeTime)=0
+    finally Lock end;
+    end
+  else
+    begin
+    RTLEventResetEvent(FModelEvent);
+    Unlock;
+    try
+      if Deadline.Infinite then RTLEventWaitFor(FModelEvent)
+      else
+        begin
+        Remaining:=(Remaining+999999) div 1000000;
+        if Remaining>QWord(High(LongInt)) then WaitMS:=High(LongInt)
+        else WaitMS:=LongInt(Remaining);
+        RTLEventWaitFor(FModelEvent,WaitMS);
+        end;
+    finally Lock end;
+    { RTL event does not return a timeout status. Recheck monotonic elapsed time.
+      This branch is used only by Windows state tests, not the native provider. }
+    if not Deadline.Infinite then
+      Result:=Extended(CurrentTick-Deadline.Start)*FTimebase.Numer/FTimebase.Denom<
+        Extended(Deadline.Timeout)*1000000;
+    end;
+end;
+
+procedure TNativeContext.ReceiveResultLocked(Buffer: Pointer; Size: SizeUInt;
+  FinalContent, HasError: Boolean; Domain, Code: LongInt);
+begin
+  FReceivePending:=False;
+  if not FStopped then
+    begin
+    if (Size>PlaintextCapacity) or ((Size>0) and (Buffer=nil)) then
+      LocalFailureLocked(NW_EOVERFLOW)
+    else
+      begin
+      if Size>0 then
+        begin
+        Move(Buffer^,FPlaintext[0],Size);
+        FOffset:=0; FLength:=Size;
+        end;
+      { Preserve data delivered with a receive error; reads drain it before
+        reporting the first native error. Never accept error+complete as EOF. }
+      if HasError then FailureLocked(Domain,Code)
+      else if FinalContent then FEOF:=True;
+      end;
+    end;
+  WakeLocked;
+end;
+
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+procedure ConfigureTCP(Options: TNWProtocolOptions); cdecl;
+begin { The default TCP configuration requires no mutations. } end;
+
+procedure AcceptPeer(Metadata: TSecProtocolMetadata; Trust: TSecTrust;
+  Complete: TSecVerifyComplete); cdecl;
+begin
+  { This per-connection block changes neither system trust nor TLS policy. }
+  { Apple supplies a non-null completion block. Assigned attempts a TMethod
+    conversion for cblocks in this compiler and cannot be used here. }
+  try Complete(True) except end;
+end;
+{$endif}
+
+procedure TNativeContext.ConfigureTLS(Options: TNWProtocolOptions); cdecl;
+var Security: TSecProtocolOptions;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    VerifyBlock: TSecVerifyBlock;
+{$endif}
+begin
+  try
+    Security:=FFunctions^.TLSCopySecurityOptions(Options);
+    if Security=nil then begin FConstructionFailed:=True; Exit end;
+    try
+      FFunctions^.SecuritySetServerName(Security,PAnsiChar(FHost));
+      FFunctions^.SecuritySetPeerRequired(Security,True);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+      if not FVerify then
+        begin
+        VerifyBlock:=@AcceptPeer;
+        FFunctions^.SecuritySetVerifyBlock(Security,VerifyBlock,FQueue);
+        end;
+{$endif}
+    finally FFunctions^.SecurityRelease(Pointer(Security)) end;
+  except FConstructionFailed:=True end;
+end;
+
+procedure TNativeContext.StateChanged(State: TNWState; Error: TNWError); cdecl;
+var DropState: Boolean;
+begin
+  DropState:=False;
+  try
+    Lock;
+    try
+      case State of
+        NWStateReady: if not FStopped then FReady:=True;
+        NWStateFailed: NativeFailureLocked(Error);
+        NWStateWaiting: if Error<>nil then NativeFailureLocked(Error);
+        NWStateCancelled:
+          begin
+          if not FStopped then LocalFailureLocked(NW_ECANCELED);
+          if FStateReference then
+            begin FStateReference:=False; DropState:=True end;
+          if FFunctions<>nil then FFunctions^.ConnectionSetStateHandler(FConnection,nil);
+          end;
+      end;
+      WakeLocked;
+    finally Unlock end;
+  except CallbackFailure end;
+  if DropState then
+    try Release except end;
+end;
+
+procedure TNativeContext.ReceiveCompleted(Data: TDispatchData;
+  Content: TNWContentContext; IsComplete: TNWBoolean; Error: TNWError); cdecl;
+var Mapped: TDispatchData; Buffer: Pointer; Size: csize_t;
+    FinalContent: Boolean; Domain, Code: LongInt;
+begin
+  Mapped:=nil; Buffer:=nil; Size:=0;
+  try
+    try
+      if Data<>nil then
+        begin
+        Mapped:=FFunctions^.DataCreateMap(Data,@Buffer,@Size);
+        if Mapped=nil then raise EOutOfMemory.Create('Native data map');
+        end;
+      FinalContent:=IsComplete and ((Content=nil) or FFunctions^.ContentGetFinal(Content));
+      Domain:=0; Code:=0;
+      if Error<>nil then
+        begin Domain:=FFunctions^.ErrorDomain(Error); Code:=FFunctions^.ErrorCode(Error) end;
+      Lock;
+      try ReceiveResultLocked(Buffer,Size,FinalContent,Error<>nil,Domain,Code)
+      finally Unlock end;
+    except CallbackFailure end;
+  finally
+    { Each receive completion balances its explicit context reference. }
+    try if Mapped<>nil then FFunctions^.DispatchRelease(Pointer(Mapped)) except end;
+    try Release except end;
+  end;
+end;
+
+procedure TNativeContext.SendCompleted(Error: TNWError); cdecl;
+begin
+  try
+    try
+      Lock;
+      try
+        FSendPending:=False; FSendDone:=True;
+        if Error<>nil then NativeFailureLocked(Error);
+        WakeLocked;
+      finally Unlock end;
+    except CallbackFailure end;
+  finally
+    try Release except end;
+  end;
+end;
+
+procedure TNativeContext.StartLocked;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var StateBlock: TNWStateBlock;
+{$endif}
+begin
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  try StateBlock:=@Self.StateChanged
+  except LocalFailureLocked(NW_ENOMEM); Exit end;
+{$endif}
+  FStarted:=True; FStateReference:=True; Inc(FReferences);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  FFunctions^.ConnectionSetStateHandler(FConnection,StateBlock);
+  FFunctions^.ConnectionStart(FConnection);
+{$endif}
+end;
+
+procedure TNativeContext.ReceiveLocked;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var ReceiveBlock: TNWReceiveBlock;
+{$endif}
+begin
+  if FReceivePending or (FLength>0) or FEOF or FStopped then Exit;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  try ReceiveBlock:=@Self.ReceiveCompleted
+  except LocalFailureLocked(NW_ENOMEM); Exit end;
+{$endif}
+  FReceivePending:=True; Inc(FReferences);
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  FFunctions^.ConnectionReceive(FConnection,1,PlaintextCapacity,ReceiveBlock);
+{$endif}
+end;
+
+function NativeCreate(Host, Port: PAnsiChar; VerifyPeer: LongInt;
+  out Domain, Code: LongInt): Pointer; cdecl;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+var Context: TNativeContext; Functions: PNetworkFrameworkFunctions;
+    Parameters: TNWParameters; Endpoint: TNWEndpoint;
+    TLSBlock, TCPBlock: TNWConfigureBlock;
+{$endif}
+begin
+  Result:=nil; Domain:=0; Code:=0;
+  if (Host=nil) or (Host^=#0) or not ValidPort(Port) then
+    begin Domain:=NWDomainPOSIX; Code:=NW_EINVAL; Exit end;
+  if not NetworkFrameworkAvailable then
+    begin Domain:=NWDomainPOSIX; Code:=NW_ENOSYS; Exit end;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+  Functions:=NetworkFrameworkSymbols;
+  Context:=nil; Parameters:=nil; Endpoint:=nil;
+  try
+    try
+      Context:=TNativeContext.Create(Functions);
+      SetString(Context.FHost,Host,StrLen(Host)); Context.FVerify:=VerifyPeer<>0;
+      TLSBlock:=@Context.ConfigureTLS; TCPBlock:=@ConfigureTCP;
+      Parameters:=Functions^.ParametersCreateSecureTCP(TLSBlock,TCPBlock);
+      if (Parameters=nil) or Context.FConstructionFailed then
+        begin Domain:=NWDomainPOSIX; Code:=NW_EIO; Exit end;
+      Endpoint:=Functions^.EndpointCreateHost(Host,Port);
+      if Endpoint=nil then begin Domain:=NWDomainPOSIX; Code:=NW_ENOMEM; Exit end;
+      Context.FConnection:=Functions^.ConnectionCreate(Endpoint,Parameters);
+      if Context.FConnection=nil then begin Domain:=NWDomainPOSIX; Code:=NW_ENOMEM; Exit end;
+      Functions^.ConnectionSetQueue(Context.FConnection,Context.FQueue);
+      { No connection is started and no state hold exists until Connect. }
+      Result:=Pointer(Context); Context:=nil;
+    except
+      on E: EOutOfMemory do begin Domain:=NWDomainPOSIX; Code:=NW_ENOMEM end;
+      else begin Domain:=NWDomainPOSIX; Code:=NW_EIO end;
+    end;
+  finally
+    if Endpoint<>nil then Functions^.NWRelease(Pointer(Endpoint));
+    if Parameters<>nil then Functions^.NWRelease(Pointer(Parameters));
+    if Context<>nil then Context.Release;
+  end;
+{$endif}
+end;
+
+function NativeConnect(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then begin Domain:=NWDomainPOSIX; Code:=NW_EINVAL; Exit(-1) end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Context.FStarted then
+      begin Context.LocalFailureLocked(NW_EALREADY); Exit(Context.ErrorResultLocked(Domain,Code)) end;
+    Context.StartLocked;
+    while not Context.FReady and not Context.FError do
+      if not Context.WaitLocked(Deadline) and not Context.FReady and not Context.FError then
+        Context.LocalFailureLocked(NW_ETIMEDOUT);
+    if Context.FError then Result:=Context.ErrorResultLocked(Domain,Code) else Result:=1;
+  finally Context.Unlock end;
+end;
+
+function NativeRead(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline; Size: SizeUInt;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then begin Domain:=NWDomainPOSIX; Code:=NW_EINVAL; Exit(-1) end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if (Count<0) or ((Count>0) and (Buffer=nil)) then
+      begin Context.LocalFailureLocked(NW_EINVAL); Exit(Context.ErrorResultLocked(Domain,Code)) end;
+    if Count=0 then
+      begin if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code)) else Exit(0) end;
+    repeat
+      if Context.FLength>0 then
+        begin
+        Size:=SizeUInt(Count); if Size>Context.FLength then Size:=Context.FLength;
+        Move(Context.FPlaintext[Context.FOffset],Buffer^,Size);
+        Inc(Context.FOffset,Size); Dec(Context.FLength,Size);
+        if Context.FLength=0 then Context.FOffset:=0;
+        Exit(LongInt(Size));
+        end;
+      if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+      if Context.FEOF then Exit(0);
+      if not Context.UsableLocked then Continue;
+      Context.ReceiveLocked;
+      if Context.FError then Continue;
+      if not Context.WaitLocked(Deadline) and (Context.FLength=0) and
+        not Context.FEOF and not Context.FError then Context.LocalFailureLocked(NW_ETIMEDOUT);
+    until False;
+  finally Context.Unlock end;
+end;
+
+function NativeCanRead(Value: Pointer; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline;
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then begin Domain:=NWDomainPOSIX; Code:=NW_EINVAL; Exit(-1) end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=High(Cardinal));
+  Context.Lock;
+  try
+    repeat
+      if Context.FLength>0 then Exit(1);
+      if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+      if Context.FEOF then Exit(1);
+      if not Context.UsableLocked then Continue;
+      Context.ReceiveLocked;
+      if Context.FError then Continue;
+      if Timeout=0 then Exit(0);
+      if not Context.WaitLocked(Deadline) and (Context.FLength=0) and
+        not Context.FEOF and not Context.FError then Exit(0);
+    until False;
+  finally Context.Unlock end;
+end;
+
+function NativeWrite(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal;
+  out Domain, Code: LongInt): LongInt; cdecl;
+var Context: TNativeContext; Deadline: TNativeDeadline; Size: SizeUInt;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    Data: TDispatchData; Content: TNWContentContext; SendBlock: TNWSendBlock;
+{$endif}
+begin
+  Domain:=0; Code:=0;
+  if Value=nil then begin Domain:=NWDomainPOSIX; Code:=NW_EINVAL; Exit(-1) end;
+  Context:=TNativeContext(Value); Deadline:=Context.NewDeadline(Timeout,Timeout=0);
+  Context.Lock;
+  try
+    if (Count<0) or ((Count>0) and (Buffer=nil)) then Context.LocalFailureLocked(NW_EINVAL);
+    if Context.FError then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Count=0 then Exit(0);
+    if not Context.UsableLocked then Exit(Context.ErrorResultLocked(Domain,Code));
+    if Context.FSendPending then
+      begin Context.LocalFailureLocked(NW_EBUSY); Exit(Context.ErrorResultLocked(Domain,Code)) end;
+    Size:=SizeUInt(Count); if Size>PlaintextCapacity then Size:=PlaintextCapacity;
+{$ifdef FPC_NATIVE_NETWORK_FRAMEWORK}
+    try SendBlock:=@Context.SendCompleted
+    except
+      Context.LocalFailureLocked(NW_ENOMEM);
+      Exit(Context.ErrorResultLocked(Domain,Code));
+    end;
+    { nil is DISPATCH_DATA_DESTRUCTOR_DEFAULT: dispatch copies these bytes before
+      returning. No caller buffer or Pascal allocator reaches an async callback. }
+    Data:=Context.FFunctions^.DataCreate(Buffer,Size,Context.FQueue,nil);
+    if Data=nil then
+      begin Context.LocalFailureLocked(NW_ENOMEM); Exit(Context.ErrorResultLocked(Domain,Code)) end;
+    Content:=nil;
+    try
+      Content:=Context.FFunctions^.ContentCreate('org.freepascal.tls.write');
+      if Content=nil then
+        begin Context.LocalFailureLocked(NW_ENOMEM); Exit(Context.ErrorResultLocked(Domain,Code)) end;
+      Context.FFunctions^.ContentSetFinal(Content,False);
+      Context.FSendDone:=False; Context.FSendPending:=True; Inc(Context.FReferences);
+      Context.FFunctions^.ConnectionSend(Context.FConnection,Data,Content,True,SendBlock);
+    finally
+      if Content<>nil then Context.FFunctions^.NWRelease(Pointer(Content));
+      Context.FFunctions^.DispatchRelease(Pointer(Data));
+    end;
+{$else}
+    { Model exercises shared deadline/completion state, without sending data. }
+    Context.FSendDone:=False; Context.FSendPending:=True; Inc(Context.FReferences);
+{$endif}
+    while not Context.FSendDone and not Context.FError do
+      if not Context.WaitLocked(Deadline) and not Context.FSendDone and not Context.FError then
+        Context.LocalFailureLocked(NW_ETIMEDOUT);
+    if Context.FError then Result:=Context.ErrorResultLocked(Domain,Code) else Result:=LongInt(Size);
+  finally Context.Unlock end;
+end;
+
+function NativeBytesAvailable(Value: Pointer): LongInt; cdecl;
+var Context: TNativeContext;
+begin
+  if Value=nil then Exit(0);
+  Context:=TNativeContext(Value); Context.Lock;
+  try Result:=Context.FLength finally Context.Unlock end;
+end;
+
+procedure NativeRetain(Value: Pointer); cdecl;
+begin if Value<>nil then TNativeContext(Value).Retain end;
+procedure NativeRelease(Value: Pointer); cdecl;
+begin if Value<>nil then TNativeContext(Value).Release end;
+
+procedure NativeClose(Value: Pointer); cdecl;
+var Context: TNativeContext; DropOwner: Boolean;
+begin
+  if Value=nil then Exit;
+  Context:=TNativeContext(Value); DropOwner:=False;
+  Context.Lock;
+  try
+    if not Context.FOwnerClosed then
+      begin
+      Context.FOwnerClosed:=True;
+      Context.LocalFailureLocked(NW_ECANCELED);
+      DropOwner:=True;
+      end;
+  finally Context.Unlock end;
+  if DropOwner then Context.Release;
+end;
+
+function NetworkFrameworkAvailable: Boolean;
+begin Result:=NetworkFrameworkSymbolsAvailable end;
+
+function NativeNetworkFrameworkAPI: TFPNWAPI;
+begin
+  FillChar(Result,SizeOf(Result),0);
+  if not NetworkFrameworkAvailable then Exit;
+  Result.CreateConnection:=@NativeCreate;
+  Result.Connect:=@NativeConnect;
+  Result.Read:=@NativeRead;
+  Result.Write:=@NativeWrite;
+  Result.CanRead:=@NativeCanRead;
+  Result.BytesAvailable:=@NativeBytesAvailable;
+  Result.Close:=@NativeClose;
+  Result.Retain:=@NativeRetain;
+  Result.Release:=@NativeRelease;
+end;
+
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+procedure CoreCheck(Condition: Boolean; const Name: String);
+begin if not Condition then raise Exception.Create('FAIL core model: '+Name) end;
+
+function ModelContext: TNativeContext;
+begin Result:=TNativeContext.Create(nil); Result.FReady:=True end;
+
+procedure DeliverModel(Context: TNativeContext; Data: Pointer; Size: SizeUInt;
+  FinalContent, HasError: Boolean; Domain, Code: LongInt);
+begin
+  Context.Lock;
+  try
+    CoreCheck(Context.FReceivePending,'one pending receive before delivery');
+    Context.ReceiveResultLocked(Data,Size,FinalContent,HasError,Domain,Code);
+  finally Context.Unlock end;
+  Context.Release;
+end;
+
+function RaisingErrorDomain(Error: TNWError): TNWErrorDomain; cdecl;
+begin raise Exception.Create('intentional boundary conversion failure') end;
+
+type
+  TModelReader = class(TThread)
+    Context: TNativeContext;
+    Readiness: Boolean;
+    Status, Domain, Code: LongInt;
+    procedure Execute; override;
+  end;
+
+procedure TModelReader.Execute;
+var ByteValue: Byte;
+begin
+  try
+    if Readiness then Status:=NativeCanRead(Pointer(Context),High(Cardinal),Domain,Code)
+    else Status:=NativeRead(Pointer(Context),@ByteValue,1,0,Domain,Code);
+  finally Context.Release end;
+end;
+
+procedure RunNetworkFrameworkCoreModelTests;
+var Context: TNativeContext; Domain, Code, Status, BeforeDestroy: LongInt;
+    Buffer: array[0..7] of Byte; LiteralData: AnsiString;
+    FakeFunctions: TNetworkFrameworkFunctions; Reader: TModelReader;
+    Start: QWord; Pending: Boolean; Provider: TFPNWAPI;
+    LargeBuffer: array[0..PlaintextCapacity] of Byte;
+    Index, CallerKind: LongInt;
+begin
+  CoreCheck(ValidPort('443') and ValidPort('65535'),'valid decimal ports');
+  CoreCheck(not ValidPort(nil) and not ValidPort('0') and not ValidPort('65536') and
+    not ValidPort('12x') and not ValidPort('-1'),'invalid ports');
+  CoreCheck((SizeOf(TNWBoolean)=1) and (SizeOf(cint)=4) and
+    (SizeOf(csize_t)=SizeOf(Pointer)) and (SizeOf(TFPNWAPI)=9*SizeOf(Pointer)),
+    'native scalar and provider record widths');
+  Provider:=NativeNetworkFrameworkAPI;
+{$ifndef FPC_NATIVE_NETWORK_FRAMEWORK}
+  CoreCheck(not NetworkFrameworkAvailable and not Assigned(Provider.CreateConnection),
+    'non-Darwin unavailable, no pretend native provider');
+{$endif}
+  BeforeDestroy:=ModelDestroyed;
+  Context:=TNativeContext.Create(nil);
+  NativeRetain(Pointer(Context)); NativeClose(Pointer(Context));
+  Status:=NativeConnect(Pointer(Context),1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=1) and (Code=89),'close before start is terminal');
+  NativeClose(Pointer(Context)); { repeated close only while the explicit hold exists }
+  NativeRelease(Pointer(Context));
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'one owner release and one operation hold');
+
+  LiteralData:='abc'; Context:=ModelContext;
+  Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(NativeBytesAvailable(Pointer(Context))=3,'buffered plaintext count');
+  FillChar(Buffer,SizeOf(Buffer),0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,2,1,Domain,Code)=2,'partial read');
+  CoreCheck((Buffer[0]=Ord('a')) and (Buffer[1]=Ord('b')) and
+    (NativeBytesAvailable(Pointer(Context))=1),'partial contents and remaining count');
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=1,'remaining read');
+  CoreCheck(Buffer[0]=Ord('c'),'remaining contents');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,True,True,3,-9807);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=3,'native error after partial data');
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=3) and (Code=-9807) and not Context.FEOF,
+    'native TLS error preserved over final content');
+  NativeRetain(Pointer(Context)); NativeClose(Pointer(Context));
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=3) and (Code=-9807),'close cannot replace first native error');
+  NativeRelease(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,True,False,0,0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,8,1,Domain,Code)=3,'data before EOF');
+  CoreCheck((NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0) and
+    (NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0),'clean EOF is repeatable');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext;
+  CoreCheck(NativeCanRead(Pointer(Context),0,Domain,Code)=0,'readiness poll');
+  CoreCheck(NativeCanRead(Pointer(Context),2,Domain,Code)=0,'benign readiness deadline');
+  CoreCheck(Context.FReceivePending and not Context.FStopped and (Context.FReferences=2),
+    'readiness keeps exactly one pending receive');
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(NativeRead(Pointer(Context),@Buffer,3,1,Domain,Code)=3,'receive survives readiness timeout');
+  NativeClose(Pointer(Context));
+
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext; Buffer[0]:=99;
+  Status:=NativeRead(Pointer(Context),@Buffer,1,2,Domain,Code);
+  CoreCheck((Status=-1) and (Domain=1) and (Code=60) and (Buffer[0]=99),
+    'read deadline terminal and caller buffer untouched');
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60),'deadline persists');
+  NativeClose(Pointer(Context));
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck((Buffer[0]=99) and (ModelDestroyed=BeforeDestroy+1),
+    'late receive after timeout/owner close releases safely');
+
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext;
+  Status:=NativeWrite(Pointer(Context),PAnsiChar(LiteralData),3,2,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60) and Context.FSendPending,'terminal send deadline');
+  NativeClose(Pointer(Context));
+  Context.SendCompleted(nil);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'late send completion releases safely');
+
+  Context:=ModelContext;
+  FillChar(FakeFunctions,SizeOf(FakeFunctions),0);
+  FakeFunctions.ErrorDomain:=@RaisingErrorDomain;
+  Context.FFunctions:=@FakeFunctions;
+  Context.StateChanged(NWStateFailed,TNWError(Pointer(1)));
+  CoreCheck(Context.FError and (Context.FDomain=1) and (Context.FCode=5),
+    'callback exception converted locally, no foreign unwind');
+  Context.FFunctions:=nil;
+  NativeClose(Pointer(Context));
+
+  for CallerKind:=0 to 1 do
+    begin
+  BeforeDestroy:=ModelDestroyed; Context:=ModelContext;
+  NativeRetain(Pointer(Context));
+  Reader:=TModelReader.Create(True);
+  Reader.Readiness:=CallerKind=1;
+  Reader.Context:=Context;
+  Reader.Start;
+  Start:=GetTickCount64;
+  repeat
+    Context.Lock; try Pending:=Context.FReceivePending finally Context.Unlock end;
+    if not Pending then Sleep(1);
+  until Pending or (GetTickCount64-Start>1000);
+  CoreCheck(Pending,'blocking reader reached pending receive');
+  NativeClose(Pointer(Context));
+  Reader.WaitFor;
+  CoreCheck((Reader.Status=-1) and (Reader.Domain=1) and (Reader.Code=89),
+    'concurrent close interrupts unlimited read under operation hold');
+  Reader.Free;
+  DeliverModel(Context,PAnsiChar(LiteralData),3,False,False,0,0);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'closed caller and late callback each release once');
+    end;
+
+  BeforeDestroy:=ModelDestroyed; Context:=TNativeContext.Create(nil);
+  Status:=NativeConnect(Pointer(Context),2,Domain,Code);
+  CoreCheck((Status=-1) and (Code=60) and Context.FStateReference and
+    (Context.FReferences=2),'connect deadline retains one state handler');
+  NativeClose(Pointer(Context));
+  Context.StateChanged(NWStateCancelled,nil);
+  CoreCheck(ModelDestroyed=BeforeDestroy+1,'late cancelled state releases after connect timeout');
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,nil,0,False,False,0,0);
+  CoreCheck(not Context.FEOF and (NativeCanRead(Pointer(Context),0,Domain,Code)=0),
+    'empty nonfinal receive is not EOF and queues next receive');
+  DeliverModel(Context,nil,0,True,False,0,0);
+  CoreCheck((NativeCanRead(Pointer(Context),0,Domain,Code)=1) and
+    (NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code)=0),'empty final receive is EOF');
+  NativeClose(Pointer(Context));
+
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,PAnsiChar(LiteralData),PlaintextCapacity+1,False,False,0,0);
+  Status:=NativeRead(Pointer(Context),@Buffer,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=84) and (NativeBytesAvailable(Pointer(Context))=0),
+    'oversized native payload rejected before copy');
+  NativeClose(Pointer(Context));
+
+  for Index:=0 to PlaintextCapacity-1 do LargeBuffer[Index]:=Index mod 251;
+  LargeBuffer[PlaintextCapacity]:=99;
+  Context:=ModelContext; Context.Lock; try Context.ReceiveLocked finally Context.Unlock end;
+  DeliverModel(Context,@LargeBuffer,PlaintextCapacity,False,False,0,0);
+  FillChar(LargeBuffer,PlaintextCapacity,0);
+  CoreCheck(NativeBytesAvailable(Pointer(Context))=PlaintextCapacity,'16 KiB capacity');
+  CoreCheck(NativeRead(Pointer(Context),@LargeBuffer,PlaintextCapacity+1,1,Domain,Code)=
+    PlaintextCapacity,'bounded partial read at capacity');
+  for Index:=0 to PlaintextCapacity-1 do
+    CoreCheck(LargeBuffer[Index]=Index mod 251,'exact capacity payload');
+  CoreCheck(LargeBuffer[PlaintextCapacity]=99,'read never writes past returned count');
+  CoreCheck((NativeRead(Pointer(Context),nil,0,1,Domain,Code)=0) and
+    (NativeWrite(Pointer(Context),nil,0,1,Domain,Code)=0),'zero length operations');
+  CoreCheck(not Context.FReceivePending and not Context.FSendPending,
+    'zero length operations do not create callbacks');
+  Status:=NativeRead(Pointer(Context),nil,1,1,Domain,Code);
+  CoreCheck((Status=-1) and (Code=22),'nil positive read is terminal EINVAL');
+  NativeClose(Pointer(Context));
+end;
+{$endif}
+end.
diff --git a/packages/fcl-tls/src/networkframeworksslsockets.pp b/packages/fcl-tls/src/networkframeworksslsockets.pp
new file mode 100644
index 0000000000..cf3981aa0a
--- /dev/null
+++ b/packages/fcl-tls/src/networkframeworksslsockets.pp
@@ -0,0 +1,192 @@
+{ Part of FCL; see COPYING.FPC. Client transport for Network.framework. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworksslsockets;
+{$ENDIF}
+{$mode objfpc}{$H+}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Net.Sslsockets, System.Net.Sslbase,
+  System.Net.ClientConnections, System.Net.NetworkFrameworkTLS;
+{$ELSE}
+uses SysUtils, sslsockets, sslbase, clientconnections, networkframeworktls;
+{$ENDIF}
+type
+  TNetworkFrameworkSocketHandler = class(TSSLSocketHandler)
+  private
+    FError: String;
+    FErrorCode: Integer;
+    procedure VerifyConnection(Sender: TObject; var Allow: Boolean);
+    procedure CheckCapabilities;
+    procedure RecordError(E: Exception);
+  protected
+    function GetLastSSLErrorString: String; override;
+    function GetLastSSLErrorCode: Integer; override;
+    { Model seam; production creates the native stream and no raw TCP socket. }
+    function CreateTLSStream(const Host: String; Port: Word): TNetworkFrameworkTLSStream; virtual;
+  public
+    function CreateCertGenerator: TX509Certificate; override;
+    function CreateClientConnection(const Host: String; Port: Word): TClientConnection; override;
+    function Connect: Boolean; override;
+    function Accept: Boolean; override;
+  end;
+implementation
+type
+  TNetworkFrameworkClientConnection = class(TClientConnection)
+  private
+    FHandler: TNetworkFrameworkSocketHandler;
+    FStream: TNetworkFrameworkTLSStream;
+    FIOLock: TRTLCriticalSection;
+    FLockInitialized: Boolean;
+  protected
+    function GetConnected: Boolean; override;
+    function GetClosed: Boolean; override;
+    function GetPeerClosed: Boolean; override;
+  public
+    constructor Create(Handler: TNetworkFrameworkSocketHandler; Stream: TNetworkFrameworkTLSStream);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    procedure DetachCallbacks(Owner: TObject); override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+  end;
+constructor TNetworkFrameworkClientConnection.Create(Handler: TNetworkFrameworkSocketHandler;
+  Stream: TNetworkFrameworkTLSStream);
+begin
+  inherited Create;
+  InitCriticalSection(FIOLock); FLockInitialized:=True;
+  FStream:=Stream; FHandler:=Handler;
+end;
+destructor TNetworkFrameworkClientConnection.Destroy;
+begin
+  if FLockInitialized then
+    begin
+    Close;
+    // Drain the whole adapter operation, including its handler error update.
+    EnterCriticalSection(FIOLock);
+    try FStream.Free; FHandler.Free finally LeaveCriticalSection(FIOLock) end;
+    DoneCriticalSection(FIOLock);
+    end;
+  inherited Destroy;
+end;
+function TNetworkFrameworkClientConnection.GetConnected: Boolean;
+begin Result:=FStream.Connected end;
+function TNetworkFrameworkClientConnection.GetClosed: Boolean;
+begin Result:=FStream.Closed end;
+function TNetworkFrameworkClientConnection.GetPeerClosed: Boolean;
+begin Result:=FStream.PeerClosed end;
+procedure TNetworkFrameworkClientConnection.Connect;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+  FStream.ConnectTimeout:=ConnectTimeout; FStream.IOTimeout:=IOTimeout;
+  FHandler.FError:=''; FHandler.FErrorCode:=0;
+  try
+    FStream.Connect;
+    FHandler.SetSSLActive(True);
+  except
+    on E: Exception do begin FHandler.RecordError(E); raise end;
+  end;
+  finally LeaveCriticalSection(FIOLock) end;
+end;
+procedure TNetworkFrameworkClientConnection.Close;
+begin
+  if Assigned(FStream) then FStream.Close;
+  if Assigned(FHandler) then FHandler.SetSSLActive(False);
+end;
+procedure TNetworkFrameworkClientConnection.DetachCallbacks(Owner: TObject);
+begin
+  if Assigned(FHandler.OnVerifyCertificate) and
+     (TMethod(FHandler.OnVerifyCertificate).Data=Pointer(Owner)) then
+    FHandler.OnVerifyCertificate:=Nil;
+end;
+function TNetworkFrameworkClientConnection.Read(var Buffer; Count: LongInt): LongInt;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+  FStream.IOTimeout:=IOTimeout;
+  try
+    Result:=FStream.Read(Buffer,Count);
+    if (Count>0) and (Result=0) then FHandler.SetSSLActive(False);
+  except on E: Exception do begin FHandler.RecordError(E); raise end end;
+  finally LeaveCriticalSection(FIOLock) end;
+end;
+function TNetworkFrameworkClientConnection.Write(const Buffer; Count: LongInt): LongInt;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+  FStream.IOTimeout:=IOTimeout;
+  try Result:=FStream.Write(Buffer,Count)
+  except on E: Exception do begin FHandler.RecordError(E); raise end end;
+  finally LeaveCriticalSection(FIOLock) end;
+end;
+function TNetworkFrameworkClientConnection.CanRead(Timeout: Integer): Boolean;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+  try Result:=FStream.CanRead(Timeout)
+  except on E: Exception do begin FHandler.RecordError(E); raise end end;
+  finally LeaveCriticalSection(FIOLock) end;
+end;
+function TNetworkFrameworkClientConnection.BytesAvailable: Integer;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+    try Result:=FStream.BytesAvailable
+    except on E: Exception do begin FHandler.RecordError(E); raise end end;
+  finally LeaveCriticalSection(FIOLock) end;
+end;
+function TNetworkFrameworkSocketHandler.GetLastSSLErrorString: String;
+begin Result:=FError end;
+function TNetworkFrameworkSocketHandler.GetLastSSLErrorCode: Integer;
+begin Result:=FErrorCode end;
+procedure TNetworkFrameworkSocketHandler.RecordError(E: Exception);
+begin
+  SetSSLActive(False); FError:=E.Message;
+  if E is ENetworkFrameworkTLS then FErrorCode:=ENetworkFrameworkTLS(E).Code
+  else FErrorCode:=0;
+end;
+procedure TNetworkFrameworkSocketHandler.VerifyConnection(Sender: TObject; var Allow: Boolean);
+begin
+  Allow:=DoVerifyCert; // The existing callback receives the handler as Sender.
+end;
+procedure TNetworkFrameworkSocketHandler.CheckCapabilities;
+begin
+  if not CertificateData.Certificate.Empty or not CertificateData.PrivateKey.Empty or
+     not CertificateData.CertCA.Empty or not CertificateData.TrustedCertificate.Empty or
+     not CertificateData.PFX.Empty or (CertificateData.TrustedCertsDir<>'') or
+     (CertificateData.ALPNProtocols<>'') or (CertificateData.CipherList<>'DEFAULT') or
+     (CertificateData.KeyPassword<>'') or
+     not SendHostAsSNI or (SSLType<>stAny) then
+    raise ESSLSocketError.Create('Network.framework custom credentials, trust, ciphers, ALPN or protocol selection are unsupported');
+end;
+function TNetworkFrameworkSocketHandler.CreateCertGenerator: TX509Certificate;
+begin Result:=Nil end;
+function TNetworkFrameworkSocketHandler.CreateTLSStream(const Host: String; Port: Word): TNetworkFrameworkTLSStream;
+begin Result:=TNetworkFrameworkTLSStream.Create(Host,Port,VerifyPeerCert) end;
+function TNetworkFrameworkSocketHandler.CreateClientConnection(const Host: String; Port: Word): TClientConnection;
+var Stream: TNetworkFrameworkTLSStream;
+begin
+  CheckCapabilities;
+  Stream:=CreateTLSStream(Host,Port);
+  try
+    Stream.OnVerifyConnection:=@VerifyConnection;
+    Result:=TNetworkFrameworkClientConnection.Create(Self,Stream);
+  except
+    Stream.Free;
+    raise; // Self remains owned by the caller if construction fails.
+  end;
+end;
+function TNetworkFrameworkSocketHandler.Connect: Boolean;
+begin
+  raise ESSLSocketError.Create('Network.framework owns TCP and TLS; use a client connection factory before creating a socket');
+  Result:=False;
+end;
+function TNetworkFrameworkSocketHandler.Accept: Boolean;
+begin
+  raise ESSLSocketError.Create('Network.framework TLS handler is client-only');
+  Result:=False;
+end;
+end.
diff --git a/packages/fcl-tls/src/networkframeworktls.pp b/packages/fcl-tls/src/networkframeworktls.pp
new file mode 100644
index 0000000000..313a314033
--- /dev/null
+++ b/packages/fcl-tls/src/networkframeworktls.pp
@@ -0,0 +1,396 @@
+{ Part of FCL; see COPYING.FPC. }
+{$IFNDEF FPC_DOTTEDUNITS}
+unit networkframeworktls;
+{$ENDIF}
+{$mode objfpc}{$H+}
+{$macro on}
+{$IFDEF FPC_DOTTEDUNITS}
+{$define commonunit:=System.Net.NetworkFrameworkCommon}
+{$define nativeunit:=System.Net.NetworkFrameworkNative}
+{$ELSE}
+{$define commonunit:=networkframeworkcommon}
+{$define nativeunit:=networkframeworknative}
+{$ENDIF}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Classes, System.SysUtils, System.Net.ClientConnections, System.Net.NetworkFrameworkCommon;
+{$ELSE}
+uses Classes, SysUtils, clientconnections, networkframeworkcommon;
+{$ENDIF}
+type
+  TFPNWCreate = commonunit.TFPNWCreate;
+  TFPNWConnect = commonunit.TFPNWConnect;
+  TFPNWRead = commonunit.TFPNWRead;
+  TFPNWWrite = commonunit.TFPNWWrite;
+  TFPNWCanRead = commonunit.TFPNWCanRead;
+  TFPNWBytesAvailable = commonunit.TFPNWBytesAvailable;
+  TFPNWContextProc = commonunit.TFPNWContextProc;
+  TFPNWAPI = commonunit.TFPNWAPI;
+  ENetworkFrameworkTLS = class(EStreamError)
+  private
+    FDomain, FCode: LongInt;
+  public
+    constructor CreateNative(const Operation: String; Domain, Code: LongInt);
+    property Domain: LongInt read FDomain;
+    property Code: LongInt read FCode;
+  end;
+  TNetworkFrameworkVerifyEvent = procedure(Sender: TObject; var Allow: Boolean) of object;
+  { Callers serialize Connect/Read/Write/CanRead/BytesAvailable. Close may
+    concurrently cancel one active call. Before Destroy, stop/coordinate callers:
+    no queued or new calls may remain; the one active call is cancelled/drained.
+    Unix programs must load their thread driver (normally cthreads) first. }
+  TNetworkFrameworkTLSStream = class(TClientConnection)
+  private
+    FAPI: TFPNWAPI;
+    FContext: Pointer;
+    FStateLock, FIOLock: TRTLCriticalSection;
+    FLocksInitialized: Boolean;
+    FHost: UTF8String;
+    FPort: AnsiString;
+    FVerifyPeer, FConnected, FPeerClosed, FClosed, FPeerVerified, FConnecting: Boolean;
+    FGeneration: QWord;
+    FOnVerifyConnection: TNetworkFrameworkVerifyEvent;
+    function AcquireContext: Pointer;
+    procedure DropContext(Context: Pointer; PeerEOF: Boolean = False);
+    procedure Fail(Context: Pointer; const Operation: String; Domain, Code: LongInt);
+    procedure CheckCurrent(Context: Pointer);
+  protected
+    function GetConnected: Boolean; override;
+    function GetClosed: Boolean; override;
+    function GetPeerClosed: Boolean; override;
+    { Provider seam permits ABI/state tests without claiming Apple runtime evidence. }
+    constructor CreateWithAPI(const Host: String; Port: Word; VerifyPeer: Boolean;
+      const API: TFPNWAPI);
+  public
+    constructor Create(const Host: String; Port: Word; VerifyPeer: Boolean = False);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function Seek(const Offset: Int64; Origin: TSeekOrigin): Int64; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+    property VerifyPeerCert: Boolean read FVerifyPeer;
+    property PeerVerified: Boolean read FPeerVerified;
+    { Stream-local post-handshake veto. Existing HTTP/socket callbacks are not changed. }
+    property OnVerifyConnection: TNetworkFrameworkVerifyEvent read FOnVerifyConnection write FOnVerifyConnection;
+  end;
+function NetworkFrameworkTLSAvailable: Boolean;
+implementation
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and defined(FPC_NETWORK_FRAMEWORK_NATIVE)}
+uses nativeunit;
+{$endif}
+
+function NetworkFrameworkTLSAvailable: Boolean;
+begin
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and defined(FPC_NETWORK_FRAMEWORK_NATIVE)}
+  Result:=nativeunit.NetworkFrameworkAvailable;
+{$else}
+  Result:=False;
+{$endif}
+end;
+
+function NativeAPI: TFPNWAPI;
+begin
+{$if defined(Darwin) and (defined(CPUX86_64) or defined(CPUAARCH64)) and defined(FPC_NETWORK_FRAMEWORK_NATIVE)}
+  Result:=nativeunit.NativeNetworkFrameworkAPI;
+{$else}
+  raise ENetworkFrameworkTLS.Create('Network.framework native prototype requires a 64-bit Darwin build with FPC_NETWORK_FRAMEWORK_NATIVE');
+{$endif}
+end;
+
+function TNetworkFrameworkTLSStream.GetConnected: Boolean;
+begin Result:=FConnected end;
+function TNetworkFrameworkTLSStream.GetClosed: Boolean;
+begin Result:=FClosed end;
+function TNetworkFrameworkTLSStream.GetPeerClosed: Boolean;
+begin Result:=FPeerClosed end;
+
+constructor ENetworkFrameworkTLS.CreateNative(const Operation: String; Domain, Code: LongInt);
+begin
+  FDomain:=Domain; FCode:=Code;
+  inherited CreateFmt('Network.framework %s failed (domain %d, code %d)',[Operation,Domain,Code]);
+end;
+
+constructor TNetworkFrameworkTLSStream.CreateWithAPI(const Host: String; Port: Word;
+  VerifyPeer: Boolean; const API: TFPNWAPI);
+begin
+  inherited Create;
+  InitCriticalSection(FStateLock);
+  InitCriticalSection(FIOLock);
+  FLocksInitialized:=True;
+  FClosed:=True;
+  if (Host='') or (Pos(#0,Host)<>0) or (Port=0) then
+    raise ENetworkFrameworkTLS.Create('A nonempty hostname and nonzero port are required');
+  if not (Assigned(API.CreateConnection) and Assigned(API.Connect) and Assigned(API.Read)
+    and Assigned(API.Write) and Assigned(API.CanRead) and Assigned(API.BytesAvailable)
+    and Assigned(API.Close) and Assigned(API.Retain) and Assigned(API.Release)) then
+    raise ENetworkFrameworkTLS.Create('Incomplete Network.framework bridge API');
+  FAPI:=API;
+  FVerifyPeer:=VerifyPeer;
+  FHost:=UTF8Encode(UnicodeString(Host));
+  FPort:=IntToStr(Port);
+end;
+
+constructor TNetworkFrameworkTLSStream.Create(const Host: String; Port: Word; VerifyPeer: Boolean);
+begin
+  CreateWithAPI(Host,Port,VerifyPeer,NativeAPI);
+end;
+
+destructor TNetworkFrameworkTLSStream.Destroy;
+begin
+  if FLocksInitialized then
+    begin
+    Close;
+    { No new calls may begin after destruction starts. Drain a cancelled
+      operation before its finally block touches Self or either lock. }
+    EnterCriticalSection(FIOLock);
+    LeaveCriticalSection(FIOLock);
+    DoneCriticalSection(FIOLock);
+    DoneCriticalSection(FStateLock);
+    end;
+  inherited Destroy;
+end;
+
+function TNetworkFrameworkTLSStream.AcquireContext: Pointer;
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    if not FConnected or (FContext=Nil) then
+      raise ENetworkFrameworkTLS.Create('TLS connection is not open');
+    Result:=FContext;
+    { Close can detach/cancel while the synchronous operation waits. }
+    FAPI.Retain(Result);
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+end;
+
+procedure TNetworkFrameworkTLSStream.DropContext(Context: Pointer; PeerEOF: Boolean);
+var ReleaseOwner: Boolean;
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    ReleaseOwner:=(Context<>Nil) and (FContext=Context);
+    if ReleaseOwner then
+      begin
+      FContext:=Nil;
+      FConnected:=False;
+      FClosed:=True;
+      FPeerClosed:=PeerEOF;
+      FPeerVerified:=False;
+      Inc(FGeneration);
+      end;
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+  if ReleaseOwner then FAPI.Close(Context);
+end;
+
+procedure TNetworkFrameworkTLSStream.Fail(Context: Pointer; const Operation: String; Domain, Code: LongInt);
+begin
+  DropContext(Context);
+  raise ENetworkFrameworkTLS.CreateNative(Operation,Domain,Code);
+end;
+
+procedure TNetworkFrameworkTLSStream.CheckCurrent(Context: Pointer);
+begin
+  EnterCriticalSection(FStateLock);
+  try
+    if FContext<>Context then
+      raise ENetworkFrameworkTLS.Create('TLS connection was closed during the operation');
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+end;
+
+procedure TNetworkFrameworkTLSStream.Connect;
+var Context: Pointer; Generation: QWord; Domain, Code, Status: LongInt;
+    Allow, Started: Boolean;
+begin
+  Started:=False;
+  EnterCriticalSection(FIOLock);
+  try
+    EnterCriticalSection(FStateLock);
+    try
+      if FConnecting then
+        raise ENetworkFrameworkTLS.Create('Reentrant TLS connect is not supported');
+      if FConnected then Exit;
+      if FContext<>Nil then
+        raise ENetworkFrameworkTLS.Create('TLS connection is already being established');
+      FConnecting:=True;
+      Started:=True;
+      Generation:=FGeneration;
+    finally
+      LeaveCriticalSection(FStateLock);
+    end;
+    Context:=FAPI.CreateConnection(PAnsiChar(FHost),PAnsiChar(FPort),Ord(FVerifyPeer),Domain,Code);
+    if Context=Nil then
+      raise ENetworkFrameworkTLS.CreateNative('create',Domain,Code);
+    EnterCriticalSection(FStateLock);
+    try
+      Allow:=Generation=FGeneration;
+      if Allow then
+        begin
+        FContext:=Context;
+        FClosed:=False;
+        FPeerClosed:=False;
+        FAPI.Retain(Context);
+        end;
+    finally
+      LeaveCriticalSection(FStateLock);
+    end;
+    if not Allow then
+      begin
+      FAPI.Close(Context);
+      raise ENetworkFrameworkTLS.Create('TLS connection was closed during creation');
+      end;
+    try
+      try
+        Status:=FAPI.Connect(Context,FConnectTimeout,Domain,Code);
+        if Status<>1 then Fail(Context,'connect',Domain,Code);
+        CheckCurrent(Context);
+        { Built-in trust failure never reaches this post-handshake veto. }
+        Allow:=True;
+        if Assigned(FOnVerifyConnection) then FOnVerifyConnection(Self,Allow);
+        if not Allow then Fail(Context,'application certificate veto',0,0);
+        EnterCriticalSection(FStateLock);
+        try
+          if FContext<>Context then
+            raise ENetworkFrameworkTLS.Create('TLS connection was closed by verification callback');
+          FConnected:=True;
+          FPeerVerified:=FVerifyPeer;
+        finally
+          LeaveCriticalSection(FStateLock);
+        end;
+      except
+        DropContext(Context);
+        Raise;
+      end;
+    finally
+      FAPI.Release(Context);
+    end;
+  finally
+    if Started then
+      begin
+      EnterCriticalSection(FStateLock);
+      try FConnecting:=False finally LeaveCriticalSection(FStateLock) end;
+      end;
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+procedure TNetworkFrameworkTLSStream.Close;
+var Context: Pointer;
+begin
+  if not FLocksInitialized then Exit;
+  { Do not take FIOLock: cancellation must wake a blocked Connect/Read/Write. }
+  EnterCriticalSection(FStateLock);
+  try
+    Context:=FContext;
+    FContext:=Nil;
+    FConnected:=False;
+    FClosed:=True;
+    FPeerClosed:=False;
+    FPeerVerified:=False;
+    Inc(FGeneration);
+  finally
+    LeaveCriticalSection(FStateLock);
+  end;
+  if Context<>Nil then FAPI.Close(Context);
+end;
+
+function TNetworkFrameworkTLSStream.Read(var Buffer; Count: LongInt): LongInt;
+var Context: Pointer; Domain, Code: LongInt;
+begin
+  if Count<0 then raise EStreamError.Create('Negative TLS read count');
+  if Count=0 then Exit(0);
+  EnterCriticalSection(FIOLock);
+  try
+    EnterCriticalSection(FStateLock);
+    try if FPeerClosed then Exit(0) finally LeaveCriticalSection(FStateLock) end;
+    Context:=AcquireContext;
+    try
+      Result:=FAPI.Read(Context,@Buffer,Count,FIOTimeout,Domain,Code);
+      if Result<0 then Fail(Context,'read',Domain,Code);
+      CheckCurrent(Context);
+      if Result>Count then Fail(Context,'invalid read result',0,0);
+      if Result=0 then DropContext(Context,True);
+    finally
+      FAPI.Release(Context);
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkTLSStream.Write(const Buffer; Count: LongInt): LongInt;
+var Context: Pointer; Domain, Code: LongInt;
+begin
+  if Count<0 then raise EStreamError.Create('Negative TLS write count');
+  if Count=0 then Exit(0);
+  EnterCriticalSection(FIOLock);
+  try
+    Context:=AcquireContext;
+    try
+      Result:=FAPI.Write(Context,@Buffer,Count,FIOTimeout,Domain,Code);
+      if Result<0 then Fail(Context,'write',Domain,Code);
+      CheckCurrent(Context);
+      if (Result=0) or (Result>Count) then Fail(Context,'invalid write result',0,0);
+    finally
+      FAPI.Release(Context);
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkTLSStream.Seek(const Offset: Int64; Origin: TSeekOrigin): Int64;
+begin
+  raise EStreamError.Create('TLS streams do not support seeking');
+end;
+
+function TNetworkFrameworkTLSStream.CanRead(Timeout: Integer): Boolean;
+var Context: Pointer; Domain, Code, Status: LongInt; NativeTimeout: Cardinal;
+begin
+  if Timeout<0 then NativeTimeout:=High(Cardinal) else NativeTimeout:=Cardinal(Timeout);
+  EnterCriticalSection(FIOLock);
+  try
+    EnterCriticalSection(FStateLock);
+    try if FPeerClosed then Exit(True) finally LeaveCriticalSection(FStateLock) end;
+    Context:=AcquireContext;
+    try
+      Status:=FAPI.CanRead(Context,NativeTimeout,Domain,Code);
+      if Status<0 then Fail(Context,'readiness',Domain,Code);
+      CheckCurrent(Context);
+      if Status>1 then Fail(Context,'invalid readiness result',0,0);
+      Result:=Status=1;
+    finally
+      FAPI.Release(Context);
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+
+function TNetworkFrameworkTLSStream.BytesAvailable: Integer;
+var Context: Pointer;
+begin
+  EnterCriticalSection(FIOLock);
+  try
+    EnterCriticalSection(FStateLock);
+    try if not FConnected then Exit(0) finally LeaveCriticalSection(FStateLock) end;
+    Context:=AcquireContext;
+    try
+      Result:=FAPI.BytesAvailable(Context);
+      CheckCurrent(Context);
+      if Result<0 then Fail(Context,'invalid availability result',0,0);
+    finally
+      FAPI.Release(Context);
+    end;
+  finally
+    LeaveCriticalSection(FIOLock);
+  end;
+end;
+end.
diff --git a/packages/fcl-tls/src/smartsslsockets.pp b/packages/fcl-tls/src/smartsslsockets.pp
new file mode 100644
index 0000000000..73b2247cdb
--- /dev/null
+++ b/packages/fcl-tls/src/smartsslsockets.pp
@@ -0,0 +1,453 @@
+{
+    This file is part of the Free Component Library (FCL).
+    Deterministic, lazy client TLS backend selection.
+    See COPYING.FPC for details about the copyright.
+}
+{$IFNDEF FPC_DOTTEDUNITS}
+unit smartsslsockets;
+{$ENDIF}
+{$mode objfpc}{$H+}
+{$macro on}
+{$IFDEF FPC_DOTTEDUNITS}
+{$define policyunit:=System.Net.TLSBackendPolicy}
+{$ELSE}
+{$define policyunit:=tlsbackendpolicy}
+{$ENDIF}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils, System.Net.Sslsockets, System.Net.TLSBackendPolicy;
+{$ELSE}
+uses SysUtils, sslsockets, tlsbackendpolicy;
+{$ENDIF}
+type
+  ESmartTLS = class(ESSLSocketError);
+  TTLSBackend = policyunit.TTLSBackend;
+const
+  tbAuto = policyunit.tbAuto;
+  tbOpenSSL = policyunit.tbOpenSSL;
+  tbGnuTLS = policyunit.tbGnuTLS;
+  tbSchannel = policyunit.tbSchannel;
+  tbNetworkFramework = policyunit.tbNetworkFramework;
+
+// Configure before the first factory invocation, including failed attempts.
+procedure SetSmartTLSBackend(Backend: TTLSBackend);
+// Empty paths use fixed application-directory names. Nonempty paths must be
+// absolute. OpenSSL's SSL/crypto pair must be configured together.
+procedure SetSmartTLSLibraryPaths(const SSLPath, CryptoPath, GnuTLSPath: String);
+// tbAuto until selection succeeds. Reading does not initialize a library.
+function GetSmartTLSBackend: TTLSBackend;
+function TLSBackendName(Backend: TTLSBackend): String;
+function GetSmartTLSLibraryPath: String;
+
+implementation
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.Classes, System.DynLibs, System.Net.Ssockets, System.Net.Sslbase, System.Net.Sockets, Api.Openssl,
+  System.Net.Fpopenssl, System.Net.Opensslsockets, Api.GnuTls, System.Net.Gnutlssockets
+  {$IFDEF WINDOWS}, WinApi.Windows, System.Net.SchannelSSLSockets{$ENDIF}
+  {$IFDEF DARWIN}, System.Net.NetworkFrameworkTLS, System.Net.NetworkFrameworkSSLSockets{$ENDIF};
+{$ELSE}
+uses Classes, DynLibs, ssockets, sslbase, sockets, openssl, fpopenssl, opensslsockets, gnutls, gnutlssockets
+  {$IFDEF WINDOWS}, Windows, schannelsslsockets{$ENDIF}
+  {$IFDEF DARWIN}, networkframeworktls, networkframeworksslsockets{$ENDIF};
+{$ENDIF}
+type
+  TLibraryProbe = record
+    State: TTLSLibraryState;
+    Path, Companion, ErrorText: String;
+    Handle, CompanionHandle: TLibHandle;
+  end;
+  TGetVerifyParam = function(Connection: PSSL): Pointer; cdecl;
+  TSetVerifyIP = function(Param: Pointer; IP: PAnsiChar): LongInt; cdecl;
+  TSetDefaultVerifyPaths = function(Context: PSSL_CTX): LongInt; cdecl;
+  TSmartGnuTLSHandler = class(TGNUTLSSocketHandler)
+  public
+    function Connect: Boolean; override;
+    function Accept: Boolean; override;
+  end;
+  TSmartOpenSSLHandler = class(TOpenSSLSocketHandler)
+  protected
+    function CreateSSLContext(AType: TSSLType): TSSLContext; override;
+    procedure ConfigurePeerIdentity(const HostName: AnsiString); override;
+  public
+    function Connect: Boolean; override;
+    function Accept: Boolean; override;
+  end;
+
+var
+  SelectionLock: TRTLCriticalSection;
+  RequestedBackend: TTLSBackend = tbAuto;
+  SelectedBackend: TTLSBackend = tbAuto;
+  SelectionStarted: Boolean;
+  SelectionError, SelectedPath, ConfigSSL, ConfigCrypto, ConfigGnuTLS: String;
+  SelectedClass: TSSLSocketHandlerClass;
+  HoldLibrary, HoldCompanion: TLibHandle;
+  SetDefaultVerifyPaths: TSetDefaultVerifyPaths;
+  GetVerifyParam: TGetVerifyParam;
+  SetVerifyIP: TSetVerifyIP;
+  ClaimedSSL, ClaimedGnuTLS: Boolean;
+
+function TLSBackendName(Backend: TTLSBackend): String;
+begin Result:=policyunit.TLSBackendName(Backend) end;
+
+procedure CheckConfigurable;
+begin
+  if SelectionStarted then
+    raise ESmartTLS.Create('TLS selection has started; configuration is immutable');
+end;
+
+procedure SetSmartTLSBackend(Backend: TTLSBackend);
+begin
+  EnterCriticalSection(SelectionLock);
+  try CheckConfigurable; RequestedBackend:=Backend
+  finally LeaveCriticalSection(SelectionLock) end;
+end;
+
+function IsAbsolutePath(const Path: String): Boolean;
+begin
+  {$IFDEF WINDOWS}
+  Result:=((Length(Path)>=3) and (Path[2]=':') and (Path[3] in ['\','/'])) or
+    ((Length(Path)>2) and (Copy(Path,1,2)='\\'));
+  {$ELSE}
+  Result:=(Path<>'') and (Path[1]='/');
+  {$ENDIF}
+end;
+
+procedure SetSmartTLSLibraryPaths(const SSLPath, CryptoPath, GnuTLSPath: String);
+  procedure CheckPath(const Path: String);
+  begin
+    if (Path<>'') and not IsAbsolutePath(Path) then
+      raise ESmartTLS.Create('TLS library path must be absolute: '+Path);
+  end;
+begin
+  EnterCriticalSection(SelectionLock);
+  try
+    CheckConfigurable;
+    CheckPath(SSLPath); CheckPath(CryptoPath); CheckPath(GnuTLSPath);
+    if (SSLPath='')<>(CryptoPath='') then
+      raise ESmartTLS.Create('Configure both OpenSSL library paths');
+    ConfigSSL:=SSLPath; ConfigCrypto:=CryptoPath; ConfigGnuTLS:=GnuTLSPath;
+  finally LeaveCriticalSection(SelectionLock) end;
+end;
+
+function GetSmartTLSBackend: TTLSBackend;
+begin
+  EnterCriticalSection(SelectionLock);
+  try Result:=SelectedBackend finally LeaveCriticalSection(SelectionLock) end;
+end;
+
+function GetSmartTLSLibraryPath: String;
+begin
+  EnterCriticalSection(SelectionLock);
+  try Result:=SelectedPath finally LeaveCriticalSection(SelectionLock) end;
+end;
+
+function ApplicationDirectory: String;
+{$IFDEF WINDOWS}
+var Path: array[0..32767] of WideChar; N: Cardinal;
+{$ENDIF}
+begin
+  {$IFDEF WINDOWS}
+  N:=GetModuleFileNameW(0,@Path[0],Length(Path));
+  if (N=0) or (N>=Length(Path)) then raise ESmartTLS.Create('Cannot determine application path');
+  Result:=ExtractFilePath(UTF8Encode(UnicodeString(PWideChar(@Path[0]))));
+  {$ELSE}
+  // ParamStr(0) is the executable path on supported FPC Unix targets.
+  Result:=ExtractFilePath(ExpandFileName(ParamStr(0)));
+  {$ENDIF}
+end;
+
+{$IFDEF WINDOWS}
+procedure CheckArchitecture(const Path: String);
+var F: TFileStream; Signature: Cardinal; DOS: Word; Offset: LongInt; Machine, Expected: Word;
+begin
+  {$IFDEF CPUX86_64}Expected:=$8664;{$ELSE}
+  {$IFDEF CPUAARCH64}Expected:=$AA64;{$ELSE}Expected:=$014C;{$ENDIF}{$ENDIF}
+  F:=TFileStream.Create(Path,fmOpenRead or fmShareDenyWrite);
+  try
+    F.ReadBuffer(DOS,2);
+    if (DOS<>$5A4D) or (F.Size<64) then raise ESmartTLS.Create('Invalid PE library: '+Path);
+    F.Position:=$3C; F.ReadBuffer(Offset,4);
+    if (Offset<64) or (Int64(Offset)+6>F.Size) then raise ESmartTLS.Create('Invalid PE header: '+Path);
+    F.Position:=Offset; F.ReadBuffer(Signature,4); F.ReadBuffer(Machine,2);
+    if Signature<>$00004550 then raise ESmartTLS.Create('Invalid PE signature: '+Path);
+    if Machine<>Expected then raise ESmartTLS.Create('Wrong TLS library architecture: '+Path);
+  finally F.Free end;
+end;
+{$ENDIF}
+
+function LoadExactLibrary(const Path: String): TLibHandle;
+begin
+  if not IsAbsolutePath(Path) then raise ESmartTLS.Create('TLS library path is not absolute: '+Path);
+  {$IFDEF WINDOWS}
+  CheckArchitecture(Path);
+  // Restrict dependencies to the selected DLL directory and safe default
+  // directories. Older Windows without these flags reports a clear error.
+  Result:=TLibHandle(LoadLibraryExW(PWideChar(UTF8Decode(Path)),0,$00000100 or $00001000));
+  if Result=NilHandle then
+    raise ESmartTLS.CreateFmt('Cannot load TLS library %s (Windows error %d)',[Path,GetLastError]);
+  {$ELSE}
+  Result:=LoadLibrary(Path);
+  if Result=NilHandle then raise ESmartTLS.Create('Cannot load TLS library '+Path+': '+GetLoadErrorStr);
+  {$ENDIF}
+end;
+
+procedure RequireSymbols(Handle: TLibHandle; const Path: String; const Names: array of String);
+var I: Integer;
+begin
+  for I:=0 to High(Names) do
+    if GetProcedureAddress(Handle,Names[I])=nil then
+      raise ESmartTLS.Create('TLS library '+Path+' is missing required symbol '+Names[I]);
+end;
+
+procedure UnloadProbe(var Probe: TLibraryProbe);
+begin
+  if Probe.Handle<>NilHandle then UnloadLibrary(Probe.Handle);
+  if Probe.CompanionHandle<>NilHandle then UnloadLibrary(Probe.CompanionHandle);
+  Probe.Handle:=NilHandle; Probe.CompanionHandle:=NilHandle;
+end;
+
+function ProbeOpenSSL: TLibraryProbe;
+var Dir: String; I: Integer;
+begin
+  Result:=Default(TLibraryProbe);
+  Result.Path:=ConfigSSL; Result.Companion:=ConfigCrypto;
+  if Result.Path='' then
+    begin
+    Dir:=ApplicationDirectory;
+    {$IFDEF WINDOWS}
+    for I:=Low(SSL_DLL_Names) to High(SSL_DLL_Names) do
+      if FileExists(Dir+SSL_DLL_Names[I]+'.dll') or FileExists(Dir+Crypto_DLL_Names[I]+'.dll') then
+        begin
+        Result.Path:=Dir+SSL_DLL_Names[I]+'.dll';
+        Result.Companion:=Dir+Crypto_DLL_Names[I]+'.dll';
+        Break;
+        end;
+    {$ELSE}
+    for I:=0 to 2 do
+      begin
+      {$IFDEF DARWIN}
+      case I of
+        0: begin Result.Path:=Dir+'libssl.3.dylib'; Result.Companion:=Dir+'libcrypto.3.dylib' end;
+        1: begin Result.Path:=Dir+'libssl.1.1.dylib'; Result.Companion:=Dir+'libcrypto.1.1.dylib' end;
+        2: begin Result.Path:=Dir+'libssl.dylib'; Result.Companion:=Dir+'libcrypto.dylib' end;
+      end;
+      {$ELSE}
+      case I of
+        0: begin Result.Path:=Dir+'libssl.so.3'; Result.Companion:=Dir+'libcrypto.so.3' end;
+        1: begin Result.Path:=Dir+'libssl.so.1.1'; Result.Companion:=Dir+'libcrypto.so.1.1' end;
+        2: begin Result.Path:=Dir+'libssl.so'; Result.Companion:=Dir+'libcrypto.so' end;
+      end;
+      {$ENDIF}
+      if FileExists(Result.Path) or FileExists(Result.Companion) then Break;
+      Result.Path:=''; Result.Companion:='';
+      end;
+    {$ENDIF}
+    end;
+  if Result.Path='' then Exit;
+  // Explicit paths that do not exist are configuration errors, never absence.
+  Result.State:=lsInvalid;
+  try
+    if not FileExists(Result.Path) or not FileExists(Result.Companion) then
+      raise ESmartTLS.Create('Incomplete OpenSSL library pair: '+Result.Path+' / '+Result.Companion);
+    if IsSSLloaded then
+      raise ESmartTLS.Create('OpenSSL was initialized before smart selection; use one initialization owner');
+    Result.CompanionHandle:=LoadExactLibrary(Result.Companion);
+    RequireSymbols(Result.CompanionHandle,Result.Companion,
+      ['ERR_get_error','ERR_clear_error','ERR_error_string_n','X509_free','X509_VERIFY_PARAM_set1_ip_asc']);
+    Result.Handle:=LoadExactLibrary(Result.Path);
+    RequireSymbols(Result.Handle,Result.Path,
+      ['OPENSSL_init_ssl','TLS_method','SSL_CTX_new','SSL_CTX_free','SSL_CTX_ctrl',
+       'SSL_CTX_set_cipher_list','SSL_CTX_set_verify','SSL_CTX_set_default_passwd_cb',
+       'SSL_CTX_set_default_passwd_cb_userdata','SSL_CTX_set_default_verify_paths',
+       'SSL_CTX_load_verify_locations','SSL_new','SSL_free','SSL_set_fd',
+       'SSL_ctrl','SSL_get0_param','SSL_set1_host','SSL_connect','SSL_get_error','SSL_read',
+       'SSL_write','SSL_pending','SSL_shutdown','SSL_get_verify_result']);
+    Result.State:=lsReady;
+  except
+    on E: Exception do
+      begin Result.ErrorText:='Invalid TLS library '+Result.Path+': '+E.Message; UnloadProbe(Result) end;
+  end;
+end;
+
+function ProbeGnuTLS: TLibraryProbe;
+var Dir: String;
+begin
+  Result:=Default(TLibraryProbe);
+  Result.Path:=ConfigGnuTLS;
+  if Result.Path='' then
+    begin
+    Dir:=ApplicationDirectory;
+    {$IFDEF WINDOWS}
+    if FileExists(Dir+'libgnutls-30.dll') then Result.Path:=Dir+'libgnutls-30.dll'
+    else if FileExists(Dir+'libgnutls.dll') then Result.Path:=Dir+'libgnutls.dll';
+    {$ELSE}
+    {$IFDEF DARWIN}
+    if FileExists(Dir+'libgnutls.30.dylib') then Result.Path:=Dir+'libgnutls.30.dylib'
+    else if FileExists(Dir+'libgnutls.dylib') then Result.Path:=Dir+'libgnutls.dylib';
+    {$ELSE}
+    if FileExists(Dir+'libgnutls.so.30') then Result.Path:=Dir+'libgnutls.so.30'
+    else if FileExists(Dir+'libgnutls.so') then Result.Path:=Dir+'libgnutls.so';
+    {$ENDIF}{$ENDIF}
+    end;
+  if Result.Path='' then Exit;
+  Result.State:=lsInvalid;
+  try
+    if not FileExists(Result.Path) then raise ESmartTLS.Create('GnuTLS library is absent: '+Result.Path);
+    if GnuTLSloaded then
+      raise ESmartTLS.Create('GnuTLS was initialized before smart selection; use one initialization owner');
+    Result.Handle:=LoadExactLibrary(Result.Path);
+    RequireSymbols(Result.Handle,Result.Path,
+      ['gnutls_global_init','gnutls_init','gnutls_deinit','gnutls_bye','gnutls_handshake',
+       'gnutls_handshake_set_timeout','gnutls_priority_set_direct','gnutls_server_name_set',
+       'gnutls_session_set_verify_cert','gnutls_session_get_verify_cert_status',
+       'gnutls_certificate_allocate_credentials','gnutls_certificate_free_credentials',
+       'gnutls_certificate_set_x509_system_trust','gnutls_credentials_set',
+       'gnutls_transport_set_int2','gnutls_record_send','gnutls_record_recv',
+       'gnutls_record_check_pending','gnutls_error_is_fatal','gnutls_strerror']);
+    Result.State:=lsReady;
+  except
+    on E: Exception do
+      begin Result.ErrorText:='Invalid TLS library '+Result.Path+': '+E.Message; UnloadProbe(Result) end;
+  end;
+end;
+
+function TSmartOpenSSLHandler.CreateSSLContext(AType: TSSLType): TSSLContext;
+begin
+  Result:=inherited CreateSSLContext(AType);
+  if VerifyPeerCert and (SetDefaultVerifyPaths(Result.CTX)<>1) then
+    begin Result.Free; raise ESmartTLS.Create('OpenSSL default trust paths could not be loaded') end;
+end;
+
+function RequirePeerHost(Handler: TSSLSocketHandler): String;
+begin
+  if not (Handler.Socket is TInetSocket) then
+    raise ESmartTLS.Create('smartsslsockets requires a named TCP peer');
+  Result:=TInetSocket(Handler.Socket).NetworkAddress.Address;
+  if (Result<>'') and (Result[Length(Result)]='.') then Delete(Result,Length(Result),1);
+  if (Result='') or (Pos(#0,Result)>0) then
+    raise ESmartTLS.Create('TLS peer hostname is empty or contains NUL');
+end;
+
+procedure TSmartOpenSSLHandler.ConfigurePeerIdentity(const HostName: AnsiString);
+var IP4: in_addr; IP6: in6_addr; R: Integer;
+begin
+  // 1.1.1 SSL_set1_host only configures DNS matching. IP SANs have their
+  // own verification API; use it explicitly on every supported version.
+  if TryStrToHostAddr(HostName,IP4) or TryStrToHostAddr6(HostName,IP6) then
+    R:=SetVerifyIP(GetVerifyParam(SSL.SSL),PAnsiChar(HostName))
+  else R:=SSL.Set1Host(HostName);
+  if R<>1 then raise ESmartTLS.Create('OpenSSL could not enable peer identity verification');
+end;
+
+function TSmartGnuTLSHandler.Connect: Boolean;
+begin
+  RequirePeerHost(Self);
+  // The existing client calls gnutls_session_set_verify_cert with the peer
+  // name after setting priorities, and initializes system trust by default.
+  Result:=inherited Connect;
+  if Result and VerifyPeerCert and (gnutls_session_get_verify_cert_status(Session)<>0) then
+    begin
+    SetSSLActive(False);
+    Result:=CheckOK(GNUTLS_E_CERTIFICATE_VERIFICATION_ERROR);
+    end;
+end;
+
+function TSmartOpenSSLHandler.Connect: Boolean;
+begin
+  RequirePeerHost(Self);
+  Result:=inherited Connect;
+end;
+
+function TSmartGnuTLSHandler.Accept: Boolean;
+begin
+  raise ESmartTLS.Create('smartsslsockets is client-only; select an explicit server backend');
+  Result:=False;
+end;
+
+function TSmartOpenSSLHandler.Accept: Boolean;
+begin
+  raise ESmartTLS.Create('smartsslsockets is client-only; select an explicit server backend');
+  Result:=False;
+end;
+
+function SmartHandlerClass: TSSLSocketHandlerClass;
+var SSLProbe, GnuProbe: TLibraryProbe; Native, Chosen: TTLSBackend;
+begin
+  // Also initialize handles on the cached fast path: the finally block runs
+  // when an already-selected factory exits, including on other threads.
+  SSLProbe:=Default(TLibraryProbe); GnuProbe:=Default(TLibraryProbe);
+  EnterCriticalSection(SelectionLock);
+  try
+    if SelectionStarted then
+      begin
+      if SelectionError<>'' then raise ESmartTLS.Create(SelectionError);
+      Exit(SelectedClass);
+      end;
+    SelectionStarted:=True;
+    SSLProbe:=Default(TLibraryProbe); GnuProbe:=Default(TLibraryProbe);
+    Native:=tbAuto;
+    {$IFDEF WINDOWS}Native:=tbSchannel;{$ENDIF}
+    {$IFDEF DARWIN}if NetworkFrameworkTLSAvailable then Native:=tbNetworkFramework;{$ENDIF}
+    try
+      if RequestedBackend in [tbAuto,tbOpenSSL] then SSLProbe:=ProbeOpenSSL;
+      if (RequestedBackend=tbGnuTLS) or
+         ((RequestedBackend=tbAuto) and (SSLProbe.State=lsAbsent)) then GnuProbe:=ProbeGnuTLS;
+      if SSLProbe.State=lsInvalid then raise ESmartTLS.Create(SSLProbe.ErrorText);
+      if GnuProbe.State=lsInvalid then raise ESmartTLS.Create(GnuProbe.ErrorText);
+      Chosen:=ChooseTLSBackend(RequestedBackend,SSLProbe.State,GnuProbe.State,Native);
+      case Chosen of
+        tbOpenSSL:
+          begin
+          // Probe handles pin the checked modules while the existing bindings
+          // initialize with the exact paths. No default loader search is used.
+          if not AcquireSSLInterface(SSLProbe.Path,SSLProbe.Companion,
+            SSLProbe.Handle,SSLProbe.CompanionHandle) then
+            raise ESmartTLS.Create('Checked OpenSSL library pair failed initialization or another module owns the binding');
+          ClaimedSSL:=True;
+          Pointer(SetDefaultVerifyPaths):=GetProcedureAddress(SSLProbe.Handle,'SSL_CTX_set_default_verify_paths');
+          Pointer(GetVerifyParam):=GetProcedureAddress(SSLProbe.Handle,'SSL_get0_param');
+          Pointer(SetVerifyIP):=GetProcedureAddress(SSLProbe.CompanionHandle,'X509_VERIFY_PARAM_set1_ip_asc');
+          HoldLibrary:=SSLProbe.Handle; HoldCompanion:=SSLProbe.CompanionHandle;
+          SSLProbe.Handle:=NilHandle; SSLProbe.CompanionHandle:=NilHandle;
+          SelectedPath:=SSLProbe.Path;
+          SelectedClass:=TSmartOpenSSLHandler;
+          end;
+        tbGnuTLS:
+          begin
+          AcquireGnuTLS(GnuProbe.Path,GnuProbe.Handle);
+          ClaimedGnuTLS:=True;
+          if gnutls_global_init()<0 then raise ESmartTLS.Create('GnuTLS global initialization failed');
+          HoldLibrary:=GnuProbe.Handle; GnuProbe.Handle:=NilHandle;
+          SelectedPath:=GnuProbe.Path;
+          SelectedClass:=TSmartGnuTLSHandler;
+          end;
+        {$IFDEF WINDOWS}tbSchannel: SelectedClass:=TSchannelSocketHandler;{$ENDIF}
+        {$IFDEF DARWIN}tbNetworkFramework: SelectedClass:=TNetworkFrameworkSocketHandler;{$ENDIF}
+      else raise ESmartTLS.Create('Native TLS connection adapter is not implemented on this platform');
+      end;
+      SelectedBackend:=Chosen;
+      Result:=SelectedClass;
+    except
+      on E: Exception do
+        begin
+        SelectionError:=E.Message;
+        raise ESmartTLS.Create(SelectionError);
+        end;
+    end;
+  finally
+    UnloadProbe(SSLProbe); UnloadProbe(GnuProbe);
+    LeaveCriticalSection(SelectionLock);
+  end;
+end;
+
+initialization
+  InitCriticalSection(SelectionLock);
+  TSSLSocketHandler.SetDefaultHandlerFactory(@SmartHandlerClass);
+finalization
+  // Do not reset/unload the existing backend bindings or another unit's state.
+  if ClaimedSSL then ReleaseSSLInterfaceClaim;
+  if ClaimedGnuTLS then ReleaseGnuTLSClaim;
+  if HoldLibrary<>NilHandle then UnloadLibrary(HoldLibrary);
+  if HoldCompanion<>NilHandle then UnloadLibrary(HoldCompanion);
+  DoneCriticalSection(SelectionLock);
+end.
diff --git a/packages/fcl-tls/src/tlsbackendpolicy.pp b/packages/fcl-tls/src/tlsbackendpolicy.pp
new file mode 100644
index 0000000000..d0f5d95298
--- /dev/null
+++ b/packages/fcl-tls/src/tlsbackendpolicy.pp
@@ -0,0 +1,61 @@
+{
+    This file is part of the Free Component Library (FCL).
+    See COPYING.FPC for details about the copyright.
+}
+{$IFNDEF FPC_DOTTEDUNITS}
+unit tlsbackendpolicy;
+{$ENDIF}
+{$mode objfpc}{$H+}
+interface
+{$IFDEF FPC_DOTTEDUNITS}
+uses System.SysUtils;
+{$ELSE}
+uses SysUtils;
+{$ENDIF}
+type
+  TTLSBackend = (tbAuto, tbOpenSSL, tbGnuTLS, tbSchannel, tbNetworkFramework);
+  TTLSLibraryState = (lsAbsent, lsReady, lsInvalid);
+  ETLSBackendSelection = class(Exception);
+
+function TLSBackendName(Backend: TTLSBackend): String;
+function ChooseTLSBackend(OverrideBackend: TTLSBackend;
+  OpenSSLState, GnuTLSState: TTLSLibraryState; NativeBackend: TTLSBackend): TTLSBackend;
+
+implementation
+function TLSBackendName(Backend: TTLSBackend): String;
+const Names: array[TTLSBackend] of String =
+  ('auto', 'OpenSSL', 'GnuTLS', 'Schannel', 'Network.framework');
+begin
+  Result:=Names[Backend];
+end;
+
+function ChooseTLSBackend(OverrideBackend: TTLSBackend;
+  OpenSSLState, GnuTLSState: TTLSLibraryState; NativeBackend: TTLSBackend): TTLSBackend;
+  procedure RequireLibrary(State: TTLSLibraryState; Backend: TTLSBackend);
+  begin
+    case State of
+      lsAbsent: raise ETLSBackendSelection.Create(TLSBackendName(Backend)+' library is absent');
+      lsInvalid: raise ETLSBackendSelection.Create(TLSBackendName(Backend)+' library is invalid');
+    end;
+  end;
+begin
+  Result:=OverrideBackend;
+  case OverrideBackend of
+    tbOpenSSL: RequireLibrary(OpenSSLState,tbOpenSSL);
+    tbGnuTLS: RequireLibrary(GnuTLSState,tbGnuTLS);
+    tbSchannel, tbNetworkFramework:
+      if NativeBackend<>OverrideBackend then
+        raise ETLSBackendSelection.Create(TLSBackendName(OverrideBackend)+' is unavailable');
+    tbAuto:
+      begin
+      if OpenSSLState<>lsAbsent then
+        begin RequireLibrary(OpenSSLState,tbOpenSSL); Exit(tbOpenSSL) end;
+      if GnuTLSState<>lsAbsent then
+        begin RequireLibrary(GnuTLSState,tbGnuTLS); Exit(tbGnuTLS) end;
+      if NativeBackend=tbAuto then
+        raise ETLSBackendSelection.Create('No TLS backend is available');
+      Result:=NativeBackend;
+      end;
+  end;
+end;
+end.
diff --git a/packages/fcl-tls/tests/macos/run.sh b/packages/fcl-tls/tests/macos/run.sh
new file mode 100644
index 0000000000..db0faab039
--- /dev/null
+++ b/packages/fcl-tls/tests/macos/run.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+# Existing branch compiler/RTL and Apple SDK only; no download or installation.
+set -euo pipefail
+source_dir="$(cd "$(dirname "$0")/../../../.." && pwd)"
+compiler="${1:?Pass existing branch-built Darwin compiler}"
+output_dir="${2:?Pass a fresh absolute output directory}"
+test "$(uname -s)" = Darwin
+test "$("$compiler" -iTO)" = darwin
+test "$("$compiler" -iV)" = 3.3.1
+cpu="$("$compiler" -iTP)"
+case "$cpu" in x86_64|aarch64) ;; *) echo 'Requires 64-bit Darwin' >&2; exit 1;; esac
+[[ "$output_dir" = /* ]]
+test ! -e "$output_dir"
+mkdir -p "$output_dir"
+sdk="$(xcrun --sdk macosx --show-sdk-path)"
+tools_dir="$(dirname "$(xcrun --sdk macosx --find ld)")"
+options=(-n -B -gl -dFPC_NETWORK_FRAMEWORK_NATIVE -dFPC_NETWORKFRAMEWORK_DIAGNOSTICS
+  "-XR$sdk" "-FD$tools_dir" "-Fu$source_dir/rtl/units/$cpu-darwin"
+  "-Fu$source_dir/packages/fcl-net/src" "-Fu$source_dir/packages/fcl-tls/src"
+  "-Fu$source_dir/packages/fcl-web/src/base" "-Fu$source_dir/packages/fcl-base/src"
+  "-Fu$source_dir/packages/rtl-objpas/src/inc" "-Fu$source_dir/packages/rtl-extra/src/unix"
+  "-Fu$source_dir/packages/rtl-extra/src/darwin" "-Fu$source_dir/packages/rtl-extra/src/bsd"
+  "-Fu$source_dir/packages/openssl/src" "-Fu$source_dir/packages/gnutls/src"
+  "-Fi$source_dir/packages/fcl-net/src/unix" "-Fi$source_dir/packages/rtl-extra/src/inc"
+  "-Fi$source_dir/packages/rtl-extra/src/bsd" "-Fi$source_dir/packages/rtl-extra/src/unix"
+  "-Fi$source_dir/packages/rtl-extra/src/darwin" "-FU$output_dir" "-FE$output_dir")
+for program in testnetworknative testnetworkhttp; do
+  "$compiler" "${options[@]}" "$source_dir/packages/fcl-tls/tests/macos/$program.pp" 2>&1 | tee "$output_dir/$program-compile.log"
+done
+"$output_dir/testnetworknative" 2>&1 | tee "$output_dir/construction.log"
+otool -L "$output_dir/testnetworkhttp" | tee "$output_dir/http-imports.txt"
+python3 "$source_dir/packages/fcl-tls/tests/macos/testnetworktls.py" "$output_dir/testnetworknative" \
+  "$output_dir/testnetworkhttp" "$output_dir/fixtures" 2>&1 | tee "$output_dir/acceptance.log"
diff --git a/packages/fcl-tls/tests/macos/testnetworkhttp.pp b/packages/fcl-tls/tests/macos/testnetworkhttp.pp
new file mode 100644
index 0000000000..cad9c8a620
--- /dev/null
+++ b/packages/fcl-tls/tests/macos/testnetworkhttp.pp
@@ -0,0 +1,103 @@
+{ Real macOS HTTP acceptance harness. Run with the sibling Python fixture.
+  Requires cthreads first, native provider and diagnostic counters. }
+program testnetworkhttp;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}cthreads,{$endif}
+  SysUtils, Classes, fphttpclient, ssockets, sslsockets, openssl, gnutls,
+  smartsslsockets, networkframeworktls, networkframeworksslsockets,
+  networkframeworknative;
+type
+  TNativeHTTPClient = class(TFPHTTPClient)
+  public
+    property KeepConnectionReconnectLimit;
+  end;
+  TObserver = class
+    CreatedCount, Calls: Integer;
+    CallbackAllow, DisableAfterCreate: Boolean;
+    ExpectedVerify: Boolean;
+    procedure Created(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+  end;
+procedure Require(Value: Boolean; const MessageText: String);
+begin if not Value then raise Exception.Create('FAIL '+MessageText) end;
+procedure TObserver.Created(Sender: TObject; Handler: TSocketHandler);
+begin
+  Inc(CreatedCount);
+  Require(Handler is TNetworkFrameworkSocketHandler,'native handler selected');
+  Require(TSSLSocketHandler(Handler).VerifyPeerCert=ExpectedVerify,'HTTP verification forwarded');
+  Require(TSSLSocketHandler(Handler).CertGenerator=nil,'no external certificate generator');
+  if DisableAfterCreate then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+end;
+procedure TObserver.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin
+  Inc(Calls);
+  Require(Handler is TNetworkFrameworkSocketHandler,'callback has native handler');
+  Require(Allow,'legacy callback starts with Allow=True');
+  Allow:=CallbackAllow;
+end;
+function CertificateFailure(Domain, Code: LongInt): Boolean;
+begin
+  { Apple Security/base/SecBase.h: network TLS domain uses these SSL codes.
+    A TCP reset, EOF, timeout or generic handshake error is never a pass. }
+  Result:=(Domain=3) and ((Code=-9807) or (Code=-9808) or (Code=-9812) or (Code=-9813) or
+    (Code=-9814) or (Code=-9815) or (Code=-9843));
+end;
+var Client: TNativeHTTPClient; Observer: TObserver; URL, Expected, BodyMode, Body,
+    Failure: String; Requests, Index, Domain, Code: LongInt; Succeeded: Boolean;
+    Started: QWord;
+begin
+  try
+    Require(ParamCount=8,'usage: URL default|true|false callback after_false expected callbacks body_mode requests');
+    URL:=ParamStr(1); Expected:=ParamStr(5); BodyMode:=ParamStr(7);
+    Requests:=StrToInt(ParamStr(8)); Require(Requests>0,'positive request count');
+    Require((Expected='pass') or (Expected='certificate') or (Expected='veto'),'known expectation');
+    SetSmartTLSBackend(tbNetworkFramework);
+    Observer:=TObserver.Create; Client:=TNativeHTTPClient.Create(nil);
+    try
+      Require(not Client.VerifySSLCertificate,'existing default remains False');
+      if ParamStr(2)<>'default' then Client.VerifySSLCertificate:=StrToBool(ParamStr(2));
+      Observer.ExpectedVerify:=Client.VerifySSLCertificate;
+      Observer.CallbackAllow:=StrToBool(ParamStr(3));
+      Observer.DisableAfterCreate:=StrToBool(ParamStr(4));
+      Client.AfterSocketHandlerCreate:=@Observer.Created;
+      Client.OnVerifySSLCertificate:=@Observer.Verify;
+      Client.ConnectTimeout:=10000; Client.IOTimeout:=5000;
+      Client.KeepConnection:=Requests>1; Client.KeepConnectionReconnectLimit:=0;
+      Succeeded:=False; Domain:=0; Code:=0; Failure:='';
+      try
+        for Index:=1 to Requests do
+          begin
+          Body:=Client.Get(URL);
+          Require(Client.ResponseStatusCode=200,'HTTP 200');
+          if BodyMode='local' then Require(Body='native tls fixture'+#10,'exact local HTTP contents')
+          else Require(Length(Body)>0,'public response body');
+          end;
+        Succeeded:=True;
+      except
+        on E: ENetworkFrameworkTLS do
+          begin Domain:=E.Domain; Code:=E.Code; Failure:=E.Message end;
+        on E: Exception do Failure:=E.ClassName+': '+E.Message;
+      end;
+      Writeln('RESULT success=',Succeeded,' created=',Observer.CreatedCount,
+        ' callbacks=',Observer.Calls,' domain=',Domain,' code=',Code,' error=',Failure);
+      if Expected='pass' then Require(Succeeded,'request must succeed')
+      else if Expected='certificate' then
+        Require(not Succeeded and CertificateFailure(Domain,Code),'specific certificate rejection required')
+      else Require(not Succeeded and (Pos('application certificate veto',LowerCase(Failure))>0),'callback veto required');
+      Require(Observer.Calls=StrToInt(ParamStr(6)),'exact callback count');
+      if (Expected='pass') and (Requests>1) then Require(Observer.CreatedCount=1,'same native TLS connection reused');
+      Require(GetSmartTLSBackend=tbNetworkFramework,'backend remains fixed');
+      Require(not IsSSLloaded and not GnuTLSloaded,'no third party TLS binding loaded');
+    finally
+      Client.Free; Observer.Free;
+    end;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    Started:=GetTickCount64;
+    while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+    Require(NetworkFrameworkLiveContexts=0,'native callbacks release all contexts');
+    Writeln('PASS contexts drained; destroyed=',NetworkFrameworkDestroyedContexts);
+{$endif}
+    Writeln('PASS native fphttpclient ',Expected);
+  except on E: Exception do begin Writeln(StdErr,E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-tls/tests/macos/testnetworknative.pp b/packages/fcl-tls/tests/macos/testnetworknative.pp
new file mode 100644
index 0000000000..7b83011bc5
--- /dev/null
+++ b/packages/fcl-tls/tests/macos/testnetworknative.pp
@@ -0,0 +1,321 @@
+{ Part of FCL; see COPYING.FPC.
+  Integration harness for the pure Pascal native provider; no C object required.
+  PENDING: compile/link and run on x86_64 and arm64 macOS with an Apple SDK.
+  No arguments: construction/argument/retained owner tests, no connection starts.
+  host port verify ready: TLS handshake must succeed (verify is exactly 0 or 1).
+  host port verify error domain code: exact native connection failure expected.
+  host port verify echo: fragmented 1 MiB, partial writes, readiness timeout reuse.
+  host port verify timeout: TLS fixture sends no application data.
+  host port verify close: same idle fixture; Close interrupts unlimited Read.
+  host port verify canclose: Close interrupts unlimited CanRead.
+  host port verify eof: fixture sends 'abc' then ends TLS cleanly.
+  host port verify reset: fixture aborts TCP; must report an error, never EOF.
+  Certificates, server connection counts, fixtures and trust belong to the macOS
+  runner. This program never changes system trust or provisions a server.
+  Build with -Fu../../src -FU<output> -FE<output> testnetworknative.pp.
+  Define FPC_NETWORKFRAMEWORK_MODEL on Windows to run shared production state
+  tests only: this does not compile cblocks or prove native/TLS operation. }
+program testnetworknative;
+{$mode objfpc}{$H+}
+uses
+{$ifdef unix}
+  cthreads,
+{$endif}
+  SysUtils, Classes, networkframeworkcommon, networkframeworknative;
+
+{$ifndef FPC_NETWORKFRAMEWORK_MODEL}
+const
+  DeadlineMS = 5000;
+  POSIXDomain = 1;
+  DarwinEINVAL = 22;
+  DarwinETIMEDOUT = 60;
+  DarwinECANCELED = 89;
+  PlaintextCapacity = 16384;
+var
+  API: TFPNWAPI;
+
+procedure Check(Condition: Boolean; const What: String; Domain, Code: LongInt);
+begin
+  if not Condition then
+    raise Exception.CreateFmt('FAIL %s (domain=%d code=%d)',[What,Domain,Code]);
+end;
+
+procedure Construction;
+var Context: Pointer; Domain, Code, Status, Verify: LongInt;
+begin
+  Domain:=0; Code:=0;
+  Context:=API.CreateConnection(nil,'443',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'null hostname rejected',Domain,Code);
+  Context:=API.CreateConnection('localhost','0',1,Domain,Code);
+  Check((Context=nil) and (Domain=POSIXDomain) and (Code=DarwinEINVAL),
+    'invalid port rejected',Domain,Code);
+  for Verify:=0 to 1 do
+    begin
+    Context:=API.CreateConnection('localhost','443',Verify,Domain,Code);
+    Check(Context<>nil,'construction',Domain,Code);
+    Check(API.BytesAvailable(Context)=0,'no premature plaintext',0,0);
+    API.Retain(Context);
+    API.Close(Context);
+    try
+      Status:=API.Connect(Context,1,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinECANCELED),
+        'closed unstarted context valid under operation hold',Domain,Code);
+    finally API.Release(Context) end;
+    end;
+  Writeln('PASS construction/arguments/retained close; no connection started');
+end;
+
+procedure Echo(Context: Pointer);
+var Sent: array[0..32768] of Byte; Received: array[0..252] of Byte;
+    Offset, Size, Consumed, Returned, Offered, Count, Index, Block: LongInt;
+    Domain, Code: LongInt; Marker: AnsiString;
+begin
+  Offset:=0; Block:=0;
+  while Offset<1024*1024 do
+    begin
+    if Odd(Block) then Size:=Length(Sent) else Size:=137;
+    if Size>1024*1024-Offset then Size:=1024*1024-Offset;
+    for Index:=0 to Size-1 do Sent[Index]:=(Offset+Index) mod 251;
+    Consumed:=0;
+    while Consumed<Size do
+      begin
+      Count:=API.Write(Context,@Sent[Consumed],Size-Consumed,DeadlineMS,Domain,Code);
+      Check((Count>0) and (Count<=PlaintextCapacity) and (Count<=Size-Consumed),
+        'bounded partial write',Domain,Code);
+      Returned:=0;
+      while Returned<Count do
+        begin
+        Offered:=Count-Returned;
+        if Offered>Length(Received) then Offered:=Length(Received);
+        Offered:=API.Read(Context,@Received,Offered,DeadlineMS,Domain,Code);
+        Check((Offered>0) and (Offered<=Count-Returned),'fragmented read',Domain,Code);
+        for Index:=0 to Offered-1 do
+          Check(Received[Index]=Sent[Consumed+Returned+Index],
+            'exact echo contents',Domain,Code);
+        Inc(Returned,Offered);
+        end;
+      Inc(Consumed,Count);
+      end;
+    Inc(Offset,Size); Inc(Block);
+    end;
+  Count:=API.CanRead(Context,1,Domain,Code);
+  Check((Count=0) and (Domain=0) and (Code=0),'benign idle readiness timeout',Domain,Code);
+  Marker:='xyz';
+  Count:=API.Write(Context,PAnsiChar(Marker),3,DeadlineMS,Domain,Code);
+  Check(Count=3,'usable write after readiness timeout',Domain,Code);
+  Offset:=0;
+  while Offset<3 do
+    begin
+    Count:=API.Read(Context,@Received,3-Offset,DeadlineMS,Domain,Code);
+    Check((Count>0) and (Count<=3-Offset),'receive after readiness timeout',Domain,Code);
+    for Index:=0 to Count-1 do
+      Check(Received[Index]=Ord(Marker[Offset+Index+1]),'reuse contents',Domain,Code);
+    Inc(Offset,Count);
+    end;
+  Writeln('PASS 1 MiB fragmented echo/partial writes/readiness timeout reuse');
+end;
+
+procedure WriteTimeout(Context: Pointer);
+var Buffer: array[0..16383] of Byte; Count, Domain, Code: LongInt;
+    Sent, Started: QWord;
+begin
+  FillChar(Buffer,SizeOf(Buffer),$a5); Sent:=0; Started:=GetTickCount64;
+  repeat
+    Count:=API.Write(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+    if Count>0 then Inc(Sent,Count);
+  until (Count<0) or (Sent>=64*1024*1024) or (GetTickCount64-Started>=5000);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'terminal send deadline under fixture backpressure',Domain,Code);
+  FillChar(Buffer,SizeOf(Buffer),$5a); Sleep(100);
+  Count:=API.Write(Context,@Buffer[0],Length(Buffer),10,Domain,Code);
+  Check((Count=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+    'send deadline remains terminal',Domain,Code);
+  Writeln('PASS terminal send deadline; bytes queued before timeout=',Sent);
+end;
+
+type
+  TBlockingCaller = class(TThread)
+  public
+    Context: Pointer;
+    Readiness: Boolean;
+    Entered, Completed, Status, Domain, Code: LongInt;
+    constructor Create(Value: Pointer; IsReadiness: Boolean);
+    procedure Execute; override;
+  end;
+
+constructor TBlockingCaller.Create(Value: Pointer; IsReadiness: Boolean);
+begin
+  inherited Create(True);
+  Context:=Value; Readiness:=IsReadiness;
+end;
+
+procedure TBlockingCaller.Execute;
+var ByteValue: Byte;
+begin
+  try
+    InterlockedExchange(Entered,1);
+    if Readiness then Status:=API.CanRead(Context,High(Cardinal),Domain,Code)
+    else Status:=API.Read(Context,@ByteValue,1,0,Domain,Code);
+  finally
+    API.Release(Context);
+    InterlockedExchange(Completed,1);
+  end;
+end;
+
+procedure ConcurrentClose(var Context: Pointer; Readiness: Boolean);
+var Caller: TBlockingCaller; Start: QWord;
+begin
+  API.Retain(Context);
+  try Caller:=TBlockingCaller.Create(Context,Readiness)
+  except API.Release(Context); raise end;
+  Caller.Start;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Entered,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Entered<>0,'caller thread entered',0,0);
+  Sleep(20);
+  API.Close(Context); Context:=nil;
+  Start:=GetTickCount64;
+  while (InterlockedCompareExchange(Caller.Completed,0,0)=0) and
+    (GetTickCount64-Start<1000) do Sleep(1);
+  Check(Caller.Completed<>0,'Close wakes caller promptly',0,0);
+  Caller.WaitFor;
+  try
+    Check((Caller.Status=-1) and (Caller.Domain=POSIXDomain) and
+      (Caller.Code=DarwinECANCELED),'concurrent Close cancellation',Caller.Domain,Caller.Code);
+  finally Caller.Free end;
+  Writeln('PASS concurrent Close interrupts unlimited caller under operation hold');
+end;
+
+procedure AwaitNativeRelease;
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+var Started: QWord;
+{$endif}
+begin
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+  Started:=GetTickCount64;
+  while (NetworkFrameworkLiveContexts<>0) and (GetTickCount64-Started<5000) do Sleep(1);
+  Check(NetworkFrameworkLiveContexts=0,'all native contexts eventually released',0,0);
+  Writeln('PASS native context release; destroyed=',NetworkFrameworkDestroyedContexts);
+{$else}
+  Writeln('NOT RUN context-release observation: build with FPC_NETWORKFRAMEWORK_DIAGNOSTICS');
+{$endif}
+end;
+
+procedure RunNative;
+var Context: Pointer; Host, Port, Mode: AnsiString;
+    Verify, Domain, Code, Status, ExpectedDomain, ExpectedCode, Count, Index: LongInt;
+    ByteValue: Byte; Bytes: array[0..2] of Byte;
+begin
+  API:=NativeNetworkFrameworkAPI;
+  if not NetworkFrameworkAvailable then
+    begin
+    Writeln('SKIP native Network.framework provider unavailable: ',NetworkFrameworkAvailabilityError);
+    Halt(77);
+    end;
+  Check(Assigned(API.CreateConnection) and Assigned(API.Connect) and
+    Assigned(API.Read) and Assigned(API.Write) and Assigned(API.CanRead) and
+    Assigned(API.BytesAvailable) and Assigned(API.Close) and
+    Assigned(API.Retain) and Assigned(API.Release),'complete native provider ABI',0,0);
+  if ParamCount=0 then begin Construction; Exit end;
+  if (ParamCount<>4) and (ParamCount<>6) then
+    raise Exception.Create('usage: host port 0|1 ready|echo|timeout|writetimeout|connecttimeout|close|canclose|eof|reset; or host port 0|1 error domain code');
+  Host:=ParamStr(1); Port:=ParamStr(2); Mode:=ParamStr(4);
+  Check(TryStrToInt(ParamStr(3),Verify) and ((Verify=0) or (Verify=1)),
+    'verification is exactly 0 or 1',0,0);
+  if Mode='error' then
+    begin
+    Check((ParamCount=6) and TryStrToInt(ParamStr(5),ExpectedDomain) and
+      TryStrToInt(ParamStr(6),ExpectedCode) and (ExpectedDomain<>0) and
+      (ExpectedCode<>0),'explicit expected native error required',0,0);
+    end
+  else Check((ParamCount=4) and ((Mode='ready') or (Mode='echo') or
+    (Mode='timeout') or (Mode='close') or (Mode='canclose') or (Mode='eof') or
+    (Mode='reset') or (Mode='writetimeout') or (Mode='connecttimeout')),'known test mode',0,0);
+  Context:=API.CreateConnection(PAnsiChar(Host),PAnsiChar(Port),Verify,Domain,Code);
+  Check(Context<>nil,'create',Domain,Code);
+  try
+    if Mode='connecttimeout' then Status:=API.Connect(Context,100,Domain,Code)
+    else Status:=API.Connect(Context,DeadlineMS,Domain,Code);
+    if Mode='connecttimeout' then
+      begin
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal handshake deadline',Domain,Code);
+      Writeln('PASS terminal handshake deadline'); Exit;
+      end;
+    if Mode='error' then
+      begin
+      Check((Status=-1) and (Domain=ExpectedDomain) and (Code=ExpectedCode),
+        'exact expected native connection error',Domain,Code);
+      Writeln('PASS exact expected terminal error; classification belongs to fixture expectation');
+      Exit;
+      end;
+    Check(Status=1,'TLS connection ready',Domain,Code);
+    if Mode='ready' then Writeln('PASS TLS connection ready')
+    else if Mode='echo' then Echo(Context)
+    else if Mode='writetimeout' then WriteTimeout(Context)
+    else if (Mode='close') or (Mode='canclose') then ConcurrentClose(Context,Mode='canclose')
+    else if Mode='timeout' then
+      begin
+      ByteValue:=99;
+      Status:=API.Read(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'terminal read deadline',Domain,Code);
+      Sleep(250);
+      Check(ByteValue=99,'late completion cannot touch caller buffer',0,0);
+      Status:=API.Read(Context,@ByteValue,1,10,Domain,Code);
+      Check((Status=-1) and (Domain=POSIXDomain) and (Code=DarwinETIMEDOUT),
+        'read deadline remains terminal',Domain,Code);
+      Writeln('PASS terminal read deadline and retained caller buffer contents');
+      end
+    else if Mode='eof' then
+      begin
+      Count:=0;
+      while Count<3 do
+        begin
+        Status:=API.Read(Context,@Bytes[Count],3-Count,DeadlineMS,Domain,Code);
+        Check((Status>0) and (Status<=3-Count),'data before EOF',Domain,Code);
+        Inc(Count,Status);
+        end;
+      for Index:=0 to 2 do Check(Bytes[Index]=Ord('a')+Index,'EOF fixture contents',0,0);
+      Status:=API.Read(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      Check(Status=0,'clean EOF',Domain,Code);
+      Status:=API.Read(Context,@ByteValue,1,1,Domain,Code);
+      Check(Status=0,'repeated clean EOF',Domain,Code);
+      Writeln('PASS data before clean/repeated EOF');
+      end
+    else if Mode='reset' then
+      begin
+      Status:=API.Read(Context,@ByteValue,1,DeadlineMS,Domain,Code);
+      Check((Status=-1) and (Domain<>0) and (Code<>0) and
+        not ((Domain=POSIXDomain) and (Code=DarwinETIMEDOUT)),
+        'transport abort is an error',Domain,Code);
+      Writeln('PASS transport abort rejected as clean EOF');
+      end;
+  finally
+    if Context<>nil then API.Close(Context);
+    AwaitNativeRelease;
+  end;
+end;
+{$endif}
+
+begin
+  try
+{$ifdef FPC_NETWORKFRAMEWORK_MODEL}
+    RunNetworkFrameworkCoreModelTests;
+    Writeln('PASS shared Pascal context/state/ABI model; NOT macOS or TLS runtime validation');
+{$ifdef FPC_NETWORKFRAMEWORK_DIAGNOSTICS}
+    if (NetworkFrameworkLiveContexts<>0) or (NetworkFrameworkDestroyedContexts=0) then
+      raise Exception.Create('Shared model diagnostic counters did not drain');
+    Writeln('PASS shared-model context counters drained');
+{$endif}
+{$else}
+    RunNative;
+    AwaitNativeRelease;
+{$endif}
+  except
+    on E: Exception do
+      begin Writeln(StdErr,E.Message); Halt(1) end;
+  end;
+end.
diff --git a/packages/fcl-tls/tests/macos/testnetworktls.py b/packages/fcl-tls/tests/macos/testnetworktls.py
new file mode 100644
index 0000000000..116c4373d1
--- /dev/null
+++ b/packages/fcl-tls/tests/macos/testnetworktls.py
@@ -0,0 +1,207 @@
+"""macOS native TLS acceptance, using existing Python ssl/OpenSSL only as servers.
+
+The Pascal clients load system Network/Security, never the fixture's TLS library.
+All certificates are disposable; this script does not change any trust store.
+Public negative controls isolate hostname/expiry; private fixtures test untrusted
+chains and Verify=False, and cannot isolate a hostname/expiry trust failure.
+Each case is run once and its full result retained, including early TCP failures.
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import ssl
+import struct
+import subprocess
+import threading
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('native', type=Path)
+    parser.add_argument('http', type=Path)
+    parser.add_argument('output', type=Path)
+    args = parser.parse_args()
+    args.native, args.http = args.native.resolve(), args.http.resolve()
+    root = args.output.resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    openssl_path = shutil.which('openssl')
+    if not openssl_path:
+        raise SystemExit('Existing OpenSSL CLI is required only to generate disposable server fixtures')
+    results = []
+
+    def save():
+        (root / 'results.json').write_text(json.dumps(results, indent=2), encoding='utf-8')
+
+    def openssl(*parts):
+        completed = subprocess.run([openssl_path, *map(str, parts)], capture_output=True,
+                                   text=True, timeout=30)
+        if completed.returncode:
+            raise RuntimeError(f'Fixture command {parts[0]} failed: {completed.stderr}')
+        return completed.stdout
+
+    print('SERVER_ONLY Python', ssl.OPENSSL_VERSION, 'CLI', openssl('version').strip(), flush=True)
+    config = root / 'root.conf'
+    config.write_text('[req]\ndistinguished_name=dn\nx509_extensions=ca\nprompt=no\n'
+                      '[dn]\nCN=FPC disposable native TLS root\n[ca]\n'
+                      'basicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,cRLSign\n')
+    openssl('req', '-new', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3',
+            '-config', config, '-keyout', root / 'root.key', '-out', root / 'root.pem')
+    openssl('req', '-new', '-newkey', 'rsa:2048', '-nodes', '-subj', '/CN=localhost',
+            '-keyout', root / 'server.key', '-out', root / 'server.csr')
+    for index, (name, san) in enumerate((('valid', 'DNS:localhost,IP:127.0.0.1'),
+                                        ('wrong-dns', 'DNS:another.invalid')), 1):
+        ext = root / f'{name}.ext'
+        ext.write_text('basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\n'
+                       'extendedKeyUsage=serverAuth\nsubjectAltName=' + san + '\n')
+        openssl('x509', '-req', '-in', root / 'server.csr', '-CA', root / 'root.pem',
+                '-CAkey', root / 'root.key', '-set_serial', index, '-days', '2',
+                '-extfile', ext, '-out', root / f'{name}.pem')
+    (root / 'chain.pem').write_bytes((root / 'valid.pem').read_bytes() + (root / 'root.pem').read_bytes())
+    (root / 'index.txt').write_text('')
+    (root / 'serial').write_text('1000\n')
+    config.write_text(f'[ca]\ndefault_ca=test\n[test]\ndir="{root.as_posix()}"\n'
+                      'database=$dir/index.txt\nserial=$dir/serial\nnew_certs_dir=$dir\n'
+                      'certificate=$dir/root.pem\nprivate_key=$dir/root.key\ndefault_md=sha256\n'
+                      'policy=policy\nunique_subject=no\n[policy]\ncommonName=supplied\n')
+    now = datetime.now(timezone.utc)
+    openssl('ca', '-batch', '-notext', '-config', config, '-in', root / 'server.csr',
+            '-extfile', root / 'valid.ext', '-startdate', (now-timedelta(days=2)).strftime('%Y%m%d%H%M%SZ'),
+            '-enddate', (now-timedelta(days=1)).strftime('%Y%m%d%H%M%SZ'), '-out', root / 'expired.pem')
+
+    def execute(name, command, observed=None):
+        row = {'case': name, **(observed or {})}
+        try:
+            run = subprocess.run(list(map(str, command)), capture_output=True, text=True, timeout=25)
+            row.update(returncode=run.returncode, stdout=run.stdout, stderr=run.stderr)
+        except subprocess.TimeoutExpired as exc:
+            row.update(returncode=-1, error=str(exc))
+        results.append(row)
+        save()
+        print(('PASS' if row['returncode'] == 0 else 'FAIL'), name,
+              row.get('stdout', '').strip().replace('\n', ' | '), row.get('stderr', '').strip(), flush=True)
+        return row
+
+    def local(name, mode='http', certificate='valid', verify='false', callback='true',
+              after='false', expected='pass', calls=1, requests=1, tls='tls12', reset=False):
+        listener = socket.socket()
+        listener.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 16384)
+        listener.bind(('127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(15)
+        port = listener.getsockname()[1]
+        stop = threading.Event()
+        observed = {'tls': tls, 'certificate': certificate, 'accepted': 0, 'requests': 0}
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        version = ssl.TLSVersion.TLSv1_2 if tls == 'tls12' else ssl.TLSVersion.TLSv1_3
+        context.minimum_version = context.maximum_version = version
+        context.load_cert_chain(root / f'{certificate}.pem', root / 'server.key')
+
+        def serve():
+            try:
+                connection, _ = listener.accept()
+                observed['accepted'] += 1
+                connection.settimeout(12)
+                if mode == 'connecttimeout':
+                    stop.wait(12)
+                    connection.close()
+                    return
+                with context.wrap_socket(connection, server_side=True) as secure:
+                    observed['handshake'] = secure.version()
+                    if mode == 'http':
+                        data = b''
+                        for _ in range(requests):
+                            while b'\r\n\r\n' not in data:
+                                chunk = secure.recv(4096)
+                                if not chunk:
+                                    return
+                                data += chunk
+                            _, data = data.split(b'\r\n\r\n', 1)
+                            observed['requests'] += 1
+                            body = b'native tls fixture\n'
+                            response = b'HTTP/1.1 200 OK\r\nContent-Length: '+str(len(body)).encode()+b'\r\nConnection: keep-alive\r\n\r\n'+body
+                            for offset in range(0, len(response), 7):
+                                secure.sendall(response[offset:offset+7])
+                    elif mode == 'echo':
+                        while not stop.is_set():
+                            data = secure.recv(4096)
+                            if not data:
+                                break
+                            for offset in range(0, len(data), 113):
+                                secure.sendall(data[offset:offset+113])
+                    elif mode in ('eof', 'reset', 'fin'):
+                        if mode == 'eof':
+                            secure.sendall(b'abc')
+                            secure.unwrap().close()
+                        else:
+                            fd = secure.detach()
+                            with socket.socket(fileno=fd) as raw:
+                                if mode == 'reset':
+                                    raw.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
+                                else:
+                                    raw.shutdown(socket.SHUT_WR)
+                    elif mode == 'timeout':
+                        if not stop.wait(0.15):
+                            secure.sendall(b'late-data')
+                            observed['late_send_attempt'] = True
+                    else:
+                        stop.wait(12)
+            except (ssl.SSLError, OSError) as exc:
+                observed['server_error'] = str(exc)
+            finally:
+                listener.close()
+
+        worker = threading.Thread(target=serve, daemon=True)
+        worker.start()
+        if mode == 'http':
+            command = [args.http, f'https://localhost:{port}/', verify, callback, after,
+                       expected, calls, 'local', requests]
+        else:
+            command = [args.native, 'localhost', port, '0', 'reset' if mode == 'fin' else mode]
+        row = execute(name, command)
+        stop.set()
+        worker.join(2)
+        listener.close()
+        row.update(observed)
+        if worker.is_alive() or observed['accepted'] != 1:
+            row['fixture_error'] = 'server thread did not stop or connection missing'
+            row['returncode'] = -1
+        if expected == 'pass' and mode == 'http' and observed['requests'] != requests:
+            row['fixture_error'] = 'unexpected number of HTTP requests'
+            row['returncode'] = -1
+        if expected in ('certificate', 'veto') and observed['requests']:
+            row['fixture_error'] = 'application bytes sent after rejection'
+            row['returncode'] = -1
+        save()
+
+    for tls in ('tls12', 'tls13'):
+        if tls == 'tls13' and not ssl.HAS_TLSv1_3:
+            results.append({'case': 'tls13-support', 'returncode': -1, 'error': 'fixture lacks TLS 1.3'})
+            continue
+        local(tls+'-http-default', verify='default', tls=tls)
+        for cert in ('valid', 'wrong-dns', 'expired', 'chain'):
+            local(tls+'-'+cert+'-false', certificate=cert, tls=tls)
+            local(tls+'-'+cert+'-true-reject', certificate=cert, verify='true', expected='certificate', calls=0, tls=tls)
+        local(tls+'-after-create-false', verify='true', after='true', tls=tls)
+        local(tls+'-callback-veto', callback='false', expected='veto', tls=tls)
+        local(tls+'-http-keepalive', requests=2, tls=tls)
+        for mode in ('echo', 'timeout', 'writetimeout', 'connecttimeout', 'close', 'canclose', 'eof', 'reset', 'fin'):
+            local(tls+'-'+mode, mode=mode, tls=tls)
+    # Public controls use the runner's system trust unchanged. Both settings run
+    # even if one fails, so a connection failure cannot be mislabeled validation.
+    for host in ('example.com', 'wrong.host.badssl.com', 'expired.badssl.com', 'self-signed.badssl.com', 'untrusted-root.badssl.com'):
+        for verify in ('true', 'false'):
+            expected = 'pass' if host == 'example.com' or verify == 'false' else 'certificate'
+            execute('public-'+host+'-'+verify, [args.http, f'https://{host}/', verify, 'true', 'false', expected,
+                                               1 if expected == 'pass' else 0, 'public', 1])
+    save()
+    failures = [row['case'] for row in results if row.get('returncode') != 0]
+    print('RESULT', len(results), 'cases;', len(failures), 'failed:', ', '.join(failures), flush=True)
+    raise SystemExit(bool(failures))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/packages/fcl-tls/tests/run.ps1 b/packages/fcl-tls/tests/run.ps1
new file mode 100644
index 0000000000..f6ff8cdee7
--- /dev/null
+++ b/packages/fcl-tls/tests/run.ps1
@@ -0,0 +1,106 @@
+param(
+    [string]$Compiler,
+    [string]$OutputDirectory = (Join-Path $env:TEMP 'fpc-native-tls-tests'),
+    [string]$Python = 'python',
+    [string]$OpenSSLLibrary,
+    [string]$CryptoLibrary,
+    [string]$OpenSSLCAFile,
+    [string]$OpenSSLExecutable,
+    [switch]$Online
+)
+$ErrorActionPreference = 'Stop'
+$SourceRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..\..')).Path
+if (-not $Compiler) { $Compiler = Join-Path $SourceRoot 'compiler\ppcx64.exe' }
+$Compiler = (Resolve-Path -LiteralPath $Compiler).Path
+New-Item -ItemType Directory -Force -Path $OutputDirectory | Out-Null
+$OutputDirectory = (Resolve-Path -LiteralPath $OutputDirectory).Path
+$Log = Join-Path $OutputDirectory 'results.log'
+Set-Content -LiteralPath $Log -Encoding utf8 -Value ('FPC native TLS tests ' + (Get-Date -Format o))
+$Failures = [System.Collections.Generic.List[string]]::new()
+function Run-TestCommand([string]$Name, [string]$Executable, [string[]]$CommandArgs) {
+    ('RUN ' + $Name) | Tee-Object -FilePath $Log -Append
+    try {
+        & $Executable @CommandArgs 2>&1 | Tee-Object -FilePath $Log -Append
+        if ($LASTEXITCODE -ne 0) { throw ('Exit code ' + $LASTEXITCODE) }
+    } catch {
+        $Failures.Add($Name)
+        ('FAIL ' + $Name + ': ' + $_.Exception.Message) | Tee-Object -FilePath $Log -Append
+    }
+}
+Push-Location $SourceRoot
+try {
+    $BuildOptions = @('-n', '-gl', ('-FU' + $OutputDirectory), ('-FE' + $OutputDirectory))
+    foreach ($Relative in @('rtl\units\x86_64-win64', 'packages\fcl-net\src',
+        'packages\rtl-objpas\src\inc', 'packages\rtl-extra\src\win',
+        'packages\fcl-base\src', 'packages\fcl-web\src\base',
+        'packages\openssl\src', 'packages\gnutls\src', 'packages\fcl-tls\src')) {
+        $BuildOptions += '-Fu' + (Join-Path $SourceRoot $Relative)
+    }
+    foreach ($Relative in @('packages\fcl-net\src\win', 'packages\rtl-extra\src\inc')) {
+        $BuildOptions += '-Fi' + (Join-Path $SourceRoot $Relative)
+    }
+    foreach ($Program in @('testpolicy','testfactory','testsmart','testschannel','testtransport','testbinding','testsmartclient','testopensslpeer','testverifyoptions','testnetworkstream','testhttpconnection','testnetworkhandler','tlsstub')) {
+        Run-TestCommand ('compile ' + $Program) $Compiler ($BuildOptions + (Join-Path $PSScriptRoot ($Program + '.pp')))
+    }
+    if ($Failures.Count -gt 0) { throw 'Compilation failed; stop before running stale binaries' }
+    $NativeModelOutput = Join-Path $OutputDirectory 'native-model'
+    New-Item -ItemType Directory -Force -Path $NativeModelOutput | Out-Null
+    $NativeModelOptions = @($BuildOptions | Where-Object { $_ -cnotlike '-FU*' -and $_ -cnotlike '-FE*' })
+    $NativeModelOptions += @('-B', '-gh', '-Criot', '-dFPC_NETWORKFRAMEWORK_MODEL',
+        ('-FU' + $NativeModelOutput), ('-FE' + $NativeModelOutput))
+    Run-TestCommand 'compile native callback model' $Compiler ($NativeModelOptions + (Join-Path $PSScriptRoot 'macos\testnetworknative.pp'))
+    if ($Failures.Count -gt 0) { throw 'Native model compilation failed; stop before stale binaries' }
+    Run-TestCommand 'native callback shared model (no Apple ABI evidence)' (Join-Path $NativeModelOutput 'testnetworknative.exe') @()
+    Run-TestCommand 'HTTP transport ownership model' (Join-Path $OutputDirectory 'testhttpconnection.exe') @()
+    Run-TestCommand 'native handler ownership model' (Join-Path $OutputDirectory 'testnetworkhandler.exe') @()
+    Run-TestCommand 'Network.framework Pascal ABI model' (Join-Path $OutputDirectory 'testnetworkstream.exe') @()
+    Run-TestCommand 'policy' (Join-Path $OutputDirectory 'testpolicy.exe') @()
+    Run-TestCommand 'factory' (Join-Path $OutputDirectory 'testfactory.exe') @()
+    Run-TestCommand 'concurrent native factory' (Join-Path $OutputDirectory 'testsmart.exe') @('race')
+    Run-TestCommand 'native construction and Accept' (Join-Path $OutputDirectory 'testschannel.exe') @()
+    Run-TestCommand 'SSPI state machine' $Python @((Join-Path $PSScriptRoot 'teststates.py'), $Compiler, (Join-Path $OutputDirectory 'state-tests'))
+    if ($OpenSSLLibrary -and $CryptoLibrary) {
+        Run-TestCommand 'loader matrix' $Python @((Join-Path $PSScriptRoot 'testloader.py'),
+            (Join-Path $OutputDirectory 'testsmart.exe'), (Join-Path $OutputDirectory 'tlsstub.dll'),
+            (Resolve-Path -LiteralPath $OpenSSLLibrary).Path, (Resolve-Path -LiteralPath $CryptoLibrary).Path, '--binding', (Join-Path $OutputDirectory 'testbinding.exe'))
+    } else { 'NOT RUN loader matrix: supply an existing OpenSSL pair' | Tee-Object -FilePath $Log -Append }
+    if ($OpenSSLLibrary -and $CryptoLibrary -and $OpenSSLExecutable) {
+        Run-TestCommand 'local real TLS matrix' $Python @((Join-Path $PSScriptRoot 'testlocaltls.py'),
+            (Join-Path $OutputDirectory 'testopensslpeer.exe'), (Join-Path $OutputDirectory 'testsmartclient.exe'),
+            (Resolve-Path -LiteralPath $OpenSSLExecutable).Path, $OpenSSLLibrary, $CryptoLibrary,
+            (Join-Path $OutputDirectory 'local-tls'), '--options-client',
+            (Join-Path $OutputDirectory 'testverifyoptions.exe'))
+    } else { 'NOT RUN local real TLS matrix: supply existing libraries and -OpenSSLExecutable' | Tee-Object -FilePath $Log -Append }
+    Run-TestCommand 'handshake timeout'  $Python @((Join-Path $PSScriptRoot 'tlsrelay.py'),
+        (Join-Path $OutputDirectory 'testtransport.exe'), '--mode', 'stall')
+    if ($Online) {
+        $HTTPExe = Join-Path $OutputDirectory 'testschannel.exe'
+        Run-TestCommand 'trusted HTTPS' $HTTPExe @('https://example.com/')
+        Run-TestCommand 'wrong hostname' $HTTPExe @('https://wrong.host.badssl.com/','reject','80090322')
+        Run-TestCommand 'expired certificate' $HTTPExe @('https://expired.badssl.com/','reject','80090328')
+        Run-TestCommand 'self-signed certificate' $HTTPExe @('https://self-signed.badssl.com/','reject','80090325')
+        Run-TestCommand 'untrusted root' $HTTPExe @('https://untrusted-root.badssl.com/','reject','80090325')
+        foreach ($Mode in @('large','upload','timeout')) {
+            Run-TestCommand ('TLS transport ' + $Mode) $Python @((Join-Path $PSScriptRoot 'tlsrelay.py'),
+                (Join-Path $OutputDirectory 'testtransport.exe'), '--mode', $Mode)
+        }
+        if ($OpenSSLLibrary -and $CryptoLibrary -and $OpenSSLCAFile) {
+            $PreviousCAFile = $env:SSL_CERT_FILE
+            try {
+                $env:SSL_CERT_FILE = (Resolve-Path -LiteralPath $OpenSSLCAFile).Path
+                foreach ($URL in @('https://example.com/', 'https://1.1.1.1/',
+                    'https://wrong.host.badssl.com/', 'https://expired.badssl.com/',
+                    'https://self-signed.badssl.com/', 'https://untrusted-root.badssl.com/')) {
+                    $ClientArgs = @($OpenSSLLibrary, $CryptoLibrary, $URL)
+                    if ($URL -like '*badssl.com*') { $ClientArgs += 'reject' }
+                    Run-TestCommand ('smart OpenSSL ' + $URL) (Join-Path $OutputDirectory 'testsmartclient.exe') $ClientArgs
+                }
+            } finally { $env:SSL_CERT_FILE = $PreviousCAFile }
+        } else { 'NOT RUN OpenSSL certificate tests: supply existing libraries and -OpenSSLCAFile' | Tee-Object -FilePath $Log -Append }
+        Run-TestCommand 'TLS 1.2 fragmented transport'  $Python @((Join-Path $PSScriptRoot 'tlsrelay.py'),
+            (Join-Path $OutputDirectory 'testtransport.exe'), '--tls12')
+    } else { 'NOT RUN online certificate and transport tests: pass -Online' | Tee-Object -FilePath $Log -Append }
+    ('Failures: ' + ($Failures -join ', ')) | Tee-Object -FilePath $Log -Append
+} finally { Pop-Location }
+if ($Failures.Count) { exit 1 }
+exit 0
diff --git a/packages/fcl-tls/tests/testbinding.pp b/packages/fcl-tls/tests/testbinding.pp
new file mode 100644
index 0000000000..c205fdfb0f
--- /dev/null
+++ b/packages/fcl-tls/tests/testbinding.pp
@@ -0,0 +1,60 @@
+program testbinding;
+{$mode objfpc}{$H+}
+uses Classes, SysUtils, DynLibs, openssl, gnutls;
+type
+  TInitializer = class(TThread)
+    ErrorText: String;
+    procedure Execute; override;
+  end;
+var SSLHandle, CryptoHandle, StubHandle: TLibHandle;
+    Worker: TInitializer; Acquired: Boolean; I: Integer;
+procedure Check(Value: Boolean; const Msg: String);
+begin if not Value then raise Exception.Create(Msg) end;
+procedure TInitializer.Execute;
+begin
+  try Check(InitSSLInterface(ParamStr(3),ParamStr(4)),'Legacy initialization failed')
+  except on E: Exception do ErrorText:=E.Message end;
+end;
+begin
+  SSLHandle:=LoadLibrary(ParamStr(1));
+  CryptoHandle:=LoadLibrary(ParamStr(2));
+  StubHandle:=LoadLibrary(ParamStr(5));
+  Check((SSLHandle<>NilHandle) and (CryptoHandle<>NilHandle) and (StubHandle<>NilHandle),'Fixture load failed');
+  try
+    // Both orders: another owner wins, or the checked modules win.
+    Check(InitSSLInterface(ParamStr(3),ParamStr(4)),'Other module load failed');
+    Check(not AcquireSSLInterface(ParamStr(1),ParamStr(2),SSLHandle,CryptoHandle),
+      'Claim silently reused another OpenSSL module');
+    Check(DestroySSLInterface,'Unclaimed binding must remain destroyable');
+    for I:=1 to 50 do
+      begin
+      Worker:=TInitializer.Create(True);
+      try
+        Worker.Start;
+        Acquired:=AcquireSSLInterface(ParamStr(1),ParamStr(2),SSLHandle,CryptoHandle);
+        Worker.WaitFor;
+        Check(Worker.ErrorText='',Worker.ErrorText);
+        if Acquired then
+          begin
+          Check((SSLLibHandle=SSLHandle) and (SSLUtilHandle=CryptoHandle),'Cross-module binding');
+          Check(not DestroySSLInterface,'Claimed OpenSSL binding was destroyed');
+          ReleaseSSLInterfaceClaim;
+          end
+        else Check(SSLLibHandle<>SSLHandle,'Failed claim on matching module');
+      finally Worker.Free end;
+      Check(DestroySSLInterface,'Binding release failed');
+      end;
+    // This harmless stub tests loader ownership only, not GnuTLS crypto.
+    AcquireGnuTLS(ParamStr(5),StubHandle);
+    try
+      try FreeGnuTLS; raise Exception.Create('Claimed GnuTLS was unloaded')
+      except on E: Exception do if Pos('claimed',E.Message)=0 then raise end;
+      try LoadGnuTLS(ParamStr(1)); raise Exception.Create('Claimed GnuTLS was replaced')
+      except on E: Exception do if Pos('claimed',E.Message)=0 then raise end;
+      try AcquireGnuTLS(ParamStr(1),SSLHandle); raise Exception.Create('Mismatched GnuTLS claim accepted')
+      except on E: Exception do if Pos('another module',E.Message)=0 then raise end;
+    finally ReleaseGnuTLSClaim; FreeGnuTLS end;
+    Check(not GnuTLSloaded,'Unclaimed GnuTLS release failed');
+    Writeln('PASS binding ownership and 50 competing initializations');
+  finally UnloadLibrary(SSLHandle); UnloadLibrary(CryptoHandle); UnloadLibrary(StubHandle) end;
+end.
diff --git a/packages/fcl-tls/tests/testfactory.pp b/packages/fcl-tls/tests/testfactory.pp
new file mode 100644
index 0000000000..15e78cbeea
--- /dev/null
+++ b/packages/fcl-tls/tests/testfactory.pp
@@ -0,0 +1,39 @@
+program testfactory;
+{$mode objfpc}{$H+}
+uses SysUtils, sslsockets, sslbase;
+type
+  TClient = class(TSSLSocketHandler)
+  protected
+    function GetLastSSLErrorString: String; override;
+    function GetLastSSLErrorCode: Integer; override;
+  public
+    function CreateCertGenerator: TX509Certificate; override;
+  end;
+var Calls: Integer; H: TSSLSocketHandler;
+function TClient.GetLastSSLErrorString: String;
+begin Result:='' end;
+function TClient.GetLastSSLErrorCode: Integer;
+begin Result:=0 end;
+function TClient.CreateCertGenerator: TX509Certificate;
+begin Result:=nil end;
+function Factory: TSSLSocketHandlerClass;
+begin Inc(Calls); Result:=TClient end;
+begin
+  TSSLSocketHandler.SetDefaultHandlerFactory(@Factory);
+  if Calls<>0 then raise Exception.Create('Factory must be lazy');
+  H:=TSSLSocketHandler.GetDefaultHandler;
+  try
+    if not (H is TClient) then raise Exception.Create('Factory class');
+    H.RemoteHostName:='example.com';
+    try
+      H.CreateSelfSignedCertificate;
+      raise Exception.Create('Missing generator must fail explicitly');
+    except on E: ESSLSocketError do ; end;
+  finally H.Free end;
+  if Calls<>1 then raise Exception.Create('Factory not called');
+  TSSLSocketHandler.SetDefaultHandlerClass(TClient);
+  H:=TSSLSocketHandler.GetDefaultHandler;
+  H.Free;
+  if Calls<>1 then raise Exception.Create('Explicit class must clear factory');
+  Writeln('PASS factory');
+end.
diff --git a/packages/fcl-tls/tests/testhttpconnection.pp b/packages/fcl-tls/tests/testhttpconnection.pp
new file mode 100644
index 0000000000..b9c5145c71
--- /dev/null
+++ b/packages/fcl-tls/tests/testhttpconnection.pp
@@ -0,0 +1,279 @@
+{ Pre-TCP transport model; no native or socket connection is opened. }
+program testhttpconnection;
+{$mode objfpc}{$H+}
+uses Classes, SysUtils, fphttpclient, ssockets, sslsockets, sslbase, clientconnections;
+type
+  TMockHandler = class;
+  TMockConnection = class(TClientConnection)
+  private
+    FHandler: TMockHandler;
+    FConnected, FClosed: Boolean;
+    FReply, FRequest: AnsiString;
+  protected
+    function GetConnected: Boolean; override;
+    function GetClosed: Boolean; override;
+    function GetPeerClosed: Boolean; override;
+  public
+    constructor Create(AHandler: TMockHandler);
+    destructor Destroy; override;
+    procedure Connect; override;
+    procedure Close; override;
+    procedure DetachCallbacks(Owner: TObject); override;
+    function Read(var Buffer; Count: LongInt): LongInt; override;
+    function Write(const Buffer; Count: LongInt): LongInt; override;
+    function CanRead(Timeout: Integer): Boolean; override;
+    function BytesAvailable: Integer; override;
+  end;
+  TMockHandler = class(TSSLSocketHandler)
+  protected
+    function GetLastSSLErrorString: String; override;
+    function GetLastSSLErrorCode: Integer; override;
+  public
+    destructor Destroy; override;
+    function CreateCertGenerator: TX509Certificate; override;
+    function CreateClientConnection(const Host: String; Port: Word): TClientConnection; override;
+    function Verify: Boolean;
+  end;
+  THTTP = class(TFPHTTPClient)
+  public
+    function RawSocket: TSocketStream;
+    procedure DirectConnect;
+    function GrabSocket: TSocketStream;
+    function GrabConnection: TClientConnection;
+    procedure EventStream;
+  end;
+  TEvents = class
+    AfterVerify: Integer;
+    Veto, ThrowAfter, Custom: Boolean;
+    Calls: Integer;
+    HandlerIsMock: Boolean;
+    ClientSender, HandlerSender: TObject;
+    procedure After(Sender: TObject; Handler: TSocketHandler);
+    procedure Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+    procedure GetHandler(Sender: TObject; const UseSSL: Boolean; out Handler: TSocketHandler);
+  end;
+var
+  Created, Connects, Closes, Destroyed, HandlerDestroyed, Requests, Cases: Integer;
+  SeenConnectTimeout, SeenIOTimeout: Cardinal;
+  SeenVerify, FailConnect, FailRead, FailFactory: Boolean;
+  LastConnection: TMockConnection;
+  Detached: Integer;
+  SeenHost: String; SeenPort: Word;
+procedure Check(Condition: Boolean; const Name: String);
+begin
+  if not Condition then raise Exception.Create('FAIL '+Name);
+  Inc(Cases); Writeln('PASS ',Name);
+end;
+constructor TMockConnection.Create(AHandler: TMockHandler);
+begin inherited Create; FHandler:=AHandler; LastConnection:=Self end;
+destructor TMockConnection.Destroy;
+begin Close; FHandler.Free; Inc(Destroyed); inherited Destroy end;
+function TMockConnection.GetConnected: Boolean;
+begin Result:=FConnected end;
+function TMockConnection.GetClosed: Boolean;
+begin Result:=FClosed end;
+function TMockConnection.GetPeerClosed: Boolean;
+begin Result:=False end;
+procedure TMockConnection.Connect;
+begin
+  Inc(Connects); SeenVerify:=FHandler.VerifyPeerCert;
+  SeenConnectTimeout:=ConnectTimeout;
+  if FailConnect then raise EStreamError.Create('model handshake failed');
+  if not FHandler.Verify then raise ESSLSocketError.Create('model veto');
+  FConnected:=True;
+end;
+procedure TMockConnection.Close;
+begin if not FClosed then begin Inc(Closes); FClosed:=True; FConnected:=False end end;
+procedure TMockConnection.DetachCallbacks(Owner: TObject);
+begin
+  if Assigned(FHandler.OnVerifyCertificate) and (TMethod(FHandler.OnVerifyCertificate).Data=Pointer(Owner)) then
+    begin FHandler.OnVerifyCertificate:=Nil; Inc(Detached) end;
+end;
+function TMockConnection.Read(var Buffer; Count: LongInt): LongInt;
+begin
+  SeenIOTimeout:=IOTimeout;
+  if FailRead then raise EStreamError.Create('model read failed');
+  Result:=Length(FReply); if Result>Count then Result:=Count;
+  if Result>3 then Result:=3;
+  if Result>0 then begin Move(FReply[1],Buffer,Result); Delete(FReply,1,Result) end;
+end;
+function TMockConnection.Write(const Buffer; Count: LongInt): LongInt;
+var Chunk: AnsiString;
+begin
+  SeenIOTimeout:=IOTimeout;
+  Result:=Count; if Result>7 then Result:=7;
+  SetLength(Chunk,Result); if Result>0 then Move(Buffer,Chunk[1],Result);
+  FRequest:=FRequest+Chunk;
+  if Pos(#13#10#13#10,FRequest)>0 then
+    begin
+    Inc(Requests); FRequest:='';
+    FReply:=FReply+'HTTP/1.1 200 OK'+#13#10+'Content-Length: 5'+#13#10+
+      'Connection: keep-alive'+#13#10#13#10+'hello';
+    end;
+end;
+function TMockConnection.CanRead(Timeout: Integer): Boolean;
+begin Result:=FReply<>'' end;
+function TMockConnection.BytesAvailable: Integer;
+begin Result:=Length(FReply) end;
+function TMockHandler.GetLastSSLErrorString: String;
+begin Result:='' end;
+function TMockHandler.GetLastSSLErrorCode: Integer;
+begin Result:=0 end;
+function TMockHandler.CreateCertGenerator: TX509Certificate;
+begin Result:=Nil end;
+function TMockHandler.CreateClientConnection(const Host: String; Port: Word): TClientConnection;
+begin
+  SeenHost:=Host; SeenPort:=Port; Inc(Created);
+  if FailFactory then raise EStreamError.Create('model factory failed');
+  Result:=TMockConnection.Create(Self);
+end;
+function TMockHandler.Verify: Boolean;
+begin Result:=DoVerifyCert end;
+destructor TMockHandler.Destroy;
+begin Inc(HandlerDestroyed); inherited Destroy end;
+function THTTP.RawSocket: TSocketStream;
+begin Result:=Socket end;
+procedure THTTP.DirectConnect;
+begin ConnectToServer('logical.example',8443,True) end;
+function THTTP.GrabSocket: TSocketStream;
+begin Result:=ExtractSocket end;
+function THTTP.GrabConnection: TClientConnection;
+begin Result:=ExtractClientConnection end;
+procedure THTTP.EventStream;
+begin StartEventStream end;
+procedure TEvents.After(Sender: TObject; Handler: TSocketHandler);
+begin
+  if AfterVerify=1 then TSSLSocketHandler(Handler).VerifyPeerCert:=True;
+  if AfterVerify=2 then TSSLSocketHandler(Handler).VerifyPeerCert:=False;
+  if ThrowAfter then raise Exception.Create('model configuration failed');
+end;
+procedure TEvents.Verify(Sender: TObject; Handler: TSSLSocketHandler; var Allow: Boolean);
+begin Inc(Calls); ClientSender:=Sender; HandlerSender:=Handler; HandlerIsMock:=Handler is TMockHandler; Allow:=not Veto end;
+procedure TEvents.GetHandler(Sender: TObject; const UseSSL: Boolean; out Handler: TSocketHandler);
+begin
+  if Custom and UseSSL then Handler:=TMockHandler.Create else Handler:=Nil;
+end;
+procedure Reset;
+begin
+ Created:=0;Connects:=0;Closes:=0;Destroyed:=0;HandlerDestroyed:=0;Requests:=0;
+ FailConnect:=False;FailRead:=False;FailFactory:=False; SeenHost:='';SeenPort:=0;
+ LastConnection:=Nil;Detached:=0;
+end;
+var C: THTTP; Body: AnsiString; ErrorText: String; E: TEvents; Connection: TClientConnection;
+procedure ExpectError(Client: THTTP; const Text, Name: String);
+var Msg: String;
+begin
+  Msg:='';
+  try Client.Get('https://127.0.0.1:1/') except on X: Exception do Msg:=X.Message end;
+  Check(Pos(Text,Msg)>0,Name+' ('+Msg+')');
+end;
+begin
+  TSSLSocketHandler.SetDefaultHandlerClass(TMockHandler);
+  Reset; C:=THTTP.Create(Nil);
+  try
+    C.ConnectTimeout:=123; C.IOTimeout:=456;
+    ErrorText:='';
+    try Body:=C.Get('https://127.0.0.1:1/') except on E: Exception do ErrorText:=E.Message end;
+    Check((ErrorText='') and (Body='hello'),'factory before TCP; fragmented HTTP IO ('+ErrorText+')');
+    Check((Created=1) and (Connects=1) and (Requests=1),'one owned connection');
+    Check((SeenHost='127.0.0.1') and (SeenPort=1),'logical endpoint');
+    Check(not SeenVerify,'existing verification default');
+    Check((SeenConnectTimeout=123) and (SeenIOTimeout=456),'timeouts');
+    Check(C.RawSocket=Nil,'native transport exposes no raw socket');
+    Check((Closes=1) and (Destroyed=1) and (HandlerDestroyed=1),'normal request frees connection and handler once');
+  finally C.Free end;
+  Check((Destroyed=1) and (HandlerDestroyed=1),'no duplicate destruction');
+  Reset; C:=THTTP.Create(Nil); E:=TEvents.Create;
+  try
+    C.VerifySSLCertificate:=True; C.OnVerifySSLCertificate:=@E.Verify;
+    Check(C.Get('https://127.0.0.1:1/')='hello','verified HTTP response');
+    Check(SeenVerify and (E.Calls=1) and (E.ClientSender=C) and E.HandlerIsMock,'verification flag and callback senders');
+  finally C.Free; E.Free end;
+  Reset; C:=THTTP.Create(Nil); E:=TEvents.Create;
+  try
+    E.AfterVerify:=1; C.AfterSocketHandlerCreate:=@E.After;
+    C.Get('https://127.0.0.1:1/');
+    Check(SeenVerify,'AfterSocketHandlerCreate override is applied before native factory');
+  finally C.Free; E.Free end;
+  Reset; C:=THTTP.Create(Nil); E:=TEvents.Create;
+  try
+    E.Custom:=True; C.VerifySSLCertificate:=True; C.OnGetSocketHandler:=@E.GetHandler;
+    C.Get('https://127.0.0.1:1/');
+    Check(not SeenVerify,'custom handler configuration retains existing precedence');
+  finally C.Free; E.Free end;
+  Reset; C:=THTTP.Create(Nil); E:=TEvents.Create;
+  try
+    E.Veto:=True; C.OnVerifySSLCertificate:=@E.Verify;
+    ExpectError(C,'model veto','application veto propagates');
+    Check((Destroyed=1) and (HandlerDestroyed=1),'veto cleanup owns handler exactly once');
+  finally C.Free; E.Free end;
+  Reset; C:=THTTP.Create(Nil); E:=TEvents.Create;
+  try
+    E.ThrowAfter:=True; C.AfterSocketHandlerCreate:=@E.After;
+    ExpectError(C,'model configuration failed','configuration exception propagates');
+    Check((Created=0) and (HandlerDestroyed=1),'configuration failure frees handler before factory');
+  finally C.Free; E.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    FailFactory:=True; ExpectError(C,'model factory failed','factory failure propagates');
+    Check((Destroyed=0) and (HandlerDestroyed=1),'factory exception retains caller ownership');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    FailConnect:=True; ExpectError(C,'model handshake failed','handshake failure propagates');
+    Check((Created=1) and (Connects=1) and (Destroyed=1) and (HandlerDestroyed=1),'failed connect cleans up without another backend');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    FailRead:=True; ExpectError(C,'model read failed','read failure propagates');
+    Check((Destroyed=1) and (HandlerDestroyed=1),'read failure cleanup');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    C.KeepConnection:=True;
+    C.Get('https://127.0.0.1:1/first'); C.IOTimeout:=789;
+    C.Get('https://127.0.0.1:1/second');
+    Check((Created=1) and (Connects=1) and (Requests=2) and (Destroyed=0),'keepalive reuses one native connection');
+    Check(SeenIOTimeout=789,'live IO timeout update');
+    C.Get('https://127.0.0.2:1/third');
+    Check((Created=2) and (Connects=2) and (Destroyed=1),'keepalive host change creates another connection');
+    C.Get('https://127.0.0.2:2/fourth');
+    Check((Created=3) and (Connects=3) and (Destroyed=2),'keepalive port change creates another connection');
+    LastConnection.Close; C.KeepConnection:=False;
+    Check((Destroyed=3) and (HandlerDestroyed=3),'disabling keepalive frees a closed owned transport');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil); C.KeepConnection:=True;
+  C.Get('https://127.0.0.1:1/'); LastConnection.Close; C.Free;
+  Check((Destroyed=1) and (HandlerDestroyed=1),'client destruction frees a closed owned transport');
+  Reset; C:=THTTP.Create(Nil);
+  try
+    C.Proxy.Host:='127.0.0.1'; C.Proxy.Port:=1;
+    ExpectError(C,'does not support proxies','native proxy rejected');
+    Check((Connects=0) and (Destroyed=1) and (HandlerDestroyed=1),'proxy rejection before native connect');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    C.KeepConnection:=True; C.Get('https://127.0.0.1:1/');
+    C.Proxy.Host:='127.0.0.1'; C.Proxy.Port:=1;
+    ExpectError(C,'does not support proxies','keepalive cannot bypass proxy rejection');
+    Check(Requests=1,'unsupported proxy sends no additional request');
+    C.Proxy.Host:=''; C.UnixSocketPath:='model.sock';
+    ExpectError(C,'HTTPS over Unix sockets','keepalive cannot bypass Unix HTTPS rejection');
+    Check(Requests=1,'Unix HTTPS sends no additional request');
+  finally C.Free end;
+  Reset; C:=THTTP.Create(Nil);
+  try
+    C.DirectConnect;
+    ErrorText:=''; try C.EventStream except on X: Exception do ErrorText:=X.Message end;
+    Check(Pos('unsupported',ErrorText)>0,'native SSE socket transfer rejects explicitly');
+    Check((Destroyed=0) and LastConnection.Connected,'SSE failure does not detach transport');
+    ErrorText:=''; try C.GrabSocket except on X: Exception do ErrorText:=X.Message end;
+    Check(Pos('no raw socket',ErrorText)>0,'native raw socket extraction rejects explicitly');
+    Connection:=C.GrabConnection;
+    Check((Connection<>Nil) and (Detached=1),'native extraction detaches HTTP verification callback');
+  finally C.Free end;
+  Check((Destroyed=0) and (HandlerDestroyed=0),'extracted connection keeps owned handler alive');
+  Connection.Close; Connection.Connect; Connection.Free;
+  Check((Destroyed=1) and (HandlerDestroyed=1),'extracted transport reconnects and frees independently');
+  Writeln(Cases,' HTTP connection model checks passed');
+end.
diff --git a/packages/fcl-tls/tests/testloader.py b/packages/fcl-tls/tests/testloader.py
new file mode 100644
index 0000000000..ec9eb23ad5
--- /dev/null
+++ b/packages/fcl-tls/tests/testloader.py
@@ -0,0 +1,89 @@
+"""Windows smart-loader tests using isolated application directories.
+
+Requires the compiled testsmart.exe, tlsstub.dll, and an existing real OpenSSL
+pair. Does not install or download libraries; does not touch DLLs in the source.
+"""
+import argparse
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("exe", type=Path)
+    parser.add_argument("stub", type=Path)
+    parser.add_argument("ssl", type=Path)
+    parser.add_argument("crypto", type=Path)
+    parser.add_argument("--binding", type=Path)
+    args = parser.parse_args()
+    checks = 0
+    with tempfile.TemporaryDirectory(prefix="fpc-tls-loader-") as temp:
+        root = Path(temp)
+
+        def case(name, libraries, mode="", expected="SELECTED Schannel", success=True, extra=()):
+            nonlocal checks
+            directory = root / name
+            directory.mkdir()
+            exe = directory / "testsmart.exe"
+            shutil.copy2(args.exe, exe)
+            for destination, source in libraries.items():
+                if isinstance(source, bytes):
+                    (directory / destination).write_bytes(source)
+                else:
+                    shutil.copy2(source, directory / destination)
+            # CWD deliberately differs from the application directory.
+            result = subprocess.run([str(exe), mode, *extra], cwd=root, text=True, capture_output=True, timeout=20)
+            if (result.returncode == 0) != success or expected not in result.stdout:
+                raise AssertionError(f"{name}: rc={result.returncode}\n{result.stdout}\n{result.stderr}")
+            checks += 1
+            print("PASS", name)
+
+        if args.binding:
+            first = root / 'binding-first'
+            second = root / 'binding-second'
+            first.mkdir()
+            second.mkdir()
+            for directory in (first, second):
+                shutil.copy2(args.ssl, directory / args.ssl.name)
+                shutil.copy2(args.crypto, directory / args.crypto.name)
+            binding = subprocess.run([str(args.binding), str(first / args.ssl.name),
+                str(first / args.crypto.name), str(second / args.ssl.name),
+                str(second / args.crypto.name), str(args.stub)], text=True,
+                capture_output=True, timeout=30)
+            if binding.returncode or 'PASS binding ownership' not in binding.stdout:
+                raise AssertionError(f'binding ownership: {binding.returncode}\n{binding.stdout}\n{binding.stderr}')
+            print('PASS binding ownership and 50 competing initializations')
+        pair = {args.ssl.name: args.ssl, args.crypto.name: args.crypto}
+        case("absent", {}, "race")
+        case("cwd-library-ignored", {})
+        # Only the application directory is searched, even if CWD contains a DLL.
+        (root / args.ssl.name).write_bytes(b"bad library in cwd")
+        case("cwd-library-still-ignored", {})
+        case("corrupt-pair", {args.ssl.name: b"broken", args.crypto.name: b"broken"}, expected="TLS library", success=False)
+        case("incomplete-pair", {args.ssl.name: args.ssl}, expected="Incomplete OpenSSL", success=False)
+        case("missing-ssl-symbol", {args.ssl.name: args.stub, args.crypto.name: args.crypto}, expected="missing required symbol OPENSSL_init_ssl", success=False)
+        case("missing-crypto-symbol", {args.ssl.name: args.ssl, args.crypto.name: args.stub}, expected="missing required symbol ERR_get_error", success=False)
+        case("missing-gnutls-symbol", {"libgnutls-30.dll": args.stub}, expected="missing required symbol gnutls_global_init", success=False)
+        # Minimal PE header lets the architecture guard run before LoadLibrary.
+        wrong = bytearray(128)
+        struct.pack_into("<H", wrong, 0, 0x5A4D)
+        struct.pack_into("<I", wrong, 0x3C, 64)
+        struct.pack_into("<IH", wrong, 64, 0x4550, 0x14C)
+        case("wrong-architecture", {args.ssl.name: args.ssl, args.crypto.name: bytes(wrong)}, expected="Wrong TLS library architecture", success=False)
+        case("concurrent-openssl", pair, "raceopenssl", expected="SELECTED OpenSSL")
+        case("openssl-priority", {**pair, "libgnutls-30.dll": args.stub}, expected="SELECTED OpenSSL")
+        case("explicit-native", {args.ssl.name: b"broken", args.crypto.name: b"broken", "libgnutls-30.dll": args.stub}, "native")
+        case("explicit-openssl-absent", {}, "openssl", expected="OpenSSL library is absent", success=False)
+        case("explicit-gnutls-bypasses-openssl", {args.ssl.name: b"broken", args.crypto.name: b"broken", "libgnutls-30.dll": args.stub}, "gnutls", expected="missing required symbol gnutls_global_init", success=False)
+        case("relative-path-rejected", {}, "relative", expected="path must be absolute", success=False)
+        case("preinitialized-openssl", pair, "preloaded", expected="initialized before smart selection", success=False,
+             extra=(str((root / "preinitialized-openssl" / args.ssl.name)), str((root / "preinitialized-openssl" / args.crypto.name))))
+        case("explicit-class-compatible", {}, "explicitclass", expected="PASS explicit handler registration")
+    print(f"PASS loader {checks}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/packages/fcl-tls/tests/testlocaltls.py b/packages/fcl-tls/tests/testlocaltls.py
new file mode 100644
index 0000000000..6139340633
--- /dev/null
+++ b/packages/fcl-tls/tests/testlocaltls.py
@@ -0,0 +1,246 @@
+"""Real local TLS/chain tests using an existing OpenSSL CLI and Python ssl.
+
+All keys and CA files are disposable test material in the requested output
+directory. Only each child client's SSL_CERT_FILE is set; no certificate store,
+software installation, DNS/hosts file or account setting is modified.
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+import os
+from pathlib import Path
+import socket
+import ssl
+import subprocess
+import threading
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('peer', type=Path)
+    p.add_argument('httpclient', type=Path)
+    p.add_argument('openssl', type=Path)
+    p.add_argument('ssl_library', type=Path)
+    p.add_argument('crypto_library', type=Path)
+    p.add_argument('output', type=Path)
+    p.add_argument('--options-client', type=Path)
+    args = p.parse_args()
+    for name in ('peer', 'httpclient', 'openssl', 'ssl_library', 'crypto_library'):
+        setattr(args, name, getattr(args, name).resolve())
+    for value in (args.peer, args.httpclient, args.openssl, args.ssl_library, args.crypto_library):
+        if not value.is_file():
+            raise SystemExit(f'Existing fixture/tool is missing: {value}')
+    if not ssl.HAS_TLSv1_3:
+        raise SystemExit('Python server must support TLS 1.3 to run the complete fixture matrix')
+    args.output.mkdir(parents=True, exist_ok=True)
+    root = args.output.resolve()
+    log = root / 'results.json'
+    results = []
+
+    def openssl(*parts):
+        command = [str(args.openssl), *map(str, parts)]
+        completed = subprocess.run(command, text=True, capture_output=True, timeout=30)
+        if completed.returncode:
+            raise RuntimeError(f'OpenSSL fixture command failed: {parts[0]}\n{completed.stderr}')
+        return completed.stdout
+
+    serial = 0
+    # Two unrelated roots, one trusted only by the disposable child-client file.
+    for ca in ('root', 'other-root'):
+        openssl('req', '-new', '-x509', '-newkey', 'rsa:2048', '-nodes',
+                '-keyout', root / f'{ca}.key', '-out', root / f'{ca}.pem',
+                '-days', '3', '-subj', f'/CN=FPC disposable {ca}',
+                '-addext', 'basicConstraints=critical,CA:TRUE',
+                '-addext', 'keyUsage=critical,keyCertSign,cRLSign')
+    openssl('genpkey', '-algorithm', 'RSA', '-pkeyopt', 'rsa_keygen_bits:2048',
+            '-out', root / 'server.key')
+    openssl('req', '-new', '-key', root / 'server.key', '-out', root / 'server.csr',
+            '-subj', '/CN=localhost')
+
+    def leaf(name, san, ca='root'):
+        nonlocal serial
+        serial += 1
+        ext = root / f'{name}.ext'
+        ext.write_text('basicConstraints=critical,CA:FALSE\n'
+                       'keyUsage=critical,digitalSignature,keyEncipherment\n'
+                       'extendedKeyUsage=serverAuth\nsubjectAltName=' + san + '\n')
+        openssl('x509', '-req', '-in', root / 'server.csr', '-CA', root / f'{ca}.pem',
+                '-CAkey', root / f'{ca}.key', '-set_serial', str(serial),
+                '-days', '2', '-extfile', ext, '-out', root / f'{name}.pem')
+
+    leaf('valid', 'DNS:localhost,IP:127.0.0.1,IP:::1')
+    leaf('wrong-dns', 'DNS:another.invalid')
+    leaf('dns-number', 'DNS:127.0.0.1')
+    leaf('dns-only', 'DNS:localhost')
+    leaf('untrusted', 'DNS:localhost,IP:127.0.0.1', 'other-root')
+    (root / 'untrusted-chain.pem').write_bytes((root / 'untrusted.pem').read_bytes() +
+                                               (root / 'other-root.pem').read_bytes())
+    openssl('req', '-new', '-x509', '-key', root / 'server.key', '-out', root / 'self-signed.pem',
+            '-days', '2', '-subj', '/CN=localhost', '-addext', 'subjectAltName=DNS:localhost,IP:127.0.0.1')
+    # A normally ordered, already expired validity interval independent of clock year.
+    (root / 'index.txt').write_text('')
+    (root / 'serial').write_text('1000\n')
+    config = root / 'ca.conf'
+    config.write_text(f"""[ca]
+default_ca = test
+[test]
+dir = "{root.as_posix()}"
+database = $dir/index.txt
+serial = $dir/serial
+new_certs_dir = $dir
+certificate = $dir/root.pem
+private_key = $dir/root.key
+default_md = sha256
+policy = policy
+unique_subject = no
+[policy]
+commonName = supplied
+""")
+    now = datetime.now(timezone.utc)
+    fmt = '%Y%m%d%H%M%SZ'
+    openssl('ca', '-batch', '-notext', '-config', config, '-in', root / 'server.csr',
+            '-extfile', root / 'valid.ext', '-startdate', (now - timedelta(days=2)).strftime(fmt),
+            '-enddate', (now - timedelta(days=1)).strftime(fmt), '-out', root / 'expired.pem')
+    environment = os.environ.copy()
+    environment['SSL_CERT_FILE'] = str(root / 'root.pem')
+    environment['TLS_SSL_LIBRARY'] = str(args.ssl_library)
+    environment['TLS_CRYPTO_LIBRARY'] = str(args.crypto_library)
+
+    def case(name, certificate='valid', expected='ok', code=0, host='localhost',
+             protocol='tls12', client='peer', drop=False, client_protocol=None,
+             options=None, sequence=None):
+        family = socket.AF_INET6 if ':' in host else socket.AF_INET
+        listener = socket.socket(family)
+        listener.bind(('::1' if family == socket.AF_INET6 else '127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(10)
+        port = listener.getsockname()[1]
+        observed = {'case': name, 'protocol': protocol, 'server_handshake': False}
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        context.load_cert_chain(root / f'{certificate}.pem', root / 'server.key')
+        version = ssl.TLSVersion.TLSv1_2 if protocol == 'tls12' else ssl.TLSVersion.TLSv1_3
+        context.minimum_version = context.maximum_version = version
+
+        def serve_one():
+            try:
+                connection, _ = listener.accept()
+                with connection:
+                    connection.settimeout(8)
+                    if drop:
+                        hello = connection.recv(16384)
+                        observed['client_hello_bytes'] = len(hello)
+                        observed['server_action'] = 'TCP FIN before any certificate'
+                        connection.shutdown(socket.SHUT_RDWR)
+                        return
+                    with context.wrap_socket(connection, server_side=True) as secure:
+                        observed['server_handshake'] = True
+                        observed['negotiated'] = secure.version()
+                        request = secure.recv(16384)
+                        observed['request_bytes'] = len(request)
+                        body = b'local tls fixture\n'
+                        response = b'HTTP/1.1 200 OK\r\nContent-Length: ' + str(len(body)).encode() + b'\r\nConnection: close\r\n\r\n' + body
+                        secure.sendall(response)
+                        # Send/receive proper close_notify without treating an
+                        # expected rejected-handshake alert as a server error.
+                        try:
+                            secure.unwrap().close()
+                        except (ssl.SSLError, OSError) as exc:
+                            observed['close'] = str(exc)
+            except Exception as exc:
+                observed['server_error'] = str(exc)
+            finally:
+                if not sequence:
+                    listener.close()
+
+        def serve():
+            # One client process can change validation between two connections.
+            for _ in range(2 if sequence else 1):
+                serve_one()
+
+        worker = threading.Thread(target=serve, daemon=True)
+        worker.start()
+        if client == 'peer':
+            command = [str(args.peer), str(args.ssl_library), str(args.crypto_library), host,
+                       str(port), expected, str(code), client_protocol or protocol]
+        elif client == 'options':
+            mode, verify, callback, after, accepted, calls, error = options
+            command = [str(args.options_client), mode, verify, callback, after,
+                       f'https://localhost:{port}/', str(accepted), str(calls), error or 'none']
+            if sequence:
+                verify2, accepted2, calls2, error2 = sequence
+                command.extend([verify2, str(accepted2), str(calls2), error2 or 'none'])
+        else:
+            url_host = f'[{host}]' if family == socket.AF_INET6 else host
+            command = [str(args.httpclient), str(args.ssl_library), str(args.crypto_library),
+                       f'https://{url_host}:{port}/']
+            if expected == 'verify':
+                command.append('reject')
+        completed = subprocess.run(command, env=environment, text=True, capture_output=True, timeout=20)
+        worker.join(10)
+        listener.close()
+        observed.update(returncode=completed.returncode, stdout=completed.stdout, stderr=completed.stderr)
+        results.append(observed)
+        log.write_text(json.dumps(results, indent=2), encoding='utf-8')
+        if worker.is_alive() or completed.returncode:
+            raise AssertionError(f'{name}: {observed}')
+        if expected == 'ok' and not observed['server_handshake']:
+            raise AssertionError(f'{name}: server did not establish TLS')
+        if drop and not observed.get('client_hello_bytes', 0):
+            raise AssertionError(f'{name}: missing ClientHello evidence')
+        print('PASS', name, completed.stdout.strip().replace('\n', ' | '), flush=True)
+
+    for protocol in ('tls12', 'tls13'):
+        case(protocol + '-trusted-dns', protocol=protocol)
+        case(protocol + '-trusted-ipv4', host='127.0.0.1', protocol=protocol)
+        case(protocol + '-wrong-dns', 'wrong-dns', 'verify', 62, protocol=protocol)
+        case(protocol + '-expired', 'expired', 'verify', 10, protocol=protocol)
+        case(protocol + '-self-signed', 'self-signed', 'verify', 18, protocol=protocol)
+        case(protocol + '-untrusted-root', 'untrusted', 'verify', 20, protocol=protocol)
+        case(protocol + '-untrusted-complete-chain', 'untrusted-chain', 'verify', 19, protocol=protocol)
+        case(protocol + '-numeric-dns-is-not-ip-san', 'dns-number', 'verify', 64,
+             host='127.0.0.1', protocol=protocol)
+        case(protocol + '-transport-eof', expected='eof', protocol=protocol, drop=True)
+    case('tls12-server-auto-client', client_protocol='auto')
+    case('tls12-untrusted-chain-auto-client', 'untrusted-chain', 'verify', 19, client_protocol='auto')
+    # Loopback IPv6 is deterministic and requires no public IPv6 connectivity.
+    case('trusted-ipv6', host='::1')
+    case('wrong-ipv6', 'dns-only', 'verify', 64, host='::1')
+    case('httpclient-trusted', client='http')
+    for name in ('wrong-dns', 'expired', 'self-signed', 'untrusted', 'untrusted-chain'):
+        case('httpclient-' + name, name, 'verify', client='http')
+    if args.options_client:
+        # Native True rejects these disposable roots; no Windows trust store is
+        # changed. DNS/expiry isolation is supplied by the OpenSSL cases above.
+        for mode in ('legacy', 'smart', 'native'):
+            for certificate in ('wrong-dns', 'expired', 'self-signed', 'untrusted', 'untrusted-chain'):
+                error = '80090325' if mode == 'native' else 'certificate verify failed'
+                case(f'{mode}-verify-true-{certificate}', certificate, 'verify', client='options',
+                     options=(mode, 'true', 'true', 'none', False, 0, error))
+                case(f'{mode}-verify-false-{certificate}', certificate, client='options',
+                     options=(mode, 'false', 'true', 'none', True, 1, ''))
+            case(f'{mode}-default-false', 'self-signed', client='options',
+                 options=(mode, 'default', 'true', 'none', True, 1, ''))
+            case(f'{mode}-after-create-false', 'self-signed', client='options',
+                 options=(mode, 'true', 'true', 'false', True, 1, ''))
+            case(f'{mode}-callback-veto', expected='verify', client='options',
+                 options=(mode, 'false', 'false', 'none', False, 1, ''))
+            error = '80090325' if mode == 'native' else 'certificate verify failed'
+            case(f'{mode}-false-then-true', 'self-signed', client='options',
+                 options=(mode, 'false', 'true', 'none', True, 1, ''),
+                 sequence=('true', False, 0, error))
+            case(f'{mode}-true-then-false', 'self-signed', client='options',
+                 options=(mode, 'true', 'true', 'none', False, 0, error),
+                 sequence=('false', True, 1, ''))
+            if mode != 'native':
+                for certificate in ('wrong-dns', 'expired', 'self-signed', 'untrusted', 'untrusted-chain'):
+                    case(f'{mode}-tls13-false-{certificate}', certificate, protocol='tls13', client='options',
+                         options=(mode, 'false', 'true', 'none', True, 1, ''))
+                case(f'{mode}-strict-trusted-callback', client='options',
+                     options=(mode, 'true', 'true', 'none', True, 1, ''))
+                case(f'{mode}-strict-trusted-veto', expected='verify', client='options',
+                     options=(mode, 'true', 'false', 'none', False, 1, ''))
+    print(f'PASS local real TLS {len(results)}; Python server {ssl.OPENSSL_VERSION}; log={log}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/packages/fcl-tls/tests/testnetworkhandler.pp b/packages/fcl-tls/tests/testnetworkhandler.pp
new file mode 100644
index 0000000000..39c4073ff7
--- /dev/null
+++ b/packages/fcl-tls/tests/testnetworkhandler.pp
@@ -0,0 +1,158 @@
+{ Native handler/transport ownership model; does not run Apple APIs. }
+program testnetworkhandler;
+{$mode objfpc}{$H+}
+uses {$ifdef unix}cthreads,{$endif} Classes, SysUtils, clientconnections,
+  sslsockets, sslbase, networkframeworktls, networkframeworksslsockets;
+type
+  TContext = class
+    Refs: Integer;
+    Closed: Boolean;
+    Data: AnsiString;
+    Lock: TRTLCriticalSection;
+    Cancel: PRTLEvent;
+    constructor Create;
+    destructor Destroy; override;
+  end;
+  TModelStream = class(TNetworkFrameworkTLSStream)
+    constructor Create(const Host: String; Port: Word; Verify: Boolean);
+  end;
+  TModelHandler = class(TNetworkFrameworkSocketHandler)
+  protected
+    function CreateTLSStream(const Host: String; Port: Word): TNetworkFrameworkTLSStream; override;
+  public
+    destructor Destroy; override;
+  end;
+  TVerifier = class
+    Sender: TObject;
+    Calls: Integer;
+    Veto, ThrowError: Boolean;
+    procedure Verify(AOwner: TObject; var Allow: Boolean);
+  end;
+  TReader = class(TThread)
+    Connection: TClientConnection;
+    Rejected: Boolean;
+    procedure Execute; override;
+  end;
+var
+  API: TFPNWAPI;
+  Live, Creates, HandlersDestroyed, Cases, NativeVerify: Integer;
+  SeenConnectTimeout, SeenIOTimeout: Cardinal;
+  BlockingRead: Boolean;
+  ReadEntered: LongInt;
+procedure Check(Value: Boolean; const Name: String);
+begin if not Value then raise Exception.Create('FAIL '+Name); Inc(Cases); Writeln('PASS ',Name) end;
+constructor TContext.Create;
+begin inherited Create; Refs:=1; Data:='xy'; InitCriticalSection(Lock); Cancel:=RTLEventCreate; Inc(Live) end;
+destructor TContext.Destroy;
+begin RTLEventDestroy(Cancel); DoneCriticalSection(Lock); Dec(Live); inherited Destroy end;
+procedure NativeRetain(Value: Pointer); cdecl;
+var C: TContext;
+begin C:=TContext(Value); EnterCriticalSection(C.Lock); Inc(C.Refs); LeaveCriticalSection(C.Lock) end;
+procedure NativeRelease(Value: Pointer); cdecl;
+var C: TContext; Final: Boolean;
+begin
+  C:=TContext(Value); EnterCriticalSection(C.Lock); Dec(C.Refs); Final:=C.Refs=0; LeaveCriticalSection(C.Lock);
+  if Final then C.Free;
+end;
+procedure NativeClose(Value: Pointer); cdecl;
+var C: TContext; Drop: Boolean;
+begin
+  C:=TContext(Value); EnterCriticalSection(C.Lock); Drop:=not C.Closed;
+  C.Closed:=True; RTLEventSetEvent(C.Cancel); LeaveCriticalSection(C.Lock);
+  if Drop then NativeRelease(C);
+end;
+function NativeCreate(Host, Port: PAnsiChar; Verify: LongInt; out Domain, Code: LongInt): Pointer; cdecl;
+begin Domain:=0;Code:=0;NativeVerify:=Verify;Inc(Creates); Result:=TContext.Create end;
+function NativeConnect(Value: Pointer; Timeout: Cardinal; out Domain, Code: LongInt): LongInt; cdecl;
+begin SeenConnectTimeout:=Timeout;Domain:=0;Code:=0;Result:=1 end;
+function NativeRead(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal; out Domain, Code: LongInt): LongInt; cdecl;
+var C: TContext;
+begin
+  C:=TContext(Value); SeenIOTimeout:=Timeout; Domain:=0;Code:=0;
+  if BlockingRead then
+    begin
+    InterlockedExchange(ReadEntered,1); RTLEventWaitFor(C.Cancel);
+    Domain:=1;Code:=89;Exit(-1);
+    end;
+  Result:=Length(C.Data);if Result>Count then Result:=Count;
+  if Result>0 then begin Move(C.Data[1],Buffer^,Result);Delete(C.Data,1,Result) end;
+end;
+function NativeWrite(Value, Buffer: Pointer; Count: LongInt; Timeout: Cardinal; out Domain, Code: LongInt): LongInt; cdecl;
+begin SeenIOTimeout:=Timeout; Domain:=0;Code:=0;Result:=Count;if Result>2 then Result:=2 end;
+function NativeCanRead(Value: Pointer; Timeout: Cardinal; out Domain, Code: LongInt): LongInt; cdecl;
+begin Domain:=0;Code:=0;Result:=1 end;
+function NativeBytes(Value: Pointer): LongInt; cdecl;
+begin Result:=Length(TContext(Value).Data) end;
+constructor TModelStream.Create(const Host: String; Port: Word; Verify: Boolean);
+begin CreateWithAPI(Host,Port,Verify,API) end;
+function TModelHandler.CreateTLSStream(const Host: String; Port: Word): TNetworkFrameworkTLSStream;
+begin Result:=TModelStream.Create(Host,Port,VerifyPeerCert) end;
+destructor TModelHandler.Destroy;
+begin Inc(HandlersDestroyed);inherited Destroy end;
+procedure TVerifier.Verify(AOwner: TObject; var Allow: Boolean);
+begin
+  Sender:=AOwner;Inc(Calls);
+  if ThrowError then raise Exception.Create('model callback failed');
+  Allow:=not Veto;
+end;
+procedure TReader.Execute;
+var B: Byte;
+begin try Connection.Read(B,1) except Rejected:=True end end;
+procedure Reset;
+begin Check(Live=0,'no leaked model contexts');Creates:=0;HandlersDestroyed:=0;BlockingRead:=False;ReadEntered:=0 end;
+var H: TModelHandler; C: TClientConnection; V: TVerifier; B: array[0..3] of Byte; Msg: String; Reader: TReader; Started: QWord;
+begin
+  API.CreateConnection:=@NativeCreate;API.Connect:=@NativeConnect;
+  API.Read:=@NativeRead;API.Write:=@NativeWrite;API.CanRead:=@NativeCanRead;
+  API.BytesAvailable:=@NativeBytes;API.Close:=@NativeClose;API.Retain:=@NativeRetain;API.Release:=@NativeRelease;
+  H:=TModelHandler.Create;
+  try
+    Check((H.CertGenerator=Nil) and not H.VerifyPeerCert,'native handler construction needs no OpenSSL and retains False default');
+    Msg:='';try H.Connect except on E: Exception do Msg:=E.Message end;
+    Check(Pos('owns TCP',Msg)>0,'raw socket Connect explicitly rejected');
+    Msg:='';try H.Accept except on E: Exception do Msg:=E.Message end;
+    Check(Pos('client-only',Msg)>0,'server Accept explicitly rejected');
+  finally H.Free end;
+  Reset;H:=TModelHandler.Create;
+  try
+    H.CertificateData.CertCA.FileName:='model-ca';
+    Msg:='';try H.CreateClientConnection('logical.example',443) except on E: Exception do Msg:=E.Message end;
+    Check((Pos('unsupported',Msg)>0) and (Creates=0),'unsupported custom trust fails before native creation');
+  finally H.Free end;
+  Reset;H:=TModelHandler.Create;V:=TVerifier.Create;
+  H.VerifyPeerCert:=True;H.OnVerifyCertificate:=@V.Verify;C:=H.CreateClientConnection('logical.example',443);
+  try
+    C.ConnectTimeout:=123;C.IOTimeout:=456;C.Connect;
+    Check((NativeVerify=1) and C.Connected and H.SSLActive and (V.Calls=1) and (V.Sender=H),'verification and callback use owned handler');
+    Check((SeenConnectTimeout=123) and (C.Write(B,4)=2) and (SeenIOTimeout=456),'transport forwarding preserves timeouts and partial writes');
+    Check((C.Read(B,0)=0) and H.SSLActive,'zero-length read preserves active TLS state');
+    C.IOTimeout:=789;Check((C.Read(B,4)=2) and (SeenIOTimeout=789),'updated IO timeout forwarded');
+    Check((C.Read(B,4)=0) and C.PeerClosed and not C.Connected and not H.SSLActive,'clean EOF updates connection and handler state');
+  finally C.Free;V.Free end;
+  Check((Live=0) and (HandlersDestroyed=1),'stream and handler freed once');
+  Reset;H:=TModelHandler.Create;V:=TVerifier.Create;V.Veto:=True;
+  H.OnVerifyCertificate:=@V.Verify;C:=H.CreateClientConnection('logical.example',443);
+  try
+    Msg:='';try C.Connect except on E: Exception do Msg:=E.Message end;
+    Check((Pos('veto',Msg)>0) and not C.Connected and not H.SSLActive and (Creates=1),'application veto fails without provider switching');
+    Check((Live=0) and (Pos('veto',H.LastSSLErrorString)>0),'handler retains failure description');
+  finally C.Free;V.Free end;
+  Reset;H:=TModelHandler.Create;V:=TVerifier.Create;V.ThrowError:=True;
+  H.OnVerifyCertificate:=@V.Verify;C:=H.CreateClientConnection('logical.example',443);
+  try
+    Msg:='';try C.Connect except on E: Exception do Msg:=E.Message end;
+    Check((Pos('model callback failed',Msg)>0) and (Live=0),'application callback exception closes context');
+  finally C.Free;V.Free end;
+  Reset;H:=TModelHandler.Create;V:=TVerifier.Create;
+  H.OnVerifyCertificate:=@V.Verify;C:=H.CreateClientConnection('logical.example',443);
+  C.Connect;C.DetachCallbacks(V);C.Close;V.Free;C.Connect;C.Free;
+  Check((Creates=2) and (Live=0) and (HandlersDestroyed=1),'detached callback owner may die before reconnect');
+  Reset;H:=TModelHandler.Create;C:=H.CreateClientConnection('logical.example',443);C.Connect;
+  BlockingRead:=True;Reader:=TReader.Create(True);Reader.FreeOnTerminate:=False;Reader.Connection:=C;Reader.Start;
+  Started:=GetTickCount64;
+  while (InterlockedCompareExchange(ReadEntered,0,0)=0) and (GetTickCount64-Started<3000) do Sleep(1);
+  Check(ReadEntered=1,'adapter blocked read entered');
+  C.Free;Reader.WaitFor;
+  Check(Reader.Rejected and (Live=0) and (HandlersDestroyed=1),'Free drains complete adapter operation before handler destruction');Reader.Free;
+  Writeln(Cases,' native handler model checks passed; no Apple TLS evidence');
+end.
diff --git a/packages/fcl-tls/tests/testnetworkstream.pp b/packages/fcl-tls/tests/testnetworkstream.pp
new file mode 100644
index 0000000000..1b0165f87b
--- /dev/null
+++ b/packages/fcl-tls/tests/testnetworkstream.pp
@@ -0,0 +1,258 @@
+{ ABI model tests; do not exercise Network.framework or actual TLS. }
+program testnetworkstream;
+{$mode objfpc}{$H+}
+uses {$ifdef unix}cthreads,{$endif} Classes, SysUtils, networkframeworktls;
+type
+  TMockContext = class
+    References: LongInt;
+    Data, Sent: AnsiString;
+    Position: Integer;
+    Cancel: PRTLEvent;
+    Lock: TRTLCriticalSection;
+    constructor Create;
+    destructor Destroy; override;
+  end;
+  TMockStream = class(TNetworkFrameworkTLSStream)
+    constructor Create(VerifyPeer: Boolean = False);
+  end;
+  TVerifier = class
+    Calls: Integer;
+    Reject, ThrowError, ReenterConnect, CloseStream: Boolean;
+    procedure Verify(Sender: TObject; var Allow: Boolean);
+  end;
+  TReader = class(TThread)
+    Stream: TMockStream;
+    Rejected: Boolean;
+    Operation: Integer;
+    procedure Execute; override;
+  end;
+var
+  API: TFPNWAPI;
+  LiveContexts, Creates, Closes, Retains, Releases, Reads, Writes, Connects: Integer;
+  NativeVerify: LongInt;
+  LastConnectTimeout, LastIOTimeout, LastReadinessTimeout: Cardinal;
+  CreateFailure, ConnectFailure, ReadFailure, WriteFailure, BlockingRead, BlockingWrite, BlockingConnect, BlockingCreate: Boolean;
+  ReadStarted, CreateContinue: PRTLEvent;
+  ReadEntered: LongInt;
+  ReadinessResult: LongInt = 1;
+  LastContext: TMockContext;
+procedure Check(Value: Boolean; const Msg: String);
+begin if not Value then raise Exception.Create(Msg) end;
+constructor TMockContext.Create;
+begin
+  inherited Create; References:=1; Data:='abcdefghij'; Position:=1;
+  InitCriticalSection(Lock); Cancel:=RTLEventCreate; Inc(LiveContexts);
+end;
+destructor TMockContext.Destroy;
+begin RTLEventDestroy(Cancel); DoneCriticalSection(Lock); Dec(LiveContexts); inherited Destroy end;
+procedure MockRetain(Context: Pointer); cdecl;
+begin
+  EnterCriticalSection(TMockContext(Context).Lock);
+  Inc(TMockContext(Context).References); Inc(Retains);
+  LeaveCriticalSection(TMockContext(Context).Lock);
+end;
+procedure MockRelease(Context: Pointer); cdecl;
+var C: TMockContext; Final: Boolean;
+begin
+  C:=TMockContext(Context); EnterCriticalSection(C.Lock);
+  Dec(C.References); Final:=C.References=0; Inc(Releases);
+  LeaveCriticalSection(C.Lock); if Final then C.Free;
+end;
+procedure MockClose(Context: Pointer); cdecl;
+begin Inc(Closes); RTLEventSetEvent(TMockContext(Context).Cancel); MockRelease(Context) end;
+function MockCreate(Host,Port: PAnsiChar; Verify: LongInt; out Domain,Code: LongInt): Pointer; cdecl;
+begin
+  Inc(Creates); NativeVerify:=Verify; Domain:=0; Code:=0;
+  Check((Host='localhost') and (Port='443'),'endpoint preservation');
+  if CreateFailure then begin Domain:=1; Code:=78; Exit(Nil) end;
+  LastContext:=TMockContext.Create; Result:=LastContext;
+  if BlockingCreate then
+    begin InterlockedExchange(ReadEntered,1); RTLEventSetEvent(ReadStarted);
+    RTLEventWaitFor(CreateContinue,5000) end;
+end;
+function MockConnect(Context: Pointer; Timeout: Cardinal; out Domain,Code: LongInt): LongInt; cdecl;
+begin
+  Inc(Connects); LastConnectTimeout:=Timeout; Domain:=0; Code:=0; Result:=1;
+  if BlockingConnect then
+    begin InterlockedExchange(ReadEntered,1); RTLEventSetEvent(ReadStarted);
+    RTLEventWaitFor(TMockContext(Context).Cancel,5000); Domain:=1; Code:=89; Exit(-1) end;
+  if ConnectFailure then begin Result:=-1; Domain:=3; Code:=-9807 end;
+end;
+function MockRead(Context,Buffer: Pointer; Count: LongInt; Timeout: Cardinal; out Domain,Code: LongInt): LongInt; cdecl;
+var C: TMockContext;
+begin
+  Inc(Reads); LastIOTimeout:=Timeout; Domain:=0; Code:=0; C:=TMockContext(Context);
+  if BlockingRead then
+    begin
+    InterlockedExchange(ReadEntered,1); RTLEventSetEvent(ReadStarted);
+    RTLEventWaitFor(C.Cancel,5000); Domain:=1; Code:=89; Exit(-1);
+    end;
+  if ReadFailure then begin Domain:=1; Code:=60; Exit(-1) end;
+  Result:=Length(C.Data)-C.Position+1;
+  if Result>Count then Result:=Count;
+  if Result>3 then Result:=3;
+  if Result>0 then begin Move(C.Data[C.Position],Buffer^,Result); Inc(C.Position,Result) end;
+end;
+function MockWrite(Context,Buffer: Pointer; Count: LongInt; Timeout: Cardinal; out Domain,Code: LongInt): LongInt; cdecl;
+var S: AnsiString;
+begin
+  Inc(Writes); LastIOTimeout:=Timeout; Domain:=0; Code:=0;
+  if BlockingWrite then
+    begin InterlockedExchange(ReadEntered,1); RTLEventSetEvent(ReadStarted);
+    RTLEventWaitFor(TMockContext(Context).Cancel,5000); Domain:=1; Code:=89; Exit(-1) end;
+  if WriteFailure then begin Domain:=1; Code:=60; Exit(-1) end;
+  Result:=Count; if Result>2 then Result:=2;
+  SetString(S,PAnsiChar(Buffer),Result); TMockContext(Context).Sent:=TMockContext(Context).Sent+S;
+end;
+function MockCanRead(Context: Pointer; Timeout: Cardinal; out Domain,Code: LongInt): LongInt; cdecl;
+begin LastReadinessTimeout:=Timeout; Domain:=0; Code:=0; Result:=ReadinessResult end;
+function MockBytes(Context: Pointer): LongInt; cdecl;
+begin Result:=Length(TMockContext(Context).Data)-TMockContext(Context).Position+1 end;
+constructor TMockStream.Create(VerifyPeer: Boolean);
+begin inherited CreateWithAPI('localhost',443,VerifyPeer,API) end;
+procedure TVerifier.Verify(Sender: TObject; var Allow: Boolean);
+begin Inc(Calls); Check(not TMockStream(Sender).PeerVerified,'not committed before veto');
+  if ThrowError then raise Exception.Create('callback exception');
+  if CloseStream then TMockStream(Sender).Close;
+  if ReenterConnect then
+    begin ReenterConnect:=False; TMockStream(Sender).Connect end;
+  Allow:=not Reject;
+end;
+procedure TReader.Execute;
+var Buffer: array[0..3] of Char;
+begin
+  try
+    case Operation of
+      0: Stream.Read(Buffer,SizeOf(Buffer));
+      1: Stream.Write(Buffer,SizeOf(Buffer));
+      2: Stream.Connect;
+    end;
+  except on E:ENetworkFrameworkTLS do Rejected:=True end;
+end;
+procedure ExpectConnectFailure(S: TMockStream; ExpectedDomain, ExpectedCode: LongInt);
+var Failed: Boolean;
+begin
+  Failed:=False;
+  try S.Connect except on E:ENetworkFrameworkTLS do
+    begin Failed:=True; Check((E.Domain=ExpectedDomain) and (E.Code=ExpectedCode),'native error preserved') end end;
+  Check(Failed and not S.Connected and S.Closed,'connect must fail closed');
+end;
+var
+  S: TMockStream; V: TVerifier; Buffer: array[0..15] of Char; Data, Text: AnsiString;
+  N, Before, Cases, Mode: Integer; Failed: Boolean; Reader: TReader; Start: QWord;
+begin
+  API.CreateConnection:=@MockCreate; API.Connect:=@MockConnect; API.Read:=@MockRead;
+  API.Write:=@MockWrite; API.CanRead:=@MockCanRead; API.BytesAvailable:=@MockBytes;
+  API.Close:=@MockClose; API.Retain:=@MockRetain; API.Release:=@MockRelease;
+  Cases:=0; V:=TVerifier.Create;
+  try
+    S:=TMockStream.Create;
+    try
+      Check(not S.VerifyPeerCert and S.Closed,'False default and lazy construction');
+      Check(Creates=0,'construction must not create/start native connection');
+      S.ConnectTimeout:=123; S.IOTimeout:=456; S.OnVerifyConnection:=@V.Verify; S.Connect;
+      Check((NativeVerify=0) and (V.Calls=1) and S.Connected and not S.PeerVerified,'False policy and post-handshake callback');
+      Check(LastConnectTimeout=123,'connect timeout passed');
+      Before:=Connects; S.Connect; Check(Connects=Before,'connect idempotent');
+      Check(S.BytesAvailable=10,'plaintext buffer availability'); Inc(Cases);
+      ReadinessResult:=0; Check(not S.CanRead(7) and S.Connected,'readiness timeout remains connected');
+      Check(LastReadinessTimeout=7,'readiness deadline');
+      Check(not S.CanRead(0) and (LastReadinessTimeout=0),'poll timeout');
+      S.CanRead(-1); Check(LastReadinessTimeout=High(Cardinal),'infinite readiness sentinel');
+      ReadinessResult:=1; Inc(Cases);
+      Text:=''; repeat N:=S.Read(Buffer,SizeOf(Buffer)); if N>0 then begin SetString(Data,PChar(@Buffer[0]),N); Text:=Text+Data end until N=0;
+      Check((Text='abcdefghij') and S.PeerClosed and not S.Connected,'segmented data and clean EOF');
+      Check(S.Read(Buffer,1)=0,'EOF remains EOF'); Check(LastIOTimeout=456,'IO timeout passed'); Inc(Cases);
+      Before:=Closes; S.Close; S.Close; Check(Closes=Before,'repeated close does not release twice'); Inc(Cases);
+    finally S.Free end;
+    S:=TMockStream.Create(True);
+    try
+      V.Calls:=0; S.OnVerifyConnection:=@V.Verify; S.Connect;
+      Check((NativeVerify=1) and S.PeerVerified and (V.Calls=1),'True policy');
+      Data:='partial writes'; S.WriteBuffer(Data[1],Length(Data));
+      Check(LastContext.Sent=Data,'WriteBuffer handles native partial writes');
+      Before:=Reads+Writes; Check((S.Read(Buffer,0)=0) and (S.Write(Buffer,0)=0),'zero IO');
+      Check(Reads+Writes=Before,'zero IO not delegated'); Inc(Cases);
+      Failed:=False; try S.Seek(0,soBeginning) except on E:EStreamError do Failed:=True end;
+      Check(Failed,'nonseekable'); Inc(Cases);
+    finally S.Free end;
+    CreateFailure:=True; S:=TMockStream.Create;
+    try ExpectConnectFailure(S,1,78); Inc(Cases) finally S.Free; CreateFailure:=False end;
+    ConnectFailure:=True; V.Calls:=0; S:=TMockStream.Create(True); S.OnVerifyConnection:=@V.Verify;
+    try ExpectConnectFailure(S,3,-9807); Check(V.Calls=0,'verification failure cannot be overridden'); Inc(Cases)
+    finally S.Free; ConnectFailure:=False end;
+    V.Reject:=True; S:=TMockStream.Create; S.OnVerifyConnection:=@V.Verify;
+    try ExpectConnectFailure(S,0,0); Inc(Cases) finally S.Free; V.Reject:=False end;
+    V.ThrowError:=True; S:=TMockStream.Create; S.OnVerifyConnection:=@V.Verify;
+    try Failed:=False; try S.Connect except on E:Exception do begin Failed:=True; Check(E.Message='callback exception','callback error preservation') end end;
+      Check(Failed and S.Closed,'callback exception closes'); Inc(Cases)
+    finally S.Free; V.ThrowError:=False end;
+    S:=TMockStream.Create; S.Connect; ReadFailure:=True;
+    try Failed:=False; try S.Read(Buffer,1) except on E:ENetworkFrameworkTLS do Failed:=E.Code=60 end;
+      Check(Failed and S.Closed,'read timeout terminal'); Inc(Cases)
+    finally S.Free; ReadFailure:=False end;
+    S:=TMockStream.Create; S.Connect; WriteFailure:=True;
+    try Failed:=False; try S.Write(Buffer,1) except on E:ENetworkFrameworkTLS do Failed:=E.Code=60 end;
+      Check(Failed and S.Closed,'write timeout terminal'); Inc(Cases)
+    finally S.Free; WriteFailure:=False end;
+    BlockingRead:=True; ReadStarted:=RTLEventCreate; ReadEntered:=0; S:=TMockStream.Create; S.Connect;
+    Reader:=TReader.Create(True); Reader.Stream:=S;
+    try
+      Reader.Start; RTLEventWaitFor(ReadStarted,2000); Check(ReadEntered=1,'reader started');
+      Start:=GetTickCount64; S.Close; Reader.WaitFor;
+      Check(Reader.Rejected and (GetTickCount64-Start<2000),'Close cancels outstanding synchronous IO');
+      Check(LiveContexts=0,'pending operation retains context until return'); Inc(Cases);
+    finally Reader.Free; S.Free; RTLEventDestroy(ReadStarted); BlockingRead:=False end;
+
+    for Mode:=1 to 2 do
+      begin
+      ReadStarted:=RTLEventCreate; ReadEntered:=0; S:=TMockStream.Create;
+      if Mode=1 then S.Connect;
+      BlockingWrite:=Mode=1; BlockingConnect:=Mode=2;
+      Reader:=TReader.Create(True); Reader.Stream:=S; Reader.Operation:=Mode;
+      try
+        Reader.Start; RTLEventWaitFor(ReadStarted,2000); Check(ReadEntered=1,'operation started');
+        Start:=GetTickCount64; S.Close; Reader.WaitFor;
+        Check(Reader.Rejected and (GetTickCount64-Start<2000),'Close cancels connect/write');
+        Check(LiveContexts=0,'cancelled operation drops final reference'); Inc(Cases);
+      finally Reader.Free; S.Free; RTLEventDestroy(ReadStarted); BlockingWrite:=False; BlockingConnect:=False end;
+      end;
+    V.ReenterConnect:=True; S:=TMockStream.Create; S.OnVerifyConnection:=@V.Verify; Before:=Creates;
+    try
+      Failed:=False; try S.Connect except on E:ENetworkFrameworkTLS do Failed:=True end;
+      Check(Failed and S.Closed and (Creates=Before+1),'callback reentry cannot create second connection'); Inc(Cases);
+    finally S.Free; V.ReenterConnect:=False end;
+    V.CloseStream:=True; S:=TMockStream.Create; S.OnVerifyConnection:=@V.Verify;
+    try
+      Failed:=False; try S.Connect except on E:ENetworkFrameworkTLS do Failed:=True end;
+      Check(Failed and S.Closed,'callback Close cannot commit ready state'); Inc(Cases);
+    finally S.Free; V.CloseStream:=False end;
+
+    BlockingRead:=True; ReadStarted:=RTLEventCreate; ReadEntered:=0; S:=TMockStream.Create; S.Connect;
+    Reader:=TReader.Create(True); Reader.Stream:=S;
+    try
+      Reader.Start; RTLEventWaitFor(ReadStarted,2000); Check(ReadEntered=1,'destructor reader started');
+      Start:=GetTickCount64; S.Free; S:=Nil; Reader.WaitFor;
+      Check(Reader.Rejected and (GetTickCount64-Start<2000),'destructor drains cancelled IO before destroying locks');
+      Check(LiveContexts=0,'destructor operation reference released'); Inc(Cases);
+    finally Reader.Free; S.Free; RTLEventDestroy(ReadStarted); BlockingRead:=False end;
+    BlockingCreate:=True; ReadStarted:=RTLEventCreate; CreateContinue:=RTLEventCreate;
+    ReadEntered:=0; S:=TMockStream.Create; Before:=Connects;
+    Reader:=TReader.Create(True); Reader.Stream:=S; Reader.Operation:=2;
+    try
+      Reader.Start; RTLEventWaitFor(ReadStarted,2000); Check(ReadEntered=1,'native creation started');
+      S.Close; RTLEventSetEvent(CreateContinue); Reader.WaitFor;
+      Check(Reader.Rejected and S.Closed and (Connects=Before),'creation close generation prevents late connect');
+      Check(LiveContexts=0,'unpublished native owner released'); Inc(Cases);
+    finally Reader.Free; S.Free; RTLEventDestroy(ReadStarted); RTLEventDestroy(CreateContinue); BlockingCreate:=False end;
+
+    V.CloseStream:=True; V.ReenterConnect:=True; S:=TMockStream.Create;
+    S.OnVerifyConnection:=@V.Verify; Before:=Creates;
+    try
+      Failed:=False; try S.Connect except on E:ENetworkFrameworkTLS do Failed:=True end;
+      Check(Failed and S.Closed and (Creates=Before+1),'Close-then-Connect callback cannot create second connection'); Inc(Cases);
+    finally S.Free; V.CloseStream:=False; V.ReenterConnect:=False end;
+    Check((LiveContexts=0) and (Closes=Creates-1),'no leak or double owner release');
+    WriteLn('PASS Pascal Network.framework ABI model cases=',Cases,'; no Apple runtime/TLS evidence');
+  finally V.Free end;
+end.
diff --git a/packages/fcl-tls/tests/testopensslpeer.pp b/packages/fcl-tls/tests/testopensslpeer.pp
new file mode 100644
index 0000000000..e38bb35f3d
--- /dev/null
+++ b/packages/fcl-tls/tests/testopensslpeer.pp
@@ -0,0 +1,71 @@
+program testopensslpeer;
+{$mode objfpc}{$H+}
+// Diagnostic client: distinguish X.509 rejection from an incomplete handshake.
+uses SysUtils, ssockets, sslsockets, sslbase, opensslsockets, smartsslsockets;
+var Handler: TOpenSSLSocketHandler; Stream: TInetSocket;
+    Accepted: Boolean; ErrorText, Response, Request: AnsiString;
+    VerifyResult, N: Integer; B: array[0..4095] of Char; Started: QWord;
+procedure Check(Value: Boolean; const Msg: String);
+begin if not Value then raise Exception.Create(Msg) end;
+begin
+  SetSmartTLSLibraryPaths(ParamStr(1),ParamStr(2),'');
+  SetSmartTLSBackend(tbOpenSSL);
+  Handler:=TOpenSSLSocketHandler(TSSLSocketHandler.GetDefaultHandler);
+  Handler.VerifyPeerCert:=True;
+  if ParamStr(7)='tls12' then Handler.SSLType:=stTLSv1_2;
+  Stream:=TInetSocket.Create(ParamStr(3),StrToInt(ParamStr(4)),Handler);
+  try
+    Stream.ConnectTimeout:=5000;
+    Stream.IOTimeout:=5000;
+    if ParamStr(5)='probe' then Stream.IOTimeout:=15000;
+    Started:=GetTickCount64;
+    Accepted:=False;
+    ErrorText:='';
+    try Stream.Connect; Accepted:=True
+    except on E: Exception do ErrorText:=E.Message end;
+    VerifyResult:=-1;
+    if Handler.SSL<>nil then VerifyResult:=Handler.SSL.VerifyResult;
+    Writeln('HANDSHAKE accepted=',Accepted,' verify=',VerifyResult,
+      ' active=',Handler.SSLActive,' elapsed=',GetTickCount64-Started);
+    if ErrorText<>'' then Writeln('ERROR ',ErrorText);
+    Check(GetSmartTLSBackend=tbOpenSSL,'Handshake failure changed the backend');
+    if ParamStr(5)='probe' then
+      begin
+      // Public diagnostic only: print the verdict, do not turn failures into passes.
+      Writeln('PROBE ',ParamStr(3));
+      end
+    else if ParamStr(5)='verify' then
+      begin
+      Check(not Accepted and not Handler.SSLActive,'Invalid certificate accepted');
+      Check(VerifyResult=StrToInt(ParamStr(6)),'Unexpected X.509 verification result');
+      Check(Pos('certificate verify failed',LowerCase(ErrorText))>0,
+        'Expected a certificate rejection, not another failure');
+      end
+    else if ParamStr(5)='eof' then
+      begin
+      Check(not Accepted and not Handler.SSLActive,'Dropped handshake accepted');
+      // Zero is the default before any certificate arrives, not authentication.
+      Check(VerifyResult=0,'EOF unexpectedly produced a certificate verdict');
+      Check(Pos('unexpected eof while reading',LowerCase(ErrorText))>0,
+        'Expected OpenSSL transport EOF');
+      Check(Pos('certificate verify failed',LowerCase(ErrorText))=0,
+        'EOF was misclassified as certificate rejection');
+      end
+    else
+      begin
+      Check(Accepted and Handler.SSLActive and (VerifyResult=0),'Trusted TLS handshake failed');
+      Request:='GET / HTTP/1.1'#13#10+'Host: '+ParamStr(3)+#13#10+'Connection: close'#13#10#13#10;
+      Check(Stream.Write(Request[1],Length(Request))=Length(Request),'Request write failed');
+      Response:='';
+      repeat
+        N:=Stream.Read(B,SizeOf(B));
+        Check(N>0,'Authenticated response missing: '+Handler.LastSSLErrorString);
+        Response:=Response+Copy(AnsiString(B),1,N);
+        Check(Length(Response)<16384,'Fixture response too large');
+      until Pos('local tls fixture',Response)>0;
+      Check(Pos('HTTP/1.1 200',Response)=1,'Unexpected fixture HTTP status');
+      end;
+    if ParamStr(5)<>'probe' then
+      Writeln('PASS peer ',ParamStr(5),' host=',ParamStr(3),' verify=',VerifyResult);
+  finally Stream.Free end;
+end.
diff --git a/packages/fcl-tls/tests/testpolicy.pp b/packages/fcl-tls/tests/testpolicy.pp
new file mode 100644
index 0000000000..8ecab78a69
--- /dev/null
+++ b/packages/fcl-tls/tests/testpolicy.pp
@@ -0,0 +1,40 @@
+program testpolicy;
+{$mode objfpc}{$H+}
+uses SysUtils, tlsbackendpolicy;
+var Checks: Integer;
+procedure Check(B: Boolean; const Msg: String);
+begin
+  Inc(Checks);
+  if not B then raise Exception.Create(Msg);
+end;
+procedure ExpectError(Backend: TTLSBackend; SSL, Gnu: TTLSLibraryState);
+begin
+  try
+    ChooseTLSBackend(Backend, SSL, Gnu, tbSchannel);
+  except
+    on E: ETLSBackendSelection do begin Inc(Checks); Exit end;
+  end;
+  raise Exception.Create('Expected selection error');
+end;
+begin
+  Check(ChooseTLSBackend(tbAuto, lsReady, lsReady, tbSchannel)=tbOpenSSL,'OpenSSL first');
+  Check(ChooseTLSBackend(tbAuto, lsAbsent, lsReady, tbSchannel)=tbGnuTLS,'GnuTLS second');
+  Check(ChooseTLSBackend(tbAuto, lsAbsent, lsAbsent, tbSchannel)=tbSchannel,'Native last');
+  Check(ChooseTLSBackend(tbAuto, lsReady, lsInvalid, tbSchannel)=tbOpenSSL,'Unused GnuTLS irrelevant');
+  Check(ChooseTLSBackend(tbSchannel, lsInvalid, lsInvalid, tbSchannel)=tbSchannel,'Explicit native');
+  Check(ChooseTLSBackend(tbGnuTLS, lsInvalid, lsReady, tbSchannel)=tbGnuTLS,'Explicit GnuTLS');
+  Check(ChooseTLSBackend(tbOpenSSL, lsReady, lsInvalid, tbAuto)=tbOpenSSL,'Explicit OpenSSL');
+  ExpectError(tbAuto, lsInvalid, lsReady);
+  ExpectError(tbAuto, lsAbsent, lsInvalid);
+  ExpectError(tbOpenSSL, lsAbsent, lsReady);
+  ExpectError(tbGnuTLS, lsReady, lsInvalid);
+  try
+    ChooseTLSBackend(tbAuto, lsAbsent, lsAbsent, tbAuto);
+    raise Exception.Create('Expected no backend');
+  except on E: ETLSBackendSelection do Inc(Checks) end;
+  try
+    ChooseTLSBackend(tbNetworkFramework, lsAbsent, lsAbsent, tbSchannel);
+    raise Exception.Create('Expected unsupported backend');
+  except on E: ETLSBackendSelection do Inc(Checks) end;
+  Writeln('PASS policy ', Checks);
+end.
diff --git a/packages/fcl-tls/tests/testpublicprobe.py b/packages/fcl-tls/tests/testpublicprobe.py
new file mode 100644
index 0000000000..06d6098d49
--- /dev/null
+++ b/packages/fcl-tls/tests/testpublicprobe.py
@@ -0,0 +1,70 @@
+"""Bounded public TLS diagnostics; exit 0 means collection, not validation.
+
+Never retries a connection inside a backend. Every configuration is an explicit
+new process. Default, short-group and TLS1.2 probes retain certificate/identity
+verification. An EOF or probe's exit 0 is not a successful rejection test.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import time
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('peer', type=Path)
+    p.add_argument('openssl', type=Path)
+    p.add_argument('ssl_library', type=Path)
+    p.add_argument('crypto_library', type=Path)
+    p.add_argument('ca_file', type=Path)
+    p.add_argument('output', type=Path)
+    p.add_argument('--host', default='untrusted-root.badssl.com')
+    p.add_argument('--trials', type=int, choices=(1, 2), default=1)
+    args = p.parse_args()
+    for name in ('peer', 'openssl', 'ssl_library', 'crypto_library', 'ca_file'):
+        value = getattr(args, name).resolve()
+        if not value.is_file():
+            raise SystemExit(f'Existing tool/fixture missing: {value}')
+        setattr(args, name, value)
+    args.output.mkdir(parents=True, exist_ok=True)
+    env = os.environ.copy()
+    env['SSL_CERT_FILE'] = str(args.ca_file)
+    report = {'host': args.host, 'addresses': sorted({a[4][0] for a in socket.getaddrinfo(args.host, 443)}),
+              'note': 'Collection only: no failed handshake counts as a passed certificate test', 'probes': []}
+    configurations = [('openssl-default', []), ('openssl-short-keyshare', ['-groups', 'X25519']),
+                      ('openssl-tls12', ['-tls1_2']), ('fpc-default', []), ('fpc-tls12', ['tls12'])]
+    for trial in range(args.trials):
+        for name, options in configurations:
+            if name.startswith('fpc'):
+                command = [str(args.peer), str(args.ssl_library), str(args.crypto_library),
+                           args.host, '443', 'probe', '0', *options]
+            else:
+                command = [str(args.openssl), 's_client', '-connect', args.host + ':443',
+                           '-servername', args.host, '-verify_return_error', '-verify_hostname',
+                           args.host, '-CAfile', str(args.ca_file), '-state', '-msg', *options]
+            started = time.monotonic()
+            try:
+                result = subprocess.run(command, input='', text=True, capture_output=True,
+                                        env=env, timeout=22)
+                item = {'trial': trial + 1, 'configuration': name, 'returncode': result.returncode,
+                        'stdout': result.stdout, 'stderr': result.stderr}
+            except subprocess.TimeoutExpired as exc:
+                item = {'trial': trial + 1, 'configuration': name, 'timeout': True,
+                        'stdout': str(exc.stdout), 'stderr': str(exc.stderr)}
+            item['elapsed'] = time.monotonic() - started
+            report['probes'].append(item)
+            (args.output / 'results.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+            print('PROBE', name, trial + 1, 'elapsed=', round(item['elapsed'], 3), flush=True)
+            for line in (item['stdout'] + '\n' + item['stderr']).splitlines():
+                if any(word in line.lower() for word in ('handshake accepted', 'verify=', 'verify error',
+                       'verify return', 'certificate verify failed', 'unexpected eof',
+                       'handshake has read', 'no peer certificate', 'ssl_connect:error')):
+                    print(line, flush=True)
+    print('COLLECTED', args.output / 'results.json')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/packages/fcl-tls/tests/testschannel.pp b/packages/fcl-tls/tests/testschannel.pp
new file mode 100644
index 0000000000..9311b2d0ce
--- /dev/null
+++ b/packages/fcl-tls/tests/testschannel.pp
@@ -0,0 +1,52 @@
+program testschannel;
+{$mode objfpc}{$H+}
+uses SysUtils, Classes, fphttpclient, ssockets, sslsockets, schannelsslsockets, smartsslsockets;
+var H: TSchannelSocketHandler; C: TFPHTTPClient; Body: TMemoryStream;
+    Started: QWord; Rejected: Boolean;
+begin
+  H:=TSchannelSocketHandler.Create;
+  try
+    if H.VerifyPeerCert then raise Exception.Create('Handler default changed');
+    if H.Accept then raise Exception.Create('Client backend accepted plaintext');
+    if H.LastSSLErrorCode=0 then raise Exception.Create('Accept needs error');
+    if H.SSLActive then raise Exception.Create('Accept activated TLS');
+    H.RemoteHostName:='example.com';
+  finally H.Free end;
+  if ParamCount=0 then begin Writeln('PASS Schannel construction and Accept'); Halt(0) end;
+  // Exercise fphttpclient through the smart factory, explicitly native even
+  // when test fixtures exist elsewhere on the machine.
+  SetSmartTLSBackend(tbSchannel);
+  C:=TFPHTTPClient.Create(nil);
+  Body:=TMemoryStream.Create;
+  try
+    C.VerifySSLCertificate:=True;
+    C.IOTimeout:=2000;
+    C.ConnectTimeout:=15000;
+    C.AllowRedirect:=False;
+    Started:=GetTickCount64;
+    Rejected:=False;
+    try
+      C.Get(ParamStr(1),Body);
+    except
+      on E: Exception do
+        begin
+        Rejected:=True;
+        Writeln('REJECT ', E.ClassName, ': ', E.Message);
+        if ParamStr(2)<>'reject' then raise;
+        if (Pos('Schannel handshake / system certificate validation',E.Message)=0) or
+           ((Pos('80090322',E.Message)=0) and (Pos('80090325',E.Message)=0) and
+            (Pos('80090328',E.Message)=0) and (Pos('800B010F',E.Message)=0) and
+            (Pos('800B0109',E.Message)=0) and (Pos('800B0101',E.Message)=0)) then
+          raise Exception.Create('Expected a certificate validation failure, not network failure');
+        if (ParamStr(3)<>'') and (Pos(ParamStr(3),E.Message)=0) then
+          raise Exception.Create('Certificate failure had wrong error code');
+        end;
+    end;
+    if (ParamStr(2)='reject') and not Rejected then raise Exception.Create('Invalid certificate accepted');
+    if (ParamStr(2)<>'reject') and ((C.ResponseStatusCode<>200) or (Body.Size=0)) then
+      raise Exception.Create('Expected nonempty HTTP 200');
+    if GetSmartTLSBackend<>tbSchannel then raise Exception.Create('Certificate test changed backend');
+    if not Rejected then Writeln('PASS HTTPS status=',C.ResponseStatusCode,' bytes=',Body.Size);
+    Writeln('Elapsed ms=',GetTickCount64-Started);
+  finally Body.Free; C.Free end;
+end.
diff --git a/packages/fcl-tls/tests/testsmart.pp b/packages/fcl-tls/tests/testsmart.pp
new file mode 100644
index 0000000000..17f0dd4038
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmart.pp
@@ -0,0 +1,69 @@
+program testsmart;
+{$mode objfpc}{$H+}
+uses {$ifdef unix}cthreads,{$endif} Classes, SysUtils, sslsockets, openssl, gnutls, smartsslsockets, opensslsockets;
+type
+  TWorker = class(TThread)
+    ErrorText: String;
+    procedure Execute; override;
+  end;
+var I: Integer; ExpectedClass: String; Workers: array[0..15] of TWorker; H: TSSLSocketHandler;
+procedure TWorker.Execute;
+var Handler: TSSLSocketHandler; J: Integer;
+begin
+  try
+    for J:=1 to 100 do
+      begin
+      Handler:=TSSLSocketHandler.GetDefaultHandler;
+      try
+      if Handler.ClassName<>ExpectedClass then
+        raise Exception.Create('Unexpected TLS handler class '+Handler.ClassName);
+      finally Handler.Free end;
+      end;
+  except on E: Exception do ErrorText:=E.Message end;
+end;
+begin
+  try
+    if ParamStr(1)='native' then
+      {$ifdef darwin}SetSmartTLSBackend(tbNetworkFramework){$else}SetSmartTLSBackend(tbSchannel){$endif};
+    if ParamStr(1)='gnutls' then SetSmartTLSBackend(tbGnuTLS);
+    if ParamStr(1)='openssl' then SetSmartTLSBackend(tbOpenSSL);
+    if ParamStr(1)='relative' then SetSmartTLSLibraryPaths('relative.dll','crypto.dll','');
+    if ParamStr(1)='explicitclass' then
+      begin
+      TSSLSocketHandler.SetDefaultHandlerClass(TOpenSSLSocketHandler);
+      if TSSLSocketHandler.GetDefaultHandlerClass<>TOpenSSLSocketHandler then
+        raise Exception.Create('Explicit registration did not clear smart factory');
+      if GetSmartTLSBackend<>tbAuto then raise Exception.Create('Explicit registration initialized smart');
+      Writeln('PASS explicit handler registration');
+      Halt(0);
+      end;
+    if ParamStr(1)='preloaded' then
+      begin
+      if not InitSSLInterface(ParamStr(2),ParamStr(3)) then
+        raise Exception.Create('Fixture initialization failed');
+      end;
+    {$ifdef darwin}ExpectedClass:='TNetworkFrameworkSocketHandler';{$else}ExpectedClass:='TSchannelSocketHandler';{$endif}
+    if ParamStr(1)='raceopenssl' then ExpectedClass:='TSmartOpenSSLHandler';
+    if (ParamStr(1)='race') or (ParamStr(1)='raceopenssl') then
+      begin
+      for I:=0 to High(Workers) do Workers[I]:=TWorker.Create(True);
+      for I:=0 to High(Workers) do Workers[I].Start;
+      for I:=0 to High(Workers) do
+        begin
+        Workers[I].WaitFor;
+        if Workers[I].ErrorText<>'' then raise Exception.Create(Workers[I].ErrorText);
+        Workers[I].Free;
+        end;
+      end
+    else
+      begin H:=TSSLSocketHandler.GetDefaultHandler; H.Free end;
+    Writeln('SELECTED ', TLSBackendName(GetSmartTLSBackend));
+    if (ParamStr(1)='race') and (IsSSLloaded or GnuTLSloaded) then
+      raise Exception.Create('Native selection loaded a third party TLS library');
+    try
+      SetSmartTLSBackend(tbAuto);
+      raise Exception.Create('Selection must be immutable');
+    except on E: ESmartTLS do ; end;
+    Writeln('PASS immutable selection');
+  except on E: Exception do begin Writeln('ERROR ', E.Message); Halt(1) end end;
+end.
diff --git a/packages/fcl-tls/tests/testsmartclient.pp b/packages/fcl-tls/tests/testsmartclient.pp
new file mode 100644
index 0000000000..03a6a7829f
--- /dev/null
+++ b/packages/fcl-tls/tests/testsmartclient.pp
@@ -0,0 +1,36 @@
+program testsmartclient;
+{$mode objfpc}{$H+}
+uses SysUtils, Classes, fphttpclient, smartsslsockets;
+var Client: TFPHTTPClient; Body: TMemoryStream; Rejected: Boolean;
+begin
+  SetSmartTLSLibraryPaths(ParamStr(1),ParamStr(2),'');
+  SetSmartTLSBackend(tbOpenSSL);
+  Client:=TFPHTTPClient.Create(nil);
+  Body:=TMemoryStream.Create;
+  try
+    Client.VerifySSLCertificate:=True; // strict certificate tests opt in
+    Client.ConnectTimeout:=15000;
+    Client.IOTimeout:=15000;
+    Client.AllowRedirect:=False;
+    Rejected:=False;
+    // A redirect from an IP endpoint still proves the TLS identity check.
+    try Client.HTTPMethod('GET',ParamStr(3),Body,[200,301])
+    except
+      on E: Exception do
+        begin
+        Writeln('REJECT ',E.Message);
+        if ParamStr(4)<>'reject' then raise;
+        if Pos('certificate verify failed',LowerCase(E.Message))=0 then
+          raise Exception.Create('Expected certificate rejection, not network failure');
+        Rejected:=True;
+        end;
+    end;
+    if (ParamStr(4)='reject')<>Rejected then raise Exception.Create('Unexpected certificate result');
+    if not Rejected and (((Client.ResponseStatusCode<>200) and
+       (Client.ResponseStatusCode<>301)) or
+       ((Client.ResponseStatusCode=200) and (Body.Size=0))) then
+      raise Exception.Create('Expected HTTP 200 with a body, or HTTP 301');
+    if GetSmartTLSBackend<>tbOpenSSL then raise Exception.Create('TLS backend changed');
+    Writeln('PASS smart OpenSSL client ',ParamStr(3),' rejected=',Rejected,' status=',Client.ResponseStatusCode,' bytes=',Body.Size);
+  finally Body.Free; Client.Free end;
+end.
diff --git a/packages/fcl-tls/tests/teststates.pp b/packages/fcl-tls/tests/teststates.pp
new file mode 100644
index 0000000000..29a59c8203
--- /dev/null
+++ b/packages/fcl-tls/tests/teststates.pp
@@ -0,0 +1,72 @@
+program teststates;
+{$mode objfpc}{$H+}
+// Compiled against a test-only SSPI provider in an isolated output directory.
+uses SysUtils, Windows, WinSock2, ssockets, schannelsslsockets, schannelsspi;
+var H: TSchannelSocketHandler; S: TInetSocket; B: array[0..15] of Char; N, Opt, Error: Integer; Data: AnsiString; Started, Elapsed: QWord;
+procedure Check(Value: Boolean; const Msg: String);
+begin if not Value then raise Exception.Create(Msg) end;
+begin
+  TestScenario:=ParamStr(2);
+  H:=TSchannelSocketHandler.Create;
+  S:=TInetSocket.Create('127.0.0.1',StrToInt(ParamStr(1)),H);
+  try
+    S.ConnectTimeout:=500;
+    S.IOTimeout:=500;
+    S.Connect;
+    if (TestScenario='sendpressure') or (TestScenario='shutdownpressure') then
+      begin
+      Opt:=4096;
+      Check(SetSockOpt(S.Handle,SOL_SOCKET,SO_SNDBUF,@Opt,SizeOf(Opt))=0,'Small send buffer');
+      Data:=StringOfChar('x',32*1024*1024);
+      if TestScenario='sendpressure' then
+        begin
+        S.IOTimeout:=150;
+        Started:=GetTickCount64;
+        N:=S.Write(Data[1],Length(Data));
+        Elapsed:=GetTickCount64-Started;
+        Check((N=-1) and (H.LastError=WSAETIMEDOUT),'Backpressure must time out');
+        Check((Elapsed>=100) and (Elapsed<1500),'Send exceeded deadline');
+        end
+      else
+        begin
+        // Fill the nonblocking TCP send queue without making TLS terminal.
+        repeat
+          N:=WinSock2.Send(S.Handle,Data[1],Length(Data),0);
+          if N=SOCKET_ERROR then
+            begin Error:=WSAGetLastError; Check(Error=WSAEWOULDBLOCK,'Fill send queue') end;
+        until N=SOCKET_ERROR;
+        TestToken:=StringOfChar('z',1024*1024);
+        S.IOTimeout:=0;
+        Started:=GetTickCount64;
+        Check(not H.Shutdown(False),'Backpressure close must time out');
+        Elapsed:=GetTickCount64-Started;
+        Check(H.LastError=WSAETIMEDOUT,'Close timeout error');
+        Check((Elapsed>=1800) and (Elapsed<3500),'Default close exceeded two-second deadline');
+        end;
+      Writeln('PASS simulated SSPI state ',TestScenario,' elapsed=',Elapsed);
+      Halt(0);
+      end;
+    if TestScenario='renegotiate' then
+      begin
+      N:=S.Read(B,3);
+      Check((N=3) and (Copy(String(B),1,3)='ABC'),'Plaintext before renegotiation lost');
+      Check(TestISCCount=2,'Renegotiation must re-enter ISC with no EXTRA');
+      N:=S.Read(B,1);
+      Check((N=1) and (B[0]='G'),'Final plaintext before close_notify lost');
+      Check(S.Read(B,1)=0,'Expected TLS EOF');
+      end
+    else
+      begin
+      N:=S.Read(B,2);
+      Check((N=2) and (B[0]='A') and (B[1]='B'),'Incomplete record or data lost');
+      Check(H.BytesAvailable=4,'Plaintext remainder not buffered');
+      Check(S.CanRead(0),'Buffered plaintext was not readable');
+      N:=S.Read(B,4);
+      Check((N=4) and (B[0]='C') and (B[3]='F'),'Plaintext remainder corrupted');
+      N:=S.Read(B,1);
+      Check((N=1) and (B[0]='G'),'Plaintext returned with close_notify lost');
+      Check(S.Read(B,1)=0,'Expected TLS EOF');
+      end;
+    Writeln('PASS simulated SSPI state ',TestScenario);
+  finally S.Free end;
+end.
diff --git a/packages/fcl-tls/tests/teststates.py b/packages/fcl-tls/tests/teststates.py
new file mode 100644
index 0000000000..2c068e64cd
--- /dev/null
+++ b/packages/fcl-tls/tests/teststates.py
@@ -0,0 +1,146 @@
+"""Test handler control flow with an isolated, scripted SSPI boundary provider.
+
+This is a state-machine test, not a cryptographic or Windows trust test. The
+real schannelsslsockets implementation reads fragmented bytes over loopback;
+only OS SSPI calls are replaced. Production units contain no test hooks.
+"""
+import argparse
+from pathlib import Path
+import re
+import socket
+import subprocess
+import threading
+import time
+
+PROVIDER = r"""
+function AcquireCredentialsHandleW(Principal, PackageName: PWideChar;
+  Use: Cardinal; LogonID, AuthData, GetKey, GetKeyArg: Pointer;
+  Credential: PSecHandle; Expiry: Pointer): TSecurityStatus; stdcall;
+begin
+  Credential^.Lower:=1;
+  Result:=SEC_E_OK;
+end;
+function InitializeSecurityContextW(Credential, Context: PSecHandle;
+  Target: PWideChar; Requirements, Reserved1, DataRep: Cardinal;
+  Input: PSecBufferDesc; Reserved2: Cardinal; NewContext: PSecHandle;
+  Output: PSecBufferDesc; Attributes: PCardinal; Expiry: Pointer): TSecurityStatus; stdcall;
+begin
+  Inc(TestISCCount);
+  NewContext^.Lower:=2;
+  Attributes^:=ISC_REQ_CONFIDENTIALITY;
+  if TestShutdown then
+    begin
+    Output^.Buffers[0].BufferType:=SECBUFFER_TOKEN;
+    Output^.Buffers[0].Size:=Length(TestToken);
+    Output^.Buffers[0].Data:=PChar(TestToken);
+    end;
+  Result:=SEC_E_OK;
+end;
+function QueryContextAttributesW(Context: PSecHandle; Attribute: Cardinal;
+  Buffer: Pointer): TSecurityStatus; stdcall;
+var Sizes: ^TSecStreamSizes;
+begin
+  Sizes:=Buffer;
+  FillChar(Sizes^,SizeOf(Sizes^),0);
+  Sizes^.MaximumMessage:=16384;
+  Result:=SEC_E_OK;
+end;
+function EncryptMessage(Context: PSecHandle; QOP: Cardinal;
+  Message: PSecBufferDesc; Sequence: Cardinal): TSecurityStatus; stdcall;
+begin Result:=SEC_E_OK end;
+function DecryptMessage(Context: PSecHandle; Message: PSecBufferDesc;
+  Sequence: Cardinal; QOP: PCardinal): TSecurityStatus; stdcall;
+var InputSize: Cardinal;
+begin
+  InputSize:=Message^.Buffers[0].Size;
+  if (TestScenario<>'renegotiate') and (TestDecryptCount=0) and (InputSize<2) then
+    Exit(SEC_E_INCOMPLETE_MESSAGE);
+  FillChar(Message^.Buffers^,4*SizeOf(TSecBuffer),0);
+  Message^.Buffers[1].BufferType:=SECBUFFER_DATA;
+  if TestDecryptCount=0 then
+    begin
+    Message^.Buffers[1].Data:=PChar(TestPlain);
+    if TestScenario='renegotiate' then
+      begin Message^.Buffers[1].Size:=3; Result:=SEC_I_RENEGOTIATE end
+    else
+      begin Message^.Buffers[1].Size:=6; Result:=SEC_E_OK end;
+    // No SECBUFFER_EXTRA is returned for the renegotiation test.
+    end
+  else
+    begin
+    Message^.Buffers[1].Data:=PChar(TestFinal);
+    Message^.Buffers[1].Size:=1;
+    Result:=SEC_I_CONTEXT_EXPIRED;
+    end;
+  Inc(TestDecryptCount);
+end;
+function ApplyControlToken(Context: PSecHandle; Input: PSecBufferDesc): TSecurityStatus; stdcall;
+begin TestShutdown:=True; Result:=SEC_E_OK end;
+function FreeContextBuffer(Buffer: Pointer): TSecurityStatus; stdcall;
+begin Result:=SEC_E_OK end;
+function DeleteSecurityContext(Context: PSecHandle): TSecurityStatus; stdcall;
+begin Result:=SEC_E_OK end;
+function FreeCredentialsHandle(Credential: PSecHandle): TSecurityStatus; stdcall;
+begin Result:=SEC_E_OK end;
+end.
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("compiler", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--scenario", choices=("incomplete", "renegotiate", "sendpressure", "shutdownpressure"))
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[3]
+    args.output.mkdir(parents=True, exist_ok=True)
+    binding = (root / "packages/fcl-net/src/schannelsspi.pp").read_text()
+    interface = binding.split("implementation")[0]
+    interface = re.sub(r"\s*external 'secur32.dll' name '[^']+';", "", interface)
+    interface += "\nvar TestScenario: String; TestISCCount, TestDecryptCount: Integer;\n"
+    interface += "TestShutdown: Boolean; TestToken: String;\n"
+    interface += "TestPlain: String = 'ABCDEF'; TestFinal: String = 'G';\nimplementation\n"
+    (args.output / "schannelsspi.pp").write_text(interface + PROVIDER)
+    command = [str(args.compiler), "-n", "-B", "-gl", f"-Fu{args.output}",
+               f"-Fu{root / 'rtl/units/x86_64-win64'}", f"-Fu{root / 'packages/fcl-net/src'}",
+               f"-Fu{root / 'packages/rtl-objpas/src/inc'}", f"-Fu{root / 'packages/rtl-extra/src/win'}",
+               f"-Fu{root / 'packages/fcl-base/src'}", f"-Fi{root / 'packages/fcl-net/src/win'}",
+               f"-Fi{root / 'packages/rtl-extra/src/inc'}", f"-FU{args.output}", f"-FE{args.output}",
+               str(root / "packages/fcl-tls/tests/teststates.pp")]
+    subprocess.run(command, check=True)
+    for scenario in ((args.scenario,) if args.scenario else ("incomplete", "renegotiate", "sendpressure", "shutdownpressure")):
+        listener = socket.socket()
+        listener.bind(("127.0.0.1", 0))
+        listener.listen(1)
+        listener.settimeout(10)
+
+        finished = threading.Event()
+
+        def feed():
+            client, _ = listener.accept()
+            with client:
+                if scenario in ("sendpressure", "shutdownpressure"):
+                    client.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1024)
+                    finished.wait(8)
+                    listener.close()
+                    return
+                client.sendall(b"x")
+                time.sleep(0.1)
+                if scenario != "renegotiate":
+                    client.sendall(b"y")
+                    time.sleep(0.1)
+                client.sendall(b"z")
+                time.sleep(0.1)
+            listener.close()
+
+        worker = threading.Thread(target=feed)
+        worker.start()
+        result = subprocess.run([str(args.output / "teststates.exe"), str(listener.getsockname()[1]), scenario], timeout=10)
+        finished.set()
+        worker.join(2)
+        if result.returncode:
+            raise SystemExit(result.returncode)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/packages/fcl-tls/tests/testtransport.pp b/packages/fcl-tls/tests/testtransport.pp
new file mode 100644
index 0000000000..c3149464ff
--- /dev/null
+++ b/packages/fcl-tls/tests/testtransport.pp
@@ -0,0 +1,83 @@
+program testtransport;
+{$mode objfpc}{$H+}
+uses SysUtils, Classes, ssockets, sslsockets, sslbase, schannelsslsockets;
+var H: TSchannelSocketHandler; S: TInetSocket; Request, Header, Upload: AnsiString;
+    Buffer: array[0..4095] of Byte; N, Remaining, Expected: Integer;
+    Started: QWord;
+begin
+  H:=TSchannelSocketHandler.Create;
+  H.VerifyPeerCert:=True;
+  H.ServerName:=ParamStr(2);
+  S:=TInetSocket.Create('127.0.0.1',StrToInt(ParamStr(1)),H);
+  try
+    S.ConnectTimeout:=2000;
+    S.IOTimeout:=2000;
+    Started:=GetTickCount64;
+    if ParamStr(3)='stall' then
+      begin
+      S.ConnectTimeout:=150;
+      try
+        S.Connect;
+        raise Exception.Create('Stalled handshake accepted');
+      except
+        on E: ESocketError do
+          if (H.LastError<>10060) or (GetTickCount64-Started>1500) then raise;
+      end;
+      Writeln('PASS stalled handshake deadline');
+      Halt(0);
+      end;
+    if ParamStr(4)='tls12' then H.SSLType:=stTLSv1_2;
+    S.Connect;
+    if ParamStr(3)='timeout' then
+      begin
+      S.IOTimeout:=150;
+      N:=S.Read(Buffer,SizeOf(Buffer));
+      if (N<>-1) or (H.LastError<>10060) or (GetTickCount64-Started>3000) then
+        raise Exception.Create('Read timeout failed');
+      Writeln('PASS receive timeout');
+      Halt(0);
+      end;
+    if ParamStr(3)='upload' then
+      begin
+      Expected:=0;
+      Upload:=StringOfChar('x',1048576);
+      Request:='POST /__up HTTP/1.1'#13#10+'Host: '+ParamStr(2)+#13#10+
+        'Content-Length: '+IntToStr(Length(Upload))+#13#10+
+        'Connection: close'#13#10#13#10;
+      end
+    else
+      begin
+      Expected:=StrToInt(ParamStr(3));
+      Request:='GET /__down?bytes='+IntToStr(Expected)+' HTTP/1.1'#13#10+
+        'Host: '+ParamStr(2)+#13#10+'Connection: close'#13#10#13#10;
+      end;
+    if S.Write(Request[1],Length(Request))<>Length(Request) then
+      raise Exception.Create('Request send failed: '+H.LastSSLErrorString);
+    if (Upload<>'') and (S.Write(Upload[1],Length(Upload))<>Length(Upload)) then
+      raise Exception.Create('Large TLS send failed: '+H.LastSSLErrorString);
+    Header:='';
+    // One-byte reads exercise decrypted leftovers and CanRead.
+    repeat
+      if not S.CanRead(2000) then raise Exception.Create('Header readiness failed');
+      N:=S.Read(Buffer,1);
+      if N<>1 then raise Exception.Create('Header receive failed: '+H.LastSSLErrorString);
+      Header:=Header+AnsiChar(Buffer[0]);
+      if Length(Header)>16384 then raise Exception.Create('Oversized response header');
+    until Copy(Header,Length(Header)-3,4)=#13#10#13#10;
+    if Pos(' 200 ',Header)=0 then raise Exception.Create('Unexpected response: '+Header);
+    Remaining:=Expected;
+    while Remaining>0 do
+      begin
+      N:=SizeOf(Buffer);
+      if Remaining<N then N:=Remaining;
+      N:=S.Read(Buffer,N);
+      if N<=0 then raise Exception.Create('Body receive failed: '+H.LastSSLErrorString);
+      Dec(Remaining,N);
+      end;
+    if not H.Shutdown(False) then raise Exception.Create('TLS shutdown failed: '+H.LastSSLErrorString);
+    if H.SSLActive then raise Exception.Create('TLS remained active after shutdown');
+    if not H.Shutdown(False) then raise Exception.Create('Repeated shutdown failed');
+    if Upload<>'' then Writeln('PASS large send bytes=',Length(Upload))
+    else Writeln('PASS fragmented receive bytes=',Expected,' elapsed=',GetTickCount64-Started);
+  finally S.Free end;
+end.
